@@ -0,0 +1,84 @@
+use crate::high_level_api::composites::aes::constants::{AES_BLOCK_SIZE, BLOCKS_PER_BYTE};
+use crate::integer::{IntegerCiphertext, RadixCiphertext};
+use crate::shortint::Ciphertext;
+
+pub(crate) type FheAesByte = RadixCiphertext;
+
+#[derive(Clone)]
+pub(crate) struct FheAesState([[FheAesByte; 4]; 4]);
+
+impl FheAesState {
+    pub(crate) fn state_from_column_major(block: &[FheAesByte; AES_BLOCK_SIZE]) -> Self {
+        let init = core::array::from_fn(|_| block[0].clone());
+        let mut state: [[FheAesByte; 4]; 4] = core::array::from_fn(|_| init.clone());
+
+        for col_idx in 0..4 {
+            for row_idx in 0..4 {
+                state[row_idx][col_idx] = block[col_idx * 4 + row_idx].clone();
+            }
+        }
+
+        Self(state)
+    }
+
+    pub(crate) fn state_from_column_major_in_blocks_assign(&mut self, flat: &[Ciphertext]) {
+        for i in 0..AES_BLOCK_SIZE {
+            let ct_blocks = flat[i * BLOCKS_PER_BYTE..(i + 1) * BLOCKS_PER_BYTE].to_vec();
+            let col = i / 4;
+            let row = i % 4;
+            self.0[row][col] = FheAesByte::from_blocks(ct_blocks);
+        }
+    }
+
+    pub(crate) fn state_into_column_major(self) -> [FheAesByte; AES_BLOCK_SIZE] {
+        let mut block = core::array::from_fn(|_| self.0[0][0].clone());
+
+        for col_idx in 0..4 {
+            for row_idx in 0..4 {
+                block[col_idx * 4 + row_idx] = self.0[row_idx][col_idx].clone();
+            }
+        }
+
+        block
+    }
+
+    pub(crate) fn state_into_column_major_in_blocks(&self) -> Vec<Ciphertext> {
+        let mut blocks = Vec::with_capacity(AES_BLOCK_SIZE * BLOCKS_PER_BYTE);
+
+        for col_idx in 0..4 {
+            for row in self.rows() {
+                blocks.extend(row[col_idx].blocks().to_vec());
+            }
+        }
+
+        blocks
+    }
+
+    pub(crate) fn state_from_row_major_in_blocks_assign(&mut self, flat: &[Ciphertext]) {
+        for i in 0..AES_BLOCK_SIZE {
+            let ct_blocks = flat[i * BLOCKS_PER_BYTE..(i + 1) * BLOCKS_PER_BYTE].to_vec();
+            let row = i / 4;
+            let col = i % 4;
+            self.0[row][col] = FheAesByte::from_blocks(ct_blocks); // You must implement this
+        }
+    }
+
+    pub(crate) fn rot_row_left(&mut self, row: usize, offset: usize) {
+        let mut tmp = self.0[row].clone();
+
+        tmp.rotate_left(offset);
+        self.0[row].clone_from_slice(&tmp);
+    }
+
+    pub(crate) fn rot_row_right(&mut self, row: usize, offset: usize) {
+        self.rot_row_left(row, 4 - (offset % 4));
+    }
+
+    pub(crate) fn rows(&self) -> impl Iterator<Item = &[FheAesByte; 4]> + '_ {
+        (0..4).map(|i| &self.0[i])
+    }
+
+    pub(crate) fn get_whole(&self) -> [[FheAesByte; 4]; 4] {
+        self.0.clone()
+    }
+}
diff --git a/tfhe/src/high_level_api/composites/aes/engine/threading.rs b/tfhe/src/high_level_api/composites/aes/engine/threading.rs
new file mode 100644
index 000000000..db3546fe1
