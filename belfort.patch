+];
+
+pub fn fhe_aes_encrypt_n_blocks_bench(c: &mut Criterion, n: usize) {
+    let key: [u8; AES_128_KEY_SIZE] = [0x00; AES_128_KEY_SIZE];
+
+    let (client_key, server_key) = tfhe::integer::gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, 4);
+    let mut fpga_key = BelfortServerKey::from(&server_key);
+    fpga_key.connect();
+    set_server_key(fpga_key.clone());
+    let fhe = FheAes::new(&fpga_key);
+
+    let fhe_key = core::array::from_fn(|i| client_key.encrypt(key[i] as u64));
+    let expanded_key = fhe.expand_key(&fhe_key);
+
+    let fhe_blocks = (0..n)
+        .map(|i| {
+            let block = BLOCKS[i];
+            core::array::from_fn(|j| client_key.encrypt(block[j] as u64))
+        })
+        .collect::<Vec<_>>();
+
+    c.bench_function(format!("FHE_AES128_encrypt_{n}_blocks").as_str(), |b| {
+        b.iter(|| {
+            let _cipher = fhe.aes_enc_blocks(black_box(&fhe_blocks), black_box(&expanded_key));
+        });
+    });
+
+    fpga_key.disconnect();
+}
