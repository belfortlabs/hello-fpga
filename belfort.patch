+            ctxt,
+            Some(ctxt_shifted).as_ref(),
+            &scalar,
+            window_size,
+            OffsetMode::PushOffset,
+        );
+
+        let mut result = self.scalar_mul_aggregation(&mut buckets, num_blocks, window_size);
+
+        self.full_propagate_parallelized(&mut result);
+
+        *ctxt = result;
