diff --git a/tfhe/src/high_level_api/composites/aes/engine/round_ops.rs b/tfhe/src/high_level_api/composites/aes/engine/round_ops.rs
new file mode 100644
index 000000000..23637305e
--- /dev/null
+++ b/tfhe/src/high_level_api/composites/aes/engine/round_ops.rs
@@ -0,0 +1,189 @@
+use crate::high_level_api::composites::aes::constants::{
+    BLOCKS_IN_STATE, COLS_IN_STATE, EXPANDED_KEY_SIZE, SHIFT_ROW_PAIRS,
+};
+use crate::high_level_api::composites::aes::engine::state::FheAesState;
+use crate::integer::IntegerCiphertext;
+use crate::shortint::Ciphertext;
+
+use super::state::FheAesByte;
+use super::FheAesEngine;
+
+impl FheAesEngine<'_> {
+    /// Performs AES MixColumns operation.
+    ///
+    /// # Arguments
+    /// - `state`: The current state of the cipher, represented as a mutable 2D array.
+    ///
+    /// * Modifies the state in place.
+    pub(crate) fn mix_columns(&self, state: &mut FheAesState) {
+        let lut_both_flush = self.lookup.lut_both_flush();
+        let lut_reconstruct = self.lookup.lut_reconstruct();
+
+        let bit_extract_manylut = self.lookup.bit_extract_manylut();
+
+        let state_in_blocks = state.state_into_column_major_in_blocks();
+
+        let all_bit_combinations = self
+            .fpga_key
+            .apply_same_many_lookup_vector_packed(&state_in_blocks, &bit_extract_manylut);
+
+        let flattened_bytes_in_bit_blocks: Vec<_> = all_bit_combinations
+            .iter()
+            .map(|vec| vec[0].clone())
+            .collect();
+
+        let bytes_in_bit_blocks: Vec<&[_]> = flattened_bytes_in_bit_blocks.chunks(4).collect();
+
+        let bytes_mul_by_2 = self.field.gf2_8_mul2_from_bitblocks(&all_bit_combinations);
+
+        let mut acc = bytes_mul_by_2.clone();
+
+        for col in 0..COLS_IN_STATE {
+            let i0 = col * COLS_IN_STATE;
+            let i1 = col * COLS_IN_STATE + 1;
+            let i2 = col * COLS_IN_STATE + 2;
+            let i3 = col * COLS_IN_STATE + 3;
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], &bytes_mul_by_2[i1]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], bytes_in_bit_blocks[i1]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], bytes_in_bit_blocks[i0]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], &bytes_mul_by_2[i2]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], &bytes_mul_by_2[i3]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], bytes_in_bit_blocks[i1]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], &bytes_mul_by_2[i0]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], bytes_in_bit_blocks[i0]);
+        }
+
+        self.fpga_key
+            .apply_lut_flat_in_place(&mut acc, &lut_both_flush);
+
+        for col in 0..COLS_IN_STATE {
+            let i0 = col * COLS_IN_STATE;
+            let i1 = col * COLS_IN_STATE + 1;
+            let i2 = col * COLS_IN_STATE + 2;
+            let i3 = col * COLS_IN_STATE + 3;
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], bytes_in_bit_blocks[i2]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], bytes_in_bit_blocks[i3]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], bytes_in_bit_blocks[i2]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], bytes_in_bit_blocks[i3]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], bytes_in_bit_blocks[i0]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], bytes_in_bit_blocks[i3]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], bytes_in_bit_blocks[i1]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], bytes_in_bit_blocks[i2]);
+        }
+
+        self.fpga_key
+            .apply_lut_flat_in_place(&mut acc, &lut_reconstruct);
+        let final_flat = acc.into_iter().flatten().collect::<Vec<_>>();
+
+        state.state_from_column_major_in_blocks_assign(&final_flat);
+    }
+
+    /// Performs AES SubBytes operation using tower field construction.
+    ///
+    /// # Arguments
+    /// - `state`: The current state of the cipher, represented as a mut 2D array.
+    ///
+    /// * Modifies the state in place.
+    pub(crate) fn sub_bytes(&self, state: &mut FheAesState) {
+        let mut state_in_blocks = self.fpga_key.expand_state_blocks(state);
+
+        self.field
+            .apply_isomorphism(&mut state_in_blocks, &self.lookup.fwd_base());
+
+        let mut inv_in_tower_field = self
+            .field
+            .compute_substitute_in_tower_field(&state_in_blocks);
+
+        self.field
+            .apply_isomorphism(&mut inv_in_tower_field, &self.lookup.inv_with_affine_base());
+
+        state.state_from_row_major_in_blocks_assign(&inv_in_tower_field);
+    }
+
+    /// Performs the addition of a round key to the state using an XOR operation.
+    ///
+    /// # Arguments
+    /// - `round`: The current round number.
+    /// - `state`: The current state of the cipher, represented as a mut 2D array.
+    /// - `expanded_key`: The expanded key buffer containing all round keys.
+    // # Note
+    ///   Modifies the state in place.
+    pub(crate) fn add_round_key(
+        &self,
+        round: usize,
+        state: &mut FheAesState,
+        expanded_key: &[FheAesByte; EXPANDED_KEY_SIZE],
+    ) {
+        let mut round_key: Vec<Ciphertext> = Vec::with_capacity(BLOCKS_IN_STATE);
+
+        for i in 0..4 {
+            for j in 0..4 {
+                round_key.extend(
+                    expanded_key[round * COLS_IN_STATE * 4 + i * COLS_IN_STATE + j]
+                        .blocks()
+                        .iter()
+                        .cloned(),
+                )
+            }
+        }
+
+        let mut col_major_state: Vec<Ciphertext> = Vec::with_capacity(BLOCKS_IN_STATE);
+
+        for col in 0..COLS_IN_STATE {
+            for row in state.rows() {
+                if let Some(ct) = row.get(col) {
+                    col_major_state.extend(ct.blocks().iter().cloned());
+                }
+            }
+        }
+
+        let mut packed = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&col_major_state, &round_key);
+
+        self.fpga_key
+            .apply_same_lookup_vector_packed_assign(&mut packed, &self.fpga_key.lut_bitxor());
+
+        state.state_from_column_major_in_blocks_assign(&packed);
+    }
+}
+
+/// Perform the ShiftRows transformation for AES encryption.
+///
+/// This function cyclically shifts the rows of the state matrix to the left.
+/// Each row is shifted by a different offset depending on its index.
+///
+/// # Arguments
+/// - `state`: The current state of the cipher, represented as a mut 2D array.
+///
+/// # Note
+///   Modifies the state in place.
+pub(crate) fn shift_rows(state: &mut FheAesState) {
+    for (row, offset) in SHIFT_ROW_PAIRS {
+        state.rot_row_left(*row, *offset);
+    }
+}
diff --git a/tfhe/src/high_level_api/composites/aes/engine/state.rs b/tfhe/src/high_level_api/composites/aes/engine/state.rs
