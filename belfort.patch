+
+            bench_group.bench_function(&bench_id, |b| {
+                let encrypt_values = || {
+                    let clear_values = (0..nb_elements)
+                        .map(|_| {
+                            let mut v: ScalarType =
+                                gen_random_u256(&mut rng) & max_value_for_bit_size;
