+    }
+
+    pub(crate) fn are_all_comparisons_block_true_simd(
+        &self,
+        mut all_blocks: Vec<Ciphertext>,
+        num_comparisons: usize,
+        mut blocks_per_comparison: usize,
+    ) -> Vec<Ciphertext> {
+        let shortint_key = &self.key.key.key;
+        let max_sum_size = self.key.key.max_sum_size(Degree::new(1));
+
+        while blocks_per_comparison > 1 {
+            let num_groups = blocks_per_comparison.div_ceil(max_sum_size);
+
+            let group_luts: Vec<LookupVector> = (0..num_groups)
+                .map(|group_idx| {
+                    let start = group_idx * max_sum_size;
+                    let end = (start + max_sum_size).min(blocks_per_comparison);
+                    let group_size = (end - start) as u64;
+                    shortint_key.generate_lookup_vector(&move |x| u64::from((x & 15) == group_size))
+                })
+                .collect();
+
+            let mut new_blocks = Vec::with_capacity(num_comparisons * num_groups);
+            for comp_idx in 0..num_comparisons {
+                let base = comp_idx * blocks_per_comparison;
+                for group_idx in 0..num_groups {
+                    let start = base + group_idx * max_sum_size;
+                    let end =
+                        (base + (group_idx + 1) * max_sum_size).min(base + blocks_per_comparison);
+                    let mut sum = all_blocks[start].clone();
+                    for block in &all_blocks[(start + 1)..end] {
+                        shortint_key.unchecked_add_assign(&mut sum, block);
+                    }
+                    new_blocks.push(sum);
+                }
+            }
+
+            let lut_refs: Vec<&LookupVector> = group_luts
+                .iter()
+                .cycle()
+                .take(num_comparisons * num_groups)
+                .collect();
+
+            self.apply_lookup_vector_packed_assign(&mut new_blocks, &lut_refs);
+
+            all_blocks = new_blocks;
+            blocks_per_comparison = num_groups;
+        }
+
+        all_blocks
+    }
+
+    pub(crate) fn is_at_least_one_comparisons_block_true_simd(
+        &self,
+        mut all_blocks: Vec<Ciphertext>,
+        num_comparisons: usize,
+        mut blocks_per_comparison: usize,
+    ) -> Vec<Ciphertext> {
+        let shortint_key = &self.key.key.key;
+        let max_sum_size = self.key.key.max_sum_size(Degree::new(1));
+
+        while blocks_per_comparison > 1 {
+            let num_groups = blocks_per_comparison.div_ceil(max_sum_size);
+
+            let mut new_blocks = Vec::with_capacity(num_comparisons * num_groups);
+            for comp_idx in 0..num_comparisons {
+                let base = comp_idx * blocks_per_comparison;
+                for group_idx in 0..num_groups {
+                    let start = base + group_idx * max_sum_size;
+                    let end =
+                        (base + (group_idx + 1) * max_sum_size).min(base + blocks_per_comparison);
+                    let mut sum = all_blocks[start].clone();
+                    for block in &all_blocks[(start + 1)..end] {
+                        shortint_key.unchecked_add_assign(&mut sum, block);
+                    }
+                    new_blocks.push(sum);
+                }
+            }
+
+            let lut_is_non_zero = shortint_key.generate_lookup_vector(&|x| u64::from(x != 0));
+            self.apply_same_lookup_vector_packed_assign(&mut new_blocks, &lut_is_non_zero);
+
+            all_blocks = new_blocks;
+            blocks_per_comparison = num_groups;
+        }
+
+        all_blocks
+    }
+}
