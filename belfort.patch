+use crate::integer::parameters::IntegerCompactCiphertextListExpansionMode;
+use crate::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn integer_compact_ciphertext_list_expansion_mode(
+        &self,
+    ) -> IntegerCompactCiphertextListExpansionMode<'_> {
+        self.key.cpk_casting_key().map_or_else(
+            || {
+                IntegerCompactCiphertextListExpansionMode::UnpackAndSanitizeIfNecessary(
+                    self.pbs_key(),
+                )
+            },
+            IntegerCompactCiphertextListExpansionMode::CastAndUnpackIfNecessary,
+        )
+    }
+}
diff --git a/tfhe/src/integer/fpga/threading.rs b/tfhe/src/integer/fpga/threading.rs
new file mode 100644
index 000000000..fa8b827d8
--- /dev/null
+++ b/tfhe/src/integer/fpga/threading.rs
@@ -0,0 +1,96 @@
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::IntegerRadixCiphertext;
+use crate::BelfortServerKey;
+use std::sync::mpsc::{channel, Sender};
+use std::sync::Arc;
+use std::thread;
+
+pub(crate) struct OperationPackage<T, F>
+where
+    T: IntegerRadixCiphertext,
+    F: Fn(&BelfortServerKey, &T, &T) -> T + Send + Sync,
+{
+    pub idx: usize,
+    pub left: T,
+    pub right: T,
+    pub operation: Arc<F>,
+}
+
+pub(crate) struct ScalarOperationPackage<T, Clear, F>
+where
+    T: IntegerRadixCiphertext,
+    Clear: DecomposableInto<u8>,
+    F: Fn(&BelfortServerKey, &T, Clear) -> T + Send + Sync,
+{
+    pub idx: usize,
+    pub left: T,
+    pub right: Clear,
+    pub operation: Arc<F>,
+}
+
+pub(crate) fn generate_fpga_threads<T, F>(
+    fpga_key: &BelfortServerKey,
+    result_sender: &Sender<(usize, T)>,
+) -> Vec<Sender<OperationPackage<T, F>>>
+where
+    T: IntegerRadixCiphertext + 'static,
+    F: Send + Sync + Fn(&BelfortServerKey, &T, &T) -> T + 'static,
+{
+    let fpga_indexes = fpga_key.utils.fpga_indexes.clone();
+    #[cfg(feature = "emulate_fpga")]
+    let fpga_indexes: Vec<usize> =
+        crate::core_crypto::fpga::BelfortFpgaUtils::get_fpga_indices_from_env();
+
+    fpga_indexes
+        .into_iter()
+        .map(|i| {
+            let (tx, rx) = channel::<OperationPackage<T, F>>();
+            let res_sender = result_sender.clone();
+            let mut thread_key = fpga_key.clone();
+
+            thread::spawn(move || {
+                thread_key.utils.fpga_indexes = vec![i];
+
+                while let Ok(p) = rx.recv() {
+                    let result = (p.operation)(&thread_key, &p.left, &p.right);
+                    let _ = res_sender.send((p.idx, result));
+                }
+            });
+            tx
+        })
+        .collect()
+}
+
+pub(crate) fn generate_fpga_scalar_op_threads<T, Clear, F>(
+    fpga_key: &BelfortServerKey,
+    result_sender: &Sender<(usize, T)>,
+) -> Vec<Sender<ScalarOperationPackage<T, Clear, F>>>
+where
+    T: IntegerRadixCiphertext + 'static,
+    Clear: DecomposableInto<u8> + 'static,
+    F: Send + Sync + Fn(&BelfortServerKey, &T, Clear) -> T + 'static,
+{
+    let fpga_indexes = fpga_key.utils.fpga_indexes.clone();
+    #[cfg(feature = "emulate_fpga")]
+    let fpga_indexes: Vec<usize> =
+        crate::core_crypto::fpga::BelfortFpgaUtils::get_fpga_indices_from_env();
+
+    fpga_indexes
+        .into_iter()
+        .map(|i| {
+            let (tx, rx) = channel::<ScalarOperationPackage<T, Clear, F>>();
+            let res_sender = result_sender.clone();
+            let mut thread_key = fpga_key.clone();
+
+            thread::spawn(move || {
+                thread_key.utils.fpga_indexes = vec![i];
+
+                while let Ok(p) = rx.recv() {
+                    let result = (p.operation)(&thread_key, &p.left, p.right);
+                    let _ = res_sender.send((p.idx, result));
+                }
+            });
+            tx
+        })
+        .collect()
+}
