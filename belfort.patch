-            .push(HL_PROVEN_COMPACTLIST_TEST_ZKV2.clear_values[2] != 0)
-            .push(HL_PROVEN_COMPACTLIST_TEST_ZKV2.clear_values[3] != 0);
-
-        let proven_list_packed = proven_builder
-            .build_with_proof_packed(
