-  uint32_t poly_id = blockIdx.y % (glwe_dimension + 1);
-  uint32_t lwe_iteration = (blockIdx.x % lwe_chunk_size + lwe_offset);
-  uint32_t input_idx = blockIdx.x / lwe_chunk_size;
