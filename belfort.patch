+    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
+    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
+    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
+];
+
+create_test_belfort_params!(aes_key_expansion);
+create_test_belfort_params!(aes_encrypt);
+create_test_belfort_params!(aes_decrypt);
+
+pub(crate) fn expand_key_aes128(key: [u8; AES_128_KEY_SIZE]) -> [u8; EXPANDED_KEY_SIZE] {
+    let mut expanded_key = [0u8; EXPANDED_KEY_SIZE];
+    let mut temp = [0u8; 4];
+
+    for i in 0..WORDS_IN_KEY {
+        expanded_key[i * 4..(i + 1) * 4].copy_from_slice(&key[i * 4..(i + 1) * 4]);
+    }
+
+    let mut i = WORDS_IN_KEY;
+
+    while i < BYTES_IN_WORD * (ROUNDS + 1) {
+        for j in 0..4 {
+            temp[j] = expanded_key[(i - 1) * 4 + j];
+        }
+
+        if i % WORDS_IN_KEY == 0 {
+            let k = temp[0];
+            temp.rotate_left(1);
+            temp[3] = k;
+
+            for j in 0..4 {
+                temp[j] = S_BOX[temp[j] as usize];
+            }
+
+            temp[0] ^= RCON[i / WORDS_IN_KEY];
+        } else if WORDS_IN_KEY > 6 && i % WORDS_IN_KEY == 4 {
+            for j in 0..4 {
+                temp[j] = S_BOX[temp[j] as usize];
+            }
+        }
+
+        for j in 0..4 {
+            expanded_key[i * 4 + j] = expanded_key[(i - WORDS_IN_KEY) * 4 + j] ^ temp[j];
+        }
+        i += 1;
+    }
+    expanded_key
+}
+
+fn encrypt_reference_aes128(
+    blocks: &[[u8; AES_BLOCK_SIZE]],
+    key: [u8; AES_128_KEY_SIZE],
+) -> Vec<[u8; AES_BLOCK_SIZE]> {
+    let aes = Aes128::new_from_slice(&key).expect("AES-128 key must be 16 bytes");
+
+    blocks
+        .iter()
+        .map(|b| {
+            let mut tmp = Array::from(*b);
+            aes.encrypt_block(&mut tmp);
+            tmp.into()
+        })
+        .collect()
+}
+
+fn random_u128() -> [u8; AES_BLOCK_SIZE] {
+    let mut bytes = [0u8; AES_BLOCK_SIZE];
+    OsRng.fill_bytes(&mut bytes);
+    bytes
+}
+
+fn expand_key_wrapper_for_test(
+    fpga_key: &BelfortServerKey,
+    key: &[FheAesByte; AES_128_KEY_SIZE],
+) -> [FheAesByte; EXPANDED_KEY_SIZE] {
+    let fhe = FheAes::new(fpga_key);
+    fhe.expand_key(key)
+}
+
+fn aes_enc_wrapper_for_test(
+    fpga_key: &BelfortServerKey,
+    blocks: &[[FheAesByte; AES_BLOCK_SIZE]],
+    expanded_key: &[FheAesByte; EXPANDED_KEY_SIZE],
+) -> Vec<[FheAesByte; AES_BLOCK_SIZE]> {
+    let fhe = FheAes::new(fpga_key);
+    fhe.aes_enc_blocks(blocks, expanded_key)
+}
+
+fn aes_dec_wrapper_for_test(
+    fpga_key: &BelfortServerKey,
+    blocks: &[[FheAesByte; AES_BLOCK_SIZE]],
+    expanded_key: &[FheAesByte; EXPANDED_KEY_SIZE],
+) -> Vec<[FheAesByte; AES_BLOCK_SIZE]> {
+    let fhe = FheAes::new(fpga_key);
+    fhe.aes_dec_blocks(blocks, expanded_key)
+}
+
+fn aes_key_expansion<P>(param: P)
+where
+    P: Into<TestParameters>,
+{
+    let executor = FpgaFunctionExecutor::new(expand_key_wrapper_for_test);
+    aes_key_expansion_tests(param, executor);
+}
+
+fn aes_encrypt<P>(param: P)
+where
+    P: Into<TestParameters>,
+{
+    let executor = FpgaFunctionExecutor::new(aes_enc_wrapper_for_test);
+    aes_encrypt_tests(param, executor);
+}
+
+fn aes_decrypt<P>(param: P)
+where
+    P: Into<TestParameters>,
+{
+    let executor = FpgaFunctionExecutor::new(aes_dec_wrapper_for_test);
+    aes_decrypt_tests(param, executor);
+}
+
+fn aes_key_expansion_tests<P, F>(param: P, mut executor: FpgaFunctionExecutor<F>)
+where
+    P: Into<TestParameters>,
+    F: for<'a> Fn(
+        &'a BelfortServerKey,
+        &'a [FheAesByte; AES_128_KEY_SIZE],
+    ) -> [FheAesByte; EXPANDED_KEY_SIZE],
+    FpgaFunctionExecutor<F>: for<'a> FunctionExecutor<
+        &'a [FheAesByte; AES_128_KEY_SIZE],
+        [FheAesByte; EXPANDED_KEY_SIZE],
+    >,
+{
+    let key = random_u128();
+    let expected_key = expand_key_aes128(key);
+
+    let param = param.into();
+    let (cks, sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let sks = Arc::new(sks);
+
+    executor.setup(sks);
+
+    let fhe_enc_key = core::array::from_fn(|i| cks.encrypt_radix(key[i] as u64, 4));
+
+    let expanded_key =
+        crate::integer::server_key::radix_parallel::tests_cases_unsigned::FunctionExecutor::execute(
+            &mut executor,
+            &fhe_enc_key,
+        );
+
+    let dec_key: [u8; EXPANDED_KEY_SIZE] =
+        core::array::from_fn(|idx| cks.decrypt_radix(&expanded_key[idx]));
+
+    for (expected, actual) in expected_key.iter().zip(dec_key.iter()) {
+        assert_eq!(
+            expected, actual,
+            "The result should match the original expanded key."
+        );
+    }
+}
+
+pub(crate) fn aes_encrypt_tests<P, F>(param: P, mut executor: FpgaFunctionExecutor<F>)
+where
+    P: Into<TestParameters>,
+    F: for<'a> Fn(
+        &'a BelfortServerKey,
+        &'a [[FheAesByte; AES_BLOCK_SIZE]],
+        &'a [FheAesByte; EXPANDED_KEY_SIZE],
+    ) -> Vec<[FheAesByte; AES_BLOCK_SIZE]>,
+    FpgaFunctionExecutor<F>: for<'a> FunctionExecutor<
+        (
+            &'a [[FheAesByte; AES_BLOCK_SIZE]],
+            &'a [FheAesByte; EXPANDED_KEY_SIZE],
+        ),
+        Vec<[FheAesByte; AES_BLOCK_SIZE]>,
+    >,
+{
+    let key = random_u128();
+    let expanded_ref = expand_key_aes128(key);
+
+    let blocks: [[u8; AES_BLOCK_SIZE]; NUM_BLOCKS] = core::array::from_fn(|_| random_u128());
+
+    let aes_enc_blocks = encrypt_reference_aes128(&blocks, key);
+
+    let param = param.into();
+    let (cks, sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let sks = Arc::new(sks);
+    executor.setup(sks);
+
+    let exp_key: [FheAesByte; EXPANDED_KEY_SIZE] =
+        core::array::from_fn(|i| cks.encrypt_radix(expanded_ref[i] as u64, 4));
+
+    let fhe_enc_blocks: [[RadixCiphertext; AES_BLOCK_SIZE]; NUM_BLOCKS] =
+        core::array::from_fn(|block_idx| {
+            core::array::from_fn(|byte_idx| {
+                cks.create_trivial_radix(blocks[block_idx][byte_idx] as u64, 4)
+            })
+        });
+
+    let fhe_aes_enc_blocks =
+        crate::integer::server_key::radix_parallel::tests_cases_unsigned::FunctionExecutor::execute(
+            &mut executor,
+            (&fhe_enc_blocks, &exp_key),
+        );
+
+    let dec_blocks: [[u8; AES_BLOCK_SIZE]; NUM_BLOCKS] = core::array::from_fn(|block_idx| {
+        core::array::from_fn(|byte_idx| cks.decrypt_radix(&fhe_aes_enc_blocks[block_idx][byte_idx]))
+    });
+
+    for (expected, actual) in aes_enc_blocks.iter().zip(dec_blocks.iter()) {
+        assert_eq!(
+            expected.as_slice(),
+            actual,
+            "The result should match the original blocks."
+        );
+    }
+}
+
+fn aes_decrypt_tests<P, F>(param: P, mut executor: FpgaFunctionExecutor<F>)
+where
+    P: Into<TestParameters>,
+    F: for<'a> Fn(
+        &'a BelfortServerKey,
+        &'a [[FheAesByte; AES_BLOCK_SIZE]],
+        &'a [FheAesByte; EXPANDED_KEY_SIZE],
+    ) -> Vec<[FheAesByte; AES_BLOCK_SIZE]>,
+    FpgaFunctionExecutor<F>: for<'a> FunctionExecutor<
+        (
+            &'a [[FheAesByte; AES_BLOCK_SIZE]],
+            &'a [FheAesByte; EXPANDED_KEY_SIZE],
+        ),
+        Vec<[FheAesByte; AES_BLOCK_SIZE]>,
+    >,
+{
+    let key = random_u128();
+    let expanded_ref = expand_key_aes128(key);
+
+    let blocks: [[u8; AES_BLOCK_SIZE]; NUM_BLOCKS] = std::array::from_fn(|_| random_u128());
+
+    let aes_enc_blocks = encrypt_reference_aes128(&blocks, key);
+
+    let param = param.into();
+    let (cks, sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let sks = Arc::new(sks);
+    executor.setup(sks);
+
+    let exp_key: [FheAesByte; EXPANDED_KEY_SIZE] =
+        core::array::from_fn(|i| cks.encrypt_radix(expanded_ref[i] as u64, 4));
+
+    let fhe_aes_enc_blocks: [[RadixCiphertext; AES_BLOCK_SIZE]; NUM_BLOCKS] =
+        core::array::from_fn(|block_idx| {
+            core::array::from_fn(|byte_idx| {
+                cks.create_trivial_radix(aes_enc_blocks[block_idx][byte_idx] as u64, 4)
+            })
+        });
+
+    let aes_dec_blocks =
+        crate::integer::server_key::radix_parallel::tests_cases_unsigned::FunctionExecutor::execute(
+            &mut executor,
+            (&fhe_aes_enc_blocks, &exp_key),
+        );
+
+    let dec_blocks: [[u8; AES_BLOCK_SIZE]; NUM_BLOCKS] = core::array::from_fn(|block_idx| {
+        core::array::from_fn(|byte_idx| cks.decrypt_radix(&aes_dec_blocks[block_idx][byte_idx]))
+    });
+
+    for (expected, actual) in blocks.iter().zip(dec_blocks.iter()) {
+        assert_eq!(
+            expected.as_slice(),
+            actual,
+            "The result should match the original blocks."
+        );
+    }
+}
diff --git a/tfhe/src/high_level_api/composites/aes/utils.rs b/tfhe/src/high_level_api/composites/aes/utils.rs
