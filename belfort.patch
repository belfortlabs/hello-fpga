+pub(crate) fn default_add_simd_test<P, T>(param: P, mut executor: T)
+where
+    P: Into<TestParameters>,
+    T: for<'a> FunctionExecutor<
+        (&'a [RadixCiphertext], &'a [RadixCiphertext]),
+        Vec<RadixCiphertext>,
+    >,
+{
+    let param = param.into();
+    let nb_tests_smaller = nb_tests_smaller_for_params(param);
+    let (cks, mut sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let cks = RadixClientKey::from((cks, NB_CTXT));
+
+    sks.set_deterministic_pbs_execution(true);
+    let sks = Arc::new(sks);
+
+    let mut rng = rand::thread_rng();
+
+    executor.setup(&cks, sks);
+
+    for num_blocks in 1..MAX_NB_CTXT {
+        let modulus = unsigned_modulus(cks.parameters().message_modulus(), num_blocks as u32);
+
+        let clear_0 = (0..SIMD_LEN)
+            .map(|_| rng.gen::<u64>() % modulus)
+            .collect::<Vec<_>>();
+        let clear_1 = (0..SIMD_LEN)
+            .map(|_| rng.gen::<u64>() % modulus)
+            .collect::<Vec<_>>();
+
+        let ctxt_0 = clear_0
+            .iter()
+            .map(|&c| cks.as_ref().encrypt_radix(c, num_blocks))
+            .collect::<Vec<_>>();
+        let ctxt_1 = clear_1
+            .iter()
+            .map(|&c| cks.as_ref().encrypt_radix(c, num_blocks))
+            .collect::<Vec<_>>();
+
+        let mut ct_res = executor.execute((&ctxt_0, &ctxt_1));
+        let tmp_ct = executor.execute((&ctxt_0, &ctxt_1));
+
+        ct_res
+            .iter()
+            .zip(tmp_ct.iter())
+            .zip(clear_0.iter())
+            .zip(clear_1.iter())
+            .for_each(|(((ct_res_i, tmp_ct_i), &c0), &c1)| {
+                panic_if_any_block_is_not_clean(ct_res_i, &cks);
+                assert_eq!(ct_res_i, tmp_ct_i);
+
+                let expected = c0.wrapping_add(c1) % modulus;
+                let dec_res: u64 = cks.decrypt(ct_res_i);
+                assert_eq!(
+                    expected, dec_res,
+                    "Invalid result for {c0} + {c1}, expected: {expected}, got: {dec_res}\n\
+                     num_blocks={num_blocks}, modulus={modulus}"
+                );
+            });
+
+        let mut clears = clear_0
+            .iter()
+            .zip(clear_1.iter())
+            .map(|(&c0, &c1)| c0.wrapping_add(c1) % modulus)
+            .collect::<Vec<_>>();
+
+        for _ in 0..nb_tests_smaller {
+            let new_ct_res = executor.execute((&ct_res, &ctxt_0));
+
+            new_ct_res
+                .iter()
+                .zip(clears.iter_mut())
+                .zip(clear_0.iter())
+                .for_each(|((ct_res_i, clear_i), &c0)| {
+                    panic_if_any_block_is_not_clean(ct_res_i, &cks);
+
+                    let result = (*clear_i + c0) % modulus;
+                    let dec_res: u64 = cks.decrypt(ct_res_i);
+                    assert_eq!(
+                        result, dec_res,
+                        "Invalid result for {clear_i} + {c0}, expected: {result}, got: {dec_res}\n\
+                         num_blocks={num_blocks}, modulus={modulus}"
+                    );
+                    *clear_i = result;
+                });
+
+            ct_res = new_ct_res;
+        }
+    }
