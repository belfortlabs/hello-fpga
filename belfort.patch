-    precalc_coefs[threadIdx.x + i * (params::degree / params::opt)] = -1;
-    precalc_coefs[threadIdx.x + i * (params::degree / params::opt) +
-                  params::degree] = 1;
-    precalc_coefs[threadIdx.x + i * (params::degree / params::opt) +
-                  2 * params::degree] = -1;
-  }
