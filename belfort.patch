+        self.apply_same_lookup_vector_packed_assign(&mut new_blocks, &lut_create_blocks_swb1);
+
+        ct.blocks_mut().swap_with_slice(&mut new_blocks[0..]);
+
+        debug_assert!(ct.block_carries_are_empty());
+    }
+}
