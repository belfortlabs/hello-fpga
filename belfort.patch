@@ -0,0 +1,91 @@
+name: Run tests on AWS F2
+
+permissions:
+  contents: "read"
+
+on:
+  workflow_dispatch:
+    inputs:
+      instance-type:
+        description: "EC2 Instance type"
+        required: true
+        default: "f2.12xlarge"
+        type: choice
+        options:
+          - "f2.6xlarge"
+          - "f2.12xlarge"
+          - "f2.48xlarge"
+  # pull_request:
+  #   types: [ "review_requested" ]
+
+jobs:
+  start-runner:
+    uses: ./.github/workflows/aws-start-instance.yml
+    secrets:
+      github-token: ${{ secrets.GH_PERSONAL_ACCESS_TOKEN }}
+      aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+      aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+    with:
+      ec2-instance-type: ${{ github.event_name == 'workflow_dispatch' && inputs.instance-type || 'f2.12xlarge' }}
+
+  run-test:
+    name: Test TFHE-rs on AWS F2 Instance
+    needs: start-runner # required to start the main job when the runner is ready
+    runs-on: ${{ needs.start-runner.outputs.ec2-label }} # run the job on the newly created runner
+    timeout-minutes: 240
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8
+        with:
+          persist-credentials: "false"
+
+      - name: Install latest stable
+        uses: dtolnay/rust-toolchain@e97e2d8cc328f1b50210efc529dca0028893a2d9
+        with:
+          toolchain: stable
+
+      - name: Cache Rust dependencies
+        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830
+        with:
+          path: |
+            ~/.cargo/registry
+            ~/.cargo/git
+            target
+          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}
+          restore-keys: |
+            ${{ runner.os }}-cargo-
+
+      - name: Setup Belfort Environment
+        run: |
+          # shellcheck source=/dev/null
+          source /tools/belfort_v*/interface/setup.sh
+          # Set the environment variables for subsequent steps
+          {
+            echo "BELFORT_HOME=$BELFORT_HOME"
+            echo "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
+            echo "BELFORT_FPGA_IDX=$BELFORT_FPGA_IDX"
+          } >> "$GITHUB_ENV"
+
+      - name: Install Rust build toolchain
+        run: make install_rs_build_toolchain
+
+      - name: Run integer FPGA tests
+        run: make test_integer_fpga
+
+      - name: Run arrays FPGA tests
+        run: make test_arrays_fpga
+
+  stop-runner:
+    name: Stop self-hosted EC2 runner
+    needs:
+      - start-runner # required to get output from the start-runner job
+      - run-test # required to wait when the main job is done
+    if: ${{ always() }} # required to stop the runner even if the error happened in the previous jobs
+    uses: ./.github/workflows/aws-stop-instance.yml
+    secrets:
+      github-token: ${{ secrets.GH_PERSONAL_ACCESS_TOKEN }}
+      aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+      aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+    with:
+      ec2-label: ${{ needs.start-runner.outputs.ec2-label }}
+      ec2-instance-id: ${{ needs.start-runner.outputs.ec2-instance-id }}
