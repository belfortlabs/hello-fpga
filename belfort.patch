-    // Accumulate
-    for (int i = 1; i < num_lwes; i++) {
-      auto glwe_in = glwe_array_in + i * (glwe_dimension + 1) * polynomial_size;
-      glwe_out[tid] += glwe_in[tid];
-    }
-  }
-}
