+    pub fn unchecked_scalar_compare_handler<T, Scalar, F>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        let comparison = self.unchecked_scalar_compare(lhs, rhs, selector, sign_result_handler_fn);
+        BooleanBlock::new_unchecked(comparison)
+    }
+    fn default_scalar_compare_parallelized<T, Scalar, F>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        let mut tmp_lhs;
+        let lhs = if lhs.block_carries_are_empty() {
+            lhs
+        } else {
+            tmp_lhs = lhs.clone();
+            self.server_key.full_propagate(&mut tmp_lhs);
+            &tmp_lhs
+        };
+        self.unchecked_scalar_compare_handler(lhs, rhs, selector, sign_result_handler_fn)
+    }
+    fn unchecked_scalar_compare<T, Scalar, F>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> Ciphertext
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        // TODO: change this for signed integers,
+        // Look up radix_parallel/scalar_comparison.rs
+        self.unsigned_unchecked_scalar_compare_blocks(
+            lhs.blocks(),
+            rhs,
+            selector,
+            sign_result_handler_fn,
+        )
+    }
+
+    fn unsigned_unchecked_scalar_compare_blocks<Scalar, F>(
+        &self,
+        lhs_blocks: &[Ciphertext],
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> Ciphertext
+    where
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        assert!(!lhs_blocks.is_empty());
+        let shortint_key = &self.server_key.key.key.key;
+        if rhs < Scalar::ZERO {
+            // lhs_blocks represent an unsigned (always >= 0)
+            return shortint_key.create_trivial(sign_result_handler_fn(Self::IS_SUPERIOR));
+        }
+
+        let message_modulus = shortint_key.message_modulus.0;
+
+        let mut scalar_blocks =
+            BlockDecomposer::with_early_stop_at_zero(rhs, message_modulus.ilog2())
+                .iter_as::<u64>()
+                .map(|x| x as u8)
+                .collect::<Vec<_>>();
+
+        // scalar is obviously bigger if it has non-zero
+        // blocks  after lhs's last block
+        let is_scalar_obviously_bigger = scalar_blocks
+            .get(lhs_blocks.len()..)
+            .is_some_and(|sub_slice| sub_slice.iter().any(|&scalar_block| scalar_block != 0));
+        if is_scalar_obviously_bigger {
+            return shortint_key.create_trivial(sign_result_handler_fn(Self::IS_INFERIOR));
+        }
+        // If we are sill here, that means scalar_blocks above
+        // num_blocks are 0s, we can remove them
+        // as we will handle them separately.
+        scalar_blocks.truncate(lhs_blocks.len());
+
+        let (least_significant_blocks, most_significant_blocks) =
+            lhs_blocks.split_at(scalar_blocks.len());
+
+        let lut_selection = |selector: ComparisonSelector| {
+            let func = match selector {
+                ComparisonSelector::Gt => |lsb, msb| {
+                    let msb = if msb == 1 {
+                        Self::IS_EQUAL
+                    } else {
+                        Self::IS_SUPERIOR
+                    };
+                    let x = (msb << 2) + lsb;
+                    let m = (x >> 2) & 3_u64;
+                    let l = x & 3;
+                    let final_sign = if m == Self::IS_EQUAL { l } else { m };
+                    u64::from(final_sign == Self::IS_SUPERIOR)
+                },
+                ComparisonSelector::Ge => |lsb, msb| {
+                    let msb = if msb == 1 {
+                        Self::IS_EQUAL
+                    } else {
+                        Self::IS_SUPERIOR
+                    };
+                    let x = (msb << 2) + lsb;
+                    let m = (x >> 2) & 3_u64;
+                    let l = x & 3;
+                    let final_sign = if m == Self::IS_EQUAL { l } else { m };
+                    u64::from(final_sign == Self::IS_SUPERIOR || final_sign == Self::IS_EQUAL)
+                },
+                ComparisonSelector::Lt => |lsb, msb| {
+                    let msb = if msb == 1 {
+                        Self::IS_EQUAL
+                    } else {
+                        Self::IS_SUPERIOR
+                    };
+                    let x = (msb << 2) + lsb;
+                    let m = (x >> 2) & 3_u64;
+                    let l = x & 3;
+                    let final_sign = if m == Self::IS_EQUAL { l } else { m };
+                    u64::from(final_sign == Self::IS_INFERIOR)
+                },
+                ComparisonSelector::Le => |lsb, msb| {
+                    let msb = if msb == 1 {
+                        Self::IS_EQUAL
+                    } else {
+                        Self::IS_SUPERIOR
+                    };
+                    let x = (msb << 2) + lsb;
+                    let m = (x >> 2) & 3_u64;
+                    let l = x & 3;
+                    let final_sign = if m == Self::IS_EQUAL { l } else { m };
+                    u64::from(final_sign == Self::IS_INFERIOR || final_sign == Self::IS_EQUAL)
+                },
+                ComparisonSelector::None => |lsb, msb| {
+                    let msb = if msb == 1 {
+                        Self::IS_EQUAL
+                    } else {
+                        Self::IS_SUPERIOR
+                    };
+                    let x = (msb << 2) + lsb;
+                    let m = (x >> 2) & 3_u64;
+                    let l = x & 3;
+                    if m == Self::IS_EQUAL {
+                        l
+                    } else {
+                        m
+                    }
+                },
+            };
+
+            shortint_key.generate_lookup_vector_bivariate(&func)
+        };
+
+        // Reducing the signs is the bottleneck of the comparison algorithms,
+        // however if the scalar case there is an improvement:
+        //
+        // The idea is to reduce the number of signs block we have to
+        // reduce. We can do that by splitting the comparison problem in two parts.
+        //
+        // - One part where we compute the signs block between the scalar with just enough blocks
+        //   from the ciphertext that can represent the scalar value
+        //
+        // - The other part is to compare the ciphertext blocks not considered for the sign
+        //   computation with zero, and create a single sign block from that.
+        //
+        // The smaller the scalar value is compared to the ciphertext num bits encrypted,
+        // the more the comparisons with zeros we have to do,
+        // and the less signs block we will have to reduce.
+        //
+        // This will create a speedup as comparing a bunch of blocks with 0
+        // is faster
+
+        match (
+            least_significant_blocks.is_empty(),
+            most_significant_blocks.is_empty(),
+        ) {
+            (false, false) => {
+                // We have to handle both part of the work described above
+
+                let (lsb_sign, are_all_msb_equal_to_zero) = (
+                    {
+                        let lsb_signs = self.unchecked_scalar_block_slice_compare_parallelized(
+                            least_significant_blocks,
+                            &scalar_blocks,
+                        );
+
+                        self.reduce_signs_pack(lsb_signs, &ComparisonSelector::None)
+                    },
+                    self.server_key.are_all_blocks_zero(most_significant_blocks),
+                );
+
+                let lut = lut_selection(selector);
+
+                let mut prepared_blocks = self
+                    .server_key
+                    .prepare_block_vecs_bivariate(&[lsb_sign], &[are_all_msb_equal_to_zero]);
+
+                self.server_key
+                    .apply_lookup_vector_packed_assign(&mut prepared_blocks, &[&lut]);
+
+                prepared_blocks[0].clone()
+            }
+            (false, true) => {
+                // We only have to do the regular comparison
+                // And not the part where we compare most significant blocks with zeros
+
+                let signs = self.unchecked_scalar_block_slice_compare_parallelized(
+                    least_significant_blocks,
+                    &scalar_blocks,
+                );
+
+                self.reduce_signs_pack(signs, &selector)
+            }
+            (true, false) => {
+                // We only have to compare blocks with zero
+                // means scalar is zero
+                let are_all_msb_equal_to_zero =
+                    self.server_key.are_all_blocks_zero(most_significant_blocks);
+
+                let lut = lut_selection(selector);
+                let luts = vec![&lut];
+
+                let mut blocks = vec![are_all_msb_equal_to_zero];
+                self.server_key
+                    .apply_lookup_vector_packed_assign(&mut blocks, &luts);
+
+                blocks[0].clone()
+            }
+            (true, true) => {
+                // assert should have  been hit earlier
+                unreachable!("Empty input ciphertext")
+            }
+        }
+    }
+
+    fn unchecked_scalar_block_slice_compare_parallelized(
+        &self,
+        lhs_blocks: &[Ciphertext],
+        scalar_blocks: &[u8],
+    ) -> Vec<Ciphertext> {
+        assert_eq!(lhs_blocks.len(), scalar_blocks.len());
+
+        let shortint_key = &self.server_key.key.key.key;
+        let message_modulus = shortint_key.message_modulus.0;
+
+        let mut signs: Vec<_> = lhs_blocks
+            .chunks(2)
+            .zip(scalar_blocks.chunks(2))
+            .map(|(lhs_chunk, scalar_chunk)| {
+                let packed_scalar = scalar_chunk[0]
+                    + (scalar_chunk.get(1).copied().unwrap_or(0) * message_modulus as u8);
+                let mut packed_lhs = self.pack_block_chunk(lhs_chunk);
+
+                let delta = (1u64 << (u64::BITS as u64 - 1))
+                    / (packed_lhs.carry_modulus.0 * packed_lhs.message_modulus.0);
+                let plaintext = Plaintext((packed_scalar as u64) * delta);
+
+                lwe_ciphertext_plaintext_sub_assign(&mut packed_lhs.ct, plaintext);
+                packed_lhs
+            })
+            .collect();
+
+        self.server_key
+            .apply_same_lookup_vector_packed_assign(&mut signs, &self.sign_lut);
+
+        for signs_block in signs.iter_mut() {
+            shortint_key.unchecked_scalar_add_assign(signs_block, 1);
+        }
+
+        signs
+    }
+
+    pub fn scalar_max<T, Scalar>(&self, lhs: &T, rhs: Scalar) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+    {
+        let mut tmp_lhs;
+        let lhs = if lhs.block_carries_are_empty() {
+            lhs
+        } else {
+            tmp_lhs = lhs.clone();
+            self.server_key.full_propagate(&mut tmp_lhs);
+            &tmp_lhs
+        };
+        self.unchecked_scalar_min_or_max(lhs, rhs, MinMaxSelector::Max)
+    }
+
+    pub fn scalar_min<T, Scalar>(&self, lhs: &T, rhs: Scalar) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+    {
+        let mut tmp_lhs;
+        let lhs = if lhs.block_carries_are_empty() {
+            lhs
+        } else {
+            tmp_lhs = lhs.clone();
+            self.server_key.full_propagate(&mut tmp_lhs);
+            &tmp_lhs
+        };
+        self.unchecked_scalar_min_or_max(lhs, rhs, MinMaxSelector::Min)
+    }
+
+    pub fn unchecked_scalar_min_or_max<T, Scalar>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: MinMaxSelector,
+    ) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+    {
+        let return_lhs = match selector {
+            MinMaxSelector::Max => self.unchecked_scalar_gt(lhs, rhs),
+            MinMaxSelector::Min => self.unchecked_scalar_le(lhs, rhs),
+        };
+
+        let rhs = self
+            .server_key
+            .key
+            .key
+            .create_trivial_radix(rhs, lhs.blocks().len());
+
+        let do_clean_message = true;
+        self.server_key.unchecked_programmable_if_then_else(
+            &return_lhs.0,
+            lhs,
+            &rhs,
+            |x| x == 1,
+            do_clean_message,
+        )
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/fpga.rs b/tfhe/src/integer/fpga/server_key/fpga.rs
new file mode 100644
index 000000000..4ca5de672
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/fpga.rs
@@ -0,0 +1,212 @@
+use crate::core_crypto::fpga::lookup_vector::{LookupVector, ManyLookupVector};
+use crate::core_crypto::fpga::programmable_bootstrap::ProgrammableBootstrapPacked;
+use crate::high_level_api::keys::IntegerServerKey;
+use crate::high_level_api::Tag;
+use crate::shortint::Ciphertext;
+use crate::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn connect(&mut self) {
+        #[cfg(not(feature = "emulate_fpga"))]
+        {
+            use crate::core_crypto::fpga::utils::Connect;
+
+            let server_key = &self.key.key.key;
+
+            self.utils.connect(server_key);
+        }
+    }
+
+    pub fn connect_to(&mut self, fpga_indexes: Vec<usize>) {
+        #[cfg(not(feature = "emulate_fpga"))]
+        {
+            use crate::core_crypto::fpga::utils::Connect;
+
+            let server_key = &self.key.key.key;
+
+            self.utils.connect_to(server_key, fpga_indexes);
+        }
+    }
+
+    pub fn disconnect(&mut self) {
+        #[cfg(not(feature = "emulate_fpga"))]
+        self.utils.disconnect();
+    }
+
+    pub fn pbs_key(&self) -> &crate::integer::ServerKey {
+        &self.key.key
+    }
+
+    pub fn tag(&self) -> &Tag {
+        &self.tag
+    }
+
+    #[cfg(not(feature = "emulate_fpga"))]
+    fn apply_programmable_bootstrap_on_trivial(
+        &self,
+        cts: &mut Vec<Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        use rayon::iter::*;
+        use std::sync::Arc;
+
+        let arc_key: &Arc<IntegerServerKey> = &self.key;
+        let shortint_key = &arc_key.key.key;
+
+        cts.par_iter_mut()
+            .enumerate()
+            .filter(|(_, ct)| ct.is_trivial())
+            .for_each(|(index, ct)| {
+                let lut_vector = &luts[index];
+                let lut_table = shortint_key.convert_lookup_vector_to_lookup_table(lut_vector);
+                shortint_key.trivial_pbs_assign(ct, &lut_table);
+            });
+    }
+
+    #[cfg(not(feature = "emulate_fpga"))]
+    fn apply_many_lut_programmable_bootstrap_on_trivial(
+        &self,
+        cts: &[Ciphertext],
+        luts: &[&ManyLookupVector],
+    ) -> Vec<Vec<Ciphertext>> {
+        use rayon::iter::*;
+        use std::sync::Arc;
+
+        let arc_key: &Arc<IntegerServerKey> = &self.key;
+        let shortint_key = &arc_key.key.key;
+
+        let mut output: Vec<Vec<Ciphertext>> = vec![vec![]; cts.len()];
+        let result = cts
+            .par_iter()
+            .enumerate()
+            .filter(|(_, ct)| ct.is_trivial())
+            .map(|(index, ct)| {
+                let lut_vector = &luts[index];
+                let lut_table =
+                    shortint_key.convert_many_lookup_vector_to_many_lookup_table(lut_vector);
+                (index, shortint_key.trivial_pbs_many_lut(ct, &lut_table))
+            })
+            .collect::<Vec<_>>();
+
+        for (index, ct_res) in result {
+            output[index] = ct_res;
+        }
+        output
+    }
+
+    pub fn apply_lookup_vector_packed_assign(
+        &self,
+        cts: &mut Vec<Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        assert!(
+            cts.len() == luts.len(),
+            "Ciphertext and LUT length should be the same!"
+        );
+
+        #[cfg(not(feature = "emulate_fpga"))]
+        {
+            self.apply_programmable_bootstrap_on_trivial(cts, luts);
+            self.programmable_bootstrap_packed(cts, luts);
+        }
+
+        #[cfg(feature = "emulate_fpga")]
+        {
+            let shortint_key = &self.key.key.key;
+            shortint_key.apply_lookup_vector_packed_assign(cts, luts);
+        }
+    }
+
+    pub fn apply_many_lookup_vector_packed(
+        &self,
+        cts: &[Ciphertext],
+        luts: &[&ManyLookupVector],
+    ) -> Vec<Vec<Ciphertext>> {
+        assert!(
+            cts.len() == luts.len(),
+            "Ciphertext {} and LUT {} length should be the same!",
+            cts.len(),
+            luts.len()
+        );
+
+        #[cfg(not(feature = "emulate_fpga"))]
+        return {
+            let mut output = self.apply_many_lut_programmable_bootstrap_on_trivial(cts, luts);
+            self.programmable_bootstrap_packed_many_lut(cts, &mut output, luts);
+            output
+        };
+
+        #[cfg(feature = "emulate_fpga")]
+        return {
+            let shortint_key = &self.key.key.key;
+            shortint_key.apply_many_lookup_vector_packed(cts, luts)
+        };
+    }
+
+    pub fn apply_same_many_lookup_vector_packed(
+        &self,
+        cts: &[Ciphertext],
+        lut: &ManyLookupVector,
+    ) -> Vec<Vec<Ciphertext>> {
+        let luts = vec![lut; cts.len()];
+
+        self.apply_many_lookup_vector_packed(cts, &luts)
+    }
+
+    pub fn apply_same_lookup_vector_packed_assign(
+        &self,
+        ciphertexts: &mut Vec<Ciphertext>,
+        lut: &LookupVector,
+    ) {
+        let luts = vec![lut; ciphertexts.len()];
+
+        self.apply_lookup_vector_packed_assign(ciphertexts, &luts);
+    }
+
+    pub fn apply_lookup_vector_single_assign(
+        &self,
+        ciphertext: &mut Ciphertext,
+        lut: &LookupVector,
+    ) {
+        let mut cts = vec![ciphertext.clone()];
+
+        self.apply_lookup_vector_packed_assign(&mut cts, &[lut]);
+
+        ciphertext.clone_from(cts.first().unwrap());
+    }
+
+    pub fn apply_same_lookup_vector_mut_packed_assign(
+        &self,
+        ciphertexts: &mut Vec<&mut Ciphertext>,
+        lut: &LookupVector,
+    ) {
+        let luts = vec![lut; ciphertexts.len()];
+
+        self.apply_lookup_vector_mut_packed_assign(ciphertexts, &luts);
+    }
+
+    pub fn apply_lookup_vector_mut_packed_assign(
+        &self,
+        ciphertext: &mut Vec<&mut Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        let mut ct_vec: Vec<Ciphertext> = ciphertext
+            .iter_mut()
+            .map(|block| (*block).clone())
+            .collect();
+
+        #[cfg(feature = "fpga")]
+        self.apply_lookup_vector_packed_assign(&mut ct_vec, luts);
+
+        #[cfg(not(feature = "fpga"))]
+        {
+            let shortint_key = &self.key.key.key;
+            shortint_key.apply_lookup_vector_packed_assign(&mut ct_vec, luts);
+        }
+
+        ciphertext
+            .iter_mut()
+            .enumerate()
+            .for_each(|(i, block)| (*block).clone_from(&ct_vec[i]));
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/luts.rs b/tfhe/src/integer/fpga/server_key/luts.rs
new file mode 100644
index 000000000..53a489b38
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/luts.rs
@@ -0,0 +1,40 @@
+use crate::core_crypto::fpga::lookup_vector::LookupVector;
+use crate::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn lut_identity(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x| x;
+        shortint_key.generate_lookup_vector(&func)
+    }
+
+    pub fn lut_message_extract(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x| x % shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector(&func)
+    }
+
+    pub fn lut_carry_extract(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x| x / shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector(&func)
+    }
+
+    pub fn lut_mul_2lsb(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x, y| (x * y) % shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector_bivariate(&func)
+    }
+
+    pub fn lut_mul_2msb(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x, y| (x * y) / shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector_bivariate(&func)
+    }
+
+    pub fn lut_bitxor(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x, y| x ^ y;
+        shortint_key.generate_lookup_vector_bivariate(&func)
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/mod.rs b/tfhe/src/integer/fpga/server_key/mod.rs
new file mode 100644
index 000000000..e2b7b97f5
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/mod.rs
@@ -0,0 +1,362 @@
+mod comparator;
+mod fpga;
+mod luts;
+pub(crate) mod radix;
+
+use std::sync::Arc;
+
+use rayon::prelude::*;
+
+use crate::core_crypto::commons::numeric::UnsignedInteger;
+use crate::core_crypto::fpga::BelfortFpgaUtils;
+use crate::high_level_api::keys::inner::IntegerServerKey;
+use crate::high_level_api::keys::ServerKey;
+use crate::high_level_api::Tag;
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::server_key::radix_parallel::OutputFlag;
+use crate::integer::IntegerRadixCiphertext;
+use crate::shortint::Ciphertext;
+
+#[derive(Clone)]
+pub struct BelfortServerKey {
+    pub key: Arc<IntegerServerKey>,
+    pub utils: BelfortFpgaUtils,
+    pub tag: Tag,
+}
+
+impl From<&ServerKey> for BelfortServerKey {
+    fn from(value: &ServerKey) -> Self {
+        let ServerKey { key, tag } = value.clone();
+        Self::default(key, tag)
+    }
+}
+
+impl From<&IntegerServerKey> for BelfortServerKey {
+    fn from(value: &IntegerServerKey) -> Self {
+        Self::default(Arc::new(value.clone()), Tag::default())
+    }
+}
+
+impl From<&crate::integer::ServerKey> for BelfortServerKey {
+    fn from(value: &crate::integer::ServerKey) -> Self {
+        let integer_server_key = IntegerServerKey {
+            key: value.clone(),
+            cpk_key_switching_key_material: None,
+            compression_key: None,
+            decompression_key: None,
+            noise_squashing_key: None,
+            noise_squashing_compression_key: None,
+            cpk_re_randomization_key_switching_key_material: None,
+        };
+        Self::default(Arc::new(integer_server_key), Tag::default())
+    }
+}
+
+impl From<Arc<crate::integer::ServerKey>> for BelfortServerKey {
+    fn from(value: Arc<crate::integer::ServerKey>) -> Self {
+        let server_key = Arc::unwrap_or_clone(value);
+        Self::from(&server_key)
+    }
+}
+
+impl BelfortServerKey {
+    pub fn default(key: Arc<IntegerServerKey>, tag: Tag) -> Self {
+        Self {
+            key,
+            tag,
+            utils: BelfortFpgaUtils::default(),
+        }
+    }
+
+    pub fn create_trivial_radix<T, C>(&self, value: T, num_blocks: usize) -> C
+    where
+        T: DecomposableInto<u64>,
+        C: IntegerRadixCiphertext + From<Vec<crate::shortint::Ciphertext>>,
+    {
+        self.key.key.create_trivial_radix(value, num_blocks)
+    }
+
+    pub fn conditional_full_propagate_bivariate<'a, T>(&self, lhs: &'a mut T, rhs: &'a mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.conditional_full_propagate(lhs);
+        self.conditional_full_propagate(rhs);
+    }
+
+    /// Executes a full propagate if there are carries.
+    pub fn conditional_full_propagate<T>(&self, term: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if !term.block_carries_are_empty() {
+            self.full_propagate(term);
+        }
+    }
+
+    pub fn full_propagate<T>(&self, ctxt: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_blocks = ctxt.blocks().len();
+        let start_index = ctxt
+            .blocks()
+            .iter()
+            .position(|block| !block.carry_is_empty())
+            .unwrap_or(num_blocks);
+
+        let (to_be_cleaned, to_be_propagated) = ctxt.blocks_mut().split_at_mut(start_index);
+
+        if !to_be_propagated.is_empty() {
+            self.partial_propagate_blocks(to_be_propagated);
+        }
+
+        if !to_be_cleaned.is_empty() {
+            let mut result = to_be_cleaned.to_vec();
+            self.apply_same_lookup_vector_packed_assign(&mut result, &self.lut_message_extract());
+            to_be_cleaned
+                .par_iter_mut()
+                .zip(result.par_iter())
+                .for_each(|(block, result_block)| block.clone_from(result_block));
+        }
+    }
+
+    /// This function takes an input slice of shortint ciphertext (aka blocks)
+    /// for which at most one bit of carry is consumed in each block, and
+    /// it does the carry propagation in place.
+    ///
+    /// It returns the output carry of the last block
+    ///
+    /// Used in (among other) 'default' addition:
+    /// - first unchecked_add
+    /// - at this point at most on bit of carry is taken
+    /// - use this function to propagate them in parallel
+    pub(crate) fn propagate_single_carry_parallelized_low_latency(
+        &self,
+        blocks: &mut [Ciphertext],
+    ) {
+        self.advanced_add_assign_with_carry_at_least_4_bits(blocks, &[], None, OutputFlag::None);
+    }
+
+    /// Computes a prefix sum/scan in parallel using Naive Parallel Scan
+    pub(crate) fn compute_prefix_sum_hillis_steele<F>(
+        &self,
+        mut blocks: Vec<Ciphertext>,
+        lut_function: &F,
+    ) -> Vec<Ciphertext>
+    where
+        F: Fn(u64, u64) -> u64,
+    {
+        let shortint_key = &self.key.key.key;
+        debug_assert!(shortint_key.message_modulus.0 * shortint_key.carry_modulus.0 >= (1 << 4));
+
+        if blocks.is_empty() {
+            return vec![];
+        }
+
+        let lut_vector_sum = shortint_key.generate_lookup_vector_bivariate(&lut_function);
+
+        let mut space = 1;
+        let mut step_output = blocks.clone();
+
+        let num_blocks = blocks.len();
+        let num_steps = num_blocks.ceil_ilog2() as usize;
+        for _ in 0..num_steps {
+            // Copies carries
+            let mut prev_block_carries = Vec::with_capacity(num_blocks - space);
+            for block in blocks.iter().take(num_blocks - space) {
+                prev_block_carries.push(block.clone());
+            }
+
+            // Shifts block by space
+            let step_output_vec = step_output[space..num_blocks].to_vec();
+            let mut prepared_blocks =
+                self.prepare_block_vecs_bivariate(&step_output_vec, &prev_block_carries);
+
+            self.apply_same_lookup_vector_packed_assign(&mut prepared_blocks, &lut_vector_sum);
+
+            for (i, block) in prepared_blocks.into_iter().enumerate() {
+                step_output[space + i] = block;
+            }
+
+            for i in space..num_blocks {
+                blocks[i].clone_from(&step_output[i]);
+            }
+
+            space *= 2;
+        }
+
+        blocks
+    }
+
+    pub fn propagate_parallelized<T>(&self, ctxt: &mut T, index: usize) -> Ciphertext
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (message_extract_lut, carry_extract_lut) =
+            (self.lut_message_extract(), self.lut_carry_extract());
+        let luts = vec![&carry_extract_lut, &message_extract_lut];
+
+        let block = &ctxt.blocks()[index];
+        let mut result = vec![block.clone(), block.clone()];
+        self.apply_lookup_vector_packed_assign(&mut result, &luts);
+
+        let [carry, message]: [Ciphertext; 2] = result.try_into().expect("Expect two elements!");
+        ctxt.blocks_mut()[index] = message;
+
+        if index < ctxt.blocks().len() - 1 {
+            let shortint_key = &self.key.key.key;
+            shortint_key.unchecked_add_assign(&mut ctxt.blocks_mut()[index + 1], &carry);
+        }
+        carry
+    }
+
+    fn partial_propagate_blocks(&self, blocks: &mut [Ciphertext]) {
+        let shortint_key = &self.key.key.key;
+        let highest_degree = blocks
+            .iter()
+            .map(|block| block.degree.get())
+            .max_by(|degree_a, degree_b| degree_a.cmp(degree_b))
+            .unwrap();
+
+        if highest_degree > (shortint_key.message_modulus.0 - 1) * 2 {
+            let (mut message_blocks, carry_blocks) = self.extract_message_and_carry_blocks(blocks);
+
+            blocks.swap_with_slice(&mut message_blocks);
+            blocks[1..]
+                .par_iter_mut()
+                .zip(carry_blocks.par_iter())
+                .for_each(|(block, carry)| {
+                    shortint_key.unchecked_add_assign(block, carry);
+                })
+        }
+
+        self.propagate_single_carry_parallelized_low_latency(blocks);
+    }
+
+    pub(crate) fn extract_message_and_carry_blocks(
+        &self,
+        blocks: &[Ciphertext],
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let num_blocks = blocks.len();
+        let mut luts = Vec::with_capacity(2 * num_blocks);
+        let (message_extract_lut, carry_extract_lut) =
+            (self.lut_message_extract(), self.lut_carry_extract());
+        luts.extend(std::iter::repeat_n(&message_extract_lut, num_blocks));
+        luts.extend(std::iter::repeat_n(&carry_extract_lut, num_blocks));
+
+        let mut prepared_blocks = Vec::with_capacity(2 * num_blocks);
+        prepared_blocks.extend(blocks.to_owned());
+        prepared_blocks.extend(blocks.to_owned());
+
+        self.apply_lookup_vector_packed_assign(&mut prepared_blocks, &luts);
+
+        let (messages, carries) = prepared_blocks.split_at(num_blocks);
+
+        (messages.to_vec(), carries.to_vec())
+    }
+
+    pub fn prepare_block_vecs_bivariate(
+        &self,
+        lhs_blocks: &[Ciphertext],
+        rhs_blocks: &[Ciphertext],
+    ) -> Vec<Ciphertext> {
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        let mut out = lhs_blocks.to_vec();
+        out.iter_mut().zip(rhs_blocks.iter()).for_each(|(l, r)| {
+            self.key
+                .key
+                .key
+                .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+        });
+        out
+    }
+
+    pub fn prepare_block_vecs_bivariate_assign(
+        &self,
+        lhs_blocks: &mut [Ciphertext],
+        rhs_blocks: &[Ciphertext],
+    ) {
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        lhs_blocks
+            .iter_mut()
+            .zip(rhs_blocks.iter())
+            .for_each(|(l, r)| {
+                self.key
+                    .key
+                    .key
+                    .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+            });
+    }
+
+    pub fn prepare_ciphertexts_bivariate<T>(&self, ct_left: &T, ct_right: &T) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs_blocks, rhs_blocks) = (ct_left.blocks(), ct_right.blocks());
+
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        let mut out = lhs_blocks.to_vec();
+        out.iter_mut().zip(rhs_blocks.iter()).for_each(|(l, r)| {
+            self.key
+                .key
+                .key
+                .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+        });
+        out
+    }
+
+    pub fn prepare_ciphertexts_bivariate_assign<T>(&self, ct_left: &mut T, ct_right: &T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs_blocks, rhs_blocks) = (ct_left.blocks_mut(), ct_right.blocks());
+
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        lhs_blocks
+            .iter_mut()
+            .zip(rhs_blocks.iter())
+            .for_each(|(l, r)| {
+                self.key
+                    .key
+                    .key
+                    .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+            });
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/abs.rs b/tfhe/src/integer/fpga/server_key/radix/abs.rs
new file mode 100644
index 000000000..224f0af45
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/abs.rs
@@ -0,0 +1,32 @@
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn unchecked_abs<T>(&self, ct: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_abs_parallelized(ct)
+    }
+
+    pub fn smart_abs<T>(&self, ct: &mut T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.conditional_full_propagate(ct);
+        self.unchecked_abs(ct)
+    }
+
+    pub fn abs<T>(&self, ct: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if ct.block_carries_are_empty() {
+            self.unchecked_abs(ct)
+        } else {
+            let mut cloned = ct.clone();
+            self.full_propagate(&mut cloned);
+            self.unchecked_abs(&cloned)
+        }
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/add.rs b/tfhe/src/integer/fpga/server_key/radix/add.rs
new file mode 100644
index 000000000..8852bdc66
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/add.rs
@@ -0,0 +1,1158 @@
+use crate::core_crypto::commons::numeric::UnsignedInteger;
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::integer::server_key::radix_parallel::add::overflow_flag_preparation_lut;
+use crate::integer::server_key::radix_parallel::OutputFlag;
+use crate::integer::server_key::CheckError;
+use crate::integer::{BooleanBlock, RadixCiphertext, SignedRadixCiphertext};
+use crate::shortint::ciphertext::Degree;
+use crate::shortint::Ciphertext;
+use rayon::prelude::*;
+
+impl BelfortServerKey {
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertexts block carries are empty and clears them if it's not the
+    /// case and the operation requires it. It outputs a ciphertext whose block carries are always
+    /// empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 14;
+    /// let msg2 = 97;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(dec_result, msg1 + msg2);
+    /// ```
+    pub fn add<T>(&self, ct1: &T, ct2: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut ct_res = ct1.clone();
+        self.add_assign(&mut ct_res, ct2);
+        ct_res
+    }
+
+    /// Compute homomorphically an addition between two ciphertexts
+    ///
+    /// The result is stored in the `ct1` ciphertext.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertext carries are empty and clears them if it's not the case and
+    /// the operation requires it. It outputs a ciphertext whose carry is always empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 15u64;
+    /// let msg2 = 3u64;
+    ///
+    /// // Encrypt two messages:
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.add_assign(&mut ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec = cks.decrypt(&ct1);
+    /// assert_eq!(dec, msg1 + msg2);
+    /// ```
+    pub fn add_assign<T>(&self, ct1: &mut T, ct2: &T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut tmp_rhs;
+
+        let (lhs, rhs) = match (ct1.block_carries_are_empty(), ct2.block_carries_are_empty()) {
+            (true, true) => (ct1, ct2),
+            (true, false) => {
+                tmp_rhs = ct2.clone();
+                self.full_propagate(&mut tmp_rhs);
+                (ct1, &tmp_rhs)
+            }
+            (false, true) => {
+                self.full_propagate(ct1);
+                (ct1, ct2)
+            }
+            (false, false) => {
+                tmp_rhs = ct2.clone();
+                self.full_propagate(ct1);
+                self.full_propagate(&mut tmp_rhs);
+                (ct1, &tmp_rhs)
+            }
+        };
+
+        self.add_assign_with_carry(lhs, rhs, None);
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function computes the operation without checking if it exceeds the capacity of the
+    /// ciphertext.
+    ///
+    /// The result is returned as a new ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 10;
+    /// let msg2 = 127;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.unchecked_add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(dec_result, msg1 + msg2);
+    /// ```
+    pub fn unchecked_add<T>(&self, ct1: &T, ct2: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_add_parallelized(ct1, ct2)
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function computes the operation without checking if it exceeds the capacity of the
+    /// ciphertext.
+    ///
+    /// The result is assigned to the `ct1` ciphertext.
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 28;
+    /// let msg2 = 127;
+    ///
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.unchecked_add_assign(&mut ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_ct1: u64 = cks.decrypt(&ct1);
+    /// assert_eq!(dec_ct1, msg1 + msg2);
+    /// ```
+    pub fn unchecked_add_assign<T>(&self, ct1: &mut T, ct2: &T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_add_assign_parallelized(ct1, ct2);
+    }
+
+    /// Verifies if ct1 and ct2 can be added together.
+    ///
+    /// # Example
+    ///
+    ///```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 46u64;
+    /// let msg2 = 87u64;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Check if we can perform an addition
+    /// fpga_key.is_add_possible(&ct1, &ct2).unwrap();
+    /// ```
+    pub fn is_add_possible<T>(&self, ct1: &T, ct2: &T) -> Result<(), CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.is_add_possible(ct1, ct2)
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// If the operation can be performed, the result is returned in a new ciphertext.
+    /// Otherwise a [CheckError] is returned.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 41;
+    /// let msg2 = 101;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.checked_add(&ct1, &ct2);
+    ///
+    /// match ct_res {
+    ///     Err(x) => panic!("{x:?}"),
+    ///     Ok(y) => {
+    ///         let clear: u64 = cks.decrypt(&y);
+    ///         assert_eq!(msg1 + msg2, clear);
+    ///     }
+    /// }
+    /// ```
+    pub fn checked_add<T>(&self, ct1: &T, ct2: &T) -> Result<T, CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.is_add_possible(ct1, ct2)?;
+        Ok(self.unchecked_add(ct1, ct2))
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// If the operation can be performed, the result is stored in the `ct1` ciphertext.
+    /// Otherwise a [CheckError] is returned, and `ct1` is not modified.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 41;
+    /// let msg2 = 101;
+    ///
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.checked_add_assign(&mut ct1, &ct2).unwrap();
+    ///
+    /// let clear: u64 = cks.decrypt(&ct1);
+    /// assert_eq!(msg1 + msg2, clear);
+    /// ```
+    pub fn checked_add_assign<T>(&self, ct1: &mut T, ct2: &T) -> Result<(), CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.is_add_possible(ct1, ct2)?;
+        self.unchecked_add_assign(ct1, ct2);
+        Ok(())
+    }
+
+    pub fn smart_add<T>(&self, ct1: &mut T, ct2: &mut T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if self.is_add_possible(ct1, ct2).is_err() {
+            self.full_propagate(ct1);
+            self.full_propagate(ct2);
+        }
+
+        self.is_add_possible(ct1, ct2).unwrap();
+        self.unchecked_add(ct1, ct2)
+    }
+
+    pub fn smart_add_assign<T>(&self, ct1: &mut T, ct2: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if self.is_add_possible(ct1, ct2).is_err() {
+            self.full_propagate(ct1);
+            self.full_propagate(ct2);
+        }
+        self.is_add_possible(ct1, ct2).unwrap();
+        self.unchecked_add_assign(ct1, ct2);
+    }
+
+    /// Computes the addition of two ciphertexts and returns the overflow flag
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = u8::MAX;
+    /// let msg2 = 1;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// let (ct_res, overflowed) = fpga_key.overflowing_add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u8 = cks.decrypt(&ct_res);
+    /// let dec_overflowed = cks.decrypt_bool(&overflowed);
+    /// let (expected_result, expected_overflow) = msg1.overflowing_add(msg2);
+    /// assert_eq!(dec_result, expected_result);
+    /// assert_eq!(dec_overflowed, expected_overflow);
+    /// ```
+    pub fn overflowing_add<T>(&self, ct1: &T, ct2: &T) -> (T, BooleanBlock)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut ct_res = ct1.clone();
+        let overflowed = self.overflowing_add_assign(&mut ct_res, ct2);
+        (ct_res, overflowed)
+    }
+
+    pub fn overflowing_add_assign<T>(&self, ct1: &mut T, ct2: &T) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut tmp_rhs: T;
+        if ct1.blocks().is_empty() || ct2.blocks().is_empty() {
+            return self.key.key.create_trivial_boolean_block(false);
+        }
+
+        let (lhs, rhs) = match (ct1.block_carries_are_empty(), ct2.block_carries_are_empty()) {
+            (true, true) => (ct1, ct2),
+            (true, false) => {
+                tmp_rhs = ct2.clone();
+                self.full_propagate(&mut tmp_rhs);
+                (ct1, &tmp_rhs)
+            }
+            (false, true) => {
+                self.full_propagate(ct1);
+                (ct1, ct2)
+            }
+            (false, false) => {
+                tmp_rhs = ct2.clone();
+                self.full_propagate(ct1);
+                self.full_propagate(&mut tmp_rhs);
+                (ct1, &tmp_rhs)
+            }
+        };
+
+        self.overflowing_add_assign_with_carry(lhs, rhs, None)
+    }
+
+    /// Computes the addition of two unsigned ciphertexts and returns the overflow flag
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = u8::MAX;
+    /// let msg2 = 1;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// let (ct_res, overflowed) = fpga_key.unsigned_overflowing_add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u8 = cks.decrypt(&ct_res);
+    /// let dec_overflowed = cks.decrypt_bool(&overflowed);
+    /// let (expected_result, expected_overflow) = msg1.overflowing_add(msg2);
+    /// assert_eq!(dec_result, expected_result);
+    /// assert_eq!(dec_overflowed, expected_overflow);
+    /// ```
+    pub fn unsigned_overflowing_add(
+        &self,
+        ct1: &RadixCiphertext,
+        ct2: &RadixCiphertext,
+    ) -> (RadixCiphertext, BooleanBlock) {
+        self.overflowing_add(ct1, ct2)
+    }
+
+    pub fn unsigned_overflowing_add_assign(
+        &self,
+        ct1: &mut RadixCiphertext,
+        ct2: &RadixCiphertext,
+    ) -> BooleanBlock {
+        self.overflowing_add_assign(ct1, ct2)
+    }
+
+    pub fn signed_overflowing_add(
+        &self,
+        ct1: &SignedRadixCiphertext,
+        ct2: &SignedRadixCiphertext,
+    ) -> (SignedRadixCiphertext, BooleanBlock) {
+        self.overflowing_add(ct1, ct2)
+    }
+
+    pub fn unchecked_signed_overflowing_add(
+        &self,
+        ct1: &SignedRadixCiphertext,
+        ct2: &SignedRadixCiphertext,
+    ) -> (SignedRadixCiphertext, BooleanBlock) {
+        assert_eq!(
+            ct1.blocks.len(),
+            ct2.blocks.len(),
+            "lhs and rhs must have the same number of blocks ({} vs {})",
+            ct1.blocks.len(),
+            ct2.blocks.len()
+        );
+        assert!(!ct1.blocks.is_empty(), "inputs cannot be empty");
+
+        let mut result = ct1.clone();
+        let overflowed = self.overflowing_add_assign_with_carry(&mut result, ct2, None);
+        (result, overflowed)
+    }
+
+    pub fn add_assign_with_carry<T>(&self, lhs: &mut T, rhs: &T, input_carry: Option<&BooleanBlock>)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.conditional_full_propagate(lhs);
+
+        let mut cloned_rhs: T;
+        let rhs = if rhs.block_carries_are_empty() {
+            rhs
+        } else {
+            cloned_rhs = rhs.clone();
+            self.full_propagate(&mut cloned_rhs);
+            &cloned_rhs
+        };
+
+        self.advanced_add_assign_with_carry_at_least_4_bits(
+            lhs.blocks_mut(),
+            rhs.blocks(),
+            input_carry,
+            OutputFlag::None,
+        );
+    }
+
+    /// Does lhs += (rhs + carry)
+    ///
+    /// Returns a boolean block that encrypts `true` if overflow happened
+    pub fn overflowing_add_assign_with_carry<T>(
+        &self,
+        lhs: &mut T,
+        rhs: &T,
+        input_carry: Option<&BooleanBlock>,
+    ) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.advanced_add_assign_with_carry_at_least_4_bits(
+            lhs.blocks_mut(),
+            rhs.blocks(),
+            input_carry,
+            OutputFlag::from_signedness(T::IS_SIGNED),
+        )
+        .expect("internal error, overflow computation was not returned as was requested")
+    }
+
+    /// Does lhs += (rhs + carry)
+    ///
+    /// acts like the ADC assembly op, except, the flags have to be explicitly requested
+    /// as they incur additional PBSes
+    ///
+    /// - Parameters must have at least 2 bits of message, 2 bits of carry
+    /// - blocks of lhs and rhs must be clean (no carries)
+    /// - lhs and rhs must have the same length
+    pub(crate) fn advanced_add_assign_with_carry_at_least_4_bits(
+        &self,
+        lhs: &mut [Ciphertext],
+        rhs: &[Ciphertext],
+        input_carry: Option<&BooleanBlock>,
+        requested_flag: OutputFlag,
+    ) -> Option<BooleanBlock> {
+        // Empty rhs is a special case for the 'propagate single carry' function.
+        if rhs.is_empty() {
+            // Technically, CarryFlag is computable, but OverflowFlag is not
+            assert_eq!(
+                requested_flag,
+                OutputFlag::None,
+                "Cannot compute flags when called in propagation mode"
+            );
+        } else {
+            assert_eq!(
+                lhs.len(),
+                rhs.len(),
+                "Both operands must have the same number of blocks"
+            );
+        }
+        let int_key = &self.key.key;
+        let shortint_key = &int_key.key;
+
+        if lhs.is_empty() {
+            // Then both are empty
+            if requested_flag == OutputFlag::None {
+                return None;
+            }
+            return Some(int_key.create_trivial_boolean_block(false));
+        }
+
+        let message_modulus = int_key.message_modulus().0;
+        let num_bits_in_message = message_modulus.ilog2() as u64;
+
+        let block_modulus = message_modulus * int_key.carry_modulus().0;
+        let num_bits_in_block = block_modulus.ilog2();
+        assert!(
+            num_bits_in_block == 4,
+            "Having 4-bit ciphertext is a hard requirement!"
+        );
+
+        let saved_last_blocks = if requested_flag == OutputFlag::Overflow {
+            Some((lhs.last().cloned().unwrap(), rhs.last().cloned().unwrap()))
+        } else {
+            None
+        };
+
+        // Perform the block additions
+        lhs.par_iter_mut()
+            .zip(rhs.par_iter())
+            .for_each(|(lhs_b, rhs_b)| {
+                shortint_key.unchecked_add_assign(lhs_b, rhs_b);
+            });
+
+        if let Some(carry) = input_carry {
+            shortint_key.unchecked_add_assign(&mut lhs[0], &carry.0);
+        }
+
+        let blocks = lhs;
+        let num_blocks = blocks.len();
+
+        // Just in case we compare with max noise level, but it should always be num_bits_in_blocks
+        // with the parameters we provide
+        let group_size =
+            (num_bits_in_block as usize).min(shortint_key.max_noise_level.get() as usize);
+
+        // First step: Groups and block states
+        let (shifted_blocks, mut block_states) =
+            self.compute_shifted_blocks_and_block_states(blocks);
+
+        let last_lhs_block = block_states.pop().unwrap();
+        let mut output_flag = match requested_flag {
+            OutputFlag::None => None,
+            OutputFlag::Overflow => {
+                // When used on the last block of `lhs` and `rhs`, this will create a
+                // block that encodes the 2 values to know if overflow did
+                // happen depending on the input carry of the last block.
+                let lut = shortint_key.generate_lookup_vector_bivariate(&|lhs, rhs| {
+                    overflow_flag_preparation_lut(lhs, rhs, num_bits_in_message)
+                });
+                let (mut last_lhs_block, last_rhs_block) = saved_last_blocks.unwrap();
+                shortint_key.unchecked_apply_lookup_table_bivariate_assign_prep(
+                    &mut last_lhs_block,
+                    &last_rhs_block,
+                );
+                self.apply_lookup_vector_single_assign(&mut last_lhs_block, &lut);
+                Some(last_lhs_block)
+            }
+            OutputFlag::Carry => Some(last_lhs_block),
+        };
+
+        // Second step: Calculate group carries and propagation states
+        let (propagation_simulators, resolved_carries) =
+            self.compute_propagation_simulators_and_groups_carries(group_size, &block_states);
+
+        let mut prepared_blocks = shifted_blocks;
+        prepared_blocks
+            .par_iter_mut()
+            .zip(propagation_simulators.par_iter())
+            .for_each(|(block, simulator)| {
+                shortint_key.unchecked_add_assign(block, simulator);
+            });
+
+        match requested_flag {
+            OutputFlag::None => {}
+            OutputFlag::Overflow | OutputFlag::Carry => {
+                let block = output_flag.as_mut().unwrap();
+                shortint_key.unchecked_add_assign(block, &propagation_simulators[num_blocks - 1]);
+            }
+        }
+
+        // Final step: adding resolved carries and cleaning result
+        prepared_blocks
+            .iter_mut()
+            .enumerate()
+            .for_each(|(i, block)| {
+                let group_index = i / group_size;
+                let carry = &resolved_carries[group_index];
+                shortint_key.unchecked_add_assign(block, carry);
+            });
+
+        let message_extract_lut =
+            shortint_key.generate_lookup_vector(&|block| (block >> 1) % message_modulus);
+        let carry_flag_lut = shortint_key.generate_lookup_vector(&|block| (block >> 2) & 1);
+        let mut luts = vec![&message_extract_lut; num_blocks];
+
+        let overflow_flag_lut = shortint_key.generate_lookup_vector(&|block| {
+            let input_carry = (block >> 1) & 1;
+            let does_overflow_if_carry_is_1 = (block >> 3) & 1;
+            let does_overflow_if_carry_is_0 = (block >> 2) & 1;
+            if input_carry == 1 {
+                does_overflow_if_carry_is_1
+            } else {
+                does_overflow_if_carry_is_0
+            }
+        });
+
+        match requested_flag {
+            OutputFlag::None => {}
+            OutputFlag::Overflow => {
+                let mut block = output_flag.unwrap();
+                // When num block is 1, we have to use the input carry
+                // given by the caller
+                let carry_into_last_block = input_carry
+                    .as_ref()
+                    .filter(|_| num_blocks == 1)
+                    .map_or_else(
+                        || &resolved_carries[resolved_carries.len() - 1],
+                        |input_carry| &input_carry.0,
+                    );
+                shortint_key.unchecked_add_assign(&mut block, carry_into_last_block);
+
+                prepared_blocks.push(block);
+                luts.push(&overflow_flag_lut);
+            }
+            OutputFlag::Carry => {
+                let mut block = output_flag.unwrap();
+                shortint_key.unchecked_add_assign(
+                    &mut block,
+                    &resolved_carries[resolved_carries.len() - 1],
+                );
+                prepared_blocks.push(block);
+                luts.push(&carry_flag_lut);
+            }
+        }
+
+        self.apply_lookup_vector_packed_assign(&mut prepared_blocks, &luts);
+
+        blocks.clone_from_slice(&prepared_blocks[..num_blocks]);
+
+        match requested_flag {
+            OutputFlag::None => None,
+            OutputFlag::Overflow | OutputFlag::Carry => {
+                let output_flag = &prepared_blocks[num_blocks];
+                Some(BooleanBlock::new_unchecked(output_flag.clone()))
+            }
+        }
+    }
+
+    pub fn compute_shifted_blocks_and_block_states(
+        &self,
+        blocks: &[Ciphertext],
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let num_blocks = blocks.len();
+        let int_key = &self.key.key;
+        let shortint_key = &int_key.key;
+        let message_modulus = int_key.message_modulus().0;
+
+        let block_modulus = message_modulus * int_key.carry_modulus().0;
+        let num_bits_in_block = block_modulus.ilog2();
+
+        let group_size = num_bits_in_block as usize;
+
+        let shift_block_lut_fn: &dyn Fn(u64) -> u64 = &|block| (block % message_modulus) << 1;
+
+        let mut first_group_luts = vec![{
+            let first_block_state_fn = |block| {
+                if block >= message_modulus {
+                    1 // Generates
+                } else {
+                    0 // Nothing
+                }
+            };
+            shortint_key.generate_many_lookup_vector(&[&first_block_state_fn, shift_block_lut_fn])
+        }];
+
+        for index in 1..group_size {
+            let state_fn = |block| {
+                let r = if block >= message_modulus {
+                    2 // Generates Carry
+                } else if block == message_modulus - 1 {
+                    1 // Propagates a carry
+                } else {
+                    0 // Absorbs a potential carry
+                };
+
+                r << (index - 1)
+            };
+            first_group_luts
+                .push(shortint_key.generate_many_lookup_vector(&[&state_fn, shift_block_lut_fn]))
+        }
+
+        let other_block_state_luts = (0..group_size)
+            .map(|index| {
+                let state_fn = |block| {
+                    let r = if block >= message_modulus {
+                        2 // Generates Carry
+                    } else if block == message_modulus - 1 {
+                        1 // Propagates a carry
+                    } else {
+                        0 // Absorbs a potential carry
+                    };
+
+                    r << index
+                };
+                shortint_key.generate_many_lookup_vector(&[&state_fn, shift_block_lut_fn])
+            })
+            .collect::<Vec<_>>();
+
+        // For the last block the state we compute will be used (if needed)
+        // to compute the output carry of the whole addition.
+        // This computation will be done during the 'cleaning' phase
+        let last_block_luts = {
+            if blocks.len() == 1 {
+                let first_block_state_fn = |block| {
+                    if block >= message_modulus {
+                        2 << 1 // Generates
+                    } else {
+                        0 // Nothing
+                    }
+                };
+                shortint_key
+                    .generate_many_lookup_vector(&[&first_block_state_fn, shift_block_lut_fn])
+            } else {
+                first_group_luts[2].clone()
+            }
+        };
+
+        let luts = (0..num_blocks)
+            .into_par_iter()
+            .map(|index| {
+                let group_index = index / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = index % (group_size);
+                let is_last_index = index == blocks.len() - 1;
+
+                if is_last_index {
+                    &last_block_luts
+                } else if is_in_first_group {
+                    &first_group_luts[index_in_group]
+                } else {
+                    &other_block_state_luts[index_in_group]
+                }
+            })
+            .collect::<Vec<_>>();
+
+        let tmp = self.apply_many_lookup_vector_packed(blocks, &luts);
+
+        let mut shifted_blocks = Vec::with_capacity(num_blocks);
+        let mut block_states = Vec::with_capacity(num_blocks);
+        for mut blocks in tmp {
+            assert_eq!(blocks.len(), 2);
+            shifted_blocks.push(blocks.pop().unwrap());
+            block_states.push(blocks.pop().unwrap());
+        }
+        (shifted_blocks, block_states)
+    }
+
+    pub(crate) fn compute_propagation_simulators_and_groups_carries(
+        &self,
+        group_size: usize,
+        block_states: &[Ciphertext],
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let shortint_key = &self.key.key.key;
+        if block_states.is_empty() {
+            return (
+                vec![shortint_key.create_trivial(1)],
+                vec![shortint_key.create_trivial(0)],
+            );
+        }
+        let message_modulus = shortint_key.message_modulus.0;
+        let block_modulus = message_modulus * shortint_key.carry_modulus.0;
+        let num_bits_in_block = block_modulus.ilog2();
+        let num_blocks = block_states.len();
+
+        // The LUTs that tell if a carry is generated or not
+        // for a cum sum block in the first group (excluding first block)
+        let first_group_propagation_state_luts = (0..group_size)
+            .map(|index| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    let carry = (propa_cum_sum_block >> index) & 1;
+                    if carry == 0 {
+                        0 // Nothing
+                    } else {
+                        2 // Generate
+                    }
+                })
+            })
+            .collect::<Vec<_>>();
+
+        // The LUT that outputs the propagation result of the first group
+        let first_group_carry_lut = shortint_key.generate_lookup_vector(&|block| {
+            // Check if the last bit of the block is set
+            (block >> (num_bits_in_block - 1)) & 1
+        });
+
+        // The LUTs that tell if a carry is generated, propagated or none
+        // based on the block states (excluding the first group)
+        let other_groups_inner_propagation_luts = (0..group_size)
+            .map(|index| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    let mask = (2 << index) - 1;
+                    match propa_cum_sum_block.cmp(&mask) {
+                        std::cmp::Ordering::Less => 0,    // Nothing
+                        std::cmp::Ordering::Equal => 1,   // Propagate
+                        std::cmp::Ordering::Greater => 2, // Generate
+                    }
+                })
+            })
+            .collect::<Vec<_>>();
+
+        let num_groups = num_blocks.div_ceil(group_size);
+        let num_carry_to_resolve = num_groups - 1;
+
+        let sequential_depth = num_carry_to_resolve.saturating_sub(1) / (group_size - 1);
+
+        let hillis_steel_depth = if num_carry_to_resolve == 0 {
+            0
+        } else {
+            num_carry_to_resolve.ceil_ilog2() as usize
+        };
+
+        let use_sequential_algorithm_to_resolve_group_carries =
+            sequential_depth <= hillis_steel_depth;
+
+        // The LUTs that output the propagation result of the other groups
+        let other_group_carry_luts = if use_sequential_algorithm_to_resolve_group_carries {
+            // When using the sequential algorithm for the propagation of one group to the
+            // other we need to shift the PGN state to the correct position, so we later, when
+            // using them only lwe_add is needed and so noise management is easy
+            //
+            // Also, these LUTs are 'negacylic', they are made to exploit the padding bit
+            // resulting blocks from these LUTs must be added the constant `1 << index`.
+            (0..group_size)
+                .map(|index| {
+                    shortint_key.generate_lookup_vector(&|block| {
+                        // All bits set to 1 (e.g. 0b1111), means propagate
+                        if block == (block_modulus - 1) {
+                            0
+                        } else {
+                            // u64::MAX is -1 in two's complement
+                            u64::MAX << index
+                        }
+                    })
+                })
+                .collect::<Vec<_>>()
+        } else {
+            // This LUT is for when we are using Hillis-Steele prefix-scan to propagate carries
+            // between groups. When using this propagation, the encoding of the states
+            // are a bit different.
+            //
+            // Also, these LUTs are 'negacylic', they are made to exploit the padding bit
+            // resulting blocks from these LUTs must be added the constant `1`.
+            vec![shortint_key.generate_lookup_vector(&|block| {
+                if block == (block_modulus - 1) {
+                    // All bits set to 1 (e.g. 0b1111), means propagate
+                    2
+                } else {
+                    // u64::MAX is -1 in two's complement
+                    u64::MAX
+                }
+            })]
+        };
+
+        // First blocks don't require a PBS:
+        // first block in first group is already resolved,
+        // first block in other groups equals the identity function.
+        let mut propagation_cum_sums = Vec::with_capacity(num_blocks);
+        block_states.chunks(group_size).for_each(|group| {
+            // This simplifies bookkeeping. We'll fill it in later.
+            // TODO: Create a mechanism to skip empty ciphertexts, since trivial PBS also costs
+            propagation_cum_sums.push(shortint_key.create_trivial(0));
+            let mut previous_cum_sum = &group[0];
+
+            for other in &group[1..] {
+                let mut result = other.clone();
+                shortint_key.unchecked_add_assign(&mut result, previous_cum_sum);
+                propagation_cum_sums.push(result);
+                previous_cum_sum = propagation_cum_sums.last().unwrap();
+            }
+        });
+
+        // Compute the cum sum arrays,
+        // each group is independent of other groups,
+        // but we store everything flattened (Vec<_>) instead of nested (Vec<Vec<_>>)
+        let propagation_cum_sum_luts = (0..num_blocks)
+            .map(|i| {
+                let group_index = i / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = i % group_size;
+
+                if is_in_first_group {
+                    if index_in_group == group_size - 1 {
+                        &first_group_carry_lut
+                    } else {
+                        &first_group_propagation_state_luts[index_in_group]
+                    }
+                } else if index_in_group == group_size - 1 {
+                    if use_sequential_algorithm_to_resolve_group_carries {
+                        &other_group_carry_luts[(group_index - 1) % (group_size - 1)]
+                    } else {
+                        &other_group_carry_luts[0]
+                    }
+                } else {
+                    &other_groups_inner_propagation_luts[index_in_group]
+                }
+            })
+            .collect::<Vec<_>>();
+
+        self.apply_lookup_vector_packed_assign(
+            &mut propagation_cum_sums,
+            &propagation_cum_sum_luts,
+        );
+
+        // Fill in correct value
+        block_states
+            .chunks(group_size)
+            .enumerate()
+            .for_each(|(group_index, group)| {
+                if group_index == 0 {
+                    // Saves one PBS, since first element becomes 2 if the original value is 1
+                    // and 0 otherwise
+                    propagation_cum_sums[0] = shortint_key.unchecked_scalar_mul(&group[0], 2);
+                } else {
+                    propagation_cum_sums[group_size * group_index].clone_from(&group[0]);
+                }
+            });
+
+        propagation_cum_sums
+            .par_iter_mut()
+            .enumerate()
+            .for_each(|(i, block)| {
+                let group_index = i / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = i % group_size;
+
+                let may_have_its_padding_bit_set =
+                    !is_in_first_group && index_in_group == group_size - 1;
+                if may_have_its_padding_bit_set {
+                    if use_sequential_algorithm_to_resolve_group_carries {
+                        shortint_key.unchecked_scalar_add_assign(
+                            block,
+                            1 << ((group_index - 1) % (group_size - 1)),
+                        );
+                    } else {
+                        shortint_key.unchecked_scalar_add_assign(block, 1);
+                    }
+                    block.degree = Degree::new(message_modulus - 1);
+                }
+            });
+        let mut group_carries = Vec::with_capacity(num_groups);
+        let mut propagation_simulators = Vec::with_capacity(num_blocks);
+
+        // First block does not get a carry from
+        propagation_simulators.push(shortint_key.create_trivial(1));
+        for block in propagation_cum_sums.drain(..) {
+            if propagation_simulators.len() % group_size == 0 {
+                group_carries.push(block);
+
+                // The first block in each group has its simulator set to 1
+                // because it always receives an input borrow generated from a previous group
+                propagation_simulators.push(shortint_key.create_trivial(1));
+            } else {
+                propagation_simulators.push(block);
+            }
+        }
+
+        // Third step: resolve carry propagation between the groups
+        let resolved_carries = if group_carries.is_empty() {
+            vec![shortint_key.create_trivial(0)]
+        } else if use_sequential_algorithm_to_resolve_group_carries {
+            self.resolve_carries_of_groups_sequentially(group_carries, group_size)
+        } else {
+            self.resolve_carries_of_groups_using_hillis_steele(group_carries)
+        };
+        (propagation_simulators, resolved_carries)
+    }
+
+    /// This resolves the carries using a Hillis-Steele algorithm
+    ///
+    /// Blocks must have a value in
+    /// - 2 or 1 for generate
+    /// - 3 for propagate
+    /// - 0 for no carry
+    ///
+    /// The returned Vec of blocks encrypting 1 if a carry is generated, 0 if not
+    pub(crate) fn resolve_carries_of_groups_using_hillis_steele(
+        &self,
+        group_pgns: Vec<Ciphertext>,
+    ) -> Vec<Ciphertext> {
+        let shortint_key = &self.key.key.key;
+        let lut_carry_propagation_sum = |msb: u64, lsb: u64| -> u64 {
+            if msb == 2 {
+                1 // Remap Generate to 1
+            } else if msb == 3 {
+                // MSB propagates
+                if lsb == 2 {
+                    1
+                } else {
+                    lsb
+                } // also remap here
+            } else {
+                msb
+            }
+        };
+        let mut resolved_carries =
+            self.compute_prefix_sum_hillis_steele(group_pgns, &lut_carry_propagation_sum);
+        resolved_carries.insert(0, shortint_key.create_trivial(0));
+        resolved_carries
+    }
+
+    /// This resolves the carries using a sequential algorithm
+    /// where each iteration resolves group_size - 1 "PGN"
+    ///
+    /// Blocks must have a value in
+    /// - 2 for generate
+    /// - 1 for propagate
+    /// - 0 for no carry
+    ///
+    /// This value must be shifted by the position in the block's group.
+    ///
+    /// The block of the first group (so group_pgns[0]) must have a value in
+    /// - 1 for generate
+    /// - 0 for no carry
+    ///
+    /// The returned Vec of blocks encrypting 1 if a carry is generated, 0 if not
+    pub(crate) fn resolve_carries_of_groups_sequentially(
+        &self,
+        mut group_carries: Vec<Ciphertext>,
+        group_size: usize,
+    ) -> Vec<Ciphertext> {
+        let shortint_key = &self.key.key.key;
+        let luts = (0..group_size - 1)
+            .map(|index| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    (propa_cum_sum_block >> (index + 1)) & 1
+                })
+            })
+            .collect::<Vec<_>>();
+        let luts = luts.iter().collect::<Vec<_>>();
+
+        group_carries.rotate_left(1);
+        let mut resolved_carries =
+            vec![shortint_key.create_trivial(0), group_carries.pop().unwrap()];
+
+        for chunk in group_carries.chunks_mut(group_size - 1) {
+            let mut cum_sums = chunk.to_vec();
+            shortint_key.unchecked_add_assign(&mut cum_sums[0], resolved_carries.last().unwrap());
+
+            if chunk.len() > 1 {
+                let mut accumulator = cum_sums[0].clone();
+                for block in cum_sums[1..].iter_mut() {
+                    shortint_key.unchecked_add_assign(&mut accumulator, block);
+                    block.clone_from(&accumulator);
+                }
+            }
+            let initial_luts = &luts[..chunk.len()];
+            self.apply_lookup_vector_packed_assign(&mut cum_sums, initial_luts);
+
+            // Cum sums now contains the output carries
+            resolved_carries.append(&mut cum_sums);
+        }
+
+        resolved_carries
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/bit_extractor.rs b/tfhe/src/integer/fpga/server_key/radix/bit_extractor.rs
new file mode 100644
index 000000000..b77fe09fa
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/bit_extractor.rs
@@ -0,0 +1,110 @@
+use crate::core_crypto::fpga::lookup_vector::LookupVector;
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::shortint::Ciphertext;
+use itertools::iproduct;
+
+pub(crate) struct BitExtractor<'a> {
+    bit_extract_luts: Vec<LookupVector>,
+    bits_per_block: usize,
+    server_key: &'a BelfortServerKey,
+}
+
+impl<'a> BitExtractor<'a> {
+    pub(crate) fn msg_with_final_offset0(
+        server_key: &'a BelfortServerKey,
+        bits_per_block: usize,
+    ) -> Self {
+        let shortint_key = &server_key.key.key.key;
+
+        let mut bit_extract_luts: Vec<LookupVector> = Vec::new();
+
+        bit_extract_luts.push({
+            // Scalar Bitand 1
+            {
+                let func = |x| x & 1;
+                shortint_key.generate_lookup_vector(&func)
+            }
+        });
+        if bits_per_block == 2 {
+            bit_extract_luts.push({
+                // Message bit 1 extraction
+                {
+                    let func = |x| (x >> 1) & 1_u64;
+                    shortint_key.generate_lookup_vector(&func)
+                }
+            });
+        }
+
+        Self {
+            bit_extract_luts,
+            bits_per_block,
+            server_key,
+        }
+    }
+
+    /// Creates a bit extractor that will extract bits from an input ciphertext
+    /// into single blocks.
+    ///
+    /// The offset which is 2 gives the position where the extracted bit shall be placed
+    /// in the resulting block.
+    /// It may be used to align the bit with a certain position to avoid
+    /// shifting it later (and increasing noise)
+    pub(crate) fn msg_with_final_offset2(
+        server_key: &'a BelfortServerKey,
+        bits_per_block: usize,
+    ) -> Self {
+        let shortint_key = &server_key.key.key.key;
+
+        let mut bit_extract_luts: Vec<LookupVector> = Vec::new();
+
+        bit_extract_luts.push({
+            // Message bit 0 extraction with offset two
+            {
+                let func = |x| (x & 1) << 2;
+                shortint_key.generate_lookup_vector(&func)
+            }
+        });
+        if bits_per_block == 2 {
+            bit_extract_luts.push({
+                // Message bit 1 extraction with offset two
+                {
+                    let func = |x| ((x >> 1) & 1_u64) << 2;
+                    shortint_key.generate_lookup_vector(&func)
+                }
+            });
+        }
+
+        Self {
+            bit_extract_luts,
+            bits_per_block,
+            server_key,
+        }
+    }
+
+    pub(crate) fn extract_all_bits(&self, blocks: &[Ciphertext]) -> Vec<Ciphertext> {
+        let num_blocks: usize = blocks.len();
+        self.extract_n_bits(blocks, num_blocks * self.bits_per_block)
+    }
+
+    pub(crate) fn extract_n_bits(&self, blocks: &[Ciphertext], n: usize) -> Vec<Ciphertext> {
+        let num_blocks = blocks.len();
+        let (blocks_idxs, lut_idxs): (Vec<usize>, Vec<usize>) =
+            iproduct!(0..num_blocks, 0..self.bits_per_block)
+                .take(n)
+                .unzip();
+        let mut blocks = blocks_idxs
+            .iter()
+            .map(|block_idx| blocks[*block_idx].clone())
+            .collect::<Vec<_>>();
+
+        let luts = lut_idxs
+            .into_iter()
+            .map(|lut_idx| &self.bit_extract_luts[lut_idx])
+            .collect::<Vec<_>>();
+
+        self.server_key
+            .apply_lookup_vector_packed_assign(&mut blocks, &luts);
+
+        blocks
+    }
+}
