@@ -0,0 +1,64 @@
+#[cfg(test)]
+pub(crate) mod tests;
+
+use crate::array::traits::TensorSlice;
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::fpga::BelfortServerKey;
+use crate::integer::server_key::ScalarMultiplier;
+use crate::integer::IntegerRadixCiphertext;
+
+pub fn matrix_mul<'a, Clear, T>(
+    server_key: &BelfortServerKey,
+    lhs: &TensorSlice<'a, &'a [Clear]>,
+    rhs: &TensorSlice<'a, &'a [T]>,
+) -> Vec<T>
+where
+    T: IntegerRadixCiphertext + 'static,
+    Clear: DecomposableInto<u8> + ScalarMultiplier + 'static,
+{
+    let lhs_shape = lhs.dims.shape();
+    assert!(
+        lhs_shape.len() == 2,
+        "enc_matmul expects a 2D TensorSlice, got shape {lhs_shape:?}"
+    );
+    let lhs_rows = lhs_shape[0];
+    let lhs_cols = lhs_shape[1];
+
+    let rhs_shape = rhs.dims.shape();
+    assert!(
+        rhs_shape.len() == 2,
+        "enc_matmul expects a 2D TensorSlice, got shape {rhs_shape:?}",
+    );
+    let rhs_rows = rhs_shape[0];
+    let rhs_cols = rhs_shape[1];
+
+    assert_eq!(
+        lhs_cols, rhs_rows,
+        "Incompatible matrix dimensions for multiplication:
+         A is {lhs_rows}x{lhs_cols}, B is {rhs_rows}x{rhs_cols}"
+    );
+
+    let lhs_slice = lhs.slice;
+    let rhs_slice = rhs.slice;
+
+    let mut out_cts = Vec::with_capacity(lhs_rows * rhs_cols);
+
+    for i in 0..lhs_rows {
+        let row_start = i * lhs_cols;
+        let row_end = row_start + lhs_cols;
+        let scalars = &lhs_slice[row_start..row_end];
+
+        for j in 0..rhs_cols {
+            let mut enc_col = Vec::with_capacity(rhs_rows);
+            for k in 0..rhs_rows {
+                let idx = k * rhs_cols + j;
+                enc_col.push(rhs_slice[idx].clone());
+            }
+
+            let ct = server_key.multi_scalar_mul(&enc_col, scalars);
+            out_cts.push(ct);
+        }
+    }
+
+    out_cts
+}
diff --git a/tfhe/src/high_level_api/composites/matrix_mul/tests.rs b/tfhe/src/high_level_api/composites/matrix_mul/tests.rs
