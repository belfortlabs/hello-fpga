+    pub fn eq_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext + Clone,
+    {
+        let (lhs, rhs) = self.conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_eq_simd(&lhs, &rhs)
+    }
+
+    pub fn ne_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
