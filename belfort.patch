-__device__ __forceinline__ int
-get_start_ith_ggsw_offset(uint32_t polynomial_size, int glwe_dimension,
-                          uint32_t level_count) {
-  return polynomial_size * (glwe_dimension + 1) * (glwe_dimension + 1) *
-         level_count;
-}
