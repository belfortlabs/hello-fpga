+    pub fn unchecked_eq_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs.len();
+        assert_eq!(num_comparisons, rhs.len());
+        if num_comparisons == 0 {
+            return vec![];
+        }
+
+        let blocks_per_ct = lhs[0].blocks().len();
+        let shortint_key = &self.key.key.key;
+
+        assert!(lhs.iter().all(|ct| ct.blocks().len() == blocks_per_ct));
+        assert!(rhs.iter().all(|ct| ct.blocks().len() == blocks_per_ct));
+
+        let mut all_prepared = Vec::with_capacity(num_comparisons * blocks_per_ct);
+
+        for (lhs_elem, rhs_elem) in lhs.iter().zip(rhs.iter()) {
+            for (lhs_block, rhs_block) in lhs_elem.blocks().iter().zip(rhs_elem.blocks().iter()) {
+                let mut prepared = lhs_block.clone();
+                shortint_key
+                    .unchecked_apply_lookup_table_bivariate_assign_prep(&mut prepared, rhs_block);
+                all_prepared.push(prepared);
+            }
+        }
+        let lut_equal_to = shortint_key.generate_lookup_vector_bivariate(&|x, y| u64::from(x == y));
+        self.apply_same_lookup_vector_packed_assign(&mut all_prepared, &lut_equal_to);
+
+        let results =
+            self.are_all_comparisons_block_true_simd(all_prepared, num_comparisons, blocks_per_ct);
+        results
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn unchecked_ne_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs.len();
+        assert_eq!(num_comparisons, rhs.len());
+        if num_comparisons == 0 {
+            return vec![];
+        }
+
+        let blocks_per_ct = lhs[0].blocks().len();
+        let shortint_key = &self.key.key.key;
+
+        assert!(lhs.iter().all(|ct| ct.blocks().len() == blocks_per_ct));
+        assert!(rhs.iter().all(|ct| ct.blocks().len() == blocks_per_ct));
+
+        let mut all_prepared = Vec::with_capacity(num_comparisons * blocks_per_ct);
+
+        for (lhs_elem, rhs_elem) in lhs.iter().zip(rhs.iter()) {
+            for (lhs_block, rhs_block) in lhs_elem.blocks().iter().zip(rhs_elem.blocks().iter()) {
+                let mut prepared = lhs_block.clone();
+                shortint_key
+                    .unchecked_apply_lookup_table_bivariate_assign_prep(&mut prepared, rhs_block);
+                all_prepared.push(prepared);
