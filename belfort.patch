+            let fns = scalar_block_cmp_fns
+                .iter()
+                .map(|func| func as &dyn Fn(u64) -> u64)
+                .collect::<Vec<_>>();
+
+            shortint_key.generate_many_lookup_vector(fns.as_slice())
