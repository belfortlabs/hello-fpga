+
+        for lhs_elem in lhs.iter_mut() {
+            self.full_propagate(lhs_elem)
+        }
+
+        let (result_lsb_vec, result_msb_vec) =
+            self.unchecked_block_mul_lsb_msb_simd(lhs, rhs, indices);
