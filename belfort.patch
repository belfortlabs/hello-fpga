+                        expected_overflowed,
+                        "Invalid overflow flag result for overflowing_add for ({clear_0} + {clear_1}) % {modulus} \
+                         expected overflow flag {expected_overflowed}, got {decrypted_overflowed}"
+                    );
+                    assert_eq!(result_overflowed.0.degree.get(), 1);
+                    assert_eq!(result_overflowed.0.noise_level(), NoiseLevel::NOMINAL);
+                },
+            );
+
+        for _ in 0..nb_tests_smaller {
+            // Add non-zero scalar to have non-clean ciphertexts
+            let clear_2 = random_non_zero_value_simd(&mut rng, modulus, SIMD_LEN);
+            let clear_3 = random_non_zero_value_simd(&mut rng, modulus, SIMD_LEN);
+
+            let mut clear_lhs = Vec::with_capacity(SIMD_LEN);
+            let mut clear_rhs = Vec::with_capacity(SIMD_LEN);
+            let mut ctxt_0_perturbated = Vec::with_capacity(SIMD_LEN);
+            let mut ctxt_1_perturbated = Vec::with_capacity(SIMD_LEN);
+
+            (0..SIMD_LEN).for_each(|i| {
+                let ctxt_res_0 = sks.unchecked_scalar_add(&ctxt_0[i], clear_2[i]);
+                let ctxt_res_1 = sks.unchecked_scalar_add(&ctxt_1[i], clear_3[i]);
+
+                clear_lhs.push(overflowing_add_under_modulus(clear_0[i], clear_2[i], modulus).0);
+                clear_rhs.push(overflowing_add_under_modulus(clear_1[i], clear_3[i], modulus).0);
+
+                let d0: u64 = cks.decrypt(&ctxt_res_0);
+                assert_eq!(d0, clear_lhs[i], "Failed sanity decryption check");
+                let d1: u64 = cks.decrypt(&ctxt_res_1);
+                assert_eq!(d1, clear_rhs[i], "Failed sanity decryption check");
+
+                ctxt_0_perturbated.push(ctxt_res_0);
+                ctxt_1_perturbated.push(ctxt_res_1);
+            });
+
+            let (ct_res, result_overflowed) =
+                executor.execute((&mut ctxt_0_perturbated, &mut ctxt_1_perturbated));
+
+            (0..SIMD_LEN).for_each(|i| {
+                    let (clear_lhs_i, clear_rhs_i) = (clear_lhs[i], clear_rhs[i]);
+                    let (expected_result, expected_overflowed) =
+                        overflowing_add_under_modulus(clear_lhs_i, clear_rhs_i, modulus);
+
+                    panic_if_any_block_is_not_clean(&ct_res[i], &cks);
+                    let decrypted_result: u64 = cks.decrypt(&ct_res[i]);
+                    let decrypted_overflowed = cks.decrypt_bool(&result_overflowed[i]);
+                    assert_eq!(
+                        decrypted_result, expected_result,
+                        "Invalid result for add, for ({clear_lhs_i} + {clear_rhs_i}) % {modulus} \
+                        expected {expected_result}, got {decrypted_result}"
+                    );
+                    assert_eq!(
+                        decrypted_overflowed,
+                        expected_overflowed,
+                        "Invalid overflow flag result for overflowing_add, for ({clear_lhs_i} + {clear_rhs_i}) % {modulus} \
+                        expected overflow flag {expected_overflowed}, got {decrypted_overflowed}"
+                    );
+                    assert_eq!(result_overflowed[i].0.degree.get(), 1);
+                    assert_eq!(result_overflowed[i].0.noise_level(), NoiseLevel::NOMINAL);
+                })
+        }
+    }
+}
