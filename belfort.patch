+        let num_blocks = ct.blocks().len();
+        let all_luts = vec![&luts; num_blocks];
+
+        let blocks_cmps = self.apply_many_lookup_vector_packed(ct.blocks(), &all_luts);
+
+        let num_bits_in_message = message_modulus.ilog2();
+        let mut groups = possible_input_values
+            .map(|input_value| {
+                BlockDecomposer::new(input_value, num_bits_in_message)
+                    .take(num_blocks)
+                    .enumerate()
+                    .map(|(block_index, block_value)| {
+                        blocks_cmps[block_index][block_value.cast_into()].clone()
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .collect::<Vec<_>>();
+
+        let max_sum_size = integer_key.max_sum_size(Degree::new(1));
+
+        while groups.iter().any(|g| g.len() > 1) {
+            let mut all_sums: Vec<Ciphertext> = Vec::new();
+            let mut all_luts: Vec<LookupVector> = Vec::new();
+
+            let mut spans: Vec<(usize, usize, usize)> = Vec::new();
+
+            for (group_idx, group) in groups.iter().enumerate() {
+                if group.len() <= 1 {
+                    continue;
+                }
+
+                let sums_and_luts = group.chunks(max_sum_size).map(|blocks| {
+                    let mut sum = blocks[0].clone();
+                    for ct in &blocks[1..] {
+                        shortint_key.unchecked_add_assign(&mut sum, ct);
+                    }
+
+                    let len_block = blocks.len() as u64;
+                    let is_equal_to_num_blocks = {
+                        let func = move |x| u64::from((x & block_modulus) == len_block);
+                        shortint_key.generate_lookup_vector(&func)
+                    };
+
+                    (sum, is_equal_to_num_blocks)
+                });
+
+                let (mut sums, luts): (Vec<Ciphertext>, Vec<LookupVector>) = sums_and_luts.unzip();
+
+                let start = all_sums.len();
+                let len = sums.len();
+
+                all_sums.append(&mut sums);
+                all_luts.extend(luts);
+                spans.push((group_idx, start, len));
+            }
+
+            let lut_refs = all_luts.iter().collect::<Vec<_>>();
+
+            self.apply_lookup_vector_packed_assign(&mut all_sums, &lut_refs);
+
+            for (group_idx, start, len) in spans {
+                let reduced = all_sums[start..start + len].to_vec();
+                groups[group_idx].clear();
+                groups[group_idx].extend(reduced);
+            }
+        }
+
+        groups
+            .into_iter()
+            .map(|g| BooleanBlock::new_unchecked(g[0].clone()))
+            .collect::<Vec<_>>()
+    }
+
+    /// Creates a vector of radix ciphertext from an iterator that associates encrypted boolean
+    /// values to clear values.
+    ///
+    /// The elements of the resulting vector are zero if the corresponding BooleanBlock encrypted 0,
+    /// otherwise it encrypts the associated clear value.
+    ///
+    /// This is only really useful if only one of the boolean block is known to be non-zero.
+    ///
+    /// `num_blocks`: number of blocks (unpacked) needed to represent the biggest clear value
+    ///
+    /// - Resulting radix ciphertexts have their block packed, thus they will have ceil (numb_blocks
+    ///   / 2) elements
+    fn create_possible_results<T, Iter, Clear>(
+        &self,
+        num_blocks: usize,
+        possible_outputs: Iter,
+    ) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+        Iter: Iterator<Item = (BooleanBlock, Clear)>,
+        Clear: Decomposable + CastInto<usize>,
+    {
+        let integer_key = &self.key.key;
+        let shortint_key = &self.key.key.key;
+
+        let message_modulus = integer_key.message_modulus().0;
+        let carry_modulus = integer_key.carry_modulus().0;
+
+        assert!(
+            carry_modulus >= message_modulus,
+            "As this function packs blocks, it requires to have at least as much carry \
+                space as message space ({carry_modulus:?} vs {message_modulus:?})"
+        );
+        // Vector of functions that returns function, that will be used to create LUTs later
+        let scalar_block_cmp_fns = (0..(message_modulus * message_modulus))
+            .map(|packed_block_value| {
+                move |is_selected: u64| {
+                    if is_selected == 1 {
+                        packed_block_value
+                    } else {
+                        0
+                    }
+                }
+            })
+            .collect::<Vec<_>>();
+
+        // How many "manyLUTs" we can apply, since we apply luts on boolean values
+        // (Degree(1), Modulus(2))
+        // Equivalent to (2^(msg_bits + carry_bits - 1)
+        let max_num_many_luts = (message_modulus * carry_modulus) / 2;
+
+        let num_bits_in_message = message_modulus.ilog2();
+
+        let mut all_many_luts = Vec::new();
+        let mut all_inputs = Vec::new();
+        let mut per_output_lut_counts = Vec::new();
+
+        for (selector, output_value) in possible_outputs {
+            let decomposed_value = BlockDecomposer::new(output_value, 2 * num_bits_in_message)
+                .take(num_blocks.div_ceil(2))
+                .collect::<Vec<_>>();
+
+            let mut lut_count = 0usize;
+            for chunk in decomposed_value.chunks(max_num_many_luts as usize) {
+                let fns = chunk
+                    .iter()
+                    .map(|packed_value| {
+                        &(scalar_block_cmp_fns[(*packed_value).cast_into()]) as &dyn Fn(u64) -> u64
+                    })
+                    .collect::<Vec<_>>();
+
+                let many_vec = shortint_key.generate_many_lookup_vector(&fns);
+
+                all_many_luts.push(many_vec);
+                all_inputs.push(selector.0.clone());
+                lut_count += 1;
+            }
+            per_output_lut_counts.push(lut_count);
+        }
+
+        let all_many_luts = all_many_luts.iter().collect::<Vec<_>>();
+
+        let per_lut_outputs: Vec<Vec<Ciphertext>> =
+            self.apply_many_lookup_vector_packed(&all_inputs, &all_many_luts);
+
+        let mut per_lut_outputs_idx = 0usize;
+        let mut output: Vec<T> = Vec::with_capacity(per_output_lut_counts.len());
+        for &count in &per_output_lut_counts {
+            let mut blocks = Vec::new();
+            for _ in 0..count {
+                blocks.extend(per_lut_outputs[per_lut_outputs_idx].clone());
+                per_lut_outputs_idx += 1;
+            }
+            output.push(T::from_blocks(blocks));
+        }
+
+        output
+    }
+
+    /// Aggregate/combines a vec of one-hot vector of radix ciphertexts
+    /// (i.e. at most one of the vector element is non-zero) into single ciphertext
+    /// containing the non-zero value.
+    ///
+    /// The elements in the one hot vector have their block packed.
+    ///
+    /// The returned result has non packed blocks
+    fn aggregate_one_hot_vector<T>(&self, mut one_hot_vector: Vec<T>) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let shortint_key = &self.key.key.key;
+
+        // Since all but one radix are zeros, the limiting factor
+        // for additions is the noise level
+        let chunk_size = shortint_key.max_noise_level.get() as usize;
+
+        let (num_init_chunks, num_init_rest) = (
+            one_hot_vector.len() / chunk_size,
+            one_hot_vector.len() % chunk_size,
+        );
+        let mut workbench = Vec::with_capacity(num_init_chunks + num_init_rest);
+
+        let lut_identity = self.lut_identity();
+
+        while one_hot_vector.len() > chunk_size {
+            let mut chunk_results: Vec<T> = one_hot_vector
+                .chunks_exact(chunk_size)
+                .map(|chunk| {
+                    let mut acc = chunk[0].clone();
+                    for r in &chunk[1..] {
+                        self.unchecked_add_assign(&mut acc, r);
+                    }
+                    acc
+                })
+                .collect();
+
+            {
+                let num_blocks = chunk_results.iter().map(|ct| ct.blocks().len()).sum();
+
+                let mut all_blocks = Vec::with_capacity(num_blocks);
+
+                for ct in &chunk_results {
+                    all_blocks.extend(ct.blocks().iter().cloned());
+                }
+
+                let all_luts = vec![&lut_identity; num_blocks];
+
+                self.apply_lookup_vector_packed_assign(&mut all_blocks, &all_luts);
+
+                let mut all_blocks_iter = all_blocks.into_iter();
+
+                for ct in &mut chunk_results {
+                    for block in ct.blocks_mut().iter_mut() {
+                        *block = all_blocks_iter.next().unwrap();
+                    }
+                }
+            }
+
+            workbench.clear();
+            workbench.extend(chunk_results);
+
+            let start = one_hot_vector.len() - one_hot_vector.len() % chunk_size;
+            workbench.extend(one_hot_vector.drain(start..));
+
+            std::mem::swap(&mut workbench, &mut one_hot_vector);
+        }
+
+        let mut result = one_hot_vector[0].clone();
+        for r in &one_hot_vector[1..] {
+            self.unchecked_add_assign(&mut result, r);
+        }
+
+        let mut unpacked_blocks = result
+            .blocks()
+            .iter()
+            .flat_map(|block| std::iter::repeat_n(block.clone(), 2))
+            .collect::<Vec<_>>();
+
+        let msg_lut = self.lut_message_extract();
+        let carry_lut = self.lut_carry_extract();
+
+        let luts = std::iter::repeat_n([&msg_lut, &carry_lut], unpacked_blocks.len() / 2)
+            .flatten()
+            .collect::<Vec<_>>();
+
+        self.apply_lookup_vector_packed_assign(&mut unpacked_blocks, &luts);
+
+        T::from_blocks(unpacked_blocks)
+    }
+
+    /// Only keeps at most one Ciphertext that encrypts 1
+    ///
+    /// Given a Vec of Ciphertexts where each Ciphertext encrypts 0 or 1
+    /// This function will return a Vec of Ciphertext where at most one encryption of 1 is present
+    ///
+    /// The first encryption of one is kept
+    fn only_keep_first_true(&self, mut values: Vec<Ciphertext>) -> Vec<Ciphertext> {
+        let integer_key = &self.key.key;
+        let shortint_key = &self.key.key.key;
+
+        let message_modulus = integer_key.message_modulus().0;
+        let carry_modulus = integer_key.carry_modulus().0;
+
+        if values.len() <= 1 {
+            return values;
+        }
+        let does_not_have_enough_bits = message_modulus < 3 || (carry_modulus < message_modulus);
+
+        if does_not_have_enough_bits {
+            let mut true_already_seen = values[0].clone();
+            let func = move |current_block: u64, true_already_seen: u64| {
+                if true_already_seen == 1 {
+                    0
+                } else {
+                    current_block
+                }
+            };
+            let lut = shortint_key.generate_lookup_vector_bivariate(&func);
+
+            for block in &mut values[1..] {
+                let new_true_already_seen = shortint_key.bitor(&true_already_seen, block);
+                let packed = block;
+                integer_key.pack_block_assign(&true_already_seen, packed);
+                self.apply_lookup_vector_single_assign(packed, &lut);
+                true_already_seen = new_true_already_seen;
+            }
+
+            values
+        } else {
+            const ALREADY_SEEN: u64 = 2;
+            let lut_fn = |current: u64, previous: u64| -> u64 {
+                if previous == 1 || previous == ALREADY_SEEN {
+                    ALREADY_SEEN
+                } else {
+                    current
+                }
+            };
+
+            let mut values = self.compute_prefix_sum_hillis_steele(values, &lut_fn);
+            let func = move |x| {
+                if x % message_modulus == ALREADY_SEEN {
+                    0
+                } else {
+                    x % message_modulus
+                }
+            };
+            let lut = shortint_key.generate_lookup_vector(&func);
+
+            self.apply_same_lookup_vector_packed_assign(&mut values, &lut);
+
+            values
+        }
+    }
+}
