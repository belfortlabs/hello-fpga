+pub(crate) fn unchecked_block_mul_simd_test<P, T>(param: P, mut executor: T)
+where
+    P: Into<TestParameters>,
+    T: for<'a> FunctionExecutor<
+        (&'a mut [RadixCiphertext], &'a mut [Ciphertext], &'a [usize]),
