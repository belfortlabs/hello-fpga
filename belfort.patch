-  for (Index l = 4; l >= 1; --l) {
-    Index lane_mask = 1 << (l - 1);
-    Index thread_mask = (1 << l) - 1;
-    twiddle_shift <<= 1;
-
-    tid = threadIdx.x;
-    double2 reg_A[BUTTERFLY_DEPTH];
-
-    tid = threadIdx.x;
-#pragma unroll
-    for (Index i = 0; i < BUTTERFLY_DEPTH; i++) {
-      Index rank = tid & thread_mask;
