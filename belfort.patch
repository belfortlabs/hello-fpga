+impl BelfortServerKey {
+    pub fn unchecked_block_mul_assign_simd<T>(
+        &self,
+        lhs: &mut [T],
+        rhs: &[Ciphertext],
+        indices: &[usize],
+    ) where
+        T: IntegerRadixCiphertext,
+    {
+        let results = self.unchecked_block_mul_simd(lhs, rhs, indices);
+
+        for (lhs_elem, result) in lhs.iter_mut().zip(results) {
+            *lhs_elem = result;
+        }
+    }
+
+    pub fn unchecked_block_mul_simd<T>(
+        &self,
+        lhs: &[T],
+        rhs: &[Ciphertext],
+        indices: &[usize],
