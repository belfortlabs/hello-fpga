index 000000000..7680356e4
--- /dev/null
+++ b/tfhe-benchmark/benches/composites/aes/decrypt.rs
@@ -0,0 +1,59 @@
+use aes::Aes128;
+use std::hint::black_box;
+
+use criterion::Criterion;
+use tfhe::composites::aes::constants::{AES_128_KEY_SIZE, AES_BLOCK_SIZE};
+use tfhe::composites::aes::FheAes;
+use tfhe::integer::fpga::BelfortServerKey;
+use tfhe::set_server_key;
+use tfhe::shortint::prelude::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+
+use aes::cipher::{BlockCipherEncrypt, KeyInit};
+use hybrid_array::Array;
+
+use super::encrypt::BLOCKS;
+
+pub(crate) fn encrypt_reference_aes128(
+    blocks: &[[u8; AES_BLOCK_SIZE]],
+    key: [u8; AES_128_KEY_SIZE],
+) -> Vec<[u8; AES_BLOCK_SIZE]> {
+    let aes = Aes128::new_from_slice(&key).expect("AES-128 key must be 16 bytes");
+
+    blocks
+        .iter()
+        .map(|b| {
+            let mut tmp = Array::from(*b);
+            aes.encrypt_block(&mut tmp);
+            tmp.into()
+        })
+        .collect()
+}
+
+pub fn fhe_aes_decrypt_n_blocks_bench(c: &mut Criterion, n: usize) {
+    let key: [u8; AES_128_KEY_SIZE] = [0x00; AES_128_KEY_SIZE];
+
+    let (client_key, server_key) = tfhe::integer::gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, 4);
+    let mut fpga_key = BelfortServerKey::from(&server_key);
+    fpga_key.connect();
+    set_server_key(fpga_key.clone());
+    let fhe = FheAes::new(&fpga_key);
+
+    let fhe_key = core::array::from_fn(|i| client_key.encrypt(key[i] as u64));
+    let expanded_key = fhe.expand_key(&fhe_key);
+
+    let aes_blocks = encrypt_reference_aes128(&BLOCKS, key);
+    let fhe_aes_blocks = (0..n)
+        .map(|i| {
+            let block = aes_blocks[i];
+            core::array::from_fn(|i| server_key.create_trivial_radix(block[i], 4))
+        })
+        .collect::<Vec<_>>();
+
+    c.bench_function(format!("FHE_AES128_decrypt_{n}_blocks").as_str(), |b| {
+        b.iter(|| {
+            let _plain = fhe.aes_dec_blocks(black_box(&fhe_aes_blocks), black_box(&expanded_key));
+        });
+    });
+
+    fpga_key.disconnect();
+}
