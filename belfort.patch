+pub(crate) fn default_multi_scalar_mul_test<P, T>(param: P, mut executor: T)
+where
+    P: Into<TestParameters>,
+    T: for<'a> FunctionExecutor<(&'a [RadixCiphertext], &'a [u128]), RadixCiphertext>,
+{
+    let param = param.into();
+    let nb_tests_smaller = nb_tests_smaller_for_params(param);
+    let (cks, mut sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+
+    // Set parameters for vector mul
+    let nb_blocks = 32;
+    let nb_elements = 64;
+
+    let cks = RadixClientKey::from((cks, nb_blocks));
+
+    sks.set_deterministic_pbs_execution(true);
+    let sks = Arc::new(sks);
+    let mut rng = rand::thread_rng();
+
+    // message_modulus^vec_length
+    let modulus = 1u128 << (nb_blocks * 2);
+
+    executor.setup(&cks, sks);
+
+    for _ in 0..nb_tests_smaller {
+        let scalars = (0..nb_elements)
+            .map(|_| rng.gen::<u128>() % modulus)
+            .collect::<Vec<_>>();
+        let clears = (0..nb_elements)
+            .map(|_| rng.gen::<u128>() % modulus)
+            .collect::<Vec<_>>();
+
+        let ctxts = clears
+            .iter()
+            .map(|&clear| cks.encrypt(clear))
+            .collect::<Vec<_>>();
+
+        let ct_res = executor.execute((&ctxts, &scalars));
+        let tmp = executor.execute((&ctxts, &scalars));
+        assert_eq!(ct_res, tmp);
+
+        let dec_res = cks.decrypt(&ct_res);
+
+        let mut expected_result = 0u128;
+        for (clear, scalar) in clears.iter().zip(scalars.iter()) {
+            expected_result = (expected_result + ((scalar * clear) % modulus)) % modulus;
+        }
+
+        assert_eq!(expected_result, dec_res);
+    }
+}
