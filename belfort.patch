@@ -0,0 +1,120 @@
+use crate::integer::fpga::server_key::radix::tests::FpgaFunctionExecutor;
+use crate::integer::keycache::KEY_CACHE;
+use crate::integer::tests::create_test_belfort_params;
+use crate::integer::IntegerKeyKind;
+use crate::shortint::parameters::TestParameters;
+use rand::rngs::OsRng;
+use rand::RngCore;
+use std::sync::Arc;
+
+use super::matrix_mul;
+use crate::array::stride::DynDimensions;
+use crate::array::traits::TensorSlice;
+use crate::high_level_api::traits::FheTryEncrypt;
+use crate::integer::fpga::BelfortServerKey;
+use crate::integer::server_key::radix_parallel::tests_cases_unsigned::FunctionExecutor;
+use crate::integer::SignedRadixCiphertext;
+use crate::shortint::prelude::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+use crate::{ClientKey as HlClientKey, FheInt32Id, Tag};
+
+create_test_belfort_params!(matrix_multiplication);
+
+type T = SignedRadixCiphertext;
+
+fn clear_matrix_mul_i32(
+    a: &[i32],
+    b: &[i32],
+    a_rows: usize,
+    a_cols: usize,
+    b_cols: usize,
+) -> Vec<i32> {
+    let b_rows = a_cols;
+    let mut out = vec![0i32; a_rows * b_cols];
+
+    for i in 0..a_rows {
+        for j in 0..b_cols {
+            let mut acc = 0i32;
+            for k in 0..b_rows {
+                let a_val = a[i * a_cols + k];
+                let b_val = b[k * b_cols + j];
+                acc = acc.saturating_add(a_val.saturating_mul(b_val));
+            }
+            out[i * b_cols + j] = acc;
+        }
+    }
+
+    out
+}
+
+pub(crate) fn matrix_multiplication<P>(param: P)
+where
+    P: Into<TestParameters>,
+{
+    let executor = FpgaFunctionExecutor::new(matrix_mul);
+    enc_matrix_mul_tests(param, executor);
+}
+
+fn enc_matrix_mul_tests<P, F>(param: P, mut executor: FpgaFunctionExecutor<F>)
+where
+    P: Into<TestParameters>,
+    F: for<'a, 'b> Fn(
+        &'a BelfortServerKey,
+        &'a TensorSlice<'b, &'b [i32]>,
+        &'a TensorSlice<'b, &'b [T]>,
+    ) -> Vec<SignedRadixCiphertext>,
+    FpgaFunctionExecutor<F>: for<'a, 'b> FunctionExecutor<
+        (&'a TensorSlice<'b, &'b [i32]>, &'a TensorSlice<'b, &'b [T]>),
+        Vec<SignedRadixCiphertext>,
+    >,
+{
+    let param = param.into();
+
+    let (int_cks, int_sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let cks = HlClientKey::from_raw_parts(int_cks, None, None, None, None, None, Tag::default());
+
+    let sks = Arc::new(int_sks);
+    executor.setup(sks);
+
+    let test_shapes = [(1usize, 1usize, 1usize), (2, 3, 2), (3, 2, 4)];
+
+    for &(a_rows, a_cols, b_cols) in &test_shapes {
+        let b_rows = a_cols;
+
+        let mut rng = OsRng;
+
+        let mut a_vals = vec![0i32; a_rows * a_cols];
+        let mut b_vals = vec![0i32; b_rows * b_cols];
+
+        for val in &mut a_vals {
+            *val = (rng.next_u32() % 11) as i32 - 5;
+        }
+        for val in &mut b_vals {
+            *val = (rng.next_u32() % 11) as i32 - 5;
+        }
+
+        let lhs_dims = DynDimensions::from(vec![a_rows, a_cols]);
+        let lhs = TensorSlice::new(a_vals.as_slice(), &lhs_dims);
+
+        let enc_b_owned =
+            crate::high_level_api::array::CpuFheIntArray::<FheInt32Id>::try_encrypt(&b_vals, &cks)
+                .unwrap()
+                .into_container();
+
+        let rhs_dims = DynDimensions::from(vec![b_rows, b_cols]);
+        let rhs = TensorSlice::new(enc_b_owned.as_slice(), &rhs_dims);
+
+        let expected = clear_matrix_mul_i32(&a_vals, &b_vals, a_rows, a_cols, b_cols);
+
+        let enc_res = FunctionExecutor::execute(&mut executor, (&lhs, &rhs));
+
+        let dec_res_flat: Vec<i32> = enc_res
+            .iter()
+            .map(|ct| cks.key.key.decrypt_signed_radix(ct))
+            .collect();
+
+        assert_eq!(
+            expected, dec_res_flat,
+            "Result mismatch for A={a_rows}x{a_cols}, B={b_rows}x{b_cols}"
+        );
+    }
+}
