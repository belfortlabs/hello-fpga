-    for (Index i = 0; i < BUTTERFLY_DEPTH; i++) {
-      Index rank = tid & thread_mask;
-      bool u_stays_in_register = rank < lane_mask;
-      A[tid] = (u_stays_in_register) ? v[i] : u[i];
-      tid = tid + STRIDE;
