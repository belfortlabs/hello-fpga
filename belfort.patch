+
+    pub fn unchecked_mul_assign_simd<T>(&self, lhs: &mut [T], rhs: &[T])
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_multiplications = lhs.len();
+
+        assert_eq!(
+            num_multiplications,
+            rhs.len(),
+            "lhs and rhs must have the same length"
+        );
+
+        if num_multiplications == 0 {
+            return;
+        }
+
+        let mut non_boolean_indices = Vec::with_capacity(num_multiplications);
+
+        let shortint_key = &self.key.key.key;
+        let integer_key = &self.key.key;
+
+        let mut rhs_bool_cases = Vec::with_capacity(num_multiplications);
+        let mut lhs_bool_cases = Vec::with_capacity(num_multiplications);
+
+        for idx in 0..num_multiplications {
+            let rhs_elem = &rhs[idx];
+            let lhs_elem = &lhs[idx];
+
+            if rhs_elem.holds_boolean_value() {
+                let cond = &rhs_elem.blocks()[0];
+                debug_assert!(cond.degree.get() < cond.message_modulus.0);
+                if cond.degree.get() == 0 {
+                    integer_key.create_trivial_zero_assign_radix(&mut lhs[idx]);
+                } else {
+                    rhs_bool_cases.push(idx);
+                }
+            } else if lhs_elem.holds_boolean_value() {
+                let cond = &lhs_elem.blocks()[0];
+                debug_assert!(cond.degree.get() < cond.message_modulus.0);
+                if cond.degree.get() == 0 {
+                    integer_key.create_trivial_zero_assign_radix(&mut lhs[idx]);
+                } else {
+                    lhs_bool_cases.push(idx);
+                }
+            } else {
+                non_boolean_indices.push(idx);
+            }
+        }
+
+        if !rhs_bool_cases.is_empty() || !lhs_bool_cases.is_empty() {
+            let predicate_lut =
+                shortint_key.generate_lookup_vector_bivariate(&|block, condition| {
+                    if condition == 0 {
+                        0
+                    } else {
+                        block
+                    }
+                });
+
+            let bool_ct_count = rhs_bool_cases.len() + lhs_bool_cases.len();
+            let mut all_prepared = Vec::with_capacity(bool_ct_count * lhs[0].blocks().len());
+            let mut case_meta = Vec::with_capacity(bool_ct_count);
+
+            for &idx in &rhs_bool_cases {
+                let ct_blocks = lhs[idx].blocks().to_vec();
+                let condition = rhs[idx].blocks()[0].clone();
+                let condition_vec = vec![condition; ct_blocks.len()];
+                let prepared = self.prepare_block_vecs_bivariate(&ct_blocks, &condition_vec);
+                case_meta.push((idx, all_prepared.len(), prepared.len(), false));
+                all_prepared.extend(prepared);
+            }
+
+            for &idx in &lhs_bool_cases {
+                let ct_blocks = rhs[idx].blocks().to_vec();
+                let condition = lhs[idx].blocks()[0].clone();
+                let condition_vec = vec![condition; ct_blocks.len()];
+                let prepared = self.prepare_block_vecs_bivariate(&ct_blocks, &condition_vec);
+                case_meta.push((idx, all_prepared.len(), prepared.len(), true));
+                all_prepared.extend(prepared);
+            }
+
+            self.apply_same_lookup_vector_packed_assign(&mut all_prepared, &predicate_lut);
+
+            for (idx, block_start, num_blocks, is_lhs_bool) in case_meta {
+                let result = all_prepared[block_start..block_start + num_blocks].to_vec();
+                if is_lhs_bool {
+                    lhs[idx] = T::from_blocks(result);
+                } else {
+                    lhs[idx].blocks_mut().clone_from_slice(&result);
+                }
+            }
+        }
+
+        if non_boolean_indices.is_empty() {
+            return;
+        }
+
+        let mut non_boolean_lhs = non_boolean_indices
+            .iter()
+            .map(|&idx| lhs[idx].clone())
+            .collect::<Vec<_>>();
+
+        let non_boolean_rhs = non_boolean_indices
+            .iter()
+            .map(|&idx| rhs[idx].clone())
+            .collect::<Vec<_>>();
+
+        self.compute_terms_for_mul_low_simd(&mut non_boolean_lhs, &non_boolean_rhs);
+
+        for (result_idx, &original_idx) in non_boolean_indices.iter().enumerate() {
+            lhs[original_idx] = non_boolean_lhs[result_idx].clone();
+        }
+    }
+
+    fn compute_terms_for_mul_low_simd<T>(&self, lhs: &mut [T], rhs: &[T])
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_multiplications = lhs.len();
+        if num_multiplications == 0 {
+            return;
+        }
+
+        let blocks_per_ct = lhs[0].blocks().len();
+        let integer_key = &self.key.key;
+        let shortint_key = &integer_key.key;
+        let message_modulus = integer_key.message_modulus().0;
+        let max_index = blocks_per_ct - 1;
+
+        let mut all_lsb_prepared = Vec::new();
+        let mut all_msb_prepared = Vec::new();
+        let mut lsb_positions = Vec::new();
+        let mut msb_positions = Vec::new();
+
+        let (lut_mul_2lsb, lut_mul_2msb) = (self.lut_mul_2lsb(), self.lut_mul_2msb());
+        for (mult_idx, (lhs_elem, rhs_elem)) in lhs.iter().zip(rhs.iter()).enumerate() {
+            let lhs_blocks = lhs_elem.blocks();
+            let rhs_blocks = rhs_elem.blocks();
+            for (index_rhs, block_rhs) in rhs_blocks
+                .iter()
+                .enumerate()
+                .filter(|(_, block)| block.degree.get() != 0)
+            {
+                for (index_lhs, bl_lhs) in lhs_blocks[0..=max_index - index_rhs]
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, block_lhs)| block_lhs.degree.get() != 0)
+                {
+                    let mut block_lhs = bl_lhs.clone();
+                    shortint_key.unchecked_apply_lookup_table_bivariate_assign_prep(
+                        &mut block_lhs,
+                        block_rhs,
+                    );
+                    all_lsb_prepared.push(block_lhs);
+                    lsb_positions.push((mult_idx, index_rhs + index_lhs));
+                }
+            }
+            if message_modulus > 2 {
+                for (index_rhs, block_rhs) in rhs_blocks[..rhs_blocks.len() - 1]
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, block)| block.degree.get() != 0)
+                {
+                    for (index_lhs, bl_lhs) in lhs_blocks[0..(max_index - index_rhs)]
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, block_lhs)| block_lhs.degree.get() != 0)
+                    {
+                        let mut block_lhs = bl_lhs.clone();
+                        shortint_key.unchecked_apply_lookup_table_bivariate_assign_prep(
+                            &mut block_lhs,
+                            block_rhs,
+                        );
+                        all_msb_prepared.push(block_lhs);
+                        msb_positions.push((mult_idx, index_rhs + index_lhs + 1));
+                    }
+                }
+            }
+        }
+
+        let lsb_len = all_lsb_prepared.len();
+        let msb_len = all_msb_prepared.len();
+
+        if lsb_len + msb_len > 0 {
+            let mut all_cts = Vec::with_capacity(lsb_len + msb_len);
+            all_cts.append(&mut all_lsb_prepared);
+            all_cts.append(&mut all_msb_prepared);
+
+            let mut all_luts = Vec::with_capacity(lsb_len + msb_len);
+            all_luts.extend(repeat_n(&lut_mul_2lsb, lsb_len));
+            all_luts.extend(repeat_n(&lut_mul_2msb, msb_len));
+
+            self.apply_lookup_vector_packed_assign(&mut all_cts, &all_luts);
+
+            let mut it = all_cts.into_iter();
+            all_lsb_prepared.extend(it.by_ref().take(lsb_len));
+            all_msb_prepared.extend(it.take(msb_len));
+        }
+
+        let mut all_terms = vec![vec![vec![]; blocks_per_ct]; num_multiplications];
+
+        for (block, (mult_idx, block_pos)) in
+            all_lsb_prepared.into_iter().zip(lsb_positions.into_iter())
+        {
+            all_terms[mult_idx][block_pos].push(block);
+        }
+
+        for (block, (mult_idx, block_pos)) in
+            all_msb_prepared.into_iter().zip(msb_positions.into_iter())
+        {
+            all_terms[mult_idx][block_pos].push(block);
+        }
+
+        self.adder_tree_assign_batched_simd(&mut all_terms);
+
+        for (mult_idx, lhs_elem) in lhs.iter_mut().enumerate() {
+            let result_blocks = self.flatten_result(all_terms[mult_idx].clone());
+            lhs_elem
+                .blocks_mut()
+                .iter_mut()
+                .enumerate()
+                .for_each(|(index, block)| {
+                    block.clone_from(&result_blocks[index]);
+                });
+        }
+    }
+
+    fn adder_tree_assign_batched_simd(&self, all_terms: &mut [Vec<Vec<Ciphertext>>]) {
+        let num_multiplications = all_terms.len();
+        if num_multiplications == 0 {
+            return;
+        }
+
+        let blocks_per_ct = all_terms[0].len();
+        let shortint_key = &self.key.key.key;
+        let max_additions_per_slot = self.get_additions_to_fill_carry();
+        let pbs_slots_parallel = 64;
+
+        let mut ready_index = 0;
+
+        while ready_index < blocks_per_ct {
+            while ready_index < blocks_per_ct
+                && all_terms.iter().all(|terms| terms[ready_index].len() <= 1)
+            {
+                ready_index += 1;
+            }
+
+            let has_work = all_terms
+                .iter()
+                .any(|terms| terms[ready_index..].iter().any(|col| col.len() > 1));
+
+            if !has_work {
+                break;
+            }
+
+            let mut ciphertext_stack =
+                Vec::<(Ciphertext, usize, usize, LookupVector)>::with_capacity(pbs_slots_parallel);
+            let mut pbs_slots_open = pbs_slots_parallel;
+            let mut current_index = ready_index;
+            while current_index < blocks_per_ct && pbs_slots_open > 0 {
+                for (mult_idx, terms_for_mult) in
+                    all_terms.iter_mut().take(num_multiplications).enumerate()
+                {
+                    if pbs_slots_open == 0 {
+                        break;
+                    }
+
+                    let input_column = &mut terms_for_mult[current_index];
+
+                    if input_column.len() <= 1 {
+                        continue;
+                    }
+
+                    let max_additions = if current_index == blocks_per_ct - 1 {
+                        pbs_slots_open * max_additions_per_slot
+                    } else {
+                        (pbs_slots_open / 2) * max_additions_per_slot
+                    };
+
+                    let take_amount = input_column.len().min(max_additions);
+                    if take_amount < 2 {
+                        continue;
+                    }
+
+                    let mut slots_filled = take_amount / max_additions_per_slot;
+                    let has_partial_slot = (take_amount % max_additions_per_slot) > 1;
+                    if current_index == ready_index {
+                        slots_filled += has_partial_slot as usize;
+                    }
+
+                    if slots_filled == 0 {
+                        continue;
+                    }
+
+                    let slots_to_use = slots_filled.min(if current_index == blocks_per_ct - 1 {
+                        pbs_slots_open
+                    } else {
+                        pbs_slots_open / 2
+                    });
+
+                    for _ in 0..slots_to_use.min(slots_filled) {
+                        if input_column.len() < 2 {
+                            break;
+                        }
+
+                        let mut res = input_column.pop().unwrap();
+                        let second_res = input_column.pop().unwrap();
+                        shortint_key.unchecked_add_assign(&mut res, &second_res);
+
+                        let adds_left = (max_additions_per_slot - 2).min(input_column.len());
+                        for _ in 0..adds_left {
+                            shortint_key
+                                .unchecked_add_assign(&mut res, &input_column.pop().unwrap());
+                        }
+
+                        ciphertext_stack.push((
+                            res.clone(),
+                            mult_idx,
+                            current_index,
+                            self.lut_message_extract(),
+                        ));
+
+                        if current_index == blocks_per_ct - 1 {
+                            pbs_slots_open = pbs_slots_open.saturating_sub(1);
+                        } else {
+                            ciphertext_stack.push((
+                                res,
+                                mult_idx,
+                                current_index + 1,
+                                self.lut_carry_extract(),
+                            ));
+                            pbs_slots_open = pbs_slots_open.saturating_sub(2);
+                        }
+                    }
+                }
+
+                current_index += 1;
+            }
+
+            if !ciphertext_stack.is_empty() {
+                let mut luts = Vec::with_capacity(ciphertext_stack.len());
+                let mut ciphertexts = ciphertext_stack
+                    .iter()
+                    .map(|(ct, _, _, lut)| {
+                        luts.push(lut);
+                        ct.clone()
+                    })
+                    .collect::<Vec<_>>();
+
+                self.apply_lookup_vector_packed_assign(&mut ciphertexts, &luts);
+
+                for (ct_result, (_, mult_idx, index, _)) in
+                    ciphertexts.into_iter().zip(ciphertext_stack.into_iter())
+                {
+                    all_terms[mult_idx][index].push(ct_result);
+                }
+            }
+        }
+    }
+
+    fn unchecked_block_mul_lsb_msb_simd<T>(
+        &self,
+        lhs: &[T],
+        rhs: &[Ciphertext],
+        indices: &[usize],
+    ) -> (Vec<T>, Vec<T>)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let shortint_key = &self.key.key.key;
+        let lut_mul_2lsb = self.lut_mul_2lsb();
+        let lut_mul_2msb = self.lut_mul_2msb();
+
+        let shifted: Vec<T> = lhs
+            .iter()
+            .zip(indices.iter())
+            .map(|(ct1, &idx)| self.blockshift(ct1, idx))
+            .collect();
+
+        let ct_len = shifted[0].blocks().len();
+        let max_index = 2 * ct_len - 1;
+        let n = lhs.len();
+
+        let mut all_lsb = Vec::with_capacity(n * ct_len);
+        let mut all_msb = Vec::with_capacity(n * (ct_len - 1));
+        let mut lsb_pos = Vec::with_capacity(n * ct_len);
+        let mut msb_pos = Vec::with_capacity(n * (ct_len - 1));
+
+        for (pair_idx, (shifted_ct1, ct2)) in shifted.iter().zip(rhs.iter()).enumerate() {
+            shifted_ct1
+                .blocks()
+                .iter()
+                .chain(shifted_ct1.blocks()[..ct_len - 1].iter())
+                .enumerate()
+                .filter(|(_, block)| block.degree.get() != 0)
+                .for_each(|(inner_index, block)| {
+                    let mut block = block.clone();
+                    shortint_key
+                        .unchecked_apply_lookup_table_bivariate_assign_prep(&mut block, ct2);
+                    if inner_index < ct_len {
+                        lsb_pos.push((pair_idx, inner_index));
+                        all_lsb.push(block);
+                    } else {
+                        msb_pos.push((pair_idx, inner_index + 1));
+                        all_msb.push(block);
+                    }
+                });
+        }
+
+        let lsb_len = all_lsb.len();
+        let msb_len = all_msb.len();
+
+        if lsb_len + msb_len > 0 {
+            let mut all_cts = Vec::with_capacity(lsb_len + msb_len);
+            all_cts.append(&mut all_lsb);
+            all_cts.append(&mut all_msb);
+
+            let mut all_luts = Vec::with_capacity(lsb_len + msb_len);
+            all_luts.extend(repeat_n(&lut_mul_2lsb, lsb_len));
+            all_luts.extend(repeat_n(&lut_mul_2msb, msb_len));
+
+            self.apply_lookup_vector_packed_assign(&mut all_cts, &all_luts);
+
+            let mut it = all_cts.into_iter();
+            all_lsb.extend(it.by_ref().take(lsb_len));
+            all_msb.extend(it.take(msb_len));
+        }
+
+        let mut to_adds = vec![vec![vec![]; max_index + 1]; n];
+        for (ct, (pair_idx, block_pos)) in all_lsb.into_iter().zip(lsb_pos) {
+            to_adds[pair_idx][block_pos].push(ct);
+        }
+        for (ct, (pair_idx, block_pos)) in all_msb.into_iter().zip(msb_pos) {
+            to_adds[pair_idx][block_pos].push(ct);
+        }
+
+        let mut all_result_lsb = Vec::with_capacity(n);
+        let mut all_result_msb = Vec::with_capacity(n);
+        for to_add in to_adds {
+            let mut result_lsb = self.flatten_result(to_add);
+            let result_msb = result_lsb.split_off(ct_len);
+            all_result_lsb.push(T::from_blocks(result_lsb));
+            all_result_msb.push(T::from_blocks(result_msb));
+        }
+        (all_result_lsb, all_result_msb)
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/multi_scalar_mul.rs b/tfhe/src/integer/fpga/server_key/radix/multi_scalar_mul.rs
new file mode 100644
index 000000000..5e60561d5
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/multi_scalar_mul.rs
@@ -0,0 +1,95 @@
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::server_key::radix_parallel::scalar_mul::select_scalar_mul_params;
+use crate::integer::server_key::ScalarMultiplier;
+use crate::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn unchecked_multi_scalar_mul<T, Scalar>(&self, ctxts: &[T], scalars: &[Scalar]) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: ScalarMultiplier + DecomposableInto<u8>,
+    {
+        assert!(!ctxts.is_empty(), "ctxts must not be empty");
+        assert!(!scalars.is_empty(), "scalars must not be empty");
+        assert_eq!(
+            ctxts.len(),
+            scalars.len(),
+            "ctxts and scalars must have equal length"
+        );
+
+        let sample_ctxt = &ctxts[0];
+        let num_blocks = sample_ctxt.blocks().len();
+        let integer_key = &self.key.key;
+
+        let (window_size, use_doubling) = select_scalar_mul_params(scalars);
+
+        let ctxts_shifted = if use_doubling {
+            None
+        } else {
+            let mut ctxts_vec = ctxts.to_vec();
+            self.unchecked_vector_scalar_left_shift_assign(&mut ctxts_vec, 1);
+            Some(ctxts_vec)
+        };
+
+        let mut buckets = integer_key.multi_scalar_mul_accumulation(
+            ctxts,
+            ctxts_shifted.as_ref(),
+            scalars,
+            window_size,
+        );
+
+        let mut result =
+            self.multi_scalar_mul_aggregation(&mut buckets, num_blocks, window_size, use_doubling);
+
+        self.full_propagate(&mut result);
+
+        result
+    }
+
+    pub fn multi_scalar_mul<T, Scalar>(&self, ctxts: &[T], scalars: &[Scalar]) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: ScalarMultiplier + DecomposableInto<u8>,
+    {
+        let mut ctxts_vec = ctxts.to_vec();
+        for element in ctxts_vec.iter_mut() {
+            self.conditional_full_propagate(element);
+        }
+
+        self.unchecked_multi_scalar_mul(&ctxts_vec, scalars)
+    }
+
+    pub(crate) fn multi_scalar_mul_aggregation<T>(
+        &self,
+        buckets: &mut [Vec<T>],
+        num_blocks: usize,
+        window_size: usize,
+        use_doubling: bool,
+    ) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let upper_bucket_limit = 1usize << (window_size - 1);
+        let lower_bucket_limit = 1usize << (window_size - 2);
+
+        if use_doubling {
+            let result_double = self.scalar_mul_aggregation(
+                &mut buckets[lower_bucket_limit..upper_bucket_limit].to_vec(),
+                num_blocks,
+                window_size,
+            );
+
+            let (message_ctxt, carry_ctxt_shifted) =
+                self.split_msg_and_shifted_carry(&result_double);
+
+            let mut ctxts_to_be_pushed = vec![message_ctxt, carry_ctxt_shifted];
+
+            self.unchecked_vector_scalar_left_shift_assign(&mut ctxts_to_be_pushed, 1);
+
+            buckets[0].extend(ctxts_to_be_pushed);
+        }
+
+        self.scalar_mul_aggregation(buckets, num_blocks, window_size)
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/neg.rs b/tfhe/src/integer/fpga/server_key/radix/neg.rs
new file mode 100644
index 000000000..ae8b05a09
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/neg.rs
@@ -0,0 +1,362 @@
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::integer::{BooleanBlock, CheckError};
+
+impl BelfortServerKey {
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// This function computes the opposite of a message without checking if it exceeds the
+    /// capacity of the ciphertext.
+    ///
+    /// The result is returned as a new ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let modulus = 1 << 8;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg = 159u64;
+    ///
+    /// // Encrypt a message
+    /// let ctxt = cks.encrypt(msg);
+    ///
+    /// // Compute homomorphically a negation
+    /// let ct_res = fpga_key.unchecked_neg(&ctxt);
+    ///
+    /// // Decrypt
+    /// let dec: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(modulus - msg, dec);
+    /// ```
+    pub fn unchecked_neg<T>(&self, ctxt: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_neg(ctxt)
+    }
+
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// This function computes the opposite of a message without checking if it exceeds the
+    /// capacity of the ciphertext.
+    ///
+    /// The result is assigned to the input ciphertext.
+    pub fn unchecked_neg_assign<T>(&self, ctxt: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_neg_assign(ctxt);
+    }
+
+    /// Verifies if ct can be negated.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg = 2u64;
+    ///
+    /// // Encrypt a message
+    /// let ctxt = cks.encrypt(msg);
+    ///
+    /// // Check if we can perform a negation
+    /// fpga_key.is_neg_possible(&ctxt).unwrap();
+    /// ```
+    pub fn is_neg_possible<T>(&self, ctxt: &T) -> Result<(), CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.is_neg_possible(ctxt)
+    }
+
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// This function computes the opposite of a message while checking if it exceeds the
+    /// capacity of the ciphertext.
+    ///
+    /// The result is returned as a new ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg = 1u64;
+    ///
+    /// // Encrypt a message
+    /// let ctxt = cks.encrypt(msg);
+    ///
+    /// // Compute homomorphically a negation:
+    /// let ct_res = fpga_key.checked_neg(&ctxt);
+    ///
+    /// match ct_res {
+    ///     Err(x) => panic!("{x:?}"),
+    ///     Ok(y) => {
+    ///         let clear: u64 = cks.decrypt(&y);
+    ///         assert_eq!(255, clear);
+    ///     }
+    /// }
+    /// ```
+    pub fn checked_neg<T>(&self, ctxt: &T) -> Result<T, CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.checked_neg(ctxt)
+    }
+
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// This function computes the opposite of a message and checks if it exceeds the
+    /// capacity of the ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let modulus = 1 << 8;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    /// let msg = 1;
+    ///
+    /// // Encrypt a message
+    /// let mut ct = cks.encrypt(msg);
+    ///
+    /// // Compute homomorphically a negation:
+    /// fpga_key.checked_neg_assign(&mut ct).unwrap();
+    ///
+    /// let clear_res: u64 = cks.decrypt(&ct);
+    /// assert_eq!(clear_res, (modulus - msg));
+    /// ```
+    pub fn checked_neg_assign<T>(&self, ctxt: &mut T) -> Result<(), CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.checked_neg_assign(ctxt)
+    }
+
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// The result is returned as a new ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg = 1u64;
+    /// let mut ctxt = cks.encrypt(msg);
+    ///
+    /// // Compute homomorphically a negation
+    /// let ct_res = fpga_key.smart_neg(&mut ctxt);
+    ///
+    /// // Decrypt
+    /// let dec: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(255, dec);
+    /// ```
+    pub fn smart_neg<T>(&self, ctxt: &mut T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if self.is_neg_possible(ctxt).is_err() {
+            self.full_propagate(ctxt);
+        }
+        self.is_neg_possible(ctxt).unwrap();
+        self.unchecked_neg(ctxt)
+    }
+
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// The result is assigned to the input ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg = 1u64;
+    ///
+    /// // Encrypt a message:
+    /// let mut ctxt = cks.encrypt(msg);
+    ///
+    /// // Compute homomorphically a negation
+    /// fpga_key.smart_neg_assign(&mut ctxt);
+    ///
+    /// // Decrypt
+    /// let dec: u64 = cks.decrypt(&ctxt);
+    /// assert_eq!(255, dec);
+    /// ```
+    pub fn smart_neg_assign<T>(&self, ctxt: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if self.is_neg_possible(ctxt).is_err() {
+            self.full_propagate(ctxt);
+        }
+        self.is_neg_possible(ctxt).unwrap();
+        self.unchecked_neg_assign(ctxt);
+    }
+
+    /// Homomorphically computes the opposite of a ciphertext encrypting an integer message.
+    ///
+    /// The result is returned as a new ciphertext.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertexts block carries are empty and clears them if it's not the
+    /// case and the operation requires it. It outputs a ciphertext whose block carries are always
+    /// empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // We have 4 * 2 = 8 bits of message
+    /// let size = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, size);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg = 1u64;
+    ///
+    /// // Encrypt a message:
+    /// let ctxt = cks.encrypt(msg);
+    ///
+    /// // Compute homomorphically a negation
+    /// let ct_res = fpga_key.neg(&ctxt);
+    ///
+    /// // Decrypt
+    /// let dec: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(255, dec);
+    /// ```
+    pub fn neg<T>(&self, ctxt: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if ctxt.block_carries_are_empty() {
+            let mut result = self.bitnot(ctxt);
+            self.scalar_add_assign(&mut result, 1);
+            result
+        } else if self.is_neg_possible(ctxt).is_ok() {
+            let mut result = self.unchecked_neg(ctxt);
+            self.full_propagate(&mut result);
+            result
+        } else {
+            let mut cleaned_ctxt = ctxt.clone();
+            self.full_propagate(&mut cleaned_ctxt);
+            self.neg(&cleaned_ctxt)
+        }
+    }
+
+    pub fn neg_simd<T>(&self, ctxt: &[T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        ctxt.iter().map(|ct| self.neg(ct)).collect()
+    }
+
+    pub fn overflowing_neg<T>(&self, ctxt: &T) -> (T, BooleanBlock)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut tmp_ctxt;
+
+        // As we want to compute the overflow we need a truly clean state
+        // And so we cannot avoid the full_propagate like we may in non overflowing_block
+        let ct = if ctxt.block_carries_are_empty() {
+            ctxt
+        } else {
+            tmp_ctxt = ctxt.clone();
+            self.full_propagate(&mut tmp_ctxt);
+            &tmp_ctxt
+        };
+
+        let mut result = self.bitnot(ct);
+        let mut overflowed = self.overflowing_scalar_add_assign(&mut result, 1);
+
+        if !T::IS_SIGNED {
+            // Computing overflow of !input + 1 only really works for signed integers
+            // However for unsigned integers we can still get the correct result as the only
+            // case where `!input + 1` overflows, is when `!input` == MAX (0b111..111) =>
+            // `input == 0`.
+            // And in unsigned integers, the only case that is not an overflow is -0,
+            // so we can just invert the result
+            self.key.key.boolean_bitnot_assign(&mut overflowed);
+        }
+
+        (result, overflowed)
+    }
+}
