+name: Benchmark on AWS F2
+
+permissions:
+  contents: "read"
+
+on:
+  workflow_dispatch:
+  # schedule:
+  #   - cron: "5 4 * * 1"
+
+env:
+  S3_BENCH_FOLDER: s3://belfort/benchmarks/tfhe-rs
+  EC2_BENCH_FOLDER: /home/ubuntu/benchmarks/tfhe-rs
+
+jobs:
+  start-runner:
+    uses: ./.github/workflows/aws-start-instance.yml
+    secrets:
+      github-token: ${{ secrets.GH_PERSONAL_ACCESS_TOKEN }}
+      aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+      aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+    with:
+      ec2-instance-type: f2.12xlarge
+
+  run-test:
+    name: Benchmark TFHE-rs on AWS F2 Instance
+    needs: start-runner # required to start the main job when the runner is ready
+    runs-on: ${{ needs.start-runner.outputs.ec2-label }} # run the job on the newly created runner
+    timeout-minutes: 300
+    steps:
+      - name: Configure AWS credentials
+        uses: aws-actions/configure-aws-credentials@00943011d9042930efac3dcd3a170e4273319bc8
+        with:
+          aws-region: ${{ vars.AWS_REGION }}
+          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+
+      - name: Install AWS CLI
+        run: sudo snap install aws-cli --classic
+
+      - name: Checkout repository
+        uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8
+        with:
+          persist-credentials: "false"
+
+      - name: Install latest stable
+        uses: dtolnay/rust-toolchain@e97e2d8cc328f1b50210efc529dca0028893a2d9
+        with:
+          toolchain: stable
+
+      - name: Cache Rust dependencies
+        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830
+        with:
+          path: |
+            ~/.cargo/registry
+            ~/.cargo/git
+            ~/.cargo/bin
+            $GITHUB_WORKSPACE/target
+          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}
+          restore-keys: |
+            ${{ runner.os }}-cargo-
+
+      - name: Setup Belfort Environment
+        run: |
+          # shellcheck source=/dev/null
+          source /tools/belfort_v*/interface/setup.sh
+          # Set the environment variables for subsequent steps
+          {
+            echo "BELFORT_HOME=$BELFORT_HOME"
+            echo "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
+            echo "BELFORT_FPGA_IDX=$BELFORT_FPGA_IDX"
+          } >> "$GITHUB_ENV"
+
+      - name: Install Rust build toolchain
+        run: make install_rs_build_toolchain
+
+      - name: Fetch previous benchmark data
+        run: |
+          aws s3 cp --recursive "$S3_BENCH_FOLDER/latest" "$EC2_BENCH_FOLDER/latest"
+          bash "$GITHUB_WORKSPACE/scripts/fpga/setup_target_benchmark.sh" "$EC2_BENCH_FOLDER"
+
+      - name: Run benchmarking
+        run: make bench_integer_fpga
+
+      - name: Store benchmark data
+        run: |
+          bash "$GITHUB_WORKSPACE/scripts/fpga/copy_benchmarks.sh" "$EC2_BENCH_FOLDER"
+          aws s3 sync "$EC2_BENCH_FOLDER" "$S3_BENCH_FOLDER"
+
+      - name: Upload reports
+        uses: actions/upload-artifact@330a01c490aca151604b8cf639adc76d48f6c5d4
+        with:
+            name: "benchmark-report"
+            path: target/*.md
+
+  stop-runner:
+    name: Stop self-hosted EC2 runner
+    needs:
+      - start-runner # required to get output from the start-runner job
+      - run-test # required to wait when the main job is done
+    if: ${{ always() }} # required to stop the runner even if the error happened in the previous jobs
+    uses: ./.github/workflows/aws-stop-instance.yml
+    secrets:
+      github-token: ${{ secrets.GH_PERSONAL_ACCESS_TOKEN }}
+      aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+      aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+    with:
+      ec2-label: ${{ needs.start-runner.outputs.ec2-label }}
+      ec2-instance-id: ${{ needs.start-runner.outputs.ec2-instance-id }}
diff --git a/.github/workflows/aws-start-instance.yml b/.github/workflows/aws-start-instance.yml
new file mode 100644
index 000000000..3cfca9d0e
--- /dev/null
+++ b/.github/workflows/aws-start-instance.yml
@@ -0,0 +1,53 @@
+permissions: {}
+
+on:
+  workflow_call:
+    secrets:
+      github-token:
+        required: true
+      aws-access-key-id:
+        required: true
+      aws-secret-access-key:
+        required: true
+    inputs:
+      ec2-instance-type:
+        type: string
+        required: true
+
+    outputs:
+      ec2-label:
+        description: "EC2 Label"
+        value: ${{ jobs.start-runner.outputs.label }}
+      ec2-instance-id:
+        description: "EC2 instance label"
+        value: ${{ jobs.start-runner.outputs.ec2-instance-id }}
+
+jobs:
+  start-runner:
+    name: Start self-hosted EC2 runner
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    outputs:
+      label: ${{ steps.start-ec2-runner.outputs.label }}
+      ec2-instance-id: ${{ steps.start-ec2-runner.outputs.ec2-instance-id }}
+    steps:
+      - name: Configure AWS credentials
+        uses: aws-actions/configure-aws-credentials@00943011d9042930efac3dcd3a170e4273319bc8
+        with:
+          aws-access-key-id: ${{ secrets.aws-access-key-id }}
+          aws-secret-access-key: ${{ secrets.aws-secret-access-key }}
+          aws-region: ${{ vars.AWS_REGION }}
+      - name: Start EC2 runner
+        id: start-ec2-runner
+        uses: machulav/ec2-github-runner@a6dbcefcf8a31a861f5e078bb153ed332130c512
+        with:
+          mode: start
+          github-token: ${{ secrets.github-token }}
+          ec2-image-id: ami-0831d81f4fb9d5aea
+          ec2-instance-type: ${{ inputs.ec2-instance-type }}
+          subnet-id: subnet-05a3e1cb35edcc3c8
+          security-group-id: sg-0ff79f2c04eab9fce
+          aws-resource-tags: > # optional, requires additional permissions
+            [
+              {"Key": "Name", "Value": "ec2-github-runner"}
+            ]
