+    }
+    pub fn mul_assign_simd<T>(&self, lhs: &mut [T], rhs: &[T])
+    where
+        T: IntegerRadixCiphertext,
+    {
+        assert_eq!(
+            lhs.len(),
+            rhs.len(),
+            "lhs and rhs must have the same length"
+        );
+
+        if lhs.is_empty() {
+            return;
+        }
+
+        let mut tmp_rhs = Vec::with_capacity(rhs.len());
+
+        for (lhs_elem, rhs_elem) in lhs.iter_mut().zip(rhs.iter()) {
+            let rhs_ct = match (
+                lhs_elem.block_carries_are_empty(),
+                rhs_elem.block_carries_are_empty(),
+            ) {
+                (true, true) => rhs_elem.clone(),
+                (true, false) => {
+                    let mut tmp = rhs_elem.clone();
+                    self.full_propagate(&mut tmp);
+                    tmp
+                }
+                (false, true) => {
+                    self.full_propagate(lhs_elem);
+                    rhs_elem.clone()
+                }
+                (false, false) => {
+                    let mut tmp = rhs_elem.clone();
+                    self.full_propagate(lhs_elem);
+                    self.full_propagate(&mut tmp);
+                    tmp
+                }
+            };
+            tmp_rhs.push(rhs_ct);
+        }
+
+        self.unchecked_mul_assign_simd(lhs, &tmp_rhs);
+    }
+
+    pub fn smart_mul_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<T>
+    where
