+use std::hint::black_box;
+
+use criterion::Criterion;
+use tfhe::composites::aes::constants::{AES_128_KEY_SIZE, AES_BLOCK_SIZE};
+use tfhe::composites::aes::FheAes;
+use tfhe::integer::fpga::BelfortServerKey;
+use tfhe::set_server_key;
+use tfhe::shortint::prelude::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+
+pub const BLOCKS: [[u8; AES_BLOCK_SIZE]; 16] = [
+    0x0001_0203_0405_0607_0809_0a0b_0c0d_0e0f_u128.to_be_bytes(),
