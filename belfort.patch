-  cuda_set_device(streams.gpu_index(0));
-  fill_radix_from_lsb_msb<Torus, params>
-      <<<num_blocks * num_blocks, params::degree / params::opt, 0,
-         streams.stream(0)>>>(
-          (Torus *)vector_result_sb->ptr, (Torus *)vector_result_lsb->ptr,
