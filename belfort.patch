+            shortint_key.generate_lookup_vector_bivariate(&|x, y| u64::from(x != y));
+        self.apply_same_lookup_vector_packed_assign(&mut all_prepared, &lut_not_equal_to);
+
+        let results = self.is_at_least_one_comparisons_block_true_simd(
