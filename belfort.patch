+pub(crate) fn default_mul_simd_test<P, T>(param: P, mut executor: T)
+where
+    P: Into<TestParameters>,
+    T: for<'a> FunctionExecutor<
+        (&'a mut [RadixCiphertext], &'a mut [RadixCiphertext]),
+        Vec<RadixCiphertext>,
+    >,
+{
+    let param = param.into();
+    let nb_tests_smaller = nb_tests_smaller_for_params(param);
+    let (cks, mut sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let cks = RadixClientKey::from((cks, NB_CTXT));
+
+    sks.set_deterministic_pbs_execution(true);
+    let sks = Arc::new(sks);
+
+    let mut rng = rand::thread_rng();
+    executor.setup(&cks, sks.clone());
+    for num_blocks in 2..(NB_CTXT + 1) {
+        let modulus = unsigned_modulus(cks.parameters().message_modulus(), num_blocks as u32);
+
+        let clear_0 = (0..SIMD_LEN)
+            .map(|_| rng.gen::<u64>() % modulus)
+            .collect::<Vec<_>>();
+        let clear_1 = (0..SIMD_LEN)
+            .map(|_| rng.gen::<u64>() % modulus)
+            .collect::<Vec<_>>();
+
+        let ctxt_0 = clear_0
+            .iter()
+            .map(|&clear| cks.as_ref().encrypt_radix(clear, num_blocks))
+            .collect::<Vec<_>>();
+        let ctxt_1 = clear_1
+            .iter()
+            .map(|&clear| cks.as_ref().encrypt_radix(clear, num_blocks))
+            .collect::<Vec<_>>();
+
+        let ct_res = executor.execute((&mut ctxt_0.clone(), &mut ctxt_1.clone()));
+        let tmp_ct = executor.execute((&mut ctxt_0.clone(), &mut ctxt_1.clone()));
+
+        for ((i, ct), tmp) in ct_res.iter().enumerate().zip(tmp_ct.iter()) {
+            assert_eq!(
+                ct, tmp,
+                "Failed determinism check at index {i}, msg0: {}, msg1: {}",
+                clear_0[i], clear_1[i]
+            );
+
+            let decrypted_result: u64 = cks.decrypt(ct);
+            let expected_result = clear_0[i].wrapping_mul(clear_1[i]) % modulus;
+
+            assert_eq!(
+                    decrypted_result, expected_result,
+                    "Invalid result for mul_simd at index {i}, for ({} * {}) % {} expected {expected_result}, got {decrypted_result}",
+                    clear_0[i], clear_1[i], modulus
+                );
+        }
+
+        for _ in 0..nb_tests_smaller {
+            let clear_2 = random_non_zero_value_simd(&mut rng, modulus, SIMD_LEN);
+            let clear_3 = random_non_zero_value_simd(&mut rng, modulus, SIMD_LEN);
+
+            let mut clear_lhs = Vec::with_capacity(SIMD_LEN);
+            let mut clear_rhs = Vec::with_capacity(SIMD_LEN);
+            let mut ctxt_0_non_clean = Vec::with_capacity(SIMD_LEN);
+            let mut ctxt_1_non_clean = Vec::with_capacity(SIMD_LEN);
+
+            for i in 0..SIMD_LEN {
+                let ctxt_res_0 = sks.unchecked_scalar_add(&ctxt_0[i], clear_2[i]);
+                let ctxt_res_1 = sks.unchecked_scalar_add(&ctxt_1[i], clear_3[i]);
+
+                clear_lhs.push((clear_0[i] + clear_2[i]) % modulus);
+                clear_rhs.push((clear_1[i] + clear_3[i]) % modulus);
+
+                ctxt_0_non_clean.push(ctxt_res_0);
+                ctxt_1_non_clean.push(ctxt_res_1);
+            }
+
+            let ct_res = executor.execute((&mut ctxt_0_non_clean, &mut ctxt_1_non_clean));
+
+            for (i, ct) in ct_res.iter().enumerate() {
+                let decrypted_result: u64 = cks.decrypt(ct);
+                let expected_result = clear_lhs[i].wrapping_mul(clear_rhs[i]) % modulus;
+
+                assert_eq!(
+                    decrypted_result, expected_result,
+                    "Invalid result for mul_simd"
+                );
+            }
+        }
+    }
+}
