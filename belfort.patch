+            .collect::<Vec<_>>();
+
+        let (ct_res, result_overflowed) =
+            executor.execute((&mut ctxt_0.clone(), &mut ctxt_1.clone()));
+        let (tmp_ct, tmp_o) = executor.execute((&mut ctxt_0.clone(), &mut ctxt_1.clone()));
+
+        let clear_iter = clear_0.iter().zip(clear_1.iter());
+        let res_iter = ct_res.into_iter().zip(result_overflowed.into_iter());
+        let tmp_iter = tmp_ct.into_iter().zip(tmp_o.into_iter());
+
+        clear_iter.zip(res_iter).zip(tmp_iter).for_each(
