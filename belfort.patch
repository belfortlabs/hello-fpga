--- /dev/null
+++ b/tfhe/src/high_level_api/composites/aes/engine/field_arithmetic.rs
@@ -0,0 +1,817 @@
+use std::iter::repeat_n;
+
+use crate::composites::aes::constants::AES_BLOCK_SIZE;
+use crate::composites::aes::utils::{
+    interleave_chunks_of_two, interleave_low_high, repeat_each, repeat_lut, repeat_luts_cycled,
+    split_by_chunk_sizes, split_chunks_even_odd,
+};
+use crate::core_crypto::fpga::lookup_vector::LookupVector;
+use crate::high_level_api::composites::aes::lookup::FheAesLookup;
+use crate::integer::fpga::BelfortServerKey;
+use crate::shortint::Ciphertext;
+
+pub(crate) struct FheAesFieldArithmetic<'a> {
+    fpga_key: &'a BelfortServerKey,
+    lookup: FheAesLookup<'a>,
+}
+
+impl<'a> FheAesFieldArithmetic<'a> {
+    pub(crate) fn new(fpga_key: &'a BelfortServerKey) -> Self {
+        let lookup = FheAesLookup::new(fpga_key);
+        Self { fpga_key, lookup }
+    }
+
+    /// Applies the algebraic isomorphism transformation required for the tower
+    /// field decomposition.
+    ///
+    /// # Arguments
+    /// - `inputs` – Vector of ciphertexts representing input bits.
+    /// - `base` – Vector of lookup tables that define the algebraic isomorphism.
+    ///
+    /// # Note
+    /// Modifies the state in place.
+    pub(crate) fn apply_isomorphism(&self, inputs: &mut Vec<Ciphertext>, base: &[LookupVector]) {
+        let lookup = repeat_luts_cycled(base, inputs.len() / base.len());
+        let lookup = lookup.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(inputs, &lookup);
+
+        let (even_chunks, odd_chunks) = split_chunks_even_odd(inputs, 4);
+
+        *inputs = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&odd_chunks, &even_chunks);
+
+        self.fpga_key
+            .apply_same_lookup_vector_packed_assign(inputs, &self.fpga_key.lut_bitxor());
+    }
+
+    /// Multiplies one operand pair (x, y) in GF(2⁴).
+    ///
+    /// # Arguments
+    /// - `pair`: A two-element `[Vec<Ciphertext>]` containing the operands.
+    ///
+    /// # Returns
+    /// The product `x * y`, as a `Vec<Ciphertext>` of 32 blocks (2 blocks per byte).
+    pub(crate) fn gf2_4_mul_single(&self, pair: &[Vec<Ciphertext>]) -> Vec<Ciphertext> {
+        let (x, y) = (&pair[0], &pair[1]);
+        let (x_before_transf, y_before_transf) = (
+            self.fpga_key.split_and_pack(x, 1),
+            self.fpga_key.split_and_pack(y, 1),
+        );
+
+        let x_and_y_blocks_len = x_before_transf.len() + y_before_transf.len();
+        // Perform transformations on x and y individually, and also perform transformations
+        // on x and y followed by computing their bitwise XOR in GF(2^2) as a batch, using
+        // separate lookup tables for each.
+        let mut xor_and_fwd_stage = [
+            &x_before_transf[..],
+            &y_before_transf[..],
+            &repeat_each(&x_before_transf, 2)[..],
+            &repeat_each(&y_before_transf, 2)[..],
+        ]
+        .concat();
+
+        let xor_luts = [
+            repeat_lut(self.lookup.bitxor_with_fwd_transf(), x_and_y_blocks_len),
+            repeat_luts_cycled(
+                &[self.lookup.fwd_lo(), self.lookup.fwd_hi()],
+                x_and_y_blocks_len,
+            ),
+        ]
+        .concat();
+
+        let xor_luts = xor_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut xor_and_fwd_stage, &xor_luts);
+
+        let parts = split_by_chunk_sizes(
+            &xor_and_fwd_stage,
+            &[
+                x_before_transf.len(),
+                y_before_transf.len(),
+                2 * x_before_transf.len(),
+                2 * y_before_transf.len(),
+            ],
+        );
+        let [x0_xor_x1, y0_xor_y1, x0_and_x1, y0_and_y1] = <[_; 4]>::try_from(parts).unwrap();
+
+        // Compute the required GF(2^2) multiplications.
+        let (x0, x1) = split_chunks_even_odd(&x0_and_x1, 1);
+        let (y0, y1) = split_chunks_even_odd(&y0_and_y1, 1);
+
+        let mut mul_stage = [
+            &self
+                .fpga_key
+                .prepare_block_vecs_bivariate(&y0_xor_y1, &x0_xor_x1)[..],
+            &self.fpga_key.prepare_block_vecs_bivariate(&y0, &x0)[..],
+            &self.fpga_key.prepare_block_vecs_bivariate(&y1, &x1)[..],
+        ]
+        .concat();
+
+        let mul_luts = [
+            &repeat_lut(self.lookup.gf2_mul(), x0_xor_x1.len() + x0.len())[..],
+            &repeat_lut(self.lookup.gf2_mul_phi(), x1.len())[..],
+        ]
+        .concat();
+
+        let mul_luts = mul_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut mul_stage, &mul_luts);
+
+        let parts = split_by_chunk_sizes(&mul_stage, &[x0_xor_x1.len(), x0.len(), x1.len()]);
+        let [xy_xor_mul, x0y0_mul, x1y1_phi_mul] = <[_; 3]>::try_from(parts).unwrap();
+
+        // XOR the required products.
+        let hi2 = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&x0y0_mul, &xy_xor_mul);
+        let lo2 = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&x0y0_mul, &x1y1_phi_mul);
+        let mut in_blocks = interleave_low_high(&lo2, &hi2);
+
+        self.fpga_key
+            .apply_same_lookup_vector_packed_assign(&mut in_blocks, &self.fpga_key.lut_bitxor());
+
+        // Transform the results back into GF(2^4).
+        let (lower, upper) = split_chunks_even_odd(&in_blocks, 1);
+        let packed = self.fpga_key.prepare_block_vecs_bivariate(&upper, &lower);
+        let mut duplicated = repeat_each(&packed, 2);
+
+        let inv_luts =
+            repeat_luts_cycled(&[self.lookup.inv_lo(), self.lookup.inv_hi()], lower.len());
+
+        let inv_luts = inv_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut duplicated, &inv_luts);
+
+        duplicated
+    }
+
+    /// Multiplies two independent operand pairs (s, t) and (p, r) in GF(2^4).
+    ///
+    /// # Arguments
+    /// - `first` – A two-element `[Vec<Ciphertext>]` containing the first operand pair
+    /// - `second` – A two-element `[Vec<Ciphertext>]` containing the second operand pair
+    ///
+    /// # Returns
+    /// `(s * t) || (p * r)`, as a `Vec<Ciphertext>` of 64 blocks (2 blocks per byte and
+    /// multiplication).
+    pub(crate) fn gf2_4_mul_double(
+        &self,
+        first: &[Vec<Ciphertext>],
+        second: &[Vec<Ciphertext>],
+    ) -> Vec<Ciphertext> {
+        let (s, t) = (&first[0], &first[1]);
+        let (p, r) = (&second[0], &second[1]);
+
+        let (s_before_transf, t_before_transf, p_before_transf, r_before_transf) = (
+            self.fpga_key.split_and_pack(s, 1),
+            self.fpga_key.split_and_pack(t, 1),
+            self.fpga_key.split_and_pack(p, 1),
+            self.fpga_key.split_and_pack(r, 1),
+        );
+
+        // Perform transformations on each pair individually, and also perform transformations
+        // on the pairs followed by computing their bitwise XOR in GF(2^2) as a batch, using
+        // separate lookup tables for each.
+        let mut xor_and_fwd_stage = [
+            &s_before_transf[..],
+            &t_before_transf[..],
+            &p_before_transf[..],
+            &r_before_transf[..],
+            &repeat_each(&s_before_transf, 2)[..],
+            &repeat_each(&t_before_transf, 2)[..],
+            &repeat_each(&p_before_transf, 2)[..],
+            &repeat_each(&r_before_transf, 2)[..],
+        ]
+        .concat();
+
+        let s_t_p_r_len = s_before_transf.len()
+            + t_before_transf.len()
+            + p_before_transf.len()
+            + r_before_transf.len();
+        let xor_luts = [
+            &repeat_lut(self.lookup.bitxor_with_fwd_transf(), s_t_p_r_len)[..],
+            &repeat_luts_cycled(&[self.lookup.fwd_lo(), self.lookup.fwd_hi()], s_t_p_r_len),
+        ]
+        .concat();
+
+        let xor_luts = xor_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut xor_and_fwd_stage, &xor_luts);
+
+        let parts = split_by_chunk_sizes(
+            &xor_and_fwd_stage,
+            &[
+                s_before_transf.len(),
+                t_before_transf.len(),
+                p_before_transf.len(),
+                r_before_transf.len(),
+                2 * s_before_transf.len(),
+                2 * t_before_transf.len(),
+                2 * p_before_transf.len(),
+                2 * r_before_transf.len(),
+            ],
+        );
+        let [s_xor_s1, t_xor_t1, p_xor_p1, r_xor_r1, s_and_s1, t_and_t1, p_and_p1, r_and_r1] =
+            <[_; 8]>::try_from(parts).unwrap();
+
+        let (s0, s1) = split_chunks_even_odd(&s_and_s1, 1);
+        let (t0, t1) = split_chunks_even_odd(&t_and_t1, 1);
+        let (p0, p1) = split_chunks_even_odd(&p_and_p1, 1);
+        let (r0, r1) = split_chunks_even_odd(&r_and_r1, 1);
+
+        // Compute the required GF(2^2) multiplications for each pair.
+        let mut mul_stage = [
+            &self
+                .fpga_key
+                .prepare_block_vecs_bivariate(&t_xor_t1, &s_xor_s1)[..],
+            &self.fpga_key.prepare_block_vecs_bivariate(&t0, &s0)[..],
+            &self.fpga_key.prepare_block_vecs_bivariate(&t1, &s1)[..],
+            &self
+                .fpga_key
+                .prepare_block_vecs_bivariate(&r_xor_r1, &p_xor_p1)[..],
+            &self.fpga_key.prepare_block_vecs_bivariate(&r0, &p0)[..],
+            &self.fpga_key.prepare_block_vecs_bivariate(&r1, &p1)[..],
+        ]
+        .concat();
+
+        // Duplicate LUT pack for both pairs.
+        let mul_luts = repeat_luts_cycled(
+            &[
+                &repeat_lut(self.lookup.gf2_mul(), s_xor_s1.len() + s0.len())[..],
+                &repeat_lut(self.lookup.gf2_mul_phi(), s1.len())[..],
+            ]
+            .concat(),
+            2,
+        );
+
+        let mul_luts = mul_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut mul_stage, &mul_luts);
+
+        let parts_mul = split_by_chunk_sizes(
+            &mul_stage,
+            &[
+                s_xor_s1.len(),
+                s0.len(),
+                s1.len(),
+                p_xor_p1.len(),
+                p0.len(),
+                r1.len(),
+            ],
+        );
+
+        let [st_xor_mul, s0t0_mul, s1t1_phi_mul, pr_xor_mul, p0r0_mul, p1r1_phi_mul] =
+            <[_; 6]>::try_from(parts_mul).unwrap();
+
+        // XOR the required products for both pairs.
+        let st_hi2 = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&s0t0_mul, &st_xor_mul);
+        let st_lo2 = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&s0t0_mul, &s1t1_phi_mul);
+        let pr_hi2 = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&p0r0_mul, &pr_xor_mul);
+        let pr_lo2 = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&p0r0_mul, &p1r1_phi_mul);
+
+        let st_mul = interleave_low_high(&st_lo2, &st_hi2);
+        let pr_mul = interleave_low_high(&pr_lo2, &pr_hi2);
+
+        let mut combined = [&st_mul[..], &pr_mul[..]].concat();
+        self.fpga_key
+            .apply_same_lookup_vector_packed_assign(&mut combined, &self.fpga_key.lut_bitxor());
+
+        // Transform the results back into GF(2^4).
+        let (st_blocks, pr_blocks) = combined.split_at(st_mul.len());
+        let (st_lower, st_upper) = split_chunks_even_odd(st_blocks, 1);
+        let (pr_lower, pr_upper) = split_chunks_even_odd(pr_blocks, 1);
+
+        let mut inv_stage = [
+            &repeat_each(
+                &self
+                    .fpga_key
+                    .prepare_block_vecs_bivariate(&st_upper, &st_lower),
+                2,
+            )[..],
+            &repeat_each(
+                &self
+                    .fpga_key
+                    .prepare_block_vecs_bivariate(&pr_upper, &pr_lower),
+                2,
+            )[..],
+        ]
+        .concat();
+
+        let inv_luts = repeat_luts_cycled(
+            &[self.lookup.inv_lo(), self.lookup.inv_hi()],
+            st_lower.len() + pr_lower.len(),
+        );
+
+        let inv_luts = inv_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut inv_stage, &inv_luts);
+        inv_stage
+    }
+
+    /// Wrapper which does multiplication in GF(2^4) after choosing single or double path based on
+    /// input shape.
+    ///
+    /// # Arguments
+    /// - `input` – An array of vector(s) of operand pairs.
+    ///
+    /// # Returns
+    /// The multiplication result as a `Vec<Ciphertext>` of 32 or 64 blocks based on input shape.
+    ///
+    /// # Panics
+    /// Panics if the number of operand pairs is not 1 or 2.
+    pub(crate) fn gf2_4_mul(&self, inputs: &mut [Vec<Vec<Ciphertext>>]) -> Vec<Ciphertext> {
+        match inputs {
+            [pair] => self.gf2_4_mul_single(pair),
+            [first, second] => self.gf2_4_mul_double(first, second),
+            _ => panic!(
+                "gf2_4_mul expects 1 or 2 operand pairs, got {}",
+                inputs.len()
+            ),
+        }
+    }
+
+    pub(crate) fn gf2_8_mul2_from_bitblocks(
+        &self,
+        all_bit_combinations: &[Vec<Ciphertext>],
+    ) -> Vec<Vec<Ciphertext>> {
+        let shortint_key = &self.fpga_key.key.key.key;
+
+        let lut_flush = self.lookup.lut_flush();
+        let lut_upper_flush = self.lookup.lut_upper_flush();
+
+        let msbs = all_bit_combinations
+            .chunks(4)
+            .map(|chunk| chunk[3][1].clone())
+            .collect::<Vec<_>>();
+
+        let mut base_0a0b_groups_for_mul_2 = all_bit_combinations
+            .chunks(4)
+            .map(|chunk| {
+                vec![
+                    chunk[3][3].clone(),
+                    chunk[0][2].clone(),
+                    chunk[0][3].clone(),
+                    chunk[1][2].clone(),
+                    chunk[1][3].clone(),
+                    chunk[2][2].clone(),
+                    chunk[2][3].clone(),
+                    chunk[3][2].clone(),
+                ]
+            })
+            .collect::<Vec<_>>();
+
+        let mut to_flush = Vec::with_capacity(16 * 3);
+
+        for (msb_shifted, byte) in msbs.into_iter().zip(base_0a0b_groups_for_mul_2.iter_mut()) {
+            let [msb, b1, _b2, b3, b4, _b5, _b6, _b7] = &mut byte[..] else {
+                unreachable!()
+            };
+
+            shortint_key.unchecked_add_assign(b1, &msb_shifted);
+            shortint_key.unchecked_add_assign(b3, &msb_shifted);
+            shortint_key.unchecked_add_assign(b4, msb);
+
+            to_flush.push(b1);
+            to_flush.push(b3);
+            to_flush.push(b4);
+        }
+
+        let luts = repeat_n([&lut_upper_flush, &lut_upper_flush, &lut_flush], 16)
+            .flatten()
+            .collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_mut_packed_assign(&mut to_flush, &luts);
+
+        let bytes_mul_by_2 = base_0a0b_groups_for_mul_2
+            .into_iter()
+            .map(|byte| {
+                byte.chunks(2)
+                    .map(|pair| shortint_key.unchecked_add(&pair[0], &pair[1]))
+                    .collect::<Vec<_>>()
+            })
+            .collect::<Vec<_>>();
+
+        bytes_mul_by_2
+    }
+
+    pub(crate) fn gf2_8_prepare_mul_2_4_8_from_bitblocks(
+        &self,
+        base_0a0b_groups: &[&[Ciphertext]],
+        all_bit_combinations: &[Vec<Ciphertext>],
+    ) -> [Vec<Vec<Ciphertext>>; 3] {
+        let shortint_key = &self.fpga_key.key.key.key;
+
+        let lut_flush = self.lookup.lut_flush();
+        let lut_upper_flush = self.lookup.lut_upper_flush();
+        let lut_both_flush = self.lookup.lut_both_flush();
+
+        let base_0a00 = all_bit_combinations
+            .iter()
+            .map(|outs| outs[1].clone())
+            .collect::<Vec<_>>();
+
+        let base_0b00 = all_bit_combinations
+            .iter()
+            .map(|outs| outs[2].clone())
+            .collect::<Vec<_>>();
+
+        let base_000a = all_bit_combinations
+            .iter()
+            .map(|outs| outs[3].clone())
+            .collect::<Vec<_>>();
+
+        let base_0a00_groups = base_0a00
+            .chunks(4)
+            .map(|chunk| chunk.to_vec())
+            .collect::<Vec<_>>();
+
+        let base_0b00_groups = base_0b00
+            .chunks(4)
+            .map(|chunk| chunk.to_vec())
+            .collect::<Vec<_>>();
+
+        let base_000a_groups = base_000a
+            .chunks(4)
+            .map(|chunk| chunk.to_vec())
+            .collect::<Vec<_>>();
+
+        let mut for_mul_2 = all_bit_combinations
+            .chunks(4)
+            .map(|chunk| {
+                vec![
+                    chunk[3][3].clone(),
+                    chunk[0][2].clone(),
+                    chunk[0][3].clone(),
+                    chunk[1][2].clone(),
+                    chunk[1][3].clone(),
+                    chunk[2][2].clone(),
+                    chunk[2][3].clone(),
+                    chunk[3][2].clone(),
+                ]
+            })
+            .collect::<Vec<_>>();
+
+        let mut for_mul_4 = all_bit_combinations
+            .chunks(4)
+            .map(|chunk| {
+                vec![
+                    chunk[3][0].clone(),
+                    chunk[0][0].clone(),
+                    chunk[1][0].clone(),
+                    chunk[2][0].clone(),
+                ]
+            })
+            .collect::<Vec<_>>();
+
+        let mut for_mul_8 = all_bit_combinations
+            .chunks(4)
+            .map(|chunk| {
+                vec![
+                    chunk[2][3].clone(),
+                    chunk[3][2].clone(),
+                    chunk[3][3].clone(),
+                    chunk[0][2].clone(),
+                    chunk[0][3].clone(),
+                    chunk[1][2].clone(),
+                    chunk[1][3].clone(),
+                    chunk[2][2].clone(),
+                ]
+            })
+            .collect::<Vec<_>>();
+
+        let mut to_flush = Vec::with_capacity(AES_BLOCK_SIZE * 12);
+
+        for (i, byte) in for_mul_2.iter_mut().enumerate() {
+            let [b0, b1, _b2, b3, b4, _b5, _b6, _b7] = &mut byte[..] else {
+                unreachable!()
+            };
+
+            shortint_key.unchecked_add_assign(b1, &base_0a00_groups[i][3]);
+            shortint_key.unchecked_add_assign(b3, &base_0a00_groups[i][3]);
+            shortint_key.unchecked_add_assign(b4, b0);
+
+            to_flush.push(b1);
+            to_flush.push(b3);
+            to_flush.push(b4);
+        }
+
+        for (i, byte) in for_mul_4.iter_mut().enumerate() {
+            let [b0, b1, b2, _b3] = &mut byte[..] else {
+                unreachable!()
+            };
+
+            shortint_key.unchecked_add_assign(b2, b0);
+            shortint_key.unchecked_add_assign(b2, &base_000a_groups[i][3]);
+            shortint_key.unchecked_add_assign(b1, &base_0b00_groups[i][3]);
+            shortint_key.unchecked_add_assign(b1, &base_000a_groups[i][3]);
+            shortint_key.unchecked_add_assign(b0, &base_0b00_groups[i][3]);
+
+            to_flush.push(b0);
+            to_flush.push(b1);
+            to_flush.push(b2);
+        }
+
+        for (i, byte) in for_mul_8.iter_mut().enumerate() {
+            let [b0, b1, b2, b3, b4, b5, b6, _b7] = &mut byte[..] else {
+                unreachable!()
+            };
+
+            shortint_key.unchecked_add_assign(b1, &base_0a00_groups[i][2]);
+            shortint_key.unchecked_add_assign(b2, &base_0a0b_groups[i][3]);
+            shortint_key.unchecked_add_assign(b3, &base_0a00_groups[i][2]);
+            shortint_key.unchecked_add_assign(b3, &base_0a00_groups[i][3]);
+            shortint_key.unchecked_add_assign(b4, b0);
+            shortint_key.unchecked_add_assign(b4, &base_0a0b_groups[i][3]);
+            shortint_key.unchecked_add_assign(b5, &base_0b00_groups[i][3]);
+            shortint_key.unchecked_add_assign(b5, &base_0a00_groups[i][3]);
+            shortint_key.unchecked_add_assign(b6, &base_000a_groups[i][3]);
+
+            to_flush.push(b1);
+            to_flush.push(b2);
+            to_flush.push(b3);
+            to_flush.push(b4);
+            to_flush.push(b5);
+            to_flush.push(b6);
+        }
+
+        let mut all_luts = Vec::with_capacity(16 * 12);
+
+        let luts2 = repeat_n([&lut_upper_flush, &lut_upper_flush, &lut_flush], 16)
+            .flatten()
+            .collect::<Vec<_>>();
+
+        let luts4 = repeat_n([&lut_both_flush, &lut_both_flush, &lut_both_flush], 16)
+            .flatten()
+            .collect::<Vec<_>>();
+
+        let luts8 = repeat_n(
+            [
+                &lut_upper_flush,
+                &lut_flush,
+                &lut_upper_flush,
+                &lut_flush,
+                &lut_upper_flush,
+                &lut_flush,
+            ],
+            16,
+        )
+        .flatten()
+        .collect::<Vec<_>>();
+
+        all_luts.extend(luts2);
+        all_luts.extend(luts4);
+        all_luts.extend(luts8);
+
+        self.fpga_key
+            .apply_lookup_vector_mut_packed_assign(&mut to_flush, &all_luts);
+
+        let bytes_mul_by_2 = for_mul_2
+            .into_iter()
+            .map(|byte| {
+                byte.chunks(2)
+                    .map(|pair| shortint_key.unchecked_add(&pair[0], &pair[1]))
+                    .collect::<Vec<_>>()
+            })
+            .collect::<Vec<_>>();
+
+        let bytes_mul_by_8 = for_mul_8
+            .into_iter()
+            .map(|byte| {
+                byte.chunks(2)
+                    .map(|pair| shortint_key.unchecked_add(&pair[0], &pair[1]))
+                    .collect::<Vec<_>>()
+            })
+            .collect::<Vec<_>>();
+
+        [bytes_mul_by_2, for_mul_4, bytes_mul_by_8]
+    }
+
+    pub(crate) fn gf2_8_compose_9_11_13_14(
+        &self,
+        base_0a0b_groups: &[&[Ciphertext]],
+        bytes_mul_by_2: &[Vec<Ciphertext>],
+        bytes_mul_by_4: &[Vec<Ciphertext>],
+        bytes_mul_by_8: &[Vec<Ciphertext>],
+    ) -> [Vec<Vec<Ciphertext>>; 4] {
+        let lut_both_flush = self.lookup.lut_both_flush();
+
+        let blocks_per_byte = 4;
+
+        let mut bytes_mul_by_9 = bytes_mul_by_8.to_owned();
+        for i in 0..AES_BLOCK_SIZE {
+            self.fpga_key
+                .byte_xor_packed(&mut bytes_mul_by_9[i], base_0a0b_groups[i]);
+        }
+        let mut bytes_mul_by_6 = bytes_mul_by_4.to_owned();
+        for i in 0..AES_BLOCK_SIZE {
+            self.fpga_key
+                .byte_xor_packed(&mut bytes_mul_by_6[i], &bytes_mul_by_2[i]);
+        }
+        let mut bytes_mul_by_11 = bytes_mul_by_9.clone();
+        for i in 0..AES_BLOCK_SIZE {
+            self.fpga_key
+                .byte_xor_packed(&mut bytes_mul_by_11[i], &bytes_mul_by_2[i]);
+        }
+        let mut bytes_mul_by_13 = bytes_mul_by_9.clone();
+        for i in 0..AES_BLOCK_SIZE {
+            self.fpga_key
+                .byte_xor_packed(&mut bytes_mul_by_13[i], &bytes_mul_by_4[i]);
+        }
+        let mut bytes_mul_by_14 = bytes_mul_by_6.clone();
+        for i in 0..AES_BLOCK_SIZE {
+            self.fpga_key
+                .byte_xor_packed(&mut bytes_mul_by_14[i], &bytes_mul_by_8[i]);
+        }
+
+        let total_len = (bytes_mul_by_9.len()
+            + bytes_mul_by_11.len()
+            + bytes_mul_by_13.len()
+            + bytes_mul_by_14.len())
+            * blocks_per_byte;
+        let mut flat: Vec<Ciphertext> = Vec::with_capacity(total_len);
+
+        for v in &mut bytes_mul_by_9 {
+            flat.append(v);
+        }
+        for v in &mut bytes_mul_by_11 {
+            flat.append(v);
+        }
+        for v in &mut bytes_mul_by_13 {
+            flat.append(v);
+        }
+        for v in &mut bytes_mul_by_14 {
+            flat.append(v);
+        }
+        self.fpga_key
+            .apply_same_lookup_vector_packed_assign(&mut flat, &lut_both_flush);
+        let mut it = flat.into_iter();
+        for v in &mut bytes_mul_by_9 {
+            *v = it.by_ref().take(blocks_per_byte).collect::<Vec<_>>();
+        }
+        for v in &mut bytes_mul_by_11 {
+            *v = it.by_ref().take(blocks_per_byte).collect::<Vec<_>>();
+        }
+        for v in &mut bytes_mul_by_13 {
+            *v = it.by_ref().take(blocks_per_byte).collect::<Vec<_>>();
+        }
+        for v in &mut bytes_mul_by_14 {
+            *v = it.by_ref().take(blocks_per_byte).collect::<Vec<_>>();
+        }
+
+        [
+            bytes_mul_by_9,
+            bytes_mul_by_11,
+            bytes_mul_by_13,
+            bytes_mul_by_14,
+        ]
+    }
+
+    /// Computes two independent results for each byte in a single batched lookup:
+    /// 1. Blockwise bitwise XOR of `a₀` and `a₁`
+    /// 2. λ(a₁)²
+    ///
+    /// # Arguments
+    /// - `a0_in_blocks` – Vector of ciphertext blocks encoding a₀.
+    /// - `a1_in_blocks` – Vector of ciphertext blocks encoding a₁.
+    ///
+    /// # Returns
+    /// `(a₀ ⊕ a₁, λ(a₁)²)`, for each byte where each as a `Vec<Ciphertext>`
+    /// of 32 blocks (2 blocks per byte).
+    pub(crate) fn compute_xor_and_lambda_sq(
+        &self,
+        a0_in_blocks: &[Ciphertext],
+        a1_in_blocks: &[Ciphertext],
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let a0_and_a1_packed = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(a1_in_blocks, a0_in_blocks);
+
+        let a1_packed = self.fpga_key.split_and_pack(a1_in_blocks, 1);
+
+        let mut cts_xor_and_lambda_sq =
+            [&a0_and_a1_packed[..], &repeat_each(&a1_packed, 2)[..]].concat();
+
+        let luts_xor_and_lambda_sq = [
+            &repeat_lut(self.fpga_key.lut_bitxor(), a0_and_a1_packed.len())[..],
+            &repeat_luts_cycled(
+                &[self.lookup.lambda_sq_lo2(), self.lookup.lambda_sq_hi2()],
+                a1_packed.len(),
+            )[..],
+        ]
+        .concat();
+
+        let luts_xor_and_lambda_sq = luts_xor_and_lambda_sq.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut cts_xor_and_lambda_sq, &luts_xor_and_lambda_sq);
+
+        let (a0_xor_a1_in_blocks, lambda_sq_a1_in_blocks) =
+            cts_xor_and_lambda_sq.split_at(a0_and_a1_packed.len());
+
+        (
+            a0_xor_a1_in_blocks.to_vec(),
+            lambda_sq_a1_in_blocks.to_vec(),
+        )
+    }
+
+    /// Computes Δ⁻¹, the multiplicative inverse of  `Δ = a₀ · (a₀ ⊕ a₁) ⊕ λ(a₁)²` in GF(2⁴)
+    /// for each byte within the state.
+    ///
+    /// # Arguments
+    /// - `a0_in_blocks` – Vector of ciphertext blocks encoding a₀ values.
+    /// - `a0_xor_a1_in_blocks` — Vector of ciphertext blocks encoding a₀ ⊕ a₁ values.
+    /// - `lambda_sq_a1_in_blocks`— Vector of ciphertext blocks encoding λ(a₁)² values.
+    ///
+    /// # Returns
+    /// `Δ⁻¹` for each byte as a `Vec<Ciphertext>` of 32 blocks (2 blocks per byte).
+    pub(crate) fn compute_delta_inv(
+        &self,
+        a0_in_blocks: &[Ciphertext],
+        a0_xor_a1_in_blocks: &[Ciphertext],
+        lambda_sq_a1_in_blocks: &[Ciphertext],
+    ) -> Vec<Ciphertext> {
+        let mut inputs = [vec![a0_in_blocks.to_vec(), a0_xor_a1_in_blocks.to_vec()]];
+        let a0_mul_a0xor_a1 = self.gf2_4_mul(&mut inputs);
+
+        let mut delta_in_blocks = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(lambda_sq_a1_in_blocks, &a0_mul_a0xor_a1);
+        self.fpga_key.apply_same_lookup_vector_packed_assign(
+            &mut delta_in_blocks,
+            &self.fpga_key.lut_bitxor(),
+        );
+
+        let (delta_lo2, delta_hi2) = split_chunks_even_odd(&delta_in_blocks, 1);
+        let delta_packed = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&delta_hi2, &delta_lo2);
+
+        let mut delta_inv_in_blocks = repeat_each(&delta_packed, 2);
+
+        let luts_delta_inv = repeat_luts_cycled(
+            &[self.lookup.delta_inv_lo2(), self.lookup.delta_inv_hi2()],
+            delta_lo2.len(),
+        );
+
+        let luts_delta_inv = luts_delta_inv.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut delta_inv_in_blocks, &luts_delta_inv);
+
+        delta_inv_in_blocks
+    }
+
+    /// Computes the s-box substitute of each byte in the state using
+    /// tower field construction.
+    ///
+    /// # Arguments
+    /// - `state_in_blocks` – Vector of ciphertext blocks containing the flattened state.
+    ///
+    /// # Returns
+    /// `state⁻¹` as a `Vec<Ciphertext>` in the same layout.
+    pub(crate) fn compute_substitute_in_tower_field(
+        &self,
+        state_in_blocks: &[Ciphertext],
+    ) -> Vec<Ciphertext> {
+        let (a0_in_blocks, a1_in_blocks) = split_chunks_even_odd(state_in_blocks, 2);
+
+        let (a0_xor_a1_in_blocks, lambda_sq_a1_in_blocks) =
+            self.compute_xor_and_lambda_sq(&a0_in_blocks, &a1_in_blocks);
+
+        let delta_inv_in_blocks =
+            self.compute_delta_inv(&a0_in_blocks, &a0_xor_a1_in_blocks, &lambda_sq_a1_in_blocks);
+
+        let mut inputs = [
+            vec![a0_xor_a1_in_blocks.clone(), delta_inv_in_blocks.clone()],
+            vec![a1_in_blocks, delta_inv_in_blocks],
+        ];
+
+        let products = self.gf2_4_mul(&mut inputs);
+
+        let (s_t_mul_in_blocks, p_r_mul_in_blocks) = products.split_at(a0_xor_a1_in_blocks.len());
+
+        let b_in_blocks = interleave_chunks_of_two(s_t_mul_in_blocks, p_r_mul_in_blocks);
+
+        self.fpga_key.duplicate_packed_chunks(&b_in_blocks)
+    }
+}
diff --git a/tfhe/src/high_level_api/composites/aes/engine/inv_round_ops.rs b/tfhe/src/high_level_api/composites/aes/engine/inv_round_ops.rs
new file mode 100644
index 000000000..4f1fb67c8
--- /dev/null
+++ b/tfhe/src/high_level_api/composites/aes/engine/inv_round_ops.rs
@@ -0,0 +1,150 @@
+use crate::composites::aes::constants::{AES_BLOCK_SIZE, BLOCKS_PER_BYTE};
+use crate::high_level_api::composites::aes::constants::{COLS_IN_STATE, SHIFT_ROW_PAIRS};
+use crate::high_level_api::composites::aes::engine::state::FheAesState;
+use crate::high_level_api::composites::aes::engine::FheAesEngine;
+
+impl FheAesEngine<'_> {
+    /// Performs the InvMixColumns transformation for the AES decryption.
+    ///
+    /// # Arguments
+    /// - `state`: The current state of the cipher.
+    ///
+    /// # Note
+    /// Modifies the state in place.
+    pub(crate) fn inv_mix_columns(&self, state: &mut FheAesState) {
+        let lut_both_flush = self.lookup.lut_both_flush();
+        let lut_reconstruct = self.lookup.lut_reconstruct();
+
+        let bit_extract_manylut = self.lookup.bit_extract_manylut();
+
+        let state_in_blocks = state.state_into_column_major_in_blocks();
+
+        let all_bit_combinations = self
+            .fpga_key
+            .apply_same_many_lookup_vector_packed(&state_in_blocks, &bit_extract_manylut);
+
+        let base_0a0b = all_bit_combinations
+            .iter()
+            .map(|vec| vec[0].clone())
+            .collect::<Vec<_>>();
+
+        let base_0a0b_groups = base_0a0b.chunks(4).collect::<Vec<_>>();
+
+        let [bytes_mul_by_2, bytes_mul_by_4, bytes_mul_by_8] = self
+            .field
+            .gf2_8_prepare_mul_2_4_8_from_bitblocks(&base_0a0b_groups, &all_bit_combinations);
+
+        let [bytes_mul_by_9, bytes_mul_by_11, bytes_mul_by_13, bytes_mul_by_14] =
+            self.field.gf2_8_compose_9_11_13_14(
+                &base_0a0b_groups,
+                &bytes_mul_by_2,
+                &bytes_mul_by_4,
+                &bytes_mul_by_8,
+            );
+
+        let mut acc = (0..AES_BLOCK_SIZE)
+            .map(|_| Vec::with_capacity(BLOCKS_PER_BYTE))
+            .collect::<Vec<_>>();
+
+        for col in 0..COLS_IN_STATE {
+            let i0 = col * COLS_IN_STATE;
+            let i1 = col * COLS_IN_STATE + 1;
+            let i2 = col * COLS_IN_STATE + 2;
+            let i3 = col * COLS_IN_STATE + 3;
+
+            acc[i0].clone_from(&bytes_mul_by_9[i3]);
+            acc[i1].clone_from(&bytes_mul_by_9[i0]);
+            acc[i2].clone_from(&bytes_mul_by_9[i1]);
+            acc[i3].clone_from(&bytes_mul_by_9[i2]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], &bytes_mul_by_11[i1]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], &bytes_mul_by_13[i2]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], &bytes_mul_by_14[i1]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], &bytes_mul_by_11[i2]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], &bytes_mul_by_13[i0]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], &bytes_mul_by_14[i2]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], &bytes_mul_by_11[i0]);
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], &bytes_mul_by_13[i1]);
+        }
+
+        self.fpga_key
+            .apply_lut_flat_in_place(&mut acc, &lut_both_flush);
+
+        for col in 0..COLS_IN_STATE {
+            let i0 = col * COLS_IN_STATE;
+            let i1 = col * COLS_IN_STATE + 1;
+            let i2 = col * COLS_IN_STATE + 2;
+            let i3 = col * COLS_IN_STATE + 3;
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i0], &bytes_mul_by_14[i0]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i1], &bytes_mul_by_13[i3]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i2], &bytes_mul_by_11[i3]);
+
+            self.fpga_key
+                .byte_xor_packed(&mut acc[i3], &bytes_mul_by_14[i3]);
+        }
+
+        self.fpga_key
+            .apply_lut_flat_in_place(&mut acc, &lut_reconstruct);
+
+        let final_flat = acc.into_iter().flatten().collect::<Vec<_>>();
+        state.state_from_column_major_in_blocks_assign(&final_flat);
+    }
+
+    /// Performs the InvSubBytes operation using tower field construction for AES decryption.
+    ///
+    /// # Arguments
+    /// - `state`: The current state of the cipher.
+    ///
+    /// # Note
+    /// Modifies the state in place.
+    pub(crate) fn inv_sub_bytes(&self, state: &mut FheAesState) {
+        let mut state_in_blocks = self.fpga_key.expand_state_blocks(state);
+
+        self.field.apply_isomorphism(
+            &mut state_in_blocks,
+            &self.lookup.fwd_with_inv_affine_base(),
+        );
+
+        let mut inv_in_tower_field = self
+            .field
+            .compute_substitute_in_tower_field(&state_in_blocks);
+
+        self.field
+            .apply_isomorphism(&mut inv_in_tower_field, &self.lookup.inv_base());
+
+        state.state_from_row_major_in_blocks_assign(&inv_in_tower_field);
+    }
+}
+
+/// Performs the InvShiftRows transformation for AES decryption.
+///
+/// This function cyclically shifts the rows of the state matrix to the right.
+/// Each row is shifted by a different offset depending on its index.
+///
+/// # Arguments
+/// - `state`: The current state of the cipher.
+///
+/// # Note
+/// Modifies the state in place.
+pub(crate) fn inv_shift_rows(state: &mut FheAesState) {
+    for (row, offset) in SHIFT_ROW_PAIRS {
+        state.rot_row_right(*row, *offset);
+    }
+}
diff --git a/tfhe/src/high_level_api/composites/aes/engine/key_expansion.rs b/tfhe/src/high_level_api/composites/aes/engine/key_expansion.rs
new file mode 100644
index 000000000..21c466a5e
--- /dev/null
+++ b/tfhe/src/high_level_api/composites/aes/engine/key_expansion.rs
@@ -0,0 +1,97 @@
+use crate::composites::aes::utils::{repeat_luts_cycled, split_chunks_even_odd};
+use crate::high_level_api::composites::aes::constants::{BLOCKS_PER_BYTE, BYTES_IN_WORD};
+use crate::high_level_api::composites::aes::engine::FheAesEngine;
+use crate::integer::{IntegerCiphertext, RadixCiphertext};
+
+impl FheAesEngine<'_> {
+    /// Performs the AES key-schedule core operation:
+    /// `temp ← SubWord(RotWord(temp)) ⊕ Rcon[i / Nk]`
+    ///
+    /// # Arguments
+    /// - `temp`: A mutable vector of RadixCiphertext representing a 4-byte word
+    /// - `y`: The round constant
+    ///
+    /// * Modifies `temp` in place.
+    pub(crate) fn key_schedule_core(&self, temp: &mut [RadixCiphertext], y: u64) {
+        temp.rotate_left(1);
+
+        let mut temp_in_blocks = self.fpga_key.expand_lo_hi_batch(temp);
+
+        self.field
+            .apply_isomorphism(&mut temp_in_blocks, &self.lookup.fwd_base());
+
+        let mut inv_in_tower_field = self
+            .field
+            .compute_substitute_in_tower_field(&temp_in_blocks);
+
+        // Construct lookup table vector with the first byte being XORed with the round constant
+        let key_schedule_core_luts = [
+            &self.lookup.inv_with_affine_and_xor_base(y)[..],
+            &repeat_luts_cycled(&self.lookup.inv_with_affine_base(), BYTES_IN_WORD - 1)[..],
+        ]
+        .concat();
+
+        let key_schedule_core_luts = key_schedule_core_luts.iter().collect::<Vec<_>>();
+
+        self.fpga_key
+            .apply_lookup_vector_packed_assign(&mut inv_in_tower_field, &key_schedule_core_luts);
+
+        let (even_chunks, odd_chunks) = split_chunks_even_odd(&inv_in_tower_field, 4);
+
+        inv_in_tower_field = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&odd_chunks, &even_chunks);
+
+        self.fpga_key.apply_same_lookup_vector_packed_assign(
+            &mut inv_in_tower_field,
+            &self.fpga_key.lut_bitxor(),
+        );
+
+        for byte_idx in 0..BYTES_IN_WORD {
+            temp[byte_idx] = RadixCiphertext::from(
+                inv_in_tower_field[byte_idx * BLOCKS_PER_BYTE..(byte_idx + 1) * BLOCKS_PER_BYTE]
+                    .to_vec(),
+            );
+        }
+    }
+
+    /// Computes the next round word in the AES key expansion:
+    /// `next_word = temp ⊕ prev_word`
+    ///
+    /// # Arguments
+    /// - `temp`: A vector of RadixCiphertext representing a 4-byte word
+    /// - `prev_word`:  A vector of RadixCiphertext representing a 4-byte word
+    ///
+    /// # Returns
+    /// A `Vec<RadixCiphertext>` containing the next word
+    pub(crate) fn generate_next_round_word(
+        &self,
+        temp: &[RadixCiphertext],
+        prev_word: &[RadixCiphertext],
+    ) -> Vec<RadixCiphertext> {
+        let mut temp_in_blocks = Vec::with_capacity(BLOCKS_PER_BYTE * BYTES_IN_WORD);
+        let mut prev_in_blocks = Vec::with_capacity(BLOCKS_PER_BYTE * BYTES_IN_WORD);
+
+        for byte_idx in 0..BYTES_IN_WORD {
+            temp_in_blocks.extend(temp[byte_idx].blocks().to_vec());
+            prev_in_blocks.extend(prev_word[byte_idx].blocks().to_vec());
+        }
+
+        let mut xor_input = self
+            .fpga_key
+            .prepare_block_vecs_bivariate(&prev_in_blocks, &temp_in_blocks);
+
+        self.fpga_key
+            .apply_same_lookup_vector_packed_assign(&mut xor_input, &self.fpga_key.lut_bitxor());
+
+        let mut next_word = Vec::with_capacity(BYTES_IN_WORD);
+        for byte_idx in 0..BYTES_IN_WORD {
+            let offset = byte_idx * BLOCKS_PER_BYTE;
+            next_word.push(RadixCiphertext::from(
+                xor_input[offset..(offset + BLOCKS_PER_BYTE)].to_vec(),
+            ));
+        }
+
+        next_word.clone()
+    }
+}
