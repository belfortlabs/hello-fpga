+                let num_tests = 1;
+                let executor = FpgaFunctionExecutor::new(&BelfortServerKey::[<$comparison_name>]);
+                test_default_function(
+                    param,
+                    num_tests,
+                    executor,
+                    |lhs, rhs| $clear_type::from(<$clear_type>::$comparison_name(&lhs, &rhs)),
+                )
+            }
