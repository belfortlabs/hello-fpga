@@ -0,0 +1,51 @@
+use crate::shortint::ciphertext::Degree;
+
+pub trait HasVector {
+    fn vector(&self) -> &Vec<u64>;
+}
+
+#[derive(Clone, Debug)]
+pub struct LookupVector {
+    pub vector: Vec<u64>,
+    pub degree: Degree,
+}
+
+impl LookupVector {
+    pub fn new(vector: Vec<u64>) -> Self {
+        let max_value = vector.iter().max().unwrap();
+        let degree = Degree::new(*max_value);
+
+        Self { vector, degree }
+    }
+
+    pub fn new_with_max(vector: Vec<u64>, degree: u64) -> Self {
+        let degree = Degree::new(degree);
+
+        Self { vector, degree }
+    }
+
+    pub fn boolean() -> Self {
+        Self {
+            vector: vec![0],
+            degree: Degree::new(0),
+        }
+    }
+}
+
+impl HasVector for LookupVector {
+    fn vector(&self) -> &Vec<u64> {
+        &self.vector
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct ManyLookupVector {
+    pub vector: Vec<u64>,
+    pub degrees: Vec<Degree>,
+}
+
+impl HasVector for ManyLookupVector {
+    fn vector(&self) -> &Vec<u64> {
+        &self.vector
+    }
+}
