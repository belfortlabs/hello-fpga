+use crate::integer::bigint::u256::U256;
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::server_key::radix_parallel::scalar_mul::{
+    offset_factors, select_scalar_mul_params, OffsetMode,
+};
+use crate::integer::server_key::ScalarMultiplier;
+use crate::integer::ServerKey;
+use rayon::prelude::*;
+
+impl ServerKey {
+    pub fn unchecked_multi_scalar_mul_belfort<T, Scalar>(
+        &self,
+        ctxts: &[T],
+        scalars: &[Scalar],
+    ) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: ScalarMultiplier + DecomposableInto<u8>,
+    {
+        assert!(!ctxts.is_empty(), "ctxts must not be empty");
+        assert!(!scalars.is_empty(), "scalars must not be empty");
+        assert_eq!(
+            ctxts.len(),
+            scalars.len(),
+            "ctxts and scalars must have equal length"
+        );
+
+        let sample_ctxt = &ctxts[0];
+        let num_blocks = sample_ctxt.blocks().len();
+
+        let (window_size, use_doubling) = select_scalar_mul_params(scalars);
+
+        let ctxts_shifted = if use_doubling {
+            None
+        } else {
+            Some(
+                ctxts
+                    .par_iter()
+                    .map(|ctxt| self.unchecked_scalar_left_shift_parallelized(ctxt, 1))
+                    .collect::<Vec<T>>(),
+            )
+        };
+
+        let mut buckets =
+            self.multi_scalar_mul_accumulation(ctxts, ctxts_shifted.as_ref(), scalars, window_size);
+
+        let mut result =
+            self.multi_scalar_mul_aggregation(&mut buckets, num_blocks, window_size, use_doubling);
+
+        self.full_propagate_parallelized(&mut result);
+
+        result
+    }
+
+    pub fn multi_scalar_mul_belfort<T, Scalar>(&self, ctxts: &[T], scalars: &[Scalar]) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: ScalarMultiplier + DecomposableInto<u8>,
+    {
+        let mut ctxts_vec = ctxts.to_vec();
+
+        ctxts_vec
+            .par_iter_mut()
+            .for_each(|ctxt| self.full_propagate_parallelized(ctxt));
+
+        self.unchecked_multi_scalar_mul_belfort(&ctxts_vec, scalars)
+    }
+
+    pub(crate) fn multi_scalar_mul_accumulation<T, Scalar>(
+        &self,
+        ctxts: &[T],
+        ctxts_shifted: Option<&Vec<T>>,
+        scalars: &[Scalar],
+        window_size: usize,
+    ) -> Vec<Vec<T>>
+    where
+        T: IntegerRadixCiphertext + Clone,
+        Scalar: ScalarMultiplier + DecomposableInto<u8> + Copy,
+    {
+        let sample_ctxt = &ctxts[0];
+        let num_blocks = sample_ctxt.blocks().len();
+        let num_message_bits_per_block = self.key.message_modulus.0.ilog2() as usize;
+        let num_ciphertext_bits = num_blocks * num_message_bits_per_block;
+
+        let use_doubling = ctxts_shifted.is_none();
+        let bucket_count = if use_doubling {
+            1usize << (window_size - 1)
+        } else {
+            1usize << (window_size - 2)
+        };
+
+        let modulus = U256::ONE << num_ciphertext_bits;
+
+        let (mut buckets, offset_accumulator) = (0..ctxts.len())
+            .into_par_iter()
+            .map(|i| {
+                let ctxt = &ctxts[i];
+                let scalar = scalars[i];
+
+                let ctxt_shifted_ref = if use_doubling {
+                    None
+                } else {
+                    Some(&ctxts_shifted.as_ref().expect("shifted ctxts missing")[i])
+                };
+
+                let (per_buckets, per_offset_opt) = self.scalar_mul_accumulation(
+                    ctxt,
+                    ctxt_shifted_ref,
+                    &scalar,
+                    window_size,
+                    OffsetMode::ReturnOffset,
+                );
+
+                let per_offset = per_offset_opt.expect(
+                "scalar_mul_accumulation must return Some(offset) when OffsetMode::ReturnOffset",
+            );
+
+                (per_buckets, per_offset)
+            })
+            .reduce(
+                || (vec![Vec::<T>::new(); bucket_count], U256::ZERO),
+                |(mut buckets, mut offset_accumulator), (per_buckets, per_offset)| {
+                    for (global_bucket, local_bucket) in buckets.iter_mut().zip(per_buckets) {
+                        global_bucket.extend(local_bucket);
+                    }
+                    offset_accumulator = (offset_accumulator + per_offset) % modulus;
+                    (buckets, offset_accumulator)
+                },
+            );
+
+        let offset_factor = offset_factors(window_size, use_doubling);
+        let desired_offset = U256::from((offset_factor, 0u128));
+
+        let offset_correction_value =
+            (desired_offset + modulus - (offset_accumulator % modulus)) % modulus;
+
+        if offset_correction_value != U256::ZERO {
+            let offset_correction_ctxt =
+                self.create_trivial_radix(offset_correction_value, num_blocks);
+            buckets[0].push(offset_correction_ctxt);
+        }
+
+        buckets
+    }
+
+    pub(crate) fn multi_scalar_mul_aggregation<T>(
+        &self,
+        buckets: &mut [Vec<T>],
+        num_blocks: usize,
+        window_size: usize,
+        use_doubling: bool,
+    ) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let upper_bucket_limit = 1usize << (window_size - 1);
+        let lower_bucket_limit = 1usize << (window_size - 2);
+
+        if use_doubling {
+            let result_double = self.scalar_mul_aggregation(
+                &mut buckets[lower_bucket_limit..upper_bucket_limit].to_vec(),
+                num_blocks,
+                window_size,
+            );
+
+            let (message_ctxt, carry_ctxt_shifted) =
+                self.split_msg_and_shifted_carry_parallelized(&result_double);
+
+            let mut ctxts_to_be_pushed = vec![message_ctxt, carry_ctxt_shifted];
+
+            ctxts_to_be_pushed
+                .par_iter_mut()
+                .for_each(|ctxt| self.unchecked_scalar_left_shift_assign_parallelized(ctxt, 1));
+
+            buckets[0].extend(ctxts_to_be_pushed);
+        }
+
+        self.scalar_mul_aggregation(buckets, num_blocks, window_size)
+    }
+}
