+            .map(|_| rng.gen::<u64>() % block_modulus)
+            .collect::<Vec<_>>();
+        let indices = (0..SIMD_LEN)
+            .map(|_| rng.gen_range(0..num_blocks))
+            .collect::<Vec<_>>();
+
+        let mut ctxt_0 = clear_0
+            .iter()
+            .map(|&clear| cks.as_ref().encrypt_radix(clear, num_blocks))
