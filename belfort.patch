-void reverseArray(uint64_t arr[], size_t n) {
-  size_t start = 0;
-  size_t end = n - 1;
-
-  // Swap elements from the start with elements from the end
-  while (start < end) {
-    // Swap arr[start] and arr[end]
-    uint64_t temp = arr[start];
-    arr[start] = arr[end];
-    arr[end] = temp;
-
-    // Move towards the middle
-    start++;
-    end--;
-  }
-}
