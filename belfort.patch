+impl<C: ContainerMut> DerefMut for Polynomial<C> {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        self.as_mut()
+    }
+}
+
 /// Metadata used in the [`CreateFrom`] implementation to create [`Polynomial`] entities.
 #[derive(Clone, Copy)]
 pub struct PolynomialCreationMetadata {}
diff --git a/tfhe/src/core_crypto/fpga/keyswitch_blind_rotate.rs b/tfhe/src/core_crypto/fpga/keyswitch_blind_rotate.rs
new file mode 100644
index 000000000..80c031e0a
--- /dev/null
+++ b/tfhe/src/core_crypto/fpga/keyswitch_blind_rotate.rs
@@ -0,0 +1,86 @@
+use super::lookup_vector::HasVector;
+use super::{AcceleratorsHandle, InterfaceStatusT};
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::shortint::ciphertext::Ciphertext as ShortintCiphertext;
+use crate::shortint::server_key::ShortintBootstrappingKey;
+
+extern "C" {
+    pub fn pbs(
+        accelerators: AcceleratorsHandle,
+        ciphertext_ptrs: *const *const u64,
+        output_ptrs: *mut *mut *mut u32,
+        luts: *const *const u64,
+        pack_size: usize,
+        fpga_indexes: *const usize,
+        fpga_indexes_length: usize,
+    ) -> InterfaceStatusT;
+}
+
+impl BelfortServerKey {
+    pub fn keyswitch_blind_rotate_packed<T>(
+        &self,
+        ciphertexts: &[ShortintCiphertext],
+        lookup_vectors: &[&T],
+    ) -> Vec<Vec<u32>>
+    where
+        T: HasVector,
+    {
+        let max_pack_size = ciphertexts.len();
+        let mut ciphertext_ptrs: Vec<*const u64> = Vec::with_capacity(max_pack_size);
+        let mut luts: Vec<*const u64> = Vec::with_capacity(max_pack_size);
+
+        for (ct, lut) in ciphertexts.iter().zip(lookup_vectors.iter()) {
+            if ct.is_trivial() {
+                continue;
+            }
+            luts.push(lut.vector().as_ptr());
+            ciphertext_ptrs.push(ct.ct.as_ref().as_ptr());
+        }
+
+        let pack_size = luts.len();
+        if pack_size == 0 {
+            // Don't need to apply any PBS
+            return vec![];
+        }
+
+        let fpga_indexes = &self.utils.fpga_indexes;
+        let accelerator_handle = self.utils.accelerators.lock().unwrap();
+
+        let pbs_output = unsafe {
+            let mut output_ptrs: *mut *mut u32 = std::ptr::null_mut();
+
+            let status = pbs(
+                *accelerator_handle,
+                ciphertext_ptrs.as_ptr(),
+                &raw mut output_ptrs,
+                luts.as_ptr(),
+                pack_size,
+                fpga_indexes.as_ptr(),
+                fpga_indexes.len(),
+            );
+            assert!(
+                status == InterfaceStatusT::InterfaceSuccess,
+                "Failed to execute on FPGA! Status {status:?}"
+            );
+
+            Vec::from_raw_parts(output_ptrs, pack_size, pack_size)
+        };
+
+        let bsk = &self.key.key.key.fpga_pattern().bootstrapping_key;
+        convert_to_raw_glwe(pbs_output, bsk)
+    }
+}
+
+fn convert_to_raw_glwe(
+    pbs_output: Vec<*mut u32>,
+    bsk: &ShortintBootstrappingKey<u64>,
+) -> Vec<Vec<u32>> {
+    let glwe_size = bsk.glwe_size();
+    let poly_size = bsk.polynomial_size();
+
+    let dimension: usize = glwe_size.0 * poly_size.0;
+    pbs_output
+        .into_iter()
+        .map(|flat_glwe_ptr| unsafe { Vec::from_raw_parts(flat_glwe_ptr, dimension, dimension) })
+        .collect::<Vec<Vec<_>>>()
+}
diff --git a/tfhe/src/core_crypto/fpga/lookup_vector.rs b/tfhe/src/core_crypto/fpga/lookup_vector.rs
new file mode 100644
index 000000000..321695ee4
--- /dev/null
+++ b/tfhe/src/core_crypto/fpga/lookup_vector.rs
@@ -0,0 +1,51 @@
+use crate::shortint::ciphertext::Degree;
+
+pub trait HasVector {
+    fn vector(&self) -> &Vec<u64>;
+}
+
+#[derive(Clone, Debug)]
+pub struct LookupVector {
+    pub vector: Vec<u64>,
+    pub degree: Degree,
+}
+
+impl LookupVector {
+    pub fn new(vector: Vec<u64>) -> Self {
+        let max_value = vector.iter().max().unwrap();
+        let degree = Degree::new(*max_value);
+
+        Self { vector, degree }
+    }
+
+    pub fn new_with_max(vector: Vec<u64>, degree: u64) -> Self {
+        let degree = Degree::new(degree);
+
+        Self { vector, degree }
+    }
+
+    pub fn boolean() -> Self {
+        Self {
+            vector: vec![0],
+            degree: Degree::new(0),
+        }
+    }
+}
+
+impl HasVector for LookupVector {
+    fn vector(&self) -> &Vec<u64> {
+        &self.vector
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct ManyLookupVector {
+    pub vector: Vec<u64>,
+    pub degrees: Vec<Degree>,
+}
+
+impl HasVector for ManyLookupVector {
+    fn vector(&self) -> &Vec<u64> {
+        &self.vector
+    }
+}
