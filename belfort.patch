+pub(crate) fn default_multi_scalar_mul_test<P, T>(param: P, mut executor: T)
+where
+    P: Into<TestParameters>,
+    T: for<'a> FunctionExecutor<(&'a [RadixCiphertext], &'a [u128]), RadixCiphertext>,
+{
+    let param = param.into();
+    let nb_tests_smaller = nb_tests_smaller_for_params(param);
+    let (cks, mut sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+
+    // Set parameters for vector mul
+    let nb_blocks = 32;
+    let nb_elements = 64;
+
+    let cks = RadixClientKey::from((cks, nb_blocks));
+
+    sks.set_deterministic_pbs_execution(true);
+    let sks = Arc::new(sks);
+    let mut rng = rand::thread_rng();
