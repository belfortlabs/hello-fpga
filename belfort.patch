+    pub(crate) fn neg_with_offset<T>(&self, ctxt: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_blocks = ctxt.blocks().len();
+        let num_message_bits_per_block = self.key.message_modulus.0.ilog2() as usize;
+        let num_bits = num_blocks * num_message_bits_per_block;
+
+        if num_blocks == 0 {
+            return self.create_trivial_zero_radix(0);
+        }
+
+        let mask = (U256::ONE << (num_bits)) - U256::ONE;
+        let mut mask_ctxt: T = self.create_trivial_radix(mask, num_blocks);
+
+        for (mask_ctxt_block, ctxt_block) in
+            mask_ctxt.blocks_mut().iter_mut().zip(ctxt.blocks().iter())
+        {
+            lwe_ciphertext_sub_assign(&mut mask_ctxt_block.ct, &ctxt_block.ct);
+            mask_ctxt_block.degree = Degree::new(3);
+        }
+
+        mask_ctxt
+    }
+
+    pub(crate) fn neg_shifted_with_offset<T>(&self, ctxt: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_blocks = ctxt.blocks().len();
+        let num_message_bits_per_block = self.key.message_modulus.0.ilog2() as usize;
+        let num_bits = num_blocks * num_message_bits_per_block;
+
+        if num_blocks == 0 {
+            return self.create_trivial_zero_radix(0);
+        }
+
+        // Since the ciphertext is shifted, the mask needs to be shifted as well
+        let mask = (U256::ONE << (num_bits)) - U256::TWO;
+        let mut mask_ctxt: T = self.create_trivial_radix(mask, num_blocks);
+
+        for (mask_ctxt_block, ctxt_block) in
+            mask_ctxt.blocks_mut().iter_mut().zip(ctxt.blocks().iter())
+        {
+            lwe_ciphertext_sub_assign(&mut mask_ctxt_block.ct, &ctxt_block.ct);
+            mask_ctxt_block.degree = Degree::new(3);
+        }
+
+        mask_ctxt
+    }
+
+    pub(crate) fn scalar_mul_accumulation<T, Scalar>(
+        &self,
+        ctxt: &T,
+        ctxt_shifted: Option<&T>,
+        scalar: &Scalar,
+        window_size: usize,
+        offset_mode: OffsetMode,
+    ) -> (Vec<Vec<T>>, Option<U256>)
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: ScalarMultiplier + DecomposableInto<u8>,
+    {
+        let num_blocks = ctxt.blocks().len();
+        let num_message_bits_per_block = self.key.message_modulus.0.ilog2() as usize;
+        let num_ciphertext_bits = num_blocks * num_message_bits_per_block;
+
+        let mut offset_accumulator = U256::ZERO;
+
+        let use_doubling = ctxt_shifted.is_none();
+        let bucket_count = if use_doubling {
+            1usize << (window_size - 1)
+        } else {
+            1usize << (window_size - 2)
+        };
+
+        let mut buckets = vec![Vec::new(); bucket_count];
+
+        let scalar_bits = BlockDecomposer::with_early_stop_at_zero(*scalar, 1)
+            .iter_as::<u8>()
+            .collect::<Vec<_>>();
+
+        let ctxt_neg = self.neg_with_offset(ctxt);
+        let ctxt_shifted_neg: Option<T> = if use_doubling {
+            None
+        } else {
+            ctxt_shifted.map(|s| self.neg_shifted_with_offset(s))
+        };
+
+        let full_mask: U256 = (U256::ONE << num_ciphertext_bits) - U256::ONE;
+
+        let mut previous_carry = 0u8;
+        let mut bit_idx = 0usize;
+
+        while bit_idx < scalar_bits.len() {
+            let scalar_bit_with_carry = scalar_bits[bit_idx] + previous_carry;
+
+            if scalar_bit_with_carry % 2 == 0 {
+                bit_idx += 1;
+                continue;
+            }
+
+            let window_val = build_window(&scalar_bits, bit_idx, window_size, previous_carry);
+            let is_window_negative = (window_val >> (window_size - 1)) == 1;
+
+            let window_magnitude: u32 = if is_window_negative {
+                (1u32 << window_size) - window_val
+            } else {
+                window_val
+            };
+
+            previous_carry = if is_window_negative {
+                offset_accumulator +=
+                    U256::from((window_magnitude as u128, 0u128)) * (full_mask << bit_idx);
+                1u8
+            } else {
+                0u8
+            };
+
+            let use_shifted_ctxt = (bit_idx % 2) == 1;
+
+            let selected_ctxt: &T = if use_doubling {
+                if is_window_negative {
+                    &ctxt_neg
+                } else {
+                    ctxt
+                }
+            } else {
+                match (is_window_negative, use_shifted_ctxt) {
+                    (false, false) => ctxt,
+                    (false, true) => ctxt_shifted
+                        .as_ref()
+                        .expect("ctxt_shifted must be provided when not using doubling"),
+                    (true, false) => &ctxt_neg,
+                    (true, true) => ctxt_shifted_neg
+                        .as_ref()
+                        .expect("ctxt_shifted_neg must exist when not using doubling"),
+                }
+            };
+
+            let mut bucket_idx: usize = (window_magnitude / 2) as usize;
+            if use_doubling && use_shifted_ctxt {
+                bucket_idx += 1usize << (window_size - 2);
+            }
+
+            let block_shift = bit_idx / num_message_bits_per_block;
+
+            if !selected_ctxt.blocks().is_empty() && block_shift < selected_ctxt.blocks().len() {
+                buckets[bucket_idx].push(self.blockshift(selected_ctxt, block_shift));
+            }
+
+            bit_idx += window_size;
+        }
+
+        let num_scalar_bits = scalar_bits.len() as u32;
+        let num_scalar_blocks = (num_scalar_bits / 2) as usize;
+        let final_use_shifted = (num_scalar_bits % 2) == 1;
+
+        if previous_carry == 1 && num_scalar_blocks < num_blocks {
+            let (final_accum_ctxt, final_bucket_idx): (&T, usize) =
+                match (use_doubling, final_use_shifted) {
+                    (true, false) => (ctxt, 0),
+                    (true, true) => (ctxt, 1usize << (window_size - 2)),
+                    (false, false) => (ctxt, 0),
+                    (false, true) => (
+                        ctxt_shifted
+                            .as_ref()
+                            .expect("ctxt_shifted must be provided when not using doubling"),
+                        0,
+                    ),
+                };
+
+            if !final_accum_ctxt.blocks().is_empty()
+                && num_scalar_blocks < final_accum_ctxt.blocks().len()
+            {
+                buckets[final_bucket_idx]
+                    .push(self.blockshift(final_accum_ctxt, num_scalar_blocks));
+            }
+        }
+
+        match offset_mode {
+            OffsetMode::PushOffset => {
+                let offset_factor = offset_factors(window_size, false);
+                let modulus = U256::ONE << num_ciphertext_bits;
+
+                let desired_offset = U256::from((offset_factor, 0u128));
+
+                let offset_correction_value =
+                    (desired_offset + modulus - (offset_accumulator % modulus)) % modulus;
+
+                if offset_correction_value != U256::ZERO {
+                    let offset_correction_ctxt =
+                        self.create_trivial_radix(offset_correction_value, num_blocks);
+                    buckets[0].push(offset_correction_ctxt);
+                }
+
+                (buckets, None)
+            }
+            OffsetMode::ReturnOffset => (buckets, Some(offset_accumulator)),
+        }
+    }
+
+    pub fn split_msg_and_shifted_carry_parallelized<T>(&self, res: &T) -> (T, T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (message_blocks, carry_blocks) =
+            self.extract_message_and_carry_blocks_parallelized(res.blocks());
+        let message_ctxt = T::from_blocks(message_blocks);
+        let carry_ctxt = T::from_blocks(carry_blocks);
+        let carry_ctxt_shifted = self.blockshift(&carry_ctxt, 1);
+        (message_ctxt, carry_ctxt_shifted)
+    }
+
+    pub(crate) fn scalar_mul_aggregation<T>(
+        &self,
+        buckets: &mut [Vec<T>],
+        num_blocks: usize,
+        window_size: usize,
+    ) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let sum_bucket = |bucket: &mut Vec<T>| -> T {
+            if bucket.is_empty() {
+                self.create_trivial_zero_radix(num_blocks)
+            } else {
+                let elems = core::mem::take(bucket);
+                self.unchecked_partial_sum_ciphertexts_vec_parallelized(elems, None)
+                    .unwrap()
+            }
+        };
+
+        if window_size == 2 {
+            return sum_bucket(&mut buckets[0]);
+        }
+
+        if window_size == 3 {
+            let res = sum_bucket(&mut buckets[1]);
+            let (message_ctxt, carry_ctxt_shifted) =
+                self.split_msg_and_shifted_carry_parallelized(&res);
+
+            let shift = 1;
+
+            if !message_ctxt.blocks().is_empty() && shift < message_ctxt.blocks().len() {
+                buckets[0].push(self.blockshift(&message_ctxt, shift));
+            }
+            if !carry_ctxt_shifted.blocks().is_empty()
+                && (shift == 0 || shift < carry_ctxt_shifted.blocks().len())
+            {
+                buckets[0].push(self.blockshift(&carry_ctxt_shifted, shift));
+            }
+
+            buckets[0].push(self.neg_with_offset(&message_ctxt));
+            buckets[0].push(self.neg_with_offset(&carry_ctxt_shifted));
+
+            return sum_bucket(&mut buckets[0]);
+        }
+
+        let process_bucket = |bucket: &mut Vec<T>| -> (T, T) {
+            let result = sum_bucket(bucket);
+            self.split_msg_and_shifted_carry_parallelized(&result)
+        };
+
+        let process_buckets = |buckets: &mut [Vec<T>]| -> Vec<(T, T)> {
+            buckets.iter_mut().map(&process_bucket).collect::<Vec<_>>()
+        };
+
+        match window_size {
+            4 => {
+                let results = process_buckets(&mut buckets[2..4]);
+
+                // B5 = 4B1 + B1
+                buckets[0].push(self.blockshift(&results[0].0, 1));
+                buckets[0].push(self.blockshift(&results[0].1, 1));
+                buckets[0].push(results[0].0.clone());
+                buckets[0].push(results[0].1.clone());
+
+                // B7 = 4B1 + B3
+                buckets[0].push(self.blockshift(&results[1].0, 1));
+                buckets[0].push(self.blockshift(&results[1].1, 1));
+                buckets[1].push(results[1].0.clone());
+                buckets[1].push(results[1].1.clone());
+            }
+
+            5 => {
+                let results = process_buckets(&mut buckets[4..8]);
+
+                // B9 = 4B1 + B5
+                buckets[0].push(self.blockshift(&results[0].0, 1));
+                buckets[0].push(self.blockshift(&results[0].1, 1));
+                buckets[2].push(results[0].0.clone());
+                buckets[2].push(results[0].1.clone());
+
+                // B11 = 16B1 - B5
+                buckets[0].push(self.blockshift(&results[1].0, 2));
+                buckets[0].push(self.blockshift(&results[1].1, 2));
+                buckets[2].push(self.neg_with_offset(&results[1].0));
+                buckets[2].push(self.neg_with_offset(&results[1].1));
+
+                // B13 = 16B1 - B3
+                buckets[0].push(self.blockshift(&results[2].0, 2));
+                buckets[0].push(self.blockshift(&results[2].1, 2));
+                buckets[1].push(self.neg_with_offset(&results[2].0));
+                buckets[1].push(self.neg_with_offset(&results[2].1));
+
+                // B15 = 16B1 - B1
+                buckets[0].push(self.blockshift(&results[3].0, 2));
+                buckets[0].push(self.blockshift(&results[3].1, 2));
+                buckets[0].push(self.neg_with_offset(&results[3].0));
+                buckets[0].push(self.neg_with_offset(&results[3].1));
+            }
+
+            6 => {
+                let results = process_buckets(&mut buckets[8..16]);
+
+                // B31 = 16*B1 + B15
+                // B29 = 16*B1 + B13
+                // B27 = 16*B1 + B11
+                // B25 = 16*B1 + B9
+                // B23 = 16*B1 + B7
+                // B21 = 16*B1 + B5
+                // B19 = 16*B1 + B3
+                // B17 = 16*B1 + B1
+                for i in 0..8 {
+                    // 16*B1
+                    buckets[0].push(self.blockshift(&results[i].0, 2));
+                    buckets[0].push(self.blockshift(&results[i].1, 2));
+                    // BX
+                    buckets[i].push(results[i].0.clone());
+                    buckets[i].push(results[i].1.clone());
+                }
+            }
+
+            7 => {
+                let results = process_buckets(&mut buckets[16..32]);
+
+                // B63 = 64*B1 - B1
+                // B61 = 64*B1 - B3
+                // B59 = 64*B1 - B5
+                // B57 = 64*B1 - B7
+                // ....
+                // B33 = 64*B1 - B31
+                for i in 0..16 {
+                    // 16*B1
+                    buckets[0].push(self.blockshift(&results[i].0, 3));
+                    buckets[0].push(self.blockshift(&results[i].1, 3));
+                    // BX
+                    buckets[i].push(self.neg_with_offset(&results[i].0));
+                    buckets[i].push(self.neg_with_offset(&results[i].1));
+                }
+            }
+
+            8 => {
+                let results = process_buckets(&mut buckets[32..64]);
+
+                // B127 = 64*B1 + B63
+                // B125 = 64*B1 + B61
+                // B123 = 64*B1 + B59
+                // B121 = 64*B1 + B57
+                // ....
+                // B65 = 64*B1 + B1
+                for i in 0..32 {
+                    // 16*B1
+                    buckets[0].push(self.blockshift(&results[i].0, 3));
+                    buckets[0].push(self.blockshift(&results[i].1, 3));
+                    // BX
+                    buckets[i].push(results[i].0.clone());
+                    buckets[i].push(results[i].1.clone());
+                }
+            }
+
+            _ => panic!("window_size must be one of {{2, 3, 4, 5, 6, 7, 8}}"),
+        }
+
+        let next_window_size = window_size
+            .checked_sub(1)
+            .expect("window_size must be >= 2");
+
+        self.scalar_mul_aggregation(buckets, num_blocks, next_window_size)
+    }
+}
+
+pub(crate) fn build_window(
+    scalar_bits: &[u8],
+    start_bit: usize,
+    window_size: usize,
+    carry: u8,
+) -> u32 {
+    let mut window_val = scalar_bits[start_bit] + carry;
+    for bit_offset in 1..window_size {
+        let current_bit_idx = start_bit + bit_offset;
+        if current_bit_idx >= scalar_bits.len() {
+            break;
+        }
+        window_val += scalar_bits[current_bit_idx] << bit_offset;
+    }
+    window_val as u32
+}
+
+pub(crate) fn select_scalar_mul_params<Scalar>(scalars: &[Scalar]) -> (usize, bool)
+where
+    Scalar: ScalarMultiplier + DecomposableInto<u8> + Copy,
+{
+    assert!(!scalars.is_empty(), "scalars must not be empty");
+
+    let count_scalar_bits = |x: Scalar| -> u32 {
+        BlockDecomposer::with_early_stop_at_zero(x, 1)
+            .iter_as::<u8>()
+            .count() as u32
+    };
+
+    let total_scalar_bits: u64 = scalars.iter().map(|&s| count_scalar_bits(s) as u64).sum();
+    let mean_scalar_bits =
+        ((total_scalar_bits + (scalars.len() as u64 / 2)) / scalars.len() as u64) as usize;
+
+    let num_scalars = scalars.len();
+
+    if num_scalars == 1 {
+        let num_scalar_bits = count_scalar_bits(scalars[0]);
+        let window_size = match num_scalar_bits {
+            0..=127 => 2,
+            128..=256 => 3,
+            _ => panic!("Limited to 256-bit numbers."),
+        };
+        return (window_size, false);
+    }
+
+    let (window_size, use_doubling) = match (mean_scalar_bits, num_scalars) {
+        (0..=8, 0..=8) => (2, false),
+        (0..=8, 9..=16) => (2, false),
+        (0..=8, 17..=32) => (2, true),
+        (0..=8, 33..=64) => (2, true),
+        (0..=8, 65..=128) => (2, true),
+        (0..=8, 129..=256) => (3, true),
+        (0..=8, 257..=512) => (4, true),
+        (0..=8, 513..=1024) => (6, true),
+
+        (9..=16, 0..=8) => (2, false),
+        (9..=16, 9..=16) => (2, true),
+        (9..=16, 17..=32) => (3, true),
+        (9..=16, 33..=64) => (4, true),
+        (9..=16, 65..=128) => (4, true),
+        (9..=16, 129..=256) => (5, true),
+        (9..=16, 257..=512) => (6, true),
+        (9..=16, 513..=1024) => (7, true),
+
+        (17..=32, 0..=8) => (2, true),
+        (17..=32, 9..=16) => (3, true),
+        (17..=32, 17..=32) => (4, true),
+        (17..=32, 33..=64) => (4, true),
+        (17..=32, 65..=128) => (5, true),
+        (17..=32, 129..=256) => (6, true),
+        (17..=32, 257..=512) => (7, true),
+        (17..=32, 513..=1024) => (8, true),
+
+        (33..=64, 0..=8) => (4, false),
+        (33..=64, 9..=16) => (4, true),
+        (33..=64, 17..=32) => (4, true),
+        (33..=64, 33..=64) => (5, true),
+        (33..=64, 65..=128) => (6, true),
+        (33..=64, 129..=256) => (7, true),
+        (33..=64, 257..=512) => (7, true),
+        (33..=64, 513..=1024) => (8, true),
+
+        _ => panic!("Limited to 64-bit numbers and 1024 multiplications."),
+    };
+
+    (window_size, use_doubling)
+}
+
+pub(crate) fn offset_factors(window_size: usize, use_doubling: bool) -> u128 {
+    // Depending on the window size the offset is different
+    // You only compensate for subtracting buckets
+    // See https://eprint.iacr.org/2025/1267.pdf section 3.5.1 (Powershift Aggregation)
+    // Window size 2:  Buckets are B1 & B3 => B1 & B-1
+    //                 => No offset
+    // Window size 3:  Buckets are B1, B3, B5, B7 => B1, B3, B-3, B-1
+    //                 B3 = 4 * B1 - 1
+    //                 => offset = +1
+    // Window size 4:  Buckets are B1, B3, B5, B7, B9, B11, B13, B15
+    //                              => B1, B3, B7, B-7, B-5, B-3, B-1
+    //                 B3 = 4 * B1 - B1
+    //                 B5 = 4 * B1 + B1
+    //                 B7 = 4 * B1 + B3 = 4 * B1 + 4 * B1 -1
+    //                 => offset = 1 - 1 + 1 = 1
+    // Window size 5:  Buckets are B1, B3, B5, B7, .. B31
+    //                              => B1, B3, B7, .., B15, B-13, B-7, B-5, B-3, B-1
+    //                 B3 = 4 * B1 - 1 * B1 => + 1
+    //                 B5 = 4 * B1 + 1 * B1 => 0
+    //                 B7 = 4 * B1 + 3 * B1 => 0
+    //                 B9 = 4 * B1 + B5 = 4 * B1 + 4 * B1 + 1 B1 => 0
+    //                 B11 = 16 * B1 - 5 * B1 => +5
+    //                 B13 = 16 * B1 - 3 * B1 = => +3
+    //                 B15 = 16 * B1 - 1 * B1 => +1
+    //                 => offset = 1 + 5 + 3 + 1 = 10
+    let mut offset_factor = match window_size {
+        2 => 0,
+        3 | 4 => 1,
+        5 | 6 => 10,
+        7 | 8 => 266,
+        _ => panic!("window_size must be one of {{2, 3, 4, 5, 6, 7, 8}}"),
+    };
+
+    // Since offset should take into consideration both message and carry block
+    offset_factor *= 2;
+
+    if use_doubling {
+        offset_factor *= 3;
+    }
+
+    offset_factor
 }
