+    where
+        T: IntegerRadixCiphertext,
+        Scalar: ScalarMultiplier + DecomposableInto<u8>,
+    {
+        let mut ctxt_res = ctxt.clone();
+        self.scalar_mul_assign_belfort(&mut ctxt_res, scalar);
+        ctxt_res
+    }
