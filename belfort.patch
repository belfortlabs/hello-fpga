-  if (requested_flag == outputFlag::FLAG_CARRY) {
-    copy_radix_ciphertext_slice_async<Torus>(
-        streams.stream(0), streams.gpu_index(0), &output_flag, 0, 1,
-        block_states, num_radix_blocks - 1, num_radix_blocks);
