+use super::setup_default_fpga;
+use crate::array::cpu::integers::CpuUintArrayBackend;
+use crate::array::dynamic::DynUintBackend;
+use crate::array::tests::{
+    add_scalar_slice_test_case, bitand_test_case, bitor_test_case, div_scalar_slice_test_case,
+    mul_scalar_slice_test_case, rem_scalar_slice_test_case, sub_scalar_slice_test_case,
+};
+use crate::prelude::*;
+use crate::{CpuFheInt32Array, CpuFheUint32Array, FheUint32Array, FheUint32Id};
+use rand::prelude::*;
+use rand::thread_rng;
+
+macro_rules! fpga_arrays_test {
+    ($test_name:ident, $test_case:ident, $($type_param:ty),+) => {
+        #[test]
+        fn $test_name() {
+            let (ck, mut fpga_key) = setup_default_fpga();
+            $test_case::<$($type_param),+>(&ck);
+            fpga_key.disconnect();
+        }
+    };
+}
+
+fpga_arrays_test!(
+    test_fpga_arrays_bitand,
+    bitand_test_case,
+    FheUint32Id,
+    CpuUintArrayBackend,
+    u32
+);
+fpga_arrays_test!(
+    test_fpga_only_bitor,
+    bitor_test_case,
+    CpuFheUint32Array,
+    u32
+);
+fpga_arrays_test!(
+    test_fpga_dyn_bitand,
+    bitand_test_case,
+    FheUint32Id,
+    DynUintBackend,
+    u32
+);
+
+fpga_arrays_test!(
+    test_fpga_add_scalar_slice,
+    add_scalar_slice_test_case,
+    CpuFheInt32Array,
+    i32
+);
+
+fpga_arrays_test!(
+    test_fpga_sub_scalar_slice,
+    sub_scalar_slice_test_case,
+    CpuFheInt32Array,
+    i32
+);
+
+fpga_arrays_test!(
+    test_fpga_mul_scalar_slice,
+    mul_scalar_slice_test_case,
+    CpuFheInt32Array,
+    i32
+);
+
+fpga_arrays_test!(
+    test_fpga_div_scalar_slice,
+    div_scalar_slice_test_case,
+    CpuFheInt32Array,
+    i32
+);
+
+fpga_arrays_test!(
+    test_fpga_rem_scalar_slice,
+    rem_scalar_slice_test_case,
+    CpuFheInt32Array,
+    i32
+);
+
+#[test]
+fn test_single_dimension() {
+    let (ck, mut fpga_key) = setup_default_fpga();
+
+    let mut rng = thread_rng();
+
+    let num_elems = 5;
+
+    let clear_xs = (0..num_elems).map(|_| rng.gen::<u32>()).collect::<Vec<_>>();
+    let clear_ys = (0..num_elems).map(|_| rng.gen::<u32>()).collect::<Vec<_>>();
+
+    let xs = FheUint32Array::try_encrypt(clear_xs.as_slice(), &ck).unwrap();
+    let ys = FheUint32Array::try_encrypt(clear_ys.as_slice(), &ck).unwrap();
+
+    let range = 1..3;
+    let xss = xs.slice(std::slice::from_ref(&range));
+    let yss = ys.slice(std::slice::from_ref(&range));
+
+    let zs = xss + yss;
+
+    let clear_zs: Vec<u32> = zs.decrypt(&ck);
+    for (z, (x, y)) in clear_zs.into_iter().zip(
+        clear_xs[range.clone()]
+            .iter()
+            .copied()
+            .zip(clear_ys[range].iter().copied()),
+    ) {
+        assert_eq!(z, x.wrapping_add(y));
+    }
+    fpga_key.disconnect();
+}
