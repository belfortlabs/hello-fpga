+fn integer_advanced_overflowing_add_assign_with_carry<P>(param: P)
+where
+    P: Into<TestParameters>,
+{
+    // We explicitly call the 4 bit function to make sure it's being tested,
+    let func = |sks: &BelfortServerKey, lhs: &RadixCiphertext, rhs: &RadixCiphertext| {
+        let mut result = lhs.clone();
+        if !result.block_carries_are_empty() {
+            sks.full_propagate(&mut result);
+        }
+        let mut tmp_rhs;
+        let rhs = if rhs.block_carries_are_empty() {
+            rhs
+        } else {
+            tmp_rhs = rhs.clone();
+            sks.full_propagate(&mut tmp_rhs);
+            &tmp_rhs
+        };
+        let overflowed = sks
+            .advanced_add_assign_with_carry(
+                &mut result.blocks,
+                &rhs.blocks,
+                None,
+                OutputFlag::Carry,
+                CarryPropagationAlgorithm::Automatic,
+            )
+            .unwrap();
+        (result, overflowed)
+    };
+    let executor = FpgaFunctionExecutor::new(&func);
+    default_overflowing_add_test(param, executor);
