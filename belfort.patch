+use tfhe::integer::fpga::BelfortServerKey;
+use tfhe::integer::keycache::KEY_CACHE;
+use tfhe::integer::{ClientKey, IntegerKeyKind, ServerKey};
+use tfhe::set_server_key;
+use tfhe::shortint::parameters::*;
+
+pub fn setup_fpga_keys() -> (ClientKey, ServerKey, BelfortServerKey) {
+    let (cks, sks) =
+        KEY_CACHE.get_from_params(PARAM_MESSAGE_2_CARRY_2_KS_PBS, IntegerKeyKind::Radix);
+    let mut fpga_key = BelfortServerKey::from(&sks);
+
+    let fpga_indexes = vec![0];
+    fpga_key.connect_to(fpga_indexes);
+    set_server_key(fpga_key.clone());
+    (cks, sks, fpga_key)
+}
