+    pub fn unchecked_scalar_compare_handler<T, Scalar, F>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        let comparison = self.unchecked_scalar_compare(lhs, rhs, selector, sign_result_handler_fn);
+        BooleanBlock::new_unchecked(comparison)
+    }
+    fn default_scalar_compare_parallelized<T, Scalar, F>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        let mut tmp_lhs;
+        let lhs = if lhs.block_carries_are_empty() {
+            lhs
+        } else {
+            tmp_lhs = lhs.clone();
+            self.server_key.full_propagate(&mut tmp_lhs);
+            &tmp_lhs
+        };
+        self.unchecked_scalar_compare_handler(lhs, rhs, selector, sign_result_handler_fn)
+    }
+    fn unchecked_scalar_compare<T, Scalar, F>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> Ciphertext
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        // TODO: change this for signed integers,
+        // Look up radix_parallel/scalar_comparison.rs
+        self.unsigned_unchecked_scalar_compare_blocks(
+            lhs.blocks(),
+            rhs,
+            selector,
+            sign_result_handler_fn,
+        )
+    }
+
+    fn unsigned_unchecked_scalar_compare_blocks<Scalar, F>(
+        &self,
+        lhs_blocks: &[Ciphertext],
+        rhs: Scalar,
+        selector: ComparisonSelector,
+        sign_result_handler_fn: F,
+    ) -> Ciphertext
+    where
+        Scalar: DecomposableInto<u64>,
+        F: Fn(u64) -> u64 + Sync,
+    {
+        assert!(!lhs_blocks.is_empty());
+        let shortint_key = &self.server_key.key.key.key;
+        if rhs < Scalar::ZERO {
+            // lhs_blocks represent an unsigned (always >= 0)
+            return shortint_key
+                .create_trivial(sign_result_handler_fn(BaseComparator::IS_SUPERIOR));
+        }
+
+        let message_modulus = shortint_key.message_modulus.0;
+
+        let mut scalar_blocks =
+            BlockDecomposer::with_early_stop_at_zero(rhs, message_modulus.ilog2())
+                .iter_as::<u64>()
+                .map(|x| x as u8)
+                .collect::<Vec<_>>();
+
+        // scalar is obviously bigger if it has non-zero
+        // blocks  after lhs's last block
+        let is_scalar_obviously_bigger = scalar_blocks
+            .get(lhs_blocks.len()..)
+            .is_some_and(|sub_slice| sub_slice.iter().any(|&scalar_block| scalar_block != 0));
+        if is_scalar_obviously_bigger {
+            return shortint_key
+                .create_trivial(sign_result_handler_fn(BaseComparator::IS_INFERIOR));
+        }
+        // If we are sill here, that means scalar_blocks above
+        // num_blocks are 0s, we can remove them
+        // as we will handle them separately.
+        scalar_blocks.truncate(lhs_blocks.len());
+
+        let (least_significant_blocks, most_significant_blocks) =
+            lhs_blocks.split_at(scalar_blocks.len());
+
+        // Reducing the signs is the bottleneck of the comparison algorithms,
+        // however if the scalar case there is an improvement:
+        //
+        // The idea is to reduce the number of signs block we have to
+        // reduce. We can do that by splitting the comparison problem in two parts.
+        //
+        // - One part where we compute the signs block between the scalar with just enough blocks
+        //   from the ciphertext that can represent the scalar value
+        //
+        // - The other part is to compare the ciphertext blocks not considered for the sign
+        //   computation with zero, and create a single sign block from that.
+        //
+        // The smaller the scalar value is compared to the ciphertext num bits encrypted,
+        // the more the comparisons with zeros we have to do,
+        // and the less signs block we will have to reduce.
+        //
+        // This will create a speedup as comparing a bunch of blocks with 0
+        // is faster
+
+        match (
+            least_significant_blocks.is_empty(),
+            most_significant_blocks.is_empty(),
+        ) {
+            (false, false) => {
+                // We have to handle both part of the work described above
+
+                let (lsb_sign, are_all_msb_equal_to_zero) = (
+                    {
+                        let lsb_signs = self.unchecked_scalar_block_slice_compare_parallelized(
+                            least_significant_blocks,
+                            &scalar_blocks,
+                        );
+
+                        self.reduce_signs_pack(lsb_signs, &ComparisonSelector::None)
+                    },
+                    self.server_key.are_all_blocks_zero(most_significant_blocks),
+                );
+
+                let lut = self.scalar_cmp_selector_lut(selector);
+
+                let mut prepared_blocks = self
+                    .server_key
+                    .prepare_block_vecs_bivariate(&[lsb_sign], &[are_all_msb_equal_to_zero]);
+
+                self.server_key
+                    .apply_lookup_vector_packed_assign(&mut prepared_blocks, &[&lut]);
+
+                prepared_blocks[0].clone()
+            }
+            (false, true) => {
+                // We only have to do the regular comparison
+                // And not the part where we compare most significant blocks with zeros
+
+                let signs = self.unchecked_scalar_block_slice_compare_parallelized(
+                    least_significant_blocks,
+                    &scalar_blocks,
+                );
+
+                self.reduce_signs_pack(signs, &selector)
+            }
+            (true, false) => {
+                // We only have to compare blocks with zero
+                // means scalar is zero
+                let are_all_msb_equal_to_zero =
+                    self.server_key.are_all_blocks_zero(most_significant_blocks);
+
+                let lut = self.scalar_cmp_selector_lut(selector);
+                let luts = vec![&lut];
+
+                let mut blocks = vec![are_all_msb_equal_to_zero];
+                self.server_key
+                    .apply_lookup_vector_packed_assign(&mut blocks, &luts);
+
+                blocks[0].clone()
+            }
+            (true, true) => {
+                // assert should have  been hit earlier
+                unreachable!("Empty input ciphertext")
+            }
+        }
+    }
+
+    fn unchecked_scalar_block_slice_compare_parallelized(
+        &self,
+        lhs_blocks: &[Ciphertext],
+        scalar_blocks: &[u8],
+    ) -> Vec<Ciphertext> {
+        assert_eq!(lhs_blocks.len(), scalar_blocks.len());
+
+        let shortint_key = &self.server_key.key.key.key;
+        let message_modulus = shortint_key.message_modulus.0;
+
+        let mut signs: Vec<_> = lhs_blocks
+            .chunks(2)
+            .zip(scalar_blocks.chunks(2))
+            .map(|(lhs_chunk, scalar_chunk)| {
+                let packed_scalar = scalar_chunk[0]
+                    + (scalar_chunk.get(1).copied().unwrap_or(0) * message_modulus as u8);
+                let mut packed_lhs = self.pack_block_chunk(lhs_chunk);
+
+                let delta = (1u64 << (u64::BITS as u64 - 1))
+                    / (packed_lhs.carry_modulus.0 * packed_lhs.message_modulus.0);
+                let plaintext = Plaintext((packed_scalar as u64) * delta);
+
+                lwe_ciphertext_plaintext_sub_assign(&mut packed_lhs.ct, plaintext);
+                packed_lhs
+            })
+            .collect();
+
+        self.server_key
+            .apply_same_lookup_vector_packed_assign(&mut signs, &self.sign_lut);
+
+        for signs_block in signs.iter_mut() {
+            shortint_key.unchecked_scalar_add_assign(signs_block, 1);
+        }
+
+        signs
+    }
+
+    pub fn scalar_max<T, Scalar>(&self, lhs: &T, rhs: Scalar) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+    {
+        let mut tmp_lhs;
+        let lhs = if lhs.block_carries_are_empty() {
+            lhs
+        } else {
+            tmp_lhs = lhs.clone();
+            self.server_key.full_propagate(&mut tmp_lhs);
+            &tmp_lhs
+        };
+        self.unchecked_scalar_min_or_max(lhs, rhs, MinMaxSelector::Max)
+    }
+
+    pub fn scalar_min<T, Scalar>(&self, lhs: &T, rhs: Scalar) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+    {
+        let mut tmp_lhs;
+        let lhs = if lhs.block_carries_are_empty() {
+            lhs
+        } else {
+            tmp_lhs = lhs.clone();
+            self.server_key.full_propagate(&mut tmp_lhs);
+            &tmp_lhs
+        };
+        self.unchecked_scalar_min_or_max(lhs, rhs, MinMaxSelector::Min)
+    }
+
+    pub fn unchecked_scalar_min_or_max<T, Scalar>(
+        &self,
+        lhs: &T,
+        rhs: Scalar,
+        selector: MinMaxSelector,
+    ) -> T
+    where
+        T: IntegerRadixCiphertext,
+        Scalar: DecomposableInto<u64>,
+    {
+        let return_lhs = match selector {
+            MinMaxSelector::Max => self.unchecked_scalar_gt(lhs, rhs),
+            MinMaxSelector::Min => self.unchecked_scalar_le(lhs, rhs),
+        };
+
+        let rhs = self
+            .server_key
+            .key
+            .key
+            .create_trivial_radix(rhs, lhs.blocks().len());
+
+        let do_clean_message = true;
+        self.server_key.unchecked_programmable_if_then_else(
+            &return_lhs.0,
+            lhs,
+            &rhs,
+            |x| x == 1,
+            do_clean_message,
+        )
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/comparator_simd.rs b/tfhe/src/integer/fpga/server_key/comparator_simd.rs
new file mode 100644
index 000000000..f08dbf4a9
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/comparator_simd.rs
@@ -0,0 +1,569 @@
+use crate::core_crypto::algorithms::lwe_ciphertext_sub_assign;
+use crate::core_crypto::fpga::lookup_vector::LookupVector;
+use crate::integer::ciphertext::boolean_value::BooleanBlock;
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::comparator::{Comparator, ComparisonSelector};
+use crate::integer::server_key::comparator::MinMaxSelector;
+use crate::shortint::ciphertext::Degree;
+use crate::shortint::Ciphertext;
+
+impl Comparator<'_> {
+    fn compare_blocks_with_sign_bit_simd<T>(
+        &self,
+        lhs_array: &[T],
+        rhs_array: &[T],
+    ) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut packed_blocks: Vec<Ciphertext> = lhs_array
+            .iter()
+            .zip(rhs_array.iter())
+            .map(|(l, r)| {
+                let lhs_msb = l.blocks().last().unwrap();
+                let rhs_msb = r.blocks().last().unwrap();
+                let mut result = lhs_msb.clone();
+                self.pack_block_assign(rhs_msb, &mut result);
+                result
+            })
+            .collect();
+
+        self.server_key.apply_same_lookup_vector_packed_assign(
+            &mut packed_blocks,
+            &self.compare_with_sign_bits_lut,
+        );
+
+        packed_blocks
+    }
+
+    fn compare_blocks_pack_simd<T>(
+        &self,
+        lhs_array: &[T],
+        rhs_array: &[T],
+        start_block: usize,
+        num_blocks: usize,
+    ) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs_array.len();
+        let shortint_key = &self.server_key.key.key.key;
+
+        if num_blocks == 0 {
+            return vec![];
+        }
+
+        let num_pairs = num_blocks / 2;
+        let has_remainder = num_blocks % 2 == 1;
+
+        let mut all_packed: Vec<Ciphertext> = Vec::with_capacity(2 * num_comparisons * num_pairs);
+        for ct in lhs_array.iter() {
+            let blocks = ct.blocks();
+            for pair_idx in 0..num_pairs {
+                let chunk = &blocks[start_block + pair_idx * 2..start_block + pair_idx * 2 + 2];
+                all_packed.push(self.pack_block_chunk(chunk));
+            }
+        }
+        for ct in rhs_array.iter() {
+            let blocks = ct.blocks();
+            for pair_idx in 0..num_pairs {
+                let chunk = &blocks[start_block + pair_idx * 2..start_block + pair_idx * 2 + 2];
+                all_packed.push(self.pack_block_chunk(chunk));
+            }
+        }
+
+        if !all_packed.is_empty() {
+            let lut_identity = self.server_key.lut_identity();
+            self.server_key
+                .apply_same_lookup_vector_packed_assign(&mut all_packed, &lut_identity);
+        }
+
+        let rhs_packed = all_packed.split_off(num_comparisons * num_pairs);
+        let lhs_packed = all_packed;
+
+        let sign_blocks_per_ct = num_pairs + if has_remainder { 1 } else { 0 };
+        let mut lhs_final = Vec::with_capacity(num_comparisons * sign_blocks_per_ct);
+        let mut rhs_final = Vec::with_capacity(num_comparisons * sign_blocks_per_ct);
+        for i in 0..num_comparisons {
+            let packed_start = i * num_pairs;
+            lhs_final.extend_from_slice(&lhs_packed[packed_start..packed_start + num_pairs]);
+            rhs_final.extend_from_slice(&rhs_packed[packed_start..packed_start + num_pairs]);
+            if has_remainder {
+                lhs_final.push(lhs_array[i].blocks()[start_block + num_blocks - 1].clone());
+                rhs_final.push(rhs_array[i].blocks()[start_block + num_blocks - 1].clone());
+            }
+        }
+
+        lhs_final
+            .iter_mut()
+            .zip(rhs_final.iter())
+            .for_each(|(l, r)| {
+                lwe_ciphertext_sub_assign(&mut l.ct, &r.ct);
+                l.set_noise_level(
+                    l.noise_level() + r.noise_level(),
+                    shortint_key.max_noise_level,
+                );
+            });
+
+        self.server_key
+            .apply_same_lookup_vector_packed_assign(&mut lhs_final, &self.sign_lut);
+
+        for block in lhs_final.iter_mut() {
+            shortint_key.unchecked_scalar_add_assign(block, 1);
+        }
+
+        lhs_final
+    }
+
+    fn tree_reduce_signs_simd(
+        &self,
+        mut sign_blocks: Vec<Ciphertext>,
+        num_comparisons: usize,
+        mut sign_blocks_per_comparison: usize,
+    ) -> (Vec<Ciphertext>, usize) {
+        while sign_blocks_per_comparison > 2 {
+            let pairs_per_ct = sign_blocks_per_comparison / 2;
+            let nb_remainder_blocks = sign_blocks_per_comparison % 2;
+            let new_blocks_per_ct = pairs_per_ct + nb_remainder_blocks;
+
+            let mut packed_blocks = Vec::with_capacity(num_comparisons * pairs_per_ct);
+            let mut remainder_blocks = Vec::with_capacity(nb_remainder_blocks * num_comparisons);
+
+            for comp_idx in 0..num_comparisons {
+                let base = comp_idx * sign_blocks_per_comparison;
+                for pair_idx in 0..pairs_per_ct {
+                    let chunk_start = base + pair_idx * 2;
+                    packed_blocks
+                        .push(self.pack_block_chunk(&sign_blocks[chunk_start..chunk_start + 2]));
+                }
+                if nb_remainder_blocks == 1 {
+                    remainder_blocks
+                        .push(sign_blocks[base + sign_blocks_per_comparison - 1].clone());
+                }
+            }
+
+            self.server_key.apply_same_lookup_vector_packed_assign(
+                &mut packed_blocks,
+                &self.comparison_reduction_lut,
+            );
+
+            let mut new_sign_blocks = Vec::with_capacity(num_comparisons * new_blocks_per_ct);
+            let mut remainder_iter = remainder_blocks.into_iter();
+            for comp_idx in 0..num_comparisons {
+                let packed_start = comp_idx * pairs_per_ct;
+                new_sign_blocks
+                    .extend_from_slice(&packed_blocks[packed_start..packed_start + pairs_per_ct]);
+                if nb_remainder_blocks == 1 {
+                    new_sign_blocks.push(remainder_iter.next().unwrap());
+                }
+            }
+
+            sign_blocks = new_sign_blocks;
+            sign_blocks_per_comparison = new_blocks_per_ct;
+        }
+
+        (sign_blocks, sign_blocks_per_comparison)
+    }
+
+    fn compute_all_sign_blocks_simd<T>(
+        &self,
+        lhs_array: &[T],
+        rhs_array: &[T],
+    ) -> (Vec<Ciphertext>, usize)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs_array.len();
+        let blocks_per_ct = lhs_array[0].blocks().len();
+
+        if T::IS_SIGNED {
+            let lower_blocks = blocks_per_ct - 1;
+            let (lower_sign_blocks, lower_sign_count) = if lower_blocks > 0 {
+                let sign_blocks =
+                    self.compare_blocks_pack_simd(lhs_array, rhs_array, 0, lower_blocks);
+                let count = lower_blocks.div_ceil(2);
+                (sign_blocks, count)
+            } else {
+                (vec![], 0)
+            };
+
+            let msb_comparisons = self.compare_blocks_with_sign_bit_simd(lhs_array, rhs_array);
+
+            let total_per_ct = lower_sign_count + 1;
+            let mut all = Vec::with_capacity(num_comparisons * total_per_ct);
+            for (i, msb_comparison) in msb_comparisons.iter().enumerate().take(num_comparisons) {
+                let start = i * lower_sign_count;
+                all.extend_from_slice(&lower_sign_blocks[start..start + lower_sign_count]);
+                all.push(msb_comparison.clone());
+            }
+            (all, total_per_ct)
+        } else {
+            let sign_blocks = self.compare_blocks_pack_simd(lhs_array, rhs_array, 0, blocks_per_ct);
+            let per_ct = blocks_per_ct.div_ceil(2);
+            (sign_blocks, per_ct)
+        }
+    }
+
+    fn apply_final_reduction_simd(
+        &self,
+        sign_blocks: Vec<Ciphertext>,
+        num_comparisons: usize,
+        blocks_per_ct: usize,
+        lut_fn: impl Fn(bool) -> LookupVector,
+    ) -> Vec<Ciphertext> {
+        let needs_pack = blocks_per_ct == 2;
+        let lut = lut_fn(needs_pack);
+
+        let mut final_blocks = if needs_pack {
+            (0..num_comparisons)
+                .map(|i| self.pack_block_chunk(&sign_blocks[i * 2..i * 2 + 2]))
+                .collect()
+        } else {
+            sign_blocks
+        };
+
+        self.server_key
+            .apply_same_lookup_vector_packed_assign(&mut final_blocks, &lut);
+        final_blocks
+    }
+
+    fn reduce_signs_pack_simd(
+        &self,
+        sign_blocks: Vec<Ciphertext>,
+        num_comparisons: usize,
+        sign_blocks_per_comparison: usize,
+        selector: &ComparisonSelector,
+    ) -> Vec<Ciphertext> {
+        let (sign_blocks, blocks_per_ct) =
+            self.tree_reduce_signs_simd(sign_blocks, num_comparisons, sign_blocks_per_comparison);
+
+        self.apply_final_reduction_simd(sign_blocks, num_comparisons, blocks_per_ct, |needs_pack| {
+            self.get_selector_lut(selector, needs_pack)
+        })
+    }
+
+    fn unchecked_compare_simd<T>(
+        &self,
+        lhs_array: &[T],
+        rhs_array: &[T],
+        selector: &ComparisonSelector,
+    ) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs_array.len();
+        assert_eq!(num_comparisons, rhs_array.len());
+        if num_comparisons == 0 {
+            return vec![];
+        }
+
+        assert!(!lhs_array[0].blocks().is_empty());
+
+        let (all_sign_blocks, sign_blocks_per_comparison) =
+            self.compute_all_sign_blocks_simd(lhs_array, rhs_array);
+
+        self.reduce_signs_pack_simd(
+            all_sign_blocks,
+            num_comparisons,
+            sign_blocks_per_comparison,
+            selector,
+        )
+    }
+
+    fn smart_compare_simd<T>(
+        &self,
+        lhs: &mut [T],
+        rhs: &mut [T],
+        selector: &ComparisonSelector,
+    ) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        lhs.iter_mut()
+            .zip(rhs.iter_mut())
+            .for_each(|(l, r)| self.server_key.conditional_full_propagate_bivariate(l, r));
+        self.unchecked_compare_simd(lhs, rhs, selector)
+    }
+
+    fn unchecked_compare_for_min_max_simd<T>(
+        &self,
+        lhs_array: &[T],
+        rhs_array: &[T],
+    ) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs_array.len();
+
+        let (all_sign_blocks, sign_blocks_per_comparison) =
+            self.compute_all_sign_blocks_simd(lhs_array, rhs_array);
+
+        let (sign_blocks, blocks_per_ct) = self.tree_reduce_signs_simd(
+            all_sign_blocks,
+            num_comparisons,
+            sign_blocks_per_comparison,
+        );
+
+        self.apply_final_reduction_simd(sign_blocks, num_comparisons, blocks_per_ct, |needs_pack| {
+            self.minmax_reduce_lut(needs_pack)
+        })
+    }
+
+    fn unchecked_min_or_max_simd<T>(
+        &self,
+        lhs_array: &[T],
+        rhs_array: &[T],
+        selector: MinMaxSelector,
+    ) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_comparisons = lhs_array.len();
+        assert_eq!(num_comparisons, rhs_array.len());
+        if num_comparisons == 0 {
+            return vec![];
+        }
+
+        let blocks_per_ct = lhs_array[0].blocks().len();
+        let shortint_key = &self.server_key.key.key.key;
+        let message_modulus = shortint_key.message_modulus.0;
+
+        let offsets = self.unchecked_compare_for_min_max_simd(lhs_array, rhs_array);
+
+        let total_per_side = num_comparisons * blocks_per_ct;
+        let mut lhs_rhs_blocks: Vec<Ciphertext> = Vec::with_capacity(2 * total_per_side);
+        for (comp_idx, offset) in offsets.iter().enumerate() {
+            for block in lhs_array[comp_idx].blocks().iter() {
+                lhs_rhs_blocks.push(shortint_key.unchecked_add(block, offset));
+            }
+        }
+        for (comp_idx, offset) in offsets.iter().enumerate() {
+            for block in rhs_array[comp_idx].blocks().iter() {
+                lhs_rhs_blocks.push(shortint_key.unchecked_add(block, offset));
+            }
+        }
+
+        let (lhs_lut, rhs_lut) = match selector {
+            MinMaxSelector::Max => (&self.lhs_lut, &self.rhs_lut),
+            MinMaxSelector::Min => (&self.rhs_lut, &self.lhs_lut),
+        };
+
+        let luts: Vec<&LookupVector> = std::iter::repeat_n(lhs_lut, total_per_side)
+            .chain(std::iter::repeat_n(rhs_lut, total_per_side))
+            .collect();
+
+        self.server_key
+            .apply_lookup_vector_packed_assign(&mut lhs_rhs_blocks, &luts);
+
+        let (lhs_results, rhs_results) = lhs_rhs_blocks.split_at(total_per_side);
+        (0..num_comparisons)
+            .map(|comp_idx| {
+                let blocks: Vec<Ciphertext> = (0..blocks_per_ct)
+                    .map(|j| {
+                        let idx = comp_idx * blocks_per_ct + j;
+                        let mut result =
+                            shortint_key.unchecked_add(&lhs_results[idx], &rhs_results[idx]);
+                        result.degree = Degree::new(message_modulus - 1);
+                        result
+                    })
+                    .collect();
+                T::from_blocks(blocks)
+            })
+            .collect()
+    }
+
+    fn smart_min_or_max_simd<T>(
+        &self,
+        lhs: &mut [T],
+        rhs: &mut [T],
+        selector: MinMaxSelector,
+    ) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        lhs.iter_mut()
+            .zip(rhs.iter_mut())
+            .for_each(|(l, r)| self.server_key.conditional_full_propagate_bivariate(l, r));
+        self.unchecked_min_or_max_simd(lhs, rhs, selector)
+    }
+
+    //======================================
+    // Smart SIMD operations
+    //======================================
+
+    pub fn smart_gt_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.smart_compare_simd(lhs, rhs, &ComparisonSelector::Gt)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn smart_ge_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.smart_compare_simd(lhs, rhs, &ComparisonSelector::Ge)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn smart_lt_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.smart_compare_simd(lhs, rhs, &ComparisonSelector::Lt)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn smart_le_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.smart_compare_simd(lhs, rhs, &ComparisonSelector::Le)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn smart_max_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.smart_min_or_max_simd(lhs, rhs, MinMaxSelector::Max)
+    }
+
+    pub fn smart_min_simd<T>(&self, lhs: &mut [T], rhs: &mut [T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.smart_min_or_max_simd(lhs, rhs, MinMaxSelector::Min)
+    }
+
+    //======================================
+    // Default SIMD operations
+    //======================================
+
+    pub fn gt_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs, rhs) = self
+            .server_key
+            .conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_gt_simd(&lhs, &rhs)
+    }
+
+    pub fn ge_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs, rhs) = self
+            .server_key
+            .conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_ge_simd(&lhs, &rhs)
+    }
+
+    pub fn lt_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs, rhs) = self
+            .server_key
+            .conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_lt_simd(&lhs, &rhs)
+    }
+
+    pub fn le_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs, rhs) = self
+            .server_key
+            .conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_le_simd(&lhs, &rhs)
+    }
+
+    pub fn max_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs, rhs) = self
+            .server_key
+            .conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_max_simd(&lhs, &rhs)
+    }
+
+    pub fn min_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs, rhs) = self
+            .server_key
+            .conditional_full_propagate_bivariate_arrays_cow(lhs, rhs);
+        self.unchecked_min_simd(&lhs, &rhs)
+    }
+
+    //======================================
+    // Unchecked SIMD operations
+    //======================================
+
+    pub fn unchecked_gt_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.unchecked_compare_simd(lhs, rhs, &ComparisonSelector::Gt)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn unchecked_ge_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.unchecked_compare_simd(lhs, rhs, &ComparisonSelector::Ge)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn unchecked_lt_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.unchecked_compare_simd(lhs, rhs, &ComparisonSelector::Lt)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn unchecked_le_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<BooleanBlock>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.unchecked_compare_simd(lhs, rhs, &ComparisonSelector::Le)
+            .into_iter()
+            .map(BooleanBlock::new_unchecked)
+            .collect()
+    }
+
+    pub fn unchecked_max_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.unchecked_min_or_max_simd(lhs, rhs, MinMaxSelector::Max)
+    }
+
+    pub fn unchecked_min_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.unchecked_min_or_max_simd(lhs, rhs, MinMaxSelector::Min)
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/fpga.rs b/tfhe/src/integer/fpga/server_key/fpga.rs
new file mode 100644
index 000000000..c20e520cc
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/fpga.rs
@@ -0,0 +1,212 @@
+use crate::core_crypto::fpga::lookup_vector::{LookupVector, ManyLookupVector};
+use crate::core_crypto::fpga::programmable_bootstrap::ProgrammableBootstrapPacked;
+use crate::high_level_api::keys::IntegerServerKey;
+use crate::high_level_api::Tag;
+use crate::shortint::Ciphertext;
+use crate::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn connect(&mut self) {
+        #[cfg(not(feature = "emulate_fpga"))]
+        {
+            use crate::core_crypto::fpga::utils::Connect;
+
+            let server_key = &self.key.key.key;
+
+            self.utils.connect(server_key);
+        }
+    }
+
+    pub fn connect_to(&mut self, fpga_indexes: Vec<usize>) {
+        #[cfg(not(feature = "emulate_fpga"))]
+        {
+            use crate::core_crypto::fpga::utils::Connect;
+
+            let server_key = &self.key.key.key;
+
+            self.utils.connect_to(server_key, fpga_indexes);
+        }
+    }
+
+    pub fn disconnect(&mut self) {
+        #[cfg(not(feature = "emulate_fpga"))]
+        self.utils.disconnect();
+    }
+
+    pub fn pbs_key(&self) -> &crate::integer::ServerKey {
+        &self.key.key
+    }
+
+    pub fn tag(&self) -> &Tag {
+        &self.tag
+    }
+
+    #[cfg(not(feature = "emulate_fpga"))]
+    pub fn apply_programmable_bootstrap_on_trivial(
+        &self,
+        cts: &mut Vec<Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        use rayon::iter::*;
+        use std::sync::Arc;
+
+        let arc_key: &Arc<IntegerServerKey> = &self.key;
+        let shortint_key = &arc_key.key.key;
+
+        cts.par_iter_mut()
+            .enumerate()
+            .filter(|(_, ct)| ct.is_trivial())
+            .for_each(|(index, ct)| {
+                let lut_vector = &luts[index];
+                let lut_table = shortint_key.convert_lookup_vector_to_lookup_table(lut_vector);
+                shortint_key.trivial_pbs_assign(ct, &lut_table);
+            });
+    }
+
+    #[cfg(not(feature = "emulate_fpga"))]
+    fn apply_many_lut_programmable_bootstrap_on_trivial(
+        &self,
+        cts: &[Ciphertext],
+        luts: &[&ManyLookupVector],
+    ) -> Vec<Vec<Ciphertext>> {
+        use rayon::iter::*;
+        use std::sync::Arc;
+
+        let arc_key: &Arc<IntegerServerKey> = &self.key;
+        let shortint_key = &arc_key.key.key;
+
+        let mut output: Vec<Vec<Ciphertext>> = vec![vec![]; cts.len()];
+        let result = cts
+            .par_iter()
+            .enumerate()
+            .filter(|(_, ct)| ct.is_trivial())
+            .map(|(index, ct)| {
+                let lut_vector = &luts[index];
+                let lut_table =
+                    shortint_key.convert_many_lookup_vector_to_many_lookup_table(lut_vector);
+                (index, shortint_key.trivial_pbs_many_lut(ct, &lut_table))
+            })
+            .collect::<Vec<_>>();
+
+        for (index, ct_res) in result {
+            output[index] = ct_res;
+        }
+        output
+    }
+
+    pub fn apply_lookup_vector_packed_assign(
+        &self,
+        cts: &mut Vec<Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        assert!(
+            cts.len() == luts.len(),
+            "Ciphertext and LUT length should be the same!"
+        );
+
+        #[cfg(not(feature = "emulate_fpga"))]
+        {
+            self.apply_programmable_bootstrap_on_trivial(cts, luts);
+            self.programmable_bootstrap_packed(cts, luts);
+        }
+
+        #[cfg(feature = "emulate_fpga")]
+        {
+            let shortint_key = &self.key.key.key;
+            shortint_key.apply_lookup_vector_packed_assign(cts, luts);
+        }
+    }
+
+    pub fn apply_many_lookup_vector_packed(
+        &self,
+        cts: &[Ciphertext],
+        luts: &[&ManyLookupVector],
+    ) -> Vec<Vec<Ciphertext>> {
+        assert!(
+            cts.len() == luts.len(),
+            "Ciphertext {} and LUT {} length should be the same!",
+            cts.len(),
+            luts.len()
+        );
+
+        #[cfg(not(feature = "emulate_fpga"))]
+        return {
+            let mut output = self.apply_many_lut_programmable_bootstrap_on_trivial(cts, luts);
+            self.programmable_bootstrap_packed_many_lut(cts, &mut output, luts);
+            output
+        };
+
+        #[cfg(feature = "emulate_fpga")]
+        return {
+            let shortint_key = &self.key.key.key;
+            shortint_key.apply_many_lookup_vector_packed(cts, luts)
+        };
+    }
+
+    pub fn apply_same_many_lookup_vector_packed(
+        &self,
+        cts: &[Ciphertext],
+        lut: &ManyLookupVector,
+    ) -> Vec<Vec<Ciphertext>> {
+        let luts = vec![lut; cts.len()];
+
+        self.apply_many_lookup_vector_packed(cts, &luts)
+    }
+
+    pub fn apply_same_lookup_vector_packed_assign(
+        &self,
+        ciphertexts: &mut Vec<Ciphertext>,
+        lut: &LookupVector,
+    ) {
+        let luts = vec![lut; ciphertexts.len()];
+
+        self.apply_lookup_vector_packed_assign(ciphertexts, &luts);
+    }
+
+    pub fn apply_lookup_vector_single_assign(
+        &self,
+        ciphertext: &mut Ciphertext,
+        lut: &LookupVector,
+    ) {
+        let mut cts = vec![ciphertext.clone()];
+
+        self.apply_lookup_vector_packed_assign(&mut cts, &[lut]);
+
+        ciphertext.clone_from(cts.first().unwrap());
+    }
+
+    pub fn apply_same_lookup_vector_mut_packed_assign(
+        &self,
+        ciphertexts: &mut Vec<&mut Ciphertext>,
+        lut: &LookupVector,
+    ) {
+        let luts = vec![lut; ciphertexts.len()];
+
+        self.apply_lookup_vector_mut_packed_assign(ciphertexts, &luts);
+    }
+
+    pub fn apply_lookup_vector_mut_packed_assign(
+        &self,
+        ciphertext: &mut Vec<&mut Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        let mut ct_vec: Vec<Ciphertext> = ciphertext
+            .iter_mut()
+            .map(|block| (*block).clone())
+            .collect();
+
+        #[cfg(feature = "fpga")]
+        self.apply_lookup_vector_packed_assign(&mut ct_vec, luts);
+
+        #[cfg(not(feature = "fpga"))]
+        {
+            let shortint_key = &self.key.key.key;
+            shortint_key.apply_lookup_vector_packed_assign(&mut ct_vec, luts);
+        }
+
+        ciphertext
+            .iter_mut()
+            .enumerate()
+            .for_each(|(i, block)| (*block).clone_from(&ct_vec[i]));
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/luts.rs b/tfhe/src/integer/fpga/server_key/luts.rs
new file mode 100644
index 000000000..bea3cea22
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/luts.rs
@@ -0,0 +1,47 @@
+use crate::core_crypto::fpga::lookup_vector::{LookupVector, ManyLookupVector};
+use crate::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn lut_identity(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x| x;
+        shortint_key.generate_lookup_vector(&func)
+    }
+
+    pub fn lut_message_extract(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x| x % shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector(&func)
+    }
+
+    pub fn lut_carry_extract(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x| x / shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector(&func)
+    }
+
+    pub fn many_lut_message_and_carry_extract(&self) -> ManyLookupVector {
+        let shortint_key = &self.key.key.key;
+        let msg_extract = |x| x % shortint_key.message_modulus.0;
+        let carry_extract = |x| x / shortint_key.message_modulus.0;
+        shortint_key.generate_many_lookup_vector(&[&msg_extract, &carry_extract])
+    }
+
+    pub fn lut_mul_2lsb(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x, y| (x * y) % shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector_bivariate(&func)
+    }
+
+    pub fn lut_mul_2msb(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x, y| (x * y) / shortint_key.message_modulus.0;
+        shortint_key.generate_lookup_vector_bivariate(&func)
+    }
+
+    pub fn lut_bitxor(&self) -> LookupVector {
+        let shortint_key = &self.key.key.key;
+        let func = |x, y| x ^ y;
+        shortint_key.generate_lookup_vector_bivariate(&func)
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/mod.rs b/tfhe/src/integer/fpga/server_key/mod.rs
new file mode 100644
index 000000000..ed0a02f46
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/mod.rs
@@ -0,0 +1,440 @@
+mod comparator;
+mod comparator_simd;
+mod fpga;
+mod luts;
+pub(crate) mod radix;
+mod server;
+
+use std::borrow::Cow;
+use std::sync::Arc;
+
+use rayon::prelude::*;
+
+use crate::core_crypto::commons::numeric::UnsignedInteger;
+use crate::core_crypto::fpga::BelfortFpgaUtils;
+use crate::high_level_api::keys::inner::IntegerServerKey;
+use crate::high_level_api::keys::ServerKey;
+use crate::high_level_api::Tag;
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::server_key::radix_parallel::OutputFlag;
+use crate::integer::IntegerRadixCiphertext;
+use crate::shortint::Ciphertext;
+
+#[derive(Clone)]
+pub struct BelfortServerKey {
+    pub key: Arc<IntegerServerKey>,
+    pub utils: BelfortFpgaUtils,
+    pub tag: Tag,
+}
+
+unsafe impl Send for BelfortServerKey {}
+unsafe impl Sync for BelfortServerKey {}
+
+impl From<&ServerKey> for BelfortServerKey {
+    fn from(value: &ServerKey) -> Self {
+        let ServerKey { key, tag } = value.clone();
+        Self::default(key, tag)
+    }
+}
+
+impl From<&IntegerServerKey> for BelfortServerKey {
+    fn from(value: &IntegerServerKey) -> Self {
+        Self::default(Arc::new(value.clone()), Tag::default())
+    }
+}
+
+impl From<&crate::integer::ServerKey> for BelfortServerKey {
+    fn from(value: &crate::integer::ServerKey) -> Self {
+        let integer_server_key = IntegerServerKey {
+            key: value.clone(),
+            cpk_key_switching_key_material: None,
+            compression_key: None,
+            decompression_key: None,
+            noise_squashing_key: None,
+            noise_squashing_compression_key: None,
+            cpk_re_randomization_key_switching_key_material: None,
+        };
+        Self::default(Arc::new(integer_server_key), Tag::default())
+    }
+}
+
+impl From<Arc<crate::integer::ServerKey>> for BelfortServerKey {
+    fn from(value: Arc<crate::integer::ServerKey>) -> Self {
+        let server_key = Arc::unwrap_or_clone(value);
+        Self::from(&server_key)
+    }
+}
+
+impl BelfortServerKey {
+    pub fn default(key: Arc<IntegerServerKey>, tag: Tag) -> Self {
+        Self {
+            key,
+            tag,
+            utils: BelfortFpgaUtils::default(),
+        }
+    }
+
+    pub fn create_trivial_radix<T, C>(&self, value: T, num_blocks: usize) -> C
+    where
+        T: DecomposableInto<u64>,
+        C: IntegerRadixCiphertext + From<Vec<crate::shortint::Ciphertext>>,
+    {
+        self.key.key.create_trivial_radix(value, num_blocks)
+    }
+
+    pub fn conditional_full_propagate_bivariate<'a, T>(&self, lhs: &'a mut T, rhs: &'a mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.conditional_full_propagate(lhs);
+        self.conditional_full_propagate(rhs);
+    }
+
+    pub fn conditional_full_propagate_bivariate_arrays_cow<'a, T>(
+        &self,
+        lhs: &'a [T],
+        rhs: &'a [T],
+    ) -> (Cow<'a, [T]>, Cow<'a, [T]>)
+    where
+        T: IntegerRadixCiphertext + Clone,
+    {
+        let lhs = if lhs
+            .iter()
+            .all(|lhs_elem| lhs_elem.block_carries_are_empty())
+        {
+            Cow::Borrowed(lhs)
+        } else {
+            let mut tmp_lhs = lhs.to_vec();
+            for lhs_elem in tmp_lhs.iter_mut() {
+                self.conditional_full_propagate(lhs_elem);
+            }
+            Cow::Owned(tmp_lhs)
+        };
+
+        let rhs = if rhs
+            .iter()
+            .all(|rhs_elem| rhs_elem.block_carries_are_empty())
+        {
+            Cow::Borrowed(rhs)
+        } else {
+            let mut tmp_rhs = rhs.to_vec();
+            for rhs_elem in tmp_rhs.iter_mut() {
+                self.conditional_full_propagate(rhs_elem);
+            }
+            Cow::Owned(tmp_rhs)
+        };
+
+        (lhs, rhs)
+    }
+
+    pub fn conditional_full_propagate_bivariate_cow<'a, T>(
+        &self,
+        lhs: &'a T,
+        rhs: &'a T,
+    ) -> (Cow<'a, T>, Cow<'a, T>)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let lhs = if lhs.block_carries_are_empty() {
+            Cow::Borrowed(lhs)
+        } else {
+            let mut tmp = lhs.clone();
+            self.full_propagate(&mut tmp);
+            Cow::Owned(tmp)
+        };
+
+        let rhs = if rhs.block_carries_are_empty() {
+            Cow::Borrowed(rhs)
+        } else {
+            let mut tmp = rhs.clone();
+            self.full_propagate(&mut tmp);
+            Cow::Owned(tmp)
+        };
+
+        (lhs, rhs)
+    }
+
+    /// Executes a full propagate if there are carries.
+    pub fn conditional_full_propagate<T>(&self, term: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if !term.block_carries_are_empty() {
+            self.full_propagate(term);
+        }
+    }
+
+    pub fn full_propagate<T>(&self, ctxt: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let num_blocks = ctxt.blocks().len();
+        let start_index = ctxt
+            .blocks()
+            .iter()
+            .position(|block| !block.carry_is_empty())
+            .unwrap_or(num_blocks);
+
+        let (to_be_cleaned, to_be_propagated) = ctxt.blocks_mut().split_at_mut(start_index);
+
+        if !to_be_propagated.is_empty() {
+            self.partial_propagate_blocks(to_be_propagated);
+        }
+
+        if !to_be_cleaned.is_empty() {
+            let mut result = to_be_cleaned.to_vec();
+            self.apply_same_lookup_vector_packed_assign(&mut result, &self.lut_message_extract());
+            to_be_cleaned
+                .par_iter_mut()
+                .zip(result.par_iter())
+                .for_each(|(block, result_block)| block.clone_from(result_block));
+        }
+    }
+
+    /// This function takes an input slice of shortint ciphertext (aka blocks)
+    /// for which at most one bit of carry is consumed in each block, and
+    /// it does the carry propagation in place.
+    ///
+    /// It returns the output carry of the last block
+    ///
+    /// Used in (among other) 'default' addition:
+    /// - first unchecked_add
+    /// - at this point at most on bit of carry is taken
+    /// - use this function to propagate them in parallel
+    pub(crate) fn propagate_single_carry_parallelized_low_latency(
+        &self,
+        blocks: &mut [Ciphertext],
+    ) {
+        self.advanced_add_assign_with_carry_parallel(blocks, &[], None, OutputFlag::None);
+    }
+
+    /// Computes a prefix sum/scan in parallel using Naive Parallel Scan
+    pub(crate) fn compute_prefix_sum_hillis_steele<F>(
+        &self,
+        mut blocks: Vec<Ciphertext>,
+        lut_function: &F,
+    ) -> Vec<Ciphertext>
+    where
+        F: Fn(u64, u64) -> u64,
+    {
+        let shortint_key = &self.key.key.key;
+        debug_assert!(shortint_key.message_modulus.0 * shortint_key.carry_modulus.0 >= (1 << 4));
+
+        if blocks.is_empty() {
+            return vec![];
+        }
+
+        let lut_vector_sum = shortint_key.generate_lookup_vector_bivariate(&lut_function);
+
+        let mut space = 1;
+        let mut step_output = blocks.clone();
+
+        let num_blocks = blocks.len();
+        let num_steps = num_blocks.ceil_ilog2() as usize;
+        for _ in 0..num_steps {
+            // Copies carries
+            let mut prev_block_carries = Vec::with_capacity(num_blocks - space);
+            for block in blocks.iter().take(num_blocks - space) {
+                prev_block_carries.push(block.clone());
+            }
+
+            // Shifts block by space
+            let step_output_vec = &step_output[space..num_blocks];
+            let mut prepared_blocks =
+                self.prepare_block_vecs_bivariate(step_output_vec, &prev_block_carries);
+
+            self.apply_same_lookup_vector_packed_assign(&mut prepared_blocks, &lut_vector_sum);
+
+            for (i, block) in prepared_blocks.into_iter().enumerate() {
+                step_output[space + i] = block;
+            }
+
+            for i in space..num_blocks {
+                blocks[i].clone_from(&step_output[i]);
+            }
+
+            space *= 2;
+        }
+
+        blocks
+    }
+
+    pub fn propagate_parallelized<T>(&self, ctxt: &mut T, index: usize) -> Ciphertext
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (message_extract_lut, carry_extract_lut) =
+            (self.lut_message_extract(), self.lut_carry_extract());
+        let luts = vec![&carry_extract_lut, &message_extract_lut];
+
+        let block = &ctxt.blocks()[index];
+        let mut result = vec![block.clone(), block.clone()];
+        self.apply_lookup_vector_packed_assign(&mut result, &luts);
+
+        let [carry, message]: [Ciphertext; 2] = result.try_into().expect("Expect two elements!");
+        ctxt.blocks_mut()[index] = message;
+
+        if index < ctxt.blocks().len() - 1 {
+            let shortint_key = &self.key.key.key;
+            shortint_key.unchecked_add_assign(&mut ctxt.blocks_mut()[index + 1], &carry);
+        }
+        carry
+    }
+
+    fn partial_propagate_blocks(&self, blocks: &mut [Ciphertext]) {
+        let shortint_key = &self.key.key.key;
+        let highest_degree = blocks
+            .iter()
+            .map(|block| block.degree.get())
+            .max_by(|degree_a, degree_b| degree_a.cmp(degree_b))
+            .unwrap();
+
+        if highest_degree > (shortint_key.message_modulus.0 - 1) * 2 {
+            let (mut message_blocks, carry_blocks) = self.extract_message_and_carry_blocks(blocks);
+
+            blocks.swap_with_slice(&mut message_blocks);
+            blocks[1..]
+                .par_iter_mut()
+                .zip(carry_blocks.par_iter())
+                .for_each(|(block, carry)| {
+                    shortint_key.unchecked_add_assign(block, carry);
+                })
+        }
+
+        self.propagate_single_carry_parallelized_low_latency(blocks);
+    }
+
+    pub(crate) fn extract_message(&self, blocks: &Ciphertext) -> Ciphertext {
+        let message_extract_lut = self.lut_message_extract();
+        let luts = vec![&message_extract_lut];
+        let mut blocks = vec![blocks.clone()];
+        self.apply_lookup_vector_packed_assign(&mut blocks, &luts);
+        blocks.pop().unwrap()
+    }
+
+    pub(crate) fn extract_message_and_carry_blocks(
+        &self,
+        blocks: &[Ciphertext],
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let num_blocks = blocks.len();
+        let mut luts = Vec::with_capacity(2 * num_blocks);
+        let (message_extract_lut, carry_extract_lut) =
+            (self.lut_message_extract(), self.lut_carry_extract());
+        luts.extend(std::iter::repeat_n(&message_extract_lut, num_blocks));
+        luts.extend(std::iter::repeat_n(&carry_extract_lut, num_blocks));
+
+        let mut prepared_blocks = Vec::with_capacity(2 * num_blocks);
+        prepared_blocks.extend(blocks.to_owned());
+        prepared_blocks.extend(blocks.to_owned());
+
+        self.apply_lookup_vector_packed_assign(&mut prepared_blocks, &luts);
+
+        let (messages, carries) = prepared_blocks.split_at(num_blocks);
+
+        (messages.to_vec(), carries.to_vec())
+    }
+
+    pub fn prepare_block_vecs_bivariate(
+        &self,
+        lhs_blocks: &[Ciphertext],
+        rhs_blocks: &[Ciphertext],
+    ) -> Vec<Ciphertext> {
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        let mut out = lhs_blocks.to_vec();
+        out.iter_mut().zip(rhs_blocks.iter()).for_each(|(l, r)| {
+            self.key
+                .key
+                .key
+                .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+        });
+        out
+    }
+
+    pub fn prepare_block_vecs_bivariate_assign(
+        &self,
+        lhs_blocks: &mut [Ciphertext],
+        rhs_blocks: &[Ciphertext],
+    ) {
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        lhs_blocks
+            .iter_mut()
+            .zip(rhs_blocks.iter())
+            .for_each(|(l, r)| {
+                self.key
+                    .key
+                    .key
+                    .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+            });
+    }
+
+    pub fn prepare_ciphertexts_bivariate<T>(&self, ct_left: &T, ct_right: &T) -> Vec<Ciphertext>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs_blocks, rhs_blocks) = (ct_left.blocks(), ct_right.blocks());
+
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        let mut out = lhs_blocks.to_vec();
+        out.iter_mut().zip(rhs_blocks.iter()).for_each(|(l, r)| {
+            self.key
+                .key
+                .key
+                .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+        });
+        out
+    }
+
+    pub fn prepare_ciphertexts_bivariate_assign<T>(&self, ct_left: &mut T, ct_right: &T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let (lhs_blocks, rhs_blocks) = (ct_left.blocks_mut(), ct_right.blocks());
+
+        let lhs_blocks_len = lhs_blocks.len();
+        let rhs_blocks_len = rhs_blocks.len();
+
+        assert_eq!(
+            lhs_blocks_len,
+            rhs_blocks_len,
+            "bivariate pack/prepare requires equal lengths (lhs: {lhs_blocks_len}, rhs: {rhs_blocks_len})",
+
+        );
+
+        lhs_blocks
+            .iter_mut()
+            .zip(rhs_blocks.iter())
+            .for_each(|(l, r)| {
+                self.key
+                    .key
+                    .key
+                    .unchecked_apply_lookup_table_bivariate_assign_prep(l, r);
+            });
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/abs.rs b/tfhe/src/integer/fpga/server_key/radix/abs.rs
