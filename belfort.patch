+use crate::core_crypto::fpga::lookup_vector::{LookupVector, ManyLookupVector};
+use crate::core_crypto::prelude::GlweCiphertext;
+use crate::shortint::ciphertext::{Degree, MaxDegree};
+use crate::shortint::engine::fill_accumulator_vector;
+use crate::shortint::server_key::{LookupTableOwned, ManyLookupTableOwned};
+use crate::shortint::{Ciphertext, ServerKey};
+
+impl ServerKey {
+    ////////////////////////////////////////////////////////////////////////////
+    // Generators for LookupVector
+
+    pub fn generate_lookup_vector<F>(&self, func: &F) -> LookupVector
+    where
+        F: Fn(u64) -> u64,
+    {
+        let message_modulus = self.message_modulus;
+        let carry_modulus = self.carry_modulus;
+
+        let modulus = message_modulus.0 * carry_modulus.0;
+
+        // Value of the shift of the messages
+        // Ciphertext modulus = 2**64, padding bit = 1, so 64 - 1 = 63
+        let delta_shift = 63 - modulus.ilog2();
+
+        let mut max_value = 0;
+
+        let vector: Vec<u64> = (0..modulus)
+            .map(|x| {
+                let value = func(x) % (2 * modulus);
+                max_value = max_value.max(value);
+                value << delta_shift
+            })
+            .collect();
+
+        LookupVector::new_with_max(vector, max_value)
+    }
+
+    pub fn generate_many_lookup_vector(
+        &self,
+        functions: &[&dyn Fn(u64) -> u64],
+    ) -> ManyLookupVector {
+        let message_modulus = self.message_modulus;
+        let carry_modulus = self.carry_modulus;
+
+        let modulus = (message_modulus.0 * carry_modulus.0) as usize;
+
+        let fn_counts = functions.len();
+        assert!(fn_counts > 0, "ManyLUT generated from empty array!");
+
+        let sub_lut_size = modulus / fn_counts;
+        assert!(
+            fn_counts <= modulus / 2,
+            "Cannot generate many lut accumulator for {fn_counts} functions, maximum possible is {}",
+            modulus / 2
+        );
+
+        let mut degrees = vec![Degree::new(0); fn_counts];
+
+        let mut vector = vec![0u64; modulus];
+
+        // Value of the shift of the messages
+        // Ciphertext modulus = 2**64, padding bit = 1, so 64 - 1 = 63
+        let delta_shift = 63 - modulus.ilog2();
+
+        for ((sub_lut_slice, max_value_per_function), func) in vector
+            .chunks_mut(sub_lut_size)
+            .zip(degrees.iter_mut())
+            .zip(functions)
+        {
+            let sub_lut_vec: Vec<u64> = (0..sub_lut_size)
+                .map(|x| {
+                    let x = x as u64;
+                    let value = func(x) % (2 * modulus as u64);
+                    *max_value_per_function = (*max_value_per_function).max(Degree::new(value));
+                    value << delta_shift
+                })
+                .collect();
+            sub_lut_slice.copy_from_slice(sub_lut_vec.as_slice());
+        }
+
+        ManyLookupVector { vector, degrees }
+    }
+
+    pub fn generate_lookup_vector_bivariate_with_factor<F>(
+        &self,
+        func: &F,
+        factor: u64,
+    ) -> LookupVector
+    where
+        F: Fn(u64, u64) -> u64,
+    {
+        let message_modulus = self.message_modulus;
+        let carry_modulus = self.carry_modulus;
+
+        let modulus = message_modulus.0 * carry_modulus.0;
+        let delta_shift = 63 - modulus.ilog2();
+
+        let mut max_value = 0;
+
+        let vector: Vec<u64> = (0..modulus)
+            .map(|val| {
+                let lhs = (val / factor) % message_modulus.0;
+                let rhs = (val % factor) % message_modulus.0;
+                let value = func(lhs, rhs) % (2 * modulus);
+                max_value = max_value.max(value);
+                value << delta_shift
+            })
+            .collect();
+
+        LookupVector::new_with_max(vector, max_value)
+    }
+
+    pub fn generate_lookup_vector_bivariate<F>(&self, func: &F) -> LookupVector
+    where
+        F: Fn(u64, u64) -> u64,
+    {
+        let message_modulus = self.message_modulus.0;
+
+        self.generate_lookup_vector_bivariate_with_factor(func, message_modulus)
+    }
+
+    pub fn generate_lookup_table_from_vector(&self, vector: &[u64]) -> LookupTableOwned {
+        let bsk = &self.fpga_pattern().bootstrapping_key;
+        let mut acc = GlweCiphertext::new(
+            0,
+            bsk.glwe_size(),
+            bsk.polynomial_size(),
+            self.ciphertext_modulus,
+        );
+
+        let (message_modulus, carry_modulus) = (self.message_modulus, self.carry_modulus);
+        let max_value = fill_accumulator_vector(&mut acc, message_modulus, carry_modulus, vector);
+
+        LookupTableOwned {
+            acc,
+            degree: Degree::new(max_value),
+        }
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // Conversions between LookupTableOwned and LookupVector
+
+    pub fn convert_lookup_vector_to_lookup_table(
+        &self,
+        lookup_vector: &LookupVector,
+    ) -> LookupTableOwned {
+        let bsk = &self.fpga_pattern().bootstrapping_key;
+        let mut acc = GlweCiphertext::new(
+            0,
+            bsk.glwe_size(),
+            bsk.polynomial_size(),
+            self.ciphertext_modulus,
+        );
+        let (message_modulus, carry_modulus) = (self.message_modulus, self.carry_modulus);
+        let modulus = message_modulus.0 * carry_modulus.0;
+
+        // Value of the shift of the messages
+        // Ciphertext modulus = 2**64, padding bit = 1, so 64 - 1 = 63
+        let delta_shift = 63 - modulus.ilog2();
+
+        let vector = &lookup_vector
+            .vector
+            .iter()
+            .map(|v| v >> delta_shift)
+            .collect::<Vec<u64>>()[..];
+        let max_value = fill_accumulator_vector(&mut acc, message_modulus, carry_modulus, vector);
+        LookupTableOwned {
+            acc,
+            degree: Degree::new(max_value),
+        }
+    }
+
+    pub fn convert_many_lookup_vector_to_many_lookup_table(
+        &self,
+        lookup_vector: &ManyLookupVector,
+    ) -> ManyLookupTableOwned {
+        let bsk = &self.fpga_pattern().bootstrapping_key;
+        let poly_size = bsk.polynomial_size();
+
+        let mut acc = GlweCiphertext::new(0, bsk.glwe_size(), poly_size, self.ciphertext_modulus);
+        let (message_modulus, carry_modulus) = (self.message_modulus, self.carry_modulus);
+        let modulus = message_modulus.0 * carry_modulus.0;
+
+        // Value of the shift of the messages
+        // Ciphertext modulus = 2**64, padding bit = 1, so 64 - 1 = 63
+        let delta_shift = 63 - modulus.ilog2();
+
+        let vector = &lookup_vector
+            .vector
+            .iter()
+            .map(|v| v >> delta_shift)
+            .collect::<Vec<u64>>()[..];
+        let max_value = fill_accumulator_vector(&mut acc, message_modulus, carry_modulus, vector);
+
+        let sample_extraction_stride = poly_size.0 / lookup_vector.degrees.len();
+        ManyLookupTableOwned {
+            acc,
+            sample_extraction_stride,
+            input_max_degree: MaxDegree::new(max_value),
+            per_function_output_degree: lookup_vector.degrees.clone(),
+        }
+    }
+
+    // Packs the message of the left ciphertext into the carry space of the left ciphertext
+    // while copying the message of the right ciphertext to the message space of the left ciphertext
+    // This allows to parallelize the PBS on hardware
+    pub fn unchecked_apply_lookup_table_bivariate_assign_prep(
+        &self,
+        ct_left: &mut Ciphertext,
+        ct_right: &Ciphertext,
+    ) {
+        let max_modulus = self.message_modulus.0;
+        let modulus = ct_right.degree.get() + 1;
+        assert!(modulus <= max_modulus);
+
+        self.unchecked_scalar_mul_assign(ct_left, max_modulus as u8);
+
+        self.unchecked_add_assign(ct_left, ct_right);
+    }
+
+    pub fn unchecked_apply_lookup_table_bivariate_prep(
+        &self,
+        ct_left: &Ciphertext,
+        ct_right: &Ciphertext,
+    ) -> Ciphertext {
+        let max_modulus = self.message_modulus.0;
+        let modulus = ct_right.degree.get() + 1;
+        assert!(modulus <= max_modulus);
+
+        let mut prepared_block = self.unchecked_scalar_mul(ct_left, max_modulus as u8);
+
+        self.unchecked_add_assign(&mut prepared_block, ct_right);
+
+        prepared_block
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // Packed Lookup Table Operations,
+    //
+    // Implemented on shortint server_key, executed CPU. These versions are
+    // alternatives to the same functions available over BelfortServerKey
+    // offering hardware acceleration.
+    pub fn apply_lookup_vector_packed_assign(
+        &self,
+        cts: &mut Vec<Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        // Validate the correct pattern
+        let _ = self.fpga_pattern();
+        self.programmable_bootstrap_assign_packed(cts, luts);
+    }
+
+    pub(crate) fn programmable_bootstrap_assign_packed(
+        &self,
+        cts: &mut Vec<Ciphertext>,
+        luts: &[&LookupVector],
+    ) {
+        use rayon::prelude::*;
+
+        cts.par_iter_mut()
+            .zip(luts.par_iter())
+            .for_each(|(ct, lut)| {
+                let l = self.convert_lookup_vector_to_lookup_table(lut);
+                self.apply_lookup_table_assign(ct, &l);
+            });
+    }
+
+    pub fn apply_many_lookup_vector_packed(
+        &self,
+        cts: &[Ciphertext],
+        luts: &[&ManyLookupVector],
+    ) -> Vec<Vec<Ciphertext>> {
+        // Validate the correct pattern
+        let _ = self.fpga_pattern();
+        self.programmable_bootstrap_many_lut(cts, luts)
+    }
+
+    pub(crate) fn programmable_bootstrap_many_lut(
+        &self,
+        cts: &[Ciphertext],
+        luts: &[&ManyLookupVector],
+    ) -> Vec<Vec<Ciphertext>> {
+        use rayon::prelude::*;
+
+        cts.par_iter()
+            .zip(luts.par_iter())
+            .map(|(ct, lut)| {
+                let l = self.convert_many_lookup_vector_to_many_lookup_table(lut);
+                self.apply_many_lookup_table(&ct.clone(), &l)
+            })
+            .collect::<Vec<_>>()
+    }
+}
