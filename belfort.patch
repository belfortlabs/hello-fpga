+/// Function to test an "unchecked" SIMD minmax server key function.
+///
+/// This calls the `unchecked_server_key_method` with fresh ciphertexts
+/// and compares that it gives the same results as the `clear_fn`.
+pub(crate) fn test_unchecked_minmax_simd<P, T, ClearF, Scalar>(
+    param: P,
+    num_test: usize,
+    mut executor: T,
+    clear_fn: ClearF,
+) where
+    P: Into<TestParameters>,
+    Scalar: UnsignedNumeric
+        + AddAssign<Scalar>
+        + DecomposableInto<u64>
+        + RecomposableFrom<u64>
+        + std::ops::Shr<usize, Output = Scalar>,
+    T: for<'a> FunctionExecutor<
+        (&'a [RadixCiphertext], &'a [RadixCiphertext]),
+        Vec<RadixCiphertext>,
+    >,
+    ClearF: Fn(Scalar, Scalar) -> Scalar,
+    Standard: Distribution<Scalar>,
+{
+    let mut rng = rand::thread_rng();
+
+    let (cks, sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let num_bits_per_block = cks.parameters().message_modulus().0.ilog2() as usize;
+    let num_block = Scalar::BITS.div_ceil(num_bits_per_block);
+
+    let sks = Arc::new(sks);
+    let cks = RadixClientKey::from((cks, num_block));
+
+    executor.setup(&cks, sks);
+
+    // Test with low number of blocks, as they take a different branches
+    // (regression tests)
+    for num_block in [num_block, 1, 2] {
+        let max = Scalar::MAX >> (Scalar::BITS - (num_block * num_bits_per_block));
+        for _ in 0..num_test {
+            for simd_len in 1..4 {
+                let clear_lhs: Vec<Scalar> =
+                    (0..simd_len).map(|_| rng.gen::<Scalar>() & max).collect();
+                let clear_rhs: Vec<Scalar> =
+                    (0..simd_len).map(|_| rng.gen::<Scalar>() & max).collect();
+
+                let ctxt_lhs = cks.encrypt_array(&clear_lhs);
+                let ctxt_rhs = cks.encrypt_array(&clear_rhs);
+
+                {
+                    let results = executor.execute((&ctxt_lhs, &ctxt_rhs));
+
+                    for i in 0..simd_len {
+                        let decrypted: Scalar = cks.decrypt(&results[i]);
+                        let expected = clear_fn(clear_lhs[i], clear_rhs[i]);
+                        assert_eq!(decrypted, expected);
+                    }
+                }
+
+                {
+                    // Force case where lhs == rhs
+                    let results = executor.execute((&ctxt_lhs, &ctxt_lhs));
+                    for i in 0..simd_len {
+                        let decrypted: Scalar = cks.decrypt(&results[i]);
+                        let expected = clear_fn(clear_lhs[i], clear_lhs[i]);
+                        assert_eq!(decrypted, expected);
+                    }
+                }
+            }
+        }
+    }
+}
