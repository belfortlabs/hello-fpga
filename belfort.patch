diff --git a/tfhe/src/high_level_api/array/fpga/integers.rs b/tfhe/src/high_level_api/array/fpga/integers.rs
new file mode 100644
index 000000000..2fb135e79
--- /dev/null
+++ b/tfhe/src/high_level_api/array/fpga/integers.rs
@@ -0,0 +1,137 @@
+use crate::array::traits::TensorSlice;
+use crate::high_level_api::global_state;
+use crate::integer::block_decomposition::DecomposableInto;
+use crate::integer::IntegerRadixCiphertext;
+use crate::BelfortServerKey;
+use std::sync::mpsc::{channel, Sender};
+use std::sync::Arc;
+
+use crate::integer::fpga::threading::{self, OperationPackage, ScalarOperationPackage};
+
+#[inline]
+#[track_caller]
+pub(crate) fn par_map_fpga_op_on_pair_of_elements<'a, T, F>(
+    lhs: TensorSlice<'a, &'a [T]>,
+    rhs: TensorSlice<'a, &'a [T]>,
+    op: F,
+) -> Vec<T>
+where
+    T: IntegerRadixCiphertext + 'static,
+    F: Send + Sync + Fn(&BelfortServerKey, &T, &T) -> T + 'static,
+{
+    let size: usize = lhs.dims.shape().iter().product();
+
+    global_state::with_fpga_internal_keys(|key| {
+        let num_fpgas = key.utils.fpga_indexes.len();
+        #[cfg(feature = "emulate_fpga")]
+        let num_fpgas =
+            crate::core_crypto::fpga::BelfortFpgaUtils::get_fpga_indices_from_env().len();
+
+        let (tx_res, rx_res) = channel::<(usize, T)>();
+        let op = Arc::new(op);
+
+        let threads: Vec<_> = threading::generate_fpga_threads(key, &tx_res);
+
+        lhs.iter()
+            .zip(rhs.iter())
+            .enumerate()
+            .for_each(|(idx, (lhs_ct, rhs_ct))| {
+                let thread: &Sender<OperationPackage<T, F>> = &threads[idx % num_fpgas];
+                let package = OperationPackage {
+                    idx,
+                    left: lhs_ct.clone(),
+                    right: rhs_ct.clone(),
+                    operation: Arc::clone(&op),
+                };
+                let _ = thread.send(package);
+            });
+
+        let mut results: Vec<Option<T>> = vec![None; size];
+        let mut counter = 0;
+        for (idx, partial_res) in rx_res {
+            counter += 1;
+            results[idx] = Some(partial_res);
+            if counter >= size {
+                break;
+            }
+        }
+
+        // Drop all sender channels to signal completion
+        drop(tx_res);
+        drop(threads);
+
+        results.into_iter().flatten().collect()
+    })
+}
+
+#[inline]
+#[track_caller]
+pub(crate) fn par_map_fpga_scalar_op_on_pair_of_elements<'a, T, Clear, F>(
+    lhs: TensorSlice<'a, &'a [T]>,
+    rhs: TensorSlice<'a, &'a [Clear]>,
+    op: F,
+) -> Vec<T>
+where
+    T: IntegerRadixCiphertext + 'static,
+    Clear: DecomposableInto<u8> + 'static,
+    F: Send + Sync + Fn(&BelfortServerKey, &T, Clear) -> T + 'static,
+{
+    let size: usize = lhs.dims.shape().iter().product();
+
+    global_state::with_fpga_internal_keys(|key| {
+        let num_fpgas = key.utils.fpga_indexes.len();
+        #[cfg(feature = "emulate_fpga")]
+        let num_fpgas =
+            crate::core_crypto::fpga::BelfortFpgaUtils::get_fpga_indices_from_env().len();
+
+        let (tx_res, rx_res) = channel::<(usize, T)>();
+        let op = Arc::new(op);
+
+        let threads: Vec<_> = threading::generate_fpga_scalar_op_threads(key, &tx_res);
+
+        lhs.iter()
+            .zip(rhs.iter())
+            .enumerate()
+            .for_each(|(idx, (lhs_ct, rhs))| {
+                let thread: &Sender<ScalarOperationPackage<T, Clear, F>> =
+                    &threads[idx % num_fpgas];
+                let package = ScalarOperationPackage {
+                    idx,
+                    left: lhs_ct.clone(),
+                    right: *rhs,
+                    operation: Arc::clone(&op),
+                };
+                let _ = thread.send(package);
+            });
+
+        let mut results: Vec<Option<T>> = vec![None; size];
+        let mut counter = 0;
+        for (idx, partial_res) in rx_res {
+            counter += 1;
+            results[idx] = Some(partial_res);
+            if counter >= size {
+                break;
+            }
+        }
+
+        // Drop all sender channels to signal completion
+        drop(tx_res);
+        drop(threads);
+
+        results.into_iter().flatten().collect()
+    })
+}
+
+#[inline]
+#[track_caller]
+pub(crate) fn map_fpga_simd_op<'a, T, F>(
+    lhs: &TensorSlice<'a, &'a [T]>,
+    rhs: &TensorSlice<'a, &'a [T]>,
+    op: F,
+) -> Vec<T>
+where
+    T: IntegerRadixCiphertext + 'static,
+    F: Send + Sync + Fn(&BelfortServerKey, &[T], &[T]) -> Vec<T> + 'static,
+{
+    global_state::with_fpga_internal_keys(|key| op(key, lhs.slice, rhs.slice))
+}
