+
+    pub fn block_mul_simd<T>(&self, lhs: &[T], rhs: &[Ciphertext], indices: &[usize]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut result = lhs.to_vec();
+        self.block_mul_assign_simd(&mut result, rhs, indices);
+        result
+    }
+
+    pub fn block_mul_assign_simd<T>(&self, lhs: &mut [T], rhs: &[Ciphertext], indices: &[usize])
+    where
+        T: IntegerRadixCiphertext,
+    {
+        assert_eq!(
+            lhs.len(),
+            rhs.len(),
+            "lhs and rhs must have the same length"
+        );
+        assert_eq!(
+            lhs.len(),
+            indices.len(),
+            "lhs and indices must have the same length"
+        );
+
+        if lhs.is_empty() {
+            return;
+        }
+
+        let mut tmp_rhs_vec = Vec::with_capacity(rhs.len());
+
+        for (lhs_elem, rhs_block) in lhs.iter_mut().zip(rhs.iter()) {
+            let rhs_ct = match (
+                lhs_elem.block_carries_are_empty(),
+                rhs_block.carry_is_empty(),
+            ) {
+                (true, true) => rhs_block.clone(),
+                (true, false) => self.extract_message(rhs_block),
+                (false, true) => {
+                    self.full_propagate(lhs_elem);
+                    rhs_block.clone()
+                }
+                (false, false) => {
+                    self.full_propagate(lhs_elem);
+                    self.extract_message(rhs_block)
+                }
+            };
+            tmp_rhs_vec.push(rhs_ct);
+        }
+
+        self.unchecked_block_mul_assign_simd(lhs, &tmp_rhs_vec, indices);
+
+        for lhs_elem in lhs.iter_mut() {
+            self.full_propagate(lhs_elem);
+        }
+    }
+
+    pub fn mul_simd<T>(&self, lhs: &[T], rhs: &[T]) -> Vec<T>
+    where
