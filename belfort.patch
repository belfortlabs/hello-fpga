+        ::paste::paste!{
+            fn [<integer_unchecked_ $comparison_name _ $clear_type:lower>]<P>(param: P) where P: Into<TestParameters>{
+                let num_tests = 1;
+                let executor = FpgaFunctionExecutor::new(&BelfortServerKey::[<unchecked_ $comparison_name>]);
