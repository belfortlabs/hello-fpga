+use crate::integer::fpga::BelfortServerKey;
+use crate::integer::IntegerRadixCiphertext;
+
+#[cfg(test)]
+pub(crate) mod tests;
+
+pub fn erc20_transfer_simd<T>(
+    server_key: &BelfortServerKey,
+    from_balances: &[T],
+    to_balances: &[T],
+    transfer_amounts: &[T],
+) -> (Vec<T>, Vec<T>)
+where
+    T: IntegerRadixCiphertext + 'static,
+{
+    let number_of_tx = transfer_amounts.len();
+
+    assert_eq!(
+        number_of_tx,
+        to_balances.len(),
+        "to_balances and transfer_amounts must have the same length"
+    );
+    assert_eq!(
+        number_of_tx,
+        from_balances.len(),
+        "from_balances and transfer_amounts must have the same length"
+    );
+    assert!(!from_balances.is_empty(), "Input arrays must not be empty");
+
+    let num_blocks = from_balances[0].blocks().len();
+
+    let has_enough_funds = server_key.ge_simd(from_balances, transfer_amounts);
+    let has_enough_funds = has_enough_funds
+        .into_iter()
+        .map(|x| x.into_radix(num_blocks, &server_key.key.key))
+        .collect::<Vec<_>>();
+
+    let mut transfer_values = server_key.mul_simd(transfer_amounts, &has_enough_funds);
+
+    let mut neg_values = server_key.neg_simd(&transfer_values);
+
+    // Parallel addition and subtraction using the transfer values and their negation
+    transfer_values.append(&mut neg_values);
+    let mut to_balances = to_balances.to_vec();
+    to_balances.extend_from_slice(from_balances);
+
+    let result = server_key.add_simd(&to_balances, &transfer_values);
+    let (to_balances, from_balances) = result.split_at(number_of_tx);
+    (to_balances.to_vec(), from_balances.to_vec())
+}
diff --git a/tfhe/src/high_level_api/composites/erc20_simd/tests.rs b/tfhe/src/high_level_api/composites/erc20_simd/tests.rs
