+/// Function to test a "default" SIMD server key function.
+///
+/// This calls the `server_key_method` with non-fresh ciphertexts,
+/// that is ciphertexts that have non-zero carries, and compares that the result is
+/// the same as the one of `clear_fn`.
+pub(crate) fn test_default_function_simd<P, T, ClearF, Scalar>(
+    param: P,
+    num_test: usize,
+    mut executor: T,
+    clear_fn: ClearF,
+) where
+    P: Into<TestParameters>,
+    Scalar: UnsignedNumeric
+        + AddAssign<Scalar>
+        + DecomposableInto<u64>
+        + RecomposableFrom<u64>
+        + From<bool>,
+    T: for<'a> FunctionExecutor<(&'a [RadixCiphertext], &'a [RadixCiphertext]), Vec<BooleanBlock>>,
+    ClearF: Fn(Scalar, Scalar) -> Scalar,
+    Standard: Distribution<Scalar>,
+{
+    let mut rng = rand::thread_rng();
+
+    let (cks, sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+    let sks = Arc::new(sks);
+    let num_block = Scalar::BITS.div_ceil(cks.parameters().message_modulus().0.ilog2() as usize);
+    let cks = RadixClientKey::from((cks, num_block));
+
+    executor.setup(&cks, sks.clone());
+
+    assert_eq!(
+        Scalar::BITS as u32 % cks.parameters().message_modulus().0.ilog2(),
+        0,
+        "bit width must be a multiple of number of bit in a block"
+    );
+
+    for _ in 0..num_test {
+        for simd_len in 1..4 {
+            let mut clear_lhs: Vec<Scalar> = (0..simd_len).map(|_| rng.gen::<Scalar>()).collect();
+            let mut clear_rhs: Vec<Scalar> = (0..simd_len).map(|_| rng.gen::<Scalar>()).collect();
+
+            let mut ctxt_lhs = cks.encrypt_array(&clear_lhs);
+            let mut ctxt_rhs = cks.encrypt_array(&clear_rhs);
+
+            // Raise the degree to ensure worst case path in operations
+            for i in 0..simd_len {
+                while ctxt_lhs[i].block_carries_are_empty() {
+                    let clear_2 = rng.gen::<Scalar>();
+                    let ct_2 = cks.encrypt(clear_2);
+                    sks.unchecked_add_assign(&mut ctxt_lhs[i], &ct_2);
+                    clear_lhs[i] = clear_lhs[i].recomposable_wrapping_add(clear_2);
+                }
+
+                while ctxt_rhs[i].block_carries_are_empty() {
+                    let clear_2 = rng.gen::<Scalar>();
+                    let ct_2 = cks.encrypt(clear_2);
+                    sks.unchecked_add_assign(&mut ctxt_rhs[i], &ct_2);
+                    clear_rhs[i] = clear_rhs[i].recomposable_wrapping_add(clear_2);
+                }
+
+                assert!(!ctxt_lhs[i].block_carries_are_empty());
+                assert!(!ctxt_rhs[i].block_carries_are_empty());
+            }
+
+            // Sanity decryption checks
+            for i in 0..simd_len {
+                let a: Scalar = cks.decrypt(&ctxt_lhs[i]);
+                assert_eq!(a, clear_lhs[i]);
+
+                let b: Scalar = cks.decrypt(&ctxt_rhs[i]);
+                assert_eq!(b, clear_rhs[i]);
+            }
+
+            let results = executor.execute((&ctxt_lhs, &ctxt_rhs));
+
+            // Sanity decryption checks
+            for i in 0..simd_len {
+                let a: Scalar = cks.decrypt(&ctxt_lhs[i]);
+                assert_eq!(a, clear_lhs[i]);
+
+                let b: Scalar = cks.decrypt(&ctxt_rhs[i]);
+                assert_eq!(b, clear_rhs[i]);
+            }
+
+            for i in 0..simd_len {
+                let decrypted: Scalar = cks.decrypt_bool(&results[i]).into();
+                let expected = clear_fn(clear_lhs[i], clear_rhs[i]);
+                assert_eq!(decrypted, expected);
+            }
+        }
+    }
+}
