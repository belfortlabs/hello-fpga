index 000000000..224f0af45
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/abs.rs
@@ -0,0 +1,32 @@
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::BelfortServerKey;
+
+impl BelfortServerKey {
+    pub fn unchecked_abs<T>(&self, ct: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_abs_parallelized(ct)
+    }
+
+    pub fn smart_abs<T>(&self, ct: &mut T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.conditional_full_propagate(ct);
+        self.unchecked_abs(ct)
+    }
+
+    pub fn abs<T>(&self, ct: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if ct.block_carries_are_empty() {
+            self.unchecked_abs(ct)
+        } else {
+            let mut cloned = ct.clone();
+            self.full_propagate(&mut cloned);
+            self.unchecked_abs(&cloned)
+        }
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/add.rs b/tfhe/src/integer/fpga/server_key/radix/add.rs
new file mode 100644
index 000000000..6b6a5bf14
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/add.rs
@@ -0,0 +1,1405 @@
+use crate::core_crypto::commons::numeric::UnsignedInteger;
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::integer::server_key::radix_parallel::add::{
+    overflow_flag_preparation_lut, CarryPropagationAlgorithm,
+};
+use crate::integer::server_key::radix_parallel::OutputFlag;
+use crate::integer::server_key::CheckError;
+use crate::integer::{BooleanBlock, RadixCiphertext, SignedRadixCiphertext};
+use crate::shortint::ciphertext::Degree;
+use crate::shortint::Ciphertext;
+use rayon::prelude::*;
+
+/// FPGA-specific heuristic to determine if parallel propagation would be faster
+///
+/// This differs from the CPU version as it considers FPGA-specific characteristics
+/// rather than CPU thread counts.
+pub(crate) fn should_parallel_propagation_be_faster_fpga(
+    full_modulus: u64,
+    num_blocks: usize,
+) -> bool {
+    // For FPGAs, the parallel algorithm has overhead in terms of PBS operations
+    // The sequential algorithm has latency of num_blocks PBS
+    // The parallel algorithm has roughly 3 layers of PBS + carry resolution overhead
+
+    let grouping_size = full_modulus.ilog2() as usize;
+    let num_groups = num_blocks.div_ceil(grouping_size);
+    let num_carry_to_resolve = num_groups.saturating_sub(1);
+
+    let sequential_depth = (num_carry_to_resolve.saturating_sub(1)) / (grouping_size - 1);
+    let hillis_steel_depth = if num_carry_to_resolve == 0 {
+        0
+    } else {
+        num_carry_to_resolve.ceil_ilog2() as usize
+    };
+
+    // Estimate parallel latency: 3 main layers + carry resolution
+    let parallel_latency = if sequential_depth <= hillis_steel_depth {
+        3 + sequential_depth
+    } else {
+        3 + hillis_steel_depth
+    };
+
+    // Use parallel if it's expected to be faster than sequential
+    parallel_latency < num_blocks
+}
+
+impl BelfortServerKey {
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertexts block carries are empty and clears them if it's not the
+    /// case and the operation requires it. It outputs a ciphertext whose block carries are always
+    /// empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 14;
+    /// let msg2 = 97;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(dec_result, msg1 + msg2);
+    /// ```
+    pub fn add<T>(&self, ct1: &T, ct2: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut ct_res = ct1.clone();
+        self.add_assign(&mut ct_res, ct2);
+        ct_res
+    }
+
+    /// Compute homomorphically an addition between two ciphertexts
+    ///
+    /// The result is stored in the `ct1` ciphertext.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertext carries are empty and clears them if it's not the case and
+    /// the operation requires it. It outputs a ciphertext whose carry is always empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 15u64;
+    /// let msg2 = 3u64;
+    ///
+    /// // Encrypt two messages:
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.add_assign(&mut ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec = cks.decrypt(&ct1);
+    /// assert_eq!(dec, msg1 + msg2);
+    /// ```
+    pub fn add_assign<T>(&self, ct1: &mut T, ct2: &T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.add_assign_with_carry(ct1, ct2, None);
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function computes the operation without checking if it exceeds the capacity of the
+    /// ciphertext.
+    ///
+    /// The result is returned as a new ciphertext.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 10;
+    /// let msg2 = 127;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.unchecked_add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(dec_result, msg1 + msg2);
+    /// ```
+    pub fn unchecked_add<T>(&self, ct1: &T, ct2: &T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_add_parallelized(ct1, ct2)
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function computes the operation without checking if it exceeds the capacity of the
+    /// ciphertext.
+    ///
+    /// The result is assigned to the `ct1` ciphertext.
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 28;
+    /// let msg2 = 127;
+    ///
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.unchecked_add_assign(&mut ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_ct1: u64 = cks.decrypt(&ct1);
+    /// assert_eq!(dec_ct1, msg1 + msg2);
+    /// ```
+    pub fn unchecked_add_assign<T>(&self, ct1: &mut T, ct2: &T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.unchecked_add_assign_parallelized(ct1, ct2);
+    }
+
+    /// Verifies if ct1 and ct2 can be added together.
+    ///
+    /// # Example
+    ///
+    ///```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 46u64;
+    /// let msg2 = 87u64;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Check if we can perform an addition
+    /// fpga_key.is_add_possible(&ct1, &ct2).unwrap();
+    /// ```
+    pub fn is_add_possible<T>(&self, ct1: &T, ct2: &T) -> Result<(), CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.key.key.is_add_possible(ct1, ct2)
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// If the operation can be performed, the result is returned in a new ciphertext.
+    /// Otherwise a [CheckError] is returned.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 41;
+    /// let msg2 = 101;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.checked_add(&ct1, &ct2);
+    ///
+    /// match ct_res {
+    ///     Err(x) => panic!("{x:?}"),
+    ///     Ok(y) => {
+    ///         let clear: u64 = cks.decrypt(&y);
+    ///         assert_eq!(msg1 + msg2, clear);
+    ///     }
+    /// }
+    /// ```
+    pub fn checked_add<T>(&self, ct1: &T, ct2: &T) -> Result<T, CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.is_add_possible(ct1, ct2)?;
+        Ok(self.unchecked_add(ct1, ct2))
+    }
+
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// If the operation can be performed, the result is stored in the `ct1` ciphertext.
+    /// Otherwise a [CheckError] is returned, and `ct1` is not modified.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 41;
+    /// let msg2 = 101;
+    ///
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.checked_add_assign(&mut ct1, &ct2).unwrap();
+    ///
+    /// let clear: u64 = cks.decrypt(&ct1);
+    /// assert_eq!(msg1 + msg2, clear);
+    /// ```
+    pub fn checked_add_assign<T>(&self, ct1: &mut T, ct2: &T) -> Result<(), CheckError>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.is_add_possible(ct1, ct2)?;
+        self.unchecked_add_assign(ct1, ct2);
+        Ok(())
+    }
+
+    pub fn smart_add<T>(&self, ct1: &mut T, ct2: &mut T) -> T
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if self.is_add_possible(ct1, ct2).is_err() {
+            self.full_propagate(ct1);
+            self.full_propagate(ct2);
+        }
+
+        self.is_add_possible(ct1, ct2).unwrap();
+        self.unchecked_add(ct1, ct2)
+    }
+
+    pub fn smart_add_assign<T>(&self, ct1: &mut T, ct2: &mut T)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        if self.is_add_possible(ct1, ct2).is_err() {
+            self.full_propagate(ct1);
+            self.full_propagate(ct2);
+        }
+        self.is_add_possible(ct1, ct2).unwrap();
+        self.unchecked_add_assign(ct1, ct2);
+    }
+
+    /// Computes the addition of two ciphertexts and returns the overflow flag
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = u8::MAX;
+    /// let msg2 = 1;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// let (ct_res, overflowed) = fpga_key.overflowing_add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u8 = cks.decrypt(&ct_res);
+    /// let dec_overflowed = cks.decrypt_bool(&overflowed);
+    /// let (expected_result, expected_overflow) = msg1.overflowing_add(msg2);
+    /// assert_eq!(dec_result, expected_result);
+    /// assert_eq!(dec_overflowed, expected_overflow);
+    /// ```
+    pub fn overflowing_add<T>(&self, ct1: &T, ct2: &T) -> (T, BooleanBlock)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut ct_res = ct1.clone();
+        let overflowed = self.overflowing_add_assign(&mut ct_res, ct2);
+        (ct_res, overflowed)
+    }
+
+    pub fn overflowing_add_assign<T>(&self, ct1: &mut T, ct2: &T) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut tmp_rhs: T;
+        if ct1.blocks().is_empty() || ct2.blocks().is_empty() {
+            return self.key.key.create_trivial_boolean_block(false);
+        }
+
+        let (lhs, rhs) = match (ct1.block_carries_are_empty(), ct2.block_carries_are_empty()) {
+            (true, true) => (ct1, ct2),
+            (true, false) => {
+                tmp_rhs = ct2.clone();
+                self.full_propagate(&mut tmp_rhs);
+                (ct1, &tmp_rhs)
+            }
+            (false, true) => {
+                self.full_propagate(ct1);
+                (ct1, ct2)
+            }
+            (false, false) => {
+                tmp_rhs = ct2.clone();
+                self.full_propagate(ct1);
+                self.full_propagate(&mut tmp_rhs);
+                (ct1, &tmp_rhs)
+            }
+        };
+
+        self.overflowing_add_assign_with_carry(lhs, rhs, None)
+    }
+
+    /// Computes the addition of two unsigned ciphertexts and returns the overflow flag
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = u8::MAX;
+    /// let msg2 = 1;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// let (ct_res, overflowed) = fpga_key.unsigned_overflowing_add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u8 = cks.decrypt(&ct_res);
+    /// let dec_overflowed = cks.decrypt_bool(&overflowed);
+    /// let (expected_result, expected_overflow) = msg1.overflowing_add(msg2);
+    /// assert_eq!(dec_result, expected_result);
+    /// assert_eq!(dec_overflowed, expected_overflow);
+    /// ```
+    pub fn unsigned_overflowing_add(
+        &self,
+        ct1: &RadixCiphertext,
+        ct2: &RadixCiphertext,
+    ) -> (RadixCiphertext, BooleanBlock) {
+        self.overflowing_add(ct1, ct2)
+    }
+
+    pub fn unsigned_overflowing_add_assign(
+        &self,
+        ct1: &mut RadixCiphertext,
+        ct2: &RadixCiphertext,
+    ) -> BooleanBlock {
+        self.overflowing_add_assign(ct1, ct2)
+    }
+
+    pub fn signed_overflowing_add(
+        &self,
+        ct1: &SignedRadixCiphertext,
+        ct2: &SignedRadixCiphertext,
+    ) -> (SignedRadixCiphertext, BooleanBlock) {
+        self.overflowing_add(ct1, ct2)
+    }
+
+    pub fn unchecked_signed_overflowing_add(
+        &self,
+        ct1: &SignedRadixCiphertext,
+        ct2: &SignedRadixCiphertext,
+    ) -> (SignedRadixCiphertext, BooleanBlock) {
+        assert_eq!(
+            ct1.blocks.len(),
+            ct2.blocks.len(),
+            "lhs and rhs must have the same number of blocks ({} vs {})",
+            ct1.blocks.len(),
+            ct2.blocks.len()
+        );
+        assert!(!ct1.blocks.is_empty(), "inputs cannot be empty");
+
+        let mut result = ct1.clone();
+        let overflowed = self.overflowing_add_assign_with_carry(&mut result, ct2, None);
+        (result, overflowed)
+    }
+
+    pub fn add_assign_with_carry<T>(&self, lhs: &mut T, rhs: &T, input_carry: Option<&BooleanBlock>)
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.conditional_full_propagate(lhs);
+
+        let mut cloned_rhs: T;
+        let rhs = if rhs.block_carries_are_empty() {
+            rhs
+        } else {
+            cloned_rhs = rhs.clone();
+            self.full_propagate(&mut cloned_rhs);
+            &cloned_rhs
+        };
+
+        self.advanced_add_assign_with_carry(
+            lhs.blocks_mut(),
+            rhs.blocks(),
+            input_carry,
+            OutputFlag::None,
+            CarryPropagationAlgorithm::Automatic,
+        );
+    }
+
+    /// Does lhs += (rhs + carry)
+    ///
+    /// Returns a boolean block that encrypts `true` if overflow happened
+    pub fn overflowing_add_assign_with_carry<T>(
+        &self,
+        lhs: &mut T,
+        rhs: &T,
+        input_carry: Option<&BooleanBlock>,
+    ) -> BooleanBlock
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.advanced_add_assign_with_carry(
+            lhs.blocks_mut(),
+            rhs.blocks(),
+            input_carry,
+            OutputFlag::from_signedness(T::IS_SIGNED),
+            CarryPropagationAlgorithm::Automatic,
+        )
+        .expect("internal error, overflow computation was not returned as was requested")
+    }
+
+    /// Computes the result of `lhs += rhs + input_carry`
+    ///
+    /// This will select what seems to be the best algorithm to propagate carries
+    /// (fully parallel vs sequential) by looking at the number of blocks and
+    /// FPGA characteristics.
+    ///
+    /// - `lhs` and `rhs` must have the same `len()`, empty is allowed
+    /// - `blocks of lhs` and `rhs` must all be without carry
+    /// - blocks must have at least one bit of message and one bit of carry
+    ///
+    /// Returns `Some(...)` if requested_flag != ComputationFlags::None
+    pub(crate) fn advanced_add_assign_with_carry(
+        &self,
+        lhs: &mut [Ciphertext],
+        rhs: &[Ciphertext],
+        input_carry: Option<&BooleanBlock>,
+        requested_flag: OutputFlag,
+        mut algorithm: CarryPropagationAlgorithm,
+    ) -> Option<BooleanBlock> {
+        // having 4-bits is a hard requirement
+        // So to protect against bad carry prop choice we do this check
+        let total_modulus = self.key.key.message_modulus().0 * self.key.key.carry_modulus().0;
+        let has_enough_bits_per_block = total_modulus >= (1 << 4);
+        if !has_enough_bits_per_block {
+            algorithm = CarryPropagationAlgorithm::Sequential;
+        }
+
+        if algorithm == CarryPropagationAlgorithm::Automatic {
+            if should_parallel_propagation_be_faster_fpga(total_modulus, lhs.len()) {
+                algorithm = CarryPropagationAlgorithm::Parallel;
+            } else {
+                algorithm = CarryPropagationAlgorithm::Sequential
+            }
+        }
+        match algorithm {
+            CarryPropagationAlgorithm::Parallel => {
+                self.advanced_add_assign_with_carry_parallel(lhs, rhs, input_carry, requested_flag)
+            }
+            CarryPropagationAlgorithm::Sequential => self
+                .advanced_add_assign_with_carry_sequential(lhs, rhs, input_carry, requested_flag),
+            CarryPropagationAlgorithm::Automatic => unreachable!(),
+        }
+    }
+
+    /// Does lhs += (rhs + carry)
+    ///
+    /// acts like the ADC assembly op, except, the flags have to be explicitly requested
+    /// as they incur additional PBSes
+    ///
+    /// - Parameters must have at least 2 bits of message, 2 bits of carry
+    /// - blocks of lhs and rhs must be clean (no carries)
+    /// - lhs and rhs must have the same length
+    pub(crate) fn advanced_add_assign_with_carry_parallel(
+        &self,
+        lhs: &mut [Ciphertext],
+        rhs: &[Ciphertext],
+        input_carry: Option<&BooleanBlock>,
+        requested_flag: OutputFlag,
+    ) -> Option<BooleanBlock> {
+        // Empty rhs is a special case for the 'propagate single carry' function.
+        if rhs.is_empty() {
+            // Technically, CarryFlag is computable, but OverflowFlag is not
+            assert_eq!(
+                requested_flag,
+                OutputFlag::None,
+                "Cannot compute flags when called in propagation mode"
+            );
+        } else {
+            assert_eq!(
+                lhs.len(),
+                rhs.len(),
+                "Both operands must have the same number of blocks"
+            );
+        }
+        let int_key = &self.key.key;
+        let shortint_key = &int_key.key;
+
+        if lhs.is_empty() {
+            // Then both are empty
+            if requested_flag == OutputFlag::None {
+                return None;
+            }
+            return Some(int_key.create_trivial_boolean_block(false));
+        }
+
+        let message_modulus = int_key.message_modulus().0;
+        let num_bits_in_message = message_modulus.ilog2() as u64;
+
+        let block_modulus = message_modulus * int_key.carry_modulus().0;
+        let num_bits_in_block = block_modulus.ilog2();
+        assert!(
+            num_bits_in_block == 4,
+            "Having 4-bit ciphertext is a hard requirement!"
+        );
+
+        let saved_last_blocks = if requested_flag == OutputFlag::Overflow {
+            Some((lhs.last().cloned().unwrap(), rhs.last().cloned().unwrap()))
+        } else {
+            None
+        };
+
+        // Perform the block additions
+        lhs.par_iter_mut()
+            .zip(rhs.par_iter())
+            .for_each(|(lhs_b, rhs_b)| {
+                shortint_key.unchecked_add_assign(lhs_b, rhs_b);
+            });
+
+        if let Some(carry) = input_carry {
+            shortint_key.unchecked_add_assign(&mut lhs[0], &carry.0);
+        }
+
+        let blocks = lhs;
+        let num_blocks = blocks.len();
+
+        // Just in case we compare with max noise level, but it should always be num_bits_in_blocks
+        // with the parameters we provide
+        let group_size =
+            (num_bits_in_block as usize).min(shortint_key.max_noise_level.get() as usize);
+
+        // First step: Groups and block states
+        let (mut shifted_blocks, mut block_states) =
+            self.compute_shifted_blocks_and_block_states(blocks, 1);
+
+        let last_lhs_block = block_states.pop().unwrap();
+        let mut output_flag = match requested_flag {
+            OutputFlag::None => None,
+            OutputFlag::Overflow => {
+                // When used on the last block of `lhs` and `rhs`, this will create a
+                // block that encodes the 2 values to know if overflow did
+                // happen depending on the input carry of the last block.
+                let lut = shortint_key.generate_lookup_vector_bivariate(&|lhs, rhs| {
+                    overflow_flag_preparation_lut(lhs, rhs, num_bits_in_message)
+                });
+                let (mut last_lhs_block, last_rhs_block) = saved_last_blocks.unwrap();
+                shortint_key.unchecked_apply_lookup_table_bivariate_assign_prep(
+                    &mut last_lhs_block,
+                    &last_rhs_block,
+                );
+                self.apply_lookup_vector_single_assign(&mut last_lhs_block, &lut);
+                Some(last_lhs_block)
+            }
+            OutputFlag::Carry => Some(last_lhs_block),
+        };
+
+        // Second step: Calculate group carries and propagation states
+        let (propagation_simulators, resolved_carries) =
+            self.compute_propagation_simulators_and_groups_carries(group_size, &block_states);
+
+        shifted_blocks
+            .par_iter_mut()
+            .zip(propagation_simulators.par_iter())
+            .for_each(|(block, simulator)| {
+                shortint_key.unchecked_add_assign(block, simulator);
+            });
+
+        match requested_flag {
+            OutputFlag::None => {}
+            OutputFlag::Overflow | OutputFlag::Carry => {
+                let block = output_flag.as_mut().unwrap();
+                shortint_key.unchecked_add_assign(block, &propagation_simulators[num_blocks - 1]);
+            }
+        }
+
+        // Final step: adding resolved carries and cleaning result
+        shifted_blocks
+            .iter_mut()
+            .enumerate()
+            .for_each(|(i, block)| {
+                let group_index = i / group_size;
+                let carry = &resolved_carries[group_index];
+                shortint_key.unchecked_add_assign(block, carry);
+            });
+
+        let message_extract_lut =
+            shortint_key.generate_lookup_vector(&|block| (block >> 1) % message_modulus);
+        let carry_flag_lut = shortint_key.generate_lookup_vector(&|block| (block >> 2) & 1);
+        let mut luts = vec![&message_extract_lut; num_blocks];
+
+        let overflow_flag_lut = shortint_key.generate_lookup_vector(&|block| {
+            let input_carry = (block >> 1) & 1;
+            let does_overflow_if_carry_is_1 = (block >> 3) & 1;
+            let does_overflow_if_carry_is_0 = (block >> 2) & 1;
+            if input_carry == 1 {
+                does_overflow_if_carry_is_1
+            } else {
+                does_overflow_if_carry_is_0
+            }
+        });
+
+        match requested_flag {
+            OutputFlag::None => {}
+            OutputFlag::Overflow => {
+                let mut block = output_flag.unwrap();
+                // When num block is 1, we have to use the input carry
+                // given by the caller
+                let carry_into_last_block = input_carry
+                    .as_ref()
+                    .filter(|_| num_blocks == 1)
+                    .map_or_else(
+                        || &resolved_carries[resolved_carries.len() - 1],
+                        |input_carry| &input_carry.0,
+                    );
+                shortint_key.unchecked_add_assign(&mut block, carry_into_last_block);
+
+                shifted_blocks.push(block);
+                luts.push(&overflow_flag_lut);
+            }
+            OutputFlag::Carry => {
+                let mut block = output_flag.unwrap();
+                shortint_key.unchecked_add_assign(
+                    &mut block,
+                    &resolved_carries[resolved_carries.len() - 1],
+                );
+                shifted_blocks.push(block);
+                luts.push(&carry_flag_lut);
+            }
+        }
+
+        self.apply_lookup_vector_packed_assign(&mut shifted_blocks, &luts);
+
+        blocks.clone_from_slice(&shifted_blocks[..num_blocks]);
+
+        match requested_flag {
+            OutputFlag::None => None,
+            OutputFlag::Overflow | OutputFlag::Carry => {
+                let output_flag = &shifted_blocks[num_blocks];
+                Some(BooleanBlock::new_unchecked(output_flag.clone()))
+            }
+        }
+    }
+
+    pub fn compute_shifted_blocks_and_block_states(
+        &self,
+        blocks: &[Ciphertext],
+        num_additions: usize,
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let total_blocks = blocks.len();
+        assert_eq!(
+            total_blocks % num_additions,
+            0,
+            "Insufficient blocks for number of additions"
+        );
+        let blocks_per_addition = total_blocks / num_additions;
+        let int_key = &self.key.key;
+        let shortint_key = &int_key.key;
+        let message_modulus = int_key.message_modulus().0;
+
+        let block_modulus = message_modulus * int_key.carry_modulus().0;
+        let num_bits_in_block = block_modulus.ilog2();
+
+        let group_size = num_bits_in_block as usize;
+
+        let shift_block_lut_fn: &dyn Fn(u64) -> u64 = &|block| (block % message_modulus) << 1;
+
+        let mut first_group_luts = vec![{
+            let first_block_state_fn = |block| {
+                if block >= message_modulus {
+                    1 // Generates
+                } else {
+                    0 // Nothing
+                }
+            };
+            shortint_key.generate_many_lookup_vector(&[&first_block_state_fn, shift_block_lut_fn])
+        }];
+
+        for index in 1..group_size {
+            let state_fn = |block| {
+                let r = if block >= message_modulus {
+                    2 // Generates Carry
+                } else if block == message_modulus - 1 {
+                    1 // Propagates a carry
+                } else {
+                    0 // Absorbs a potential carry
+                };
+
+                r << (index - 1)
+            };
+            first_group_luts
+                .push(shortint_key.generate_many_lookup_vector(&[&state_fn, shift_block_lut_fn]))
+        }
+
+        let other_block_state_luts = (0..group_size)
+            .map(|index| {
+                let state_fn = |block| {
+                    let r = if block >= message_modulus {
+                        2 // Generates Carry
+                    } else if block == message_modulus - 1 {
+                        1 // Propagates a carry
+                    } else {
+                        0 // Absorbs a potential carry
+                    };
+
+                    r << index
+                };
+                shortint_key.generate_many_lookup_vector(&[&state_fn, shift_block_lut_fn])
+            })
+            .collect::<Vec<_>>();
+
+        // For the last block the state we compute will be used (if needed)
+        // to compute the output carry of the whole addition.
+        // This computation will be done during the 'cleaning' phase
+        let last_block_luts = {
+            if blocks_per_addition == 1 {
+                let first_block_state_fn = |block| {
+                    if block >= message_modulus {
+                        2 << 1 // Generates
+                    } else {
+                        0 // Nothing
+                    }
+                };
+                shortint_key
+                    .generate_many_lookup_vector(&[&first_block_state_fn, shift_block_lut_fn])
+            } else {
+                first_group_luts[2].clone()
+            }
+        };
+
+        let luts = (0..blocks_per_addition)
+            .into_par_iter()
+            .map(|index| {
+                let group_index = index / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = index % (group_size);
+                let is_last_index = index == blocks_per_addition - 1;
+
+                if is_last_index {
+                    &last_block_luts
+                } else if is_in_first_group {
+                    &first_group_luts[index_in_group]
+                } else {
+                    &other_block_state_luts[index_in_group]
+                }
+            })
+            .collect::<Vec<_>>()
+            .repeat(num_additions);
+
+        let tmp = self.apply_many_lookup_vector_packed(blocks, &luts);
+
+        let mut shifted_blocks = Vec::with_capacity(total_blocks);
+        let mut block_states = Vec::with_capacity(total_blocks);
+        for mut blocks in tmp {
+            assert_eq!(blocks.len(), 2);
+            shifted_blocks.push(blocks.pop().unwrap());
+            block_states.push(blocks.pop().unwrap());
+        }
+        (shifted_blocks, block_states)
+    }
+
+    pub(crate) fn compute_propagation_simulators_and_groups_carries(
+        &self,
+        group_size: usize,
+        block_states: &[Ciphertext],
+    ) -> (Vec<Ciphertext>, Vec<Ciphertext>) {
+        let shortint_key = &self.key.key.key;
+        if block_states.is_empty() {
+            return (
+                vec![shortint_key.create_trivial(1)],
+                vec![shortint_key.create_trivial(0)],
+            );
+        }
+        let message_modulus = shortint_key.message_modulus.0;
+        let block_modulus = message_modulus * shortint_key.carry_modulus.0;
+        let num_bits_in_block = block_modulus.ilog2();
+        let num_blocks = block_states.len();
+
+        // The LUTs that tell if a carry is generated or not
+        // for a cum sum block in the first group (excluding first block)
+        let first_group_propagation_state_luts = (0..group_size)
+            .map(|index| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    let carry = (propa_cum_sum_block >> index) & 1;
+                    if carry == 0 {
+                        0 // Nothing
+                    } else {
+                        2 // Generate
+                    }
+                })
+            })
+            .collect::<Vec<_>>();
+
+        // The LUT that outputs the propagation result of the first group
+        let first_group_carry_lut = shortint_key.generate_lookup_vector(&|block| {
+            // Check if the last bit of the block is set
+            (block >> (num_bits_in_block - 1)) & 1
+        });
+
+        // The LUTs that tell if a carry is generated, propagated or none
+        // based on the block states (excluding the first group)
+        let other_groups_inner_propagation_luts = (0..group_size)
+            .map(|index| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    let mask = (2 << index) - 1;
+                    match propa_cum_sum_block.cmp(&mask) {
+                        std::cmp::Ordering::Less => 0,    // Nothing
+                        std::cmp::Ordering::Equal => 1,   // Propagate
+                        std::cmp::Ordering::Greater => 2, // Generate
+                    }
+                })
+            })
+            .collect::<Vec<_>>();
+
+        let num_groups = num_blocks.div_ceil(group_size);
+        let num_carry_to_resolve = num_groups - 1;
+
+        let sequential_depth = num_carry_to_resolve.saturating_sub(1) / (group_size - 1);
+
+        let hillis_steel_depth = if num_carry_to_resolve == 0 {
+            0
+        } else {
+            num_carry_to_resolve.ceil_ilog2() as usize
+        };
+
+        let use_sequential_algorithm_to_resolve_group_carries =
+            sequential_depth <= hillis_steel_depth;
+
+        // The LUTs that output the propagation result of the other groups
+        let other_group_carry_luts = if use_sequential_algorithm_to_resolve_group_carries {
+            // When using the sequential algorithm for the propagation of one group to the
+            // other we need to shift the PGN state to the correct position, so we later, when
+            // using them only lwe_add is needed and so noise management is easy
+            //
+            // Also, these LUTs are 'negacylic', they are made to exploit the padding bit
+            // resulting blocks from these LUTs must be added the constant `1 << index`.
+            (0..group_size)
+                .map(|index| {
+                    shortint_key.generate_lookup_vector(&|block| {
+                        // All bits set to 1 (e.g. 0b1111), means propagate
+                        if block == (block_modulus - 1) {
+                            0
+                        } else {
+                            // u64::MAX is -1 in two's complement
+                            u64::MAX << index
+                        }
+                    })
+                })
+                .collect::<Vec<_>>()
+        } else {
+            // This LUT is for when we are using Hillis-Steele prefix-scan to propagate carries
+            // between groups. When using this propagation, the encoding of the states
+            // are a bit different.
+            //
+            // Also, these LUTs are 'negacylic', they are made to exploit the padding bit
+            // resulting blocks from these LUTs must be added the constant `1`.
+            vec![shortint_key.generate_lookup_vector(&|block| {
+                if block == (block_modulus - 1) {
+                    // All bits set to 1 (e.g. 0b1111), means propagate
+                    2
+                } else {
+                    // u64::MAX is -1 in two's complement
+                    u64::MAX
+                }
+            })]
+        };
+
+        // First blocks don't require a PBS:
+        // first block in first group is already resolved,
+        // first block in other groups equals the identity function.
+        let mut propagation_cum_sums = Vec::with_capacity(num_blocks);
+        block_states.chunks(group_size).for_each(|group| {
+            // This simplifies bookkeeping. We'll fill it in later.
+            // TODO: Create a mechanism to skip empty ciphertexts, since trivial PBS also costs
+            propagation_cum_sums.push(shortint_key.create_trivial(0));
+            let mut previous_cum_sum = &group[0];
+
+            for other in &group[1..] {
+                let mut result = other.clone();
+                shortint_key.unchecked_add_assign(&mut result, previous_cum_sum);
+                propagation_cum_sums.push(result);
+                previous_cum_sum = propagation_cum_sums.last().unwrap();
+            }
+        });
+
+        // Compute the cum sum arrays,
+        // each group is independent of other groups,
+        // but we store everything flattened (Vec<_>) instead of nested (Vec<Vec<_>>)
+        let propagation_cum_sum_luts = (0..num_blocks)
+            .map(|i| {
+                let group_index = i / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = i % group_size;
+
+                if is_in_first_group {
+                    if index_in_group == group_size - 1 {
+                        &first_group_carry_lut
+                    } else {
+                        &first_group_propagation_state_luts[index_in_group]
+                    }
+                } else if index_in_group == group_size - 1 {
+                    if use_sequential_algorithm_to_resolve_group_carries {
+                        &other_group_carry_luts[(group_index - 1) % (group_size - 1)]
+                    } else {
+                        &other_group_carry_luts[0]
+                    }
+                } else {
+                    &other_groups_inner_propagation_luts[index_in_group]
+                }
+            })
+            .collect::<Vec<_>>();
+
+        self.apply_lookup_vector_packed_assign(
+            &mut propagation_cum_sums,
+            &propagation_cum_sum_luts,
+        );
+
+        // Fill in correct value
+        block_states
+            .chunks(group_size)
+            .enumerate()
+            .for_each(|(group_index, group)| {
+                if group_index == 0 {
+                    // Saves one PBS, since first element becomes 2 if the original value is 1
+                    // and 0 otherwise
+                    propagation_cum_sums[0] = shortint_key.unchecked_scalar_mul(&group[0], 2);
+                } else {
+                    propagation_cum_sums[group_size * group_index].clone_from(&group[0]);
+                }
+            });
+
+        propagation_cum_sums
+            .par_iter_mut()
+            .enumerate()
+            .for_each(|(i, block)| {
+                let group_index = i / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = i % group_size;
+
+                let may_have_its_padding_bit_set =
+                    !is_in_first_group && index_in_group == group_size - 1;
+                if may_have_its_padding_bit_set {
+                    if use_sequential_algorithm_to_resolve_group_carries {
+                        shortint_key.unchecked_scalar_add_assign(
+                            block,
+                            1 << ((group_index - 1) % (group_size - 1)),
+                        );
+                    } else {
+                        shortint_key.unchecked_scalar_add_assign(block, 1);
+                    }
+                    block.degree = Degree::new(message_modulus - 1);
+                }
+            });
+        let mut group_carries = Vec::with_capacity(num_groups);
+        let mut propagation_simulators = Vec::with_capacity(num_blocks);
+
+        // First block does not get a carry from
+        propagation_simulators.push(shortint_key.create_trivial(1));
+        for block in propagation_cum_sums.drain(..) {
+            if propagation_simulators.len() % group_size == 0 {
+                group_carries.push(block);
+
+                // The first block in each group has its simulator set to 1
+                // because it always receives an input borrow generated from a previous group
+                propagation_simulators.push(shortint_key.create_trivial(1));
+            } else {
+                propagation_simulators.push(block);
+            }
+        }
+
+        // Third step: resolve carry propagation between the groups
+        let resolved_carries = if group_carries.is_empty() {
+            vec![shortint_key.create_trivial(0)]
+        } else if use_sequential_algorithm_to_resolve_group_carries {
+            self.resolve_carries_of_groups_sequentially(group_carries, group_size)
+        } else {
+            self.resolve_carries_of_groups_using_hillis_steele(group_carries)
+        };
+        (propagation_simulators, resolved_carries)
+    }
+
+    /// This resolves the carries using a Hillis-Steele algorithm
+    ///
+    /// Blocks must have a value in
+    /// - 2 or 1 for generate
+    /// - 3 for propagate
+    /// - 0 for no carry
+    ///
+    /// The returned Vec of blocks encrypting 1 if a carry is generated, 0 if not
+    pub(crate) fn resolve_carries_of_groups_using_hillis_steele(
+        &self,
+        group_pgns: Vec<Ciphertext>,
+    ) -> Vec<Ciphertext> {
+        let shortint_key = &self.key.key.key;
+        let lut_carry_propagation_sum = |msb: u64, lsb: u64| -> u64 {
+            if msb == 2 {
+                1 // Remap Generate to 1
+            } else if msb == 3 {
+                // MSB propagates
+                if lsb == 2 {
+                    1
+                } else {
+                    lsb
+                } // also remap here
+            } else {
+                msb
+            }
+        };
+        // TODO: use SIMD variant
+        let mut resolved_carries =
+            self.compute_prefix_sum_hillis_steele(group_pgns, &lut_carry_propagation_sum);
+        resolved_carries.insert(0, shortint_key.create_trivial(0));
+        resolved_carries
+    }
+
+    /// This resolves the carries using a sequential algorithm
+    /// where each iteration resolves group_size - 1 "PGN"
+    ///
+    /// Blocks must have a value in
+    /// - 2 for generate
+    /// - 1 for propagate
+    /// - 0 for no carry
+    ///
+    /// This value must be shifted by the position in the block's group.
+    ///
+    /// The block of the first group (so group_pgns[0]) must have a value in
+    /// - 1 for generate
+    /// - 0 for no carry
+    ///
+    /// The returned Vec of blocks encrypting 1 if a carry is generated, 0 if not
+    pub(crate) fn resolve_carries_of_groups_sequentially(
+        &self,
+        mut group_carries: Vec<Ciphertext>,
+        group_size: usize,
+    ) -> Vec<Ciphertext> {
+        let shortint_key = &self.key.key.key;
+        let luts = (0..group_size - 1)
+            .map(|index| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    (propa_cum_sum_block >> (index + 1)) & 1
+                })
+            })
+            .collect::<Vec<_>>();
+        let luts = luts.iter().collect::<Vec<_>>();
+
+        group_carries.rotate_left(1);
+        let mut resolved_carries =
+            vec![shortint_key.create_trivial(0), group_carries.pop().unwrap()];
+
+        for chunk in group_carries.chunks_mut(group_size - 1) {
+            let mut cum_sums = chunk.to_vec();
+            shortint_key.unchecked_add_assign(&mut cum_sums[0], resolved_carries.last().unwrap());
+
+            if chunk.len() > 1 {
+                let mut accumulator = cum_sums[0].clone();
+                for block in cum_sums[1..].iter_mut() {
+                    shortint_key.unchecked_add_assign(&mut accumulator, block);
+                    block.clone_from(&accumulator);
+                }
+            }
+            let initial_luts = &luts[..chunk.len()];
+            self.apply_lookup_vector_packed_assign(&mut cum_sums, initial_luts);
+
+            // Cum sums now contains the output carries
+            resolved_carries.append(&mut cum_sums);
+        }
+
+        resolved_carries
+    }
+
+    /// Computes the result of `lhs += rhs + input_carry`
+    ///
+    /// This uses the sequential algorithm to propagate the carries
+    ///
+    /// - `lhs` and `rhs` must have the same `len()`, empty is allowed
+    /// - `blocks of lhs` and `rhs` must all be without carry
+    /// - blocks must have at least one bit of message and one bit of carry
+    ///
+    /// Returns `Some(...)` if requested_flag != ComputationFlags::None
+    pub(crate) fn advanced_add_assign_with_carry_sequential(
+        &self,
+        lhs: &mut [Ciphertext],
+        rhs: &[Ciphertext],
+        input_carry: Option<&BooleanBlock>,
+        requested_flag: OutputFlag,
+    ) -> Option<BooleanBlock> {
+        let integer_key = &self.key.key;
+        assert_eq!(
+            lhs.len(),
+            rhs.len(),
+            "Both operands must have the same number of blocks"
+        );
+
+        if lhs.is_empty() {
+            return if requested_flag == OutputFlag::None {
+                None
+            } else {
+                Some(integer_key.create_trivial_boolean_block(false))
+            };
+        }
+
+        let carry = input_carry.map_or_else(
+            || integer_key.create_trivial_boolean_block(false),
+            Clone::clone,
+        );
+
+        // 4_4
+        // If we have at least 2 bits and at least as much carries
+        //
+        // The num blocks == 1 + requested_flag == OverflowFlag will actually result in one more
+        // PBS of latency than num_blocks == 1 && requested_flag != OverflowFlag
+        //
+        // It happens because the computation of the overflow flag requires 2 steps,
+        // and we insert these two steps in parallel to normal carry propagation.
+        // The first step is done when processing the first block,
+        // the second step is done when processing the last block.
+        // So if the number of block is smaller than 2 then,
+        // the overflow computation adds additional layer of PBS.
+        assert!(integer_key.message_modulus().0 >= 4);
+        assert!(integer_key.carry_modulus().0 >= integer_key.message_modulus().0);
+        self.advanced_add_assign_sequential_at_least_4_bits(
+            requested_flag,
+            lhs,
+            rhs,
+            carry,
+            input_carry,
+        )
+    }
+
+    /// Computes lhs += (rhs + carry) using the sequential propagation of carries
+    ///
+    /// parameters of blocks must have 4 bits, parameters in the form X_Y where X >= 2 && Y >= X
+    fn advanced_add_assign_sequential_at_least_4_bits(
+        &self,
+        requested_flag: OutputFlag,
+        lhs: &mut [Ciphertext],
+        rhs: &[Ciphertext],
+        carry: BooleanBlock,
+        input_carry: Option<&BooleanBlock>,
+    ) -> Option<BooleanBlock> {
+        let shortint_key = &self.key.key.key;
+        let message_modulus = shortint_key.message_modulus.0;
+        let mut carry = carry.0;
+
+        let overflow_requested = requested_flag == OutputFlag::Overflow;
+        let mut overflow_flag = if overflow_requested {
+            let mut block = shortint_key
+                .unchecked_scalar_mul(lhs.last().as_ref().unwrap(), message_modulus as u8);
+            shortint_key.unchecked_add_assign(&mut block, rhs.last().as_ref().unwrap());
+            Some(block)
+        } else {
+            None
+        };
+
+        // Pre-generate LUTs
+        let many_message_carry_extract = self.many_lut_message_and_carry_extract();
+
+        let num_bits_in_message = message_modulus.ilog2() as u64;
+        let overflow_prep_lut = shortint_key.generate_lookup_vector(&|lhs_rhs| {
+            let lhs = lhs_rhs / message_modulus;
+            let rhs = lhs_rhs % message_modulus;
+            overflow_flag_preparation_lut(lhs, rhs, num_bits_in_message)
+        });
+        let overflow_flag_lut = shortint_key.generate_lookup_vector(&|block| {
+            let input_carry = block & 1;
+            let does_overflow_if_carry_is_1 = (block >> 3) & 1;
+            let does_overflow_if_carry_is_0 = (block >> 2) & 1;
+            if input_carry == 1 {
+                does_overflow_if_carry_is_1
+            } else {
+                does_overflow_if_carry_is_0
+            }
+        });
+
+        // Process all blocks sequentially, propagating carries from block to block
+        let num_blocks = lhs.len();
+        for block_idx in 0..num_blocks {
+            let is_first = block_idx == 0;
+            let is_last = block_idx == num_blocks - 1;
+
+            // Add rhs + carry to lhs
+            shortint_key.unchecked_add_assign(&mut lhs[block_idx], &rhs[block_idx]);
+            shortint_key.unchecked_add_assign(&mut lhs[block_idx], &carry);
+
+            // Before last-block PBS, feed the propagated carry into overflow flags.
+            // For single-block, the carry into the only block is the external input carry;
+            // for multi-block, it's the carry propagated from the previous block.
+            if is_last && overflow_requested && num_blocks > 1 {
+                shortint_key.unchecked_add_assign(overflow_flag.as_mut().unwrap(), &carry);
+            }
+
+            // Determine which overflow LUTs to include in this PBS batch
+            let include_overflow_prep = is_first && overflow_requested;
+            let include_overflow_final = is_last && overflow_requested && num_blocks > 1;
+
+            // Build batch of blocks and LUTs for packed PBS
+            let mut overflow_flag_blocks = Vec::new();
+            let mut overflow_luts = Vec::new();
+
+            if include_overflow_prep {
+                overflow_flag_blocks.push(overflow_flag.as_ref().unwrap().clone());
+                overflow_luts.push(&overflow_prep_lut);
+            } else if include_overflow_final {
+                overflow_flag_blocks.push(overflow_flag.as_ref().unwrap().clone());
+                overflow_luts.push(&overflow_flag_lut);
+            }
+
+            let message_and_carries = self.apply_many_lookup_vector_packed(
+                &[lhs[block_idx].clone()],
+                &[&many_message_carry_extract],
+            );
+
+            // Extract results
+            lhs[block_idx].clone_from(&message_and_carries[0][0]);
+            carry.clone_from(&message_and_carries[0][1]);
+
+            if include_overflow_prep || include_overflow_final {
+                self.apply_lookup_vector_packed_assign(&mut overflow_flag_blocks, &overflow_luts);
+
+                overflow_flag
+                    .as_mut()
+                    .unwrap()
+                    .clone_from(&overflow_flag_blocks[0])
+            }
+        }
+
+        // Single-block overflow needs a second PBS round: the first round applied
+        // overflow_prep_lut, now we add the input carry and apply overflow_flag_lut.
+        if num_blocks == 1 && overflow_requested {
+            if let Some(input_carry) = input_carry {
+                shortint_key.unchecked_add_assign(overflow_flag.as_mut().unwrap(), &input_carry.0);
+            }
+
+            let mut flag = vec![overflow_flag.take().unwrap()];
+            self.apply_lookup_vector_packed_assign(&mut flag, &[&overflow_flag_lut]);
+            overflow_flag = Some(flag.into_iter().next().unwrap());
+        }
+
+        match requested_flag {
+            OutputFlag::None => None,
+            OutputFlag::Overflow => overflow_flag.map(BooleanBlock::new_unchecked),
+            OutputFlag::Carry => {
+                carry.degree = Degree::new(1);
+                Some(BooleanBlock::new_unchecked(carry))
+            }
+        }
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/add_simd.rs b/tfhe/src/integer/fpga/server_key/radix/add_simd.rs
new file mode 100644
index 000000000..0dd56688e
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/add_simd.rs
@@ -0,0 +1,1135 @@
+use crate::core_crypto::commons::numeric::UnsignedInteger;
+use crate::integer::ciphertext::IntegerRadixCiphertext;
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::integer::server_key::radix_parallel::add::{
+    overflow_flag_preparation_lut, CarryPropagationAlgorithm,
+};
+use crate::integer::server_key::radix_parallel::OutputFlag;
+use crate::integer::BooleanBlock;
+use crate::shortint::ciphertext::Degree;
+use crate::shortint::Ciphertext;
+use rayon::prelude::*;
+
+impl BelfortServerKey {
+    /// Computes homomorphically an addition between two ciphertexts encrypting integer values.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertexts block carries are empty and clears them if it's not the
+    /// case and the operation requires it. It outputs a ciphertext whose block carries are always
+    /// empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 14;
+    /// let msg2 = 97;
+    ///
+    /// let ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// let ct_res = fpga_key.add(&ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec_result: u64 = cks.decrypt(&ct_res);
+    /// assert_eq!(dec_result, msg1 + msg2);
+    /// ```
+    pub fn add_simd<T>(&self, ct1: &[T], ct2: &[T]) -> Vec<T>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let mut ct_res = ct1.to_vec();
+        self.add_assign_simd(&mut ct_res, ct2);
+        ct_res
+    }
+
+    /// Compute homomorphically an addition between two ciphertexts
+    ///
+    /// The result is stored in the `ct1` ciphertext.
+    ///
+    /// This function, like all "default" operations (i.e. not smart, checked or unchecked), will
+    /// check that the input ciphertext carries are empty and clears them if it's not the case and
+    /// the operation requires it. It outputs a ciphertext whose carry is always empty.
+    ///
+    /// This means that when using only "default" operations, a given operation (like add for
+    /// example) has always the same performance characteristics from one call to another and
+    /// guarantees correctness by pre-emptively clearing carries of output ciphertexts.
+    ///
+    /// # Example
+    ///
+    /// ```rust
+    /// use tfhe::integer::fpga::BelfortServerKey;
+    /// use tfhe::integer::gen_keys_radix;
+    /// use tfhe::shortint::parameters::PARAM_MESSAGE_2_CARRY_2_KS_PBS;
+    ///
+    /// // Generate the client key and the server key:
+    /// let num_blocks = 4;
+    /// let (cks, sks) = gen_keys_radix(PARAM_MESSAGE_2_CARRY_2_KS_PBS, num_blocks);
+    ///
+    /// // Generates the FPGA key from sks
+    /// let mut fpga_key = BelfortServerKey::from(&sks);
+    /// // Connect to the FPGAs
+    /// fpga_key.connect();
+    ///
+    /// let msg1 = 15u64;
+    /// let msg2 = 3u64;
+    ///
+    /// // Encrypt two messages:
+    /// let mut ct1 = cks.encrypt(msg1);
+    /// let ct2 = cks.encrypt(msg2);
+    ///
+    /// // Compute homomorphically an addition:
+    /// fpga_key.add_assign(&mut ct1, &ct2);
+    ///
+    /// // Decrypt:
+    /// let dec = cks.decrypt(&ct1);
+    /// assert_eq!(dec, msg1 + msg2);
+    /// ```
+    pub fn add_assign_simd<T>(&self, ct1: &mut [T], ct2: &[T])
+    where
+        T: IntegerRadixCiphertext,
+    {
+        self.add_assign_with_carry_simd(ct1, ct2, None);
+    }
+
+    pub fn add_assign_with_carry_simd<T>(
+        &self,
+        lhs: &mut [T],
+        rhs: &[T],
+        input_carries: Option<&[BooleanBlock]>,
+    ) where
+        T: IntegerRadixCiphertext,
+    {
+        for ct in lhs.iter_mut() {
+            self.conditional_full_propagate(ct);
+        }
+
+        let rhs = rhs
+            .iter()
+            .map(|ct| {
+                let mut cloned_rhs: T;
+                if ct.block_carries_are_empty() {
+                    ct.clone()
+                } else {
+                    cloned_rhs = ct.clone();
+                    self.full_propagate(&mut cloned_rhs);
+                    cloned_rhs
+                }
+            })
+            .collect::<Vec<_>>();
+
+        self.advanced_add_assign_with_carry_simd(
+            lhs,
+            &rhs,
+            input_carries,
+            OutputFlag::None,
+            CarryPropagationAlgorithm::Automatic,
+        );
+    }
+
+    /// Computes the result of `lhs[i] += rhs[i] + input_carry[i]` for multiple additions in SIMD
+    ///
+    /// This will select what seems to be the best algorithm to propagate carries
+    /// (fully parallel vs sequential) by looking at the number of blocks and
+    /// FPGA characteristics.
+    ///
+    /// - All lhs[i] and rhs[i] must have the same number of blocks
+    /// - blocks of lhs and rhs must all be without carry
+    /// - blocks must have at least one bit of message and one bit of carry
+    ///
+    /// Returns `Vec<Option<BooleanBlock>>` if requested_flag != OutputFlag::None
+    pub(crate) fn advanced_add_assign_with_carry_simd<T>(
+        &self,
+        lhs_array: &mut [T],
+        rhs_array: &[T],
+        input_carries: Option<&[BooleanBlock]>,
+        requested_flag: OutputFlag,
+        mut algorithm: CarryPropagationAlgorithm,
+    ) -> Vec<Option<BooleanBlock>>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        assert_eq!(
+            lhs_array.len(),
+            rhs_array.len(),
+            "lhs and rhs must have the same length!"
+        );
+        if lhs_array.is_empty() {
+            return vec![];
+        }
+
+        // Validate that all ciphertexts have the same number of blocks
+        let blocks_per_addition = lhs_array[0].blocks().len();
+
+        lhs_array.par_iter().zip(rhs_array.par_iter()).enumerate().for_each(|(i, (l, r))| {
+            let (lhs_len, rhs_len) = (l.blocks().len(), r.blocks().len());
+            assert_eq!(
+                lhs_len,
+                rhs_len,
+                "Addition {i}: lhs and rhs must have the same number of blocks ({lhs_len} vs {rhs_len})",
+            );
+            assert_eq!(
+                lhs_len,
+                blocks_per_addition,
+                "All ciphertexts must have the same number of blocks (expected {blocks_per_addition}, got {lhs_len} at idx {i})",
+            );
+        });
+
+        // having 4-bits is a hard requirement
+        // So to protect against bad carry prop choice we do this check
+        let total_modulus = self.key.key.message_modulus().0 * self.key.key.carry_modulus().0;
+        let has_enough_bits_per_block = total_modulus >= (1 << 4);
+        if !has_enough_bits_per_block {
+            algorithm = CarryPropagationAlgorithm::Sequential;
+        }
+
+        if algorithm == CarryPropagationAlgorithm::Automatic {
+            // TODO: https://linear.app/belfort/issue/TFHE-694/improve-the-parallelsequential-algorithm-selection-in-advanced-add
+            // if should_parallel_propagation_be_faster_fpga(total_modulus, num_blocks) {
+            algorithm = CarryPropagationAlgorithm::Sequential;
+        }
+
+        match algorithm {
+            CarryPropagationAlgorithm::Parallel => self
+                .advanced_add_assign_with_carry_parallel_simd(
+                    lhs_array,
+                    rhs_array,
+                    input_carries,
+                    requested_flag,
+                ),
+            CarryPropagationAlgorithm::Sequential => self
+                .advanced_add_assign_with_carry_sequential_simd(
+                    lhs_array,
+                    rhs_array,
+                    input_carries,
+                    requested_flag,
+                ),
+            CarryPropagationAlgorithm::Automatic => unreachable!(),
+        }
+    }
+
+    /// Does lhs[i] += (rhs[i] + carry[i]) for multiple independent ciphertext additions
+    ///
+    /// This SIMD version processes multiple additions in parallel using packed LUT operations.
+    ///
+    /// # Arguments
+    /// * `lhs` - Slice of IntegerRadixCiphertexts (mutable, results stored here)
+    /// * `rhs` - Slice of IntegerRadixCiphertexts to add
+    /// * `input_carries` - Optional vector of input carries (one per addition)
+    /// * `requested_flag` - What output flag to compute (None, Overflow, or Carry)
+    ///
+    /// # Returns
+    /// Vector of optional BooleanBlocks (one per addition, None if no flag requested)
+    ///
+    /// # Requirements
+    /// - Parameters must have at least 2 bits of message, 2 bits of carry
+    /// - blocks of lhs and rhs must be clean (no carries)
+    /// - Each lhs[i] and rhs[i] must have the same number of blocks
+    /// - All ciphertexts must have the same number of blocks
+    pub(crate) fn advanced_add_assign_with_carry_parallel_simd<T>(
+        &self,
+        lhs_array: &mut [T],
+        rhs_array: &[T],
+        input_carries: Option<&[BooleanBlock]>,
+        requested_flag: OutputFlag,
+    ) -> Vec<Option<BooleanBlock>>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let int_key = &self.key.key;
+        let shortint_key = &int_key.key;
+
+        let num_additions = lhs_array.len();
+
+        // Validate that all ciphertexts have the same number of blocks
+        let blocks_per_addition = lhs_array[0].blocks().len();
+        let total_blocks = num_additions * blocks_per_addition;
+
+        // Validate input carries if provided
+        if let Some(carries) = input_carries {
+            assert_eq!(
+                carries.len(),
+                num_additions,
+                "Number of input carries must match number of additions"
+            );
+        }
+
+        // Handle empty blocks case
+        if blocks_per_addition == 0 {
+            if requested_flag == OutputFlag::None {
+                return vec![None; num_additions];
+            }
+            return vec![Some(int_key.create_trivial_boolean_block(false)); num_additions];
+        }
+
+        let message_modulus = int_key.message_modulus().0;
+        let num_bits_in_message = message_modulus.ilog2() as u64;
+
+        let block_modulus = message_modulus * int_key.carry_modulus().0;
+        let num_bits_in_block = block_modulus.ilog2();
+        assert!(
+            num_bits_in_block == 4,
+            "Having 4-bit ciphertext is a hard requirement!"
+        );
+
+        // Save last blocks for overflow computation
+        let saved_last_blocks = if requested_flag == OutputFlag::Overflow {
+            lhs_array
+                .par_iter()
+                .zip(rhs_array.par_iter())
+                .map(|(l, r)| {
+                    Some((
+                        l.blocks().last().cloned().unwrap(),
+                        r.blocks().last().unwrap(),
+                    ))
+                })
+                .collect::<Vec<_>>()
+        } else {
+            vec![None; num_additions]
+        };
+
+        // Perform block additions for all ciphertexts in parallel
+        lhs_array
+            .par_iter_mut()
+            .zip(rhs_array.par_iter())
+            .for_each(|(lhs_ct, rhs_ct)| {
+                lhs_ct
+                    .blocks_mut()
+                    .par_iter_mut()
+                    .zip(rhs_ct.blocks().par_iter())
+                    .for_each(|(lhs_b, rhs_b)| {
+                        shortint_key.unchecked_add_assign(lhs_b, rhs_b);
+                    });
+            });
+
+        // Add input carries to first blocks
+        if let Some(carries) = input_carries {
+            lhs_array
+                .par_iter_mut()
+                .zip(carries.par_iter())
+                .for_each(|(lhs_ct, carry)| {
+                    shortint_key.unchecked_add_assign(&mut lhs_ct.blocks_mut()[0], &carry.0);
+                });
+        }
+
+        let group_size: usize =
+            (num_bits_in_block as usize).min(shortint_key.max_noise_level.get() as usize);
+
+        // Flatten all blocks for packed operations
+        let all_blocks = lhs_array
+            .iter()
+            .flat_map(|ct| ct.blocks().iter().cloned())
+            .collect::<Vec<_>>();
+
+        // First step: Compute shifted blocks and block states for all additions
+        let (mut all_shifted_blocks, all_block_states) =
+            self.compute_shifted_blocks_and_block_states(&all_blocks, num_additions);
+
+        // Prepare output flags
+        let mut output_flags: Vec<Option<Ciphertext>> = match requested_flag {
+            OutputFlag::None => vec![None; num_additions],
+            OutputFlag::Overflow => {
+                // Prepare overflow flag blocks using packed bivariate LUT
+                let lut = shortint_key.generate_lookup_vector_bivariate(&|lhs, rhs| {
+                    overflow_flag_preparation_lut(lhs, rhs, num_bits_in_message)
+                });
+
+                let mut last_blocks = Vec::with_capacity(num_additions);
+                for saved in saved_last_blocks {
+                    let (mut last_lhs_block, last_rhs_block) = saved.unwrap();
+                    shortint_key.unchecked_apply_lookup_table_bivariate_assign_prep(
+                        &mut last_lhs_block,
+                        last_rhs_block,
+                    );
+                    last_blocks.push(last_lhs_block);
+                }
+
+                // Apply packed LUT
+                self.apply_same_lookup_vector_packed_assign(&mut last_blocks, &lut);
+
+                last_blocks.into_iter().map(Some).collect()
+            }
+            OutputFlag::Carry => {
+                // Extract last block states for output flag computation
+                let mut last_block_states = vec![None; num_additions];
+                (0..num_additions).for_each(|i| {
+                    let last_block_idx = (i + 1) * blocks_per_addition - 1;
+                    last_block_states[i] = Some(all_block_states[last_block_idx].clone());
+                });
+                last_block_states
+            }
+        };
+
+        // Second step: Calculate group carries and propagation states for all additions
+        // Process all additions together in SIMD fashion
+        let (all_propagation_simulators, all_resolved_carries) = self
+            .compute_propagation_simulators_and_groups_carries_simd(
+                group_size,
+                &all_block_states,
+                num_additions,
+            );
+
+        // Add propagation simulators to shifted blocks
+        all_shifted_blocks
+            .par_iter_mut()
+            .zip(all_propagation_simulators.par_iter())
+            .for_each(|(block, simulator)| {
+                shortint_key.unchecked_add_assign(block, simulator);
+            });
+
+        // Update output flags with propagation simulators
+        match requested_flag {
+            OutputFlag::None => {}
+            OutputFlag::Overflow | OutputFlag::Carry => {
+                for (i, flag) in output_flags.iter_mut().enumerate() {
+                    if let Some(block) = flag {
+                        let prop_sim_idx = (i + 1) * blocks_per_addition - 1;
+                        shortint_key
+                            .unchecked_add_assign(block, &all_propagation_simulators[prop_sim_idx]);
+                    }
+                }
+            }
+        }
+
+        // Add resolved carries to prepared blocks
+        all_shifted_blocks
+            .par_iter_mut()
+            .enumerate()
+            .for_each(|(flat_idx, block)| {
+                let add_idx = flat_idx / blocks_per_addition;
+                let block_idx = flat_idx % blocks_per_addition;
+                let group_idx = block_idx / group_size;
+
+                let carry = &all_resolved_carries[add_idx][group_idx];
+                shortint_key.unchecked_add_assign(block, carry);
+            });
+
+        // Prepare final LUTs for message extraction and flags
+        let message_extract_lut =
+            shortint_key.generate_lookup_vector(&|block| (block >> 1) % message_modulus);
+        let carry_flag_lut = shortint_key.generate_lookup_vector(&|block| (block >> 2) & 1);
+        let overflow_flag_lut = shortint_key.generate_lookup_vector(&|block| {
+            let input_carry = (block >> 1) & 1;
+            let does_overflow_if_carry_is_1 = (block >> 3) & 1;
+            let does_overflow_if_carry_is_0 = (block >> 2) & 1;
+            if input_carry == 1 {
+                does_overflow_if_carry_is_1
+            } else {
+                does_overflow_if_carry_is_0
+            }
+        });
+
+        // Build LUT vector for all blocks plus flags
+        let mut luts = vec![&message_extract_lut; total_blocks];
+
+        // Handle output flags
+        match requested_flag {
+            OutputFlag::None => {}
+            OutputFlag::Overflow => {
+                for (i, flag) in output_flags.iter_mut().enumerate() {
+                    if let Some(block) = flag {
+                        // Add carry into last block
+                        let carry_into_last_block = input_carries
+                            .filter(|_| blocks_per_addition == 1)
+                            .map_or_else(
+                                || all_resolved_carries[i].last().unwrap(),
+                                |input_carry| &input_carry[i].0,
+                            );
+
+                        shortint_key.unchecked_add_assign(block, carry_into_last_block);
+                        all_shifted_blocks.push(block.clone());
+                        luts.push(&overflow_flag_lut);
+                    }
+                }
+            }
+            OutputFlag::Carry => {
+                for (i, flag) in output_flags.iter_mut().enumerate() {
+                    if let Some(block) = flag {
+                        shortint_key
+                            .unchecked_add_assign(block, all_resolved_carries[i].last().unwrap());
+                        all_shifted_blocks.push(block.clone());
+                        luts.push(&carry_flag_lut);
+                    }
+                }
+            }
+        }
+
+        // Apply packed LUT to all blocks at once
+        self.apply_lookup_vector_packed_assign(&mut all_shifted_blocks, &luts);
+
+        // Copy results back to lhs
+        lhs_array
+            .iter_mut()
+            .enumerate()
+            .take(num_additions)
+            .for_each(|(add_idx, lhs)| {
+                let start = add_idx * blocks_per_addition;
+                let end = start + blocks_per_addition;
+                lhs.blocks_mut()
+                    .clone_from_slice(&all_shifted_blocks[start..end]);
+            });
+
+        // Extract output flags
+        match requested_flag {
+            OutputFlag::None => vec![None; num_additions],
+            OutputFlag::Overflow | OutputFlag::Carry => (0..num_additions)
+                .map(|i| {
+                    let last_block = total_blocks + i;
+                    let output_flag = all_shifted_blocks[last_block].clone();
+                    Some(BooleanBlock::new_unchecked(output_flag))
+                })
+                .collect(),
+        }
+    }
+
+    /// Sequential SIMD addition for multiple independent ciphertext additions
+    ///
+    /// This processes multiple additions in SIMD fashion, but uses sequential carry propagation
+    /// (block by block) instead of parallel carry propagation.
+    ///
+    /// # Arguments
+    /// * `lhs_array` - Slice of IntegerRadixCiphertexts (mutable, results stored here)
+    /// * `rhs_array` - Slice of IntegerRadixCiphertexts to add
+    /// * `input_carries` - Optional vector of input carries (one per addition)
+    /// * `requested_flag` - What output flag to compute (None, Overflow, or Carry)
+    ///
+    /// # Returns
+    /// Vector of optional BooleanBlocks (one per addition, None if no flag requested)
+    ///
+    /// # Requirements
+    /// - Parameters must have at least 4 bits (2 message + 2 carry)
+    /// - blocks of lhs and rhs must be clean (no carries)
+    /// - Each lhs[i] and rhs[i] must have the same number of blocks
+    /// - All ciphertexts must have the same number of blocks
+    pub(crate) fn advanced_add_assign_with_carry_sequential_simd<T>(
+        &self,
+        lhs_array: &mut [T],
+        rhs_array: &[T],
+        input_carries: Option<&[BooleanBlock]>,
+        requested_flag: OutputFlag,
+    ) -> Vec<Option<BooleanBlock>>
+    where
+        T: IntegerRadixCiphertext,
+    {
+        let int_key = &self.key.key;
+        let shortint_key = &int_key.key;
+        let num_additions = lhs_array.len();
+
+        // Validate input carries if provided
+        if let Some(carries) = input_carries {
+            assert_eq!(
+                carries.len(),
+                num_additions,
+                "Number of input carries must match number of additions"
+            );
+        }
+
+        // Handle empty blocks case
+        let blocks_per_addition = lhs_array[0].blocks().len();
+        if blocks_per_addition == 0 {
+            if requested_flag == OutputFlag::None {
+                return vec![None; num_additions];
+            }
+            return vec![Some(int_key.create_trivial_boolean_block(false)); num_additions];
+        }
+
+        let message_modulus = int_key.message_modulus().0;
+        let num_bits_in_message = message_modulus.ilog2() as u64;
+
+        let block_modulus = message_modulus * int_key.carry_modulus().0;
+        let num_bits_in_block = block_modulus.ilog2();
+        assert!(
+            num_bits_in_block == 4,
+            "Having 4-bit ciphertext is a hard requirement!"
+        );
+
+        // Initialize carry blocks for each addition
+        let mut carries = input_carries.map_or_else(
+            || vec![shortint_key.create_trivial(0); num_additions],
+            |input_carry_vec| {
+                input_carry_vec
+                    .iter()
+                    .map(|c| c.0.clone())
+                    .collect::<Vec<_>>()
+            },
+        );
+
+        // Initialize overflow flags if requested
+        let overflow_requested = requested_flag == OutputFlag::Overflow;
+        let mut overflow_flags: Vec<Ciphertext> = if overflow_requested {
+            lhs_array
+                .par_iter()
+                .zip(rhs_array.par_iter())
+                .map(|(lhs, rhs)| {
+                    let mut block = shortint_key
+                        .unchecked_scalar_mul(lhs.blocks().last().unwrap(), message_modulus as u8);
+                    shortint_key.unchecked_add_assign(&mut block, rhs.blocks().last().unwrap());
+                    block
+                })
+                .collect()
+        } else {
+            vec![]
+        };
+
+        // Pre-generate LUTs
+        let many_message_carry_extract = self.many_lut_message_and_carry_extract();
+        let many_lut = vec![&many_message_carry_extract; num_additions];
+
+        let overflow_prep_lut = shortint_key.generate_lookup_vector(&|lhs_rhs| {
+            let lhs = lhs_rhs / message_modulus;
+            let rhs = lhs_rhs % message_modulus;
+            overflow_flag_preparation_lut(lhs, rhs, num_bits_in_message)
+        });
+        let overflow_flag_lut = shortint_key.generate_lookup_vector(&|block| {
+            let input_carry = block & 1;
+            let does_overflow_if_carry_is_1 = (block >> 3) & 1;
+            let does_overflow_if_carry_is_0 = (block >> 2) & 1;
+            if input_carry == 1 {
+                does_overflow_if_carry_is_1
+            } else {
+                does_overflow_if_carry_is_0
+            }
+        });
+
+        // Process all blocks sequentially, propagating carries from block to block
+        for block_idx in 0..blocks_per_addition {
+            let is_first = block_idx == 0;
+            let is_last = block_idx == blocks_per_addition - 1;
+
+            // Add rhs + carry to lhs for all additions in parallel
+            lhs_array
+                .par_iter_mut()
+                .zip(rhs_array.par_iter())
+                .zip(carries.par_iter())
+                .for_each(|((lhs_ct, rhs_ct), carry)| {
+                    shortint_key.unchecked_add_assign(
+                        &mut lhs_ct.blocks_mut()[block_idx],
+                        &rhs_ct.blocks()[block_idx],
+                    );
+                    shortint_key.unchecked_add_assign(&mut lhs_ct.blocks_mut()[block_idx], carry);
+                });
+
+            // Before last-block PBS, feed the propagated carry into overflow flags.
+            // For single-block, the carry into the only block is the external input carry;
+            // for multi-block, it's the carry propagated from the previous block.
+            let include_overflow_prep = is_first && overflow_requested;
+            let include_overflow_final = is_last && overflow_requested && blocks_per_addition > 1;
+            let overflow_ops_per_addition =
+                usize::from(include_overflow_prep) + usize::from(include_overflow_final);
+
+            if include_overflow_final {
+                for i in 0..num_additions {
+                    shortint_key.unchecked_add_assign(&mut overflow_flags[i], &carries[i]);
+                }
+            }
+
+            // Build batch of blocks and LUTs for packed PBS
+
+            let mut overflow_flag_blocks =
+                Vec::with_capacity(num_additions * overflow_ops_per_addition);
+            let mut overflow_luts = Vec::with_capacity(num_additions * overflow_ops_per_addition);
+
+            let mut many_blocks = Vec::with_capacity(num_additions);
+            for i in 0..num_additions {
+                many_blocks.push(lhs_array[i].blocks()[block_idx].clone());
+
+                if include_overflow_prep {
+                    overflow_flag_blocks.push(overflow_flags[i].clone());
+                    overflow_luts.push(&overflow_prep_lut);
+                } else if include_overflow_final {
+                    overflow_flag_blocks.push(overflow_flags[i].clone());
+                    overflow_luts.push(&overflow_flag_lut);
+                }
+            }
+
+            let message_and_carries = self.apply_many_lookup_vector_packed(&many_blocks, &many_lut);
+            self.apply_lookup_vector_packed_assign(&mut overflow_flag_blocks, &overflow_luts);
+
+            // Extract results
+            for i in 0..num_additions {
+                lhs_array[i].blocks_mut()[block_idx].clone_from(&message_and_carries[i][0]);
+                carries[i].clone_from(&message_and_carries[i][1]);
+
+                if include_overflow_prep || include_overflow_final {
+                    overflow_flags[i].clone_from(&overflow_flag_blocks[i]);
+                }
+            }
+        }
+
+        // Single-block overflow needs a second PBS round: the first round applied
+        // overflow_prep_lut, now we add the input carry and apply overflow_flag_lut.
+        if blocks_per_addition == 1 && overflow_requested {
+            if let Some(input_carries) = input_carries {
+                for i in 0..num_additions {
+                    shortint_key.unchecked_add_assign(&mut overflow_flags[i], &input_carries[i].0);
+                }
+            }
+
+            let luts_to_apply: Vec<_> = (0..num_additions).map(|_| &overflow_flag_lut).collect();
+            self.apply_lookup_vector_packed_assign(&mut overflow_flags, &luts_to_apply);
+        }
+
+        // Return appropriate results based on requested flag
+        match requested_flag {
+            OutputFlag::None => vec![None; num_additions],
+            OutputFlag::Overflow => overflow_flags
+                .into_iter()
+                .map(|flag| Some(BooleanBlock::new_unchecked(flag)))
+                .collect(),
+            OutputFlag::Carry => carries
+                .into_iter()
+                .map(|mut carry| {
+                    carry.degree = Degree::new(1);
+                    Some(BooleanBlock::new_unchecked(carry))
+                })
+                .collect(),
+        }
+    }
+
+    /// SIMD version of compute_propagation_simulators_and_groups_carries
+    /// Processes multiple additions together using packed LUT operations
+    ///
+    /// # Arguments
+    /// * `group_size` - Size of each group for Kogge-Stone algorithm
+    /// * `all_block_states` - Flattened block states for all additions
+    /// * `num_additions` - Number of independent additions
+    /// * `blocks_per_addition` - Number of block states per addition
+    ///
+    /// # Returns
+    /// (all_propagation_simulators, all_resolved_carries) where:
+    /// - all_propagation_simulators: Flattened propagation simulators for all additions
+    /// - all_resolved_carries: Vec of resolved carries per addition
+    // TODO: move this to add.rs and remove duplication
+    pub(crate) fn compute_propagation_simulators_and_groups_carries_simd(
+        &self,
+        group_size: usize,
+        all_block_states: &[Ciphertext],
+        num_additions: usize,
+    ) -> (Vec<Ciphertext>, Vec<Vec<Ciphertext>>) {
+        let shortint_key = &self.key.key.key;
+
+        let total_blocks = all_block_states.len() - num_additions; // -num_additions because last blocks removed
+        let blocks_per_addition = total_blocks / num_additions;
+        if blocks_per_addition == 0 {
+            let prop_sims = vec![shortint_key.create_trivial(1); num_additions];
+            let resolved = vec![vec![shortint_key.create_trivial(0)]; num_additions];
+            return (prop_sims, resolved);
+        }
+
+        let message_modulus = shortint_key.message_modulus.0;
+        let block_modulus = message_modulus * shortint_key.carry_modulus.0;
+        let num_bits_in_block = block_modulus.ilog2();
+
+        let num_groups = blocks_per_addition.div_ceil(group_size);
+        let num_carry_to_resolve = num_groups - 1;
+
+        let sequential_depth = num_carry_to_resolve.saturating_sub(1) / (group_size - 1);
+        let hillis_steel_depth = if num_carry_to_resolve == 0 {
+            0
+        } else {
+            num_carry_to_resolve.ceil_ilog2() as usize
+        };
+        let use_sequential_algorithm_to_resolve_group_carries =
+            sequential_depth <= hillis_steel_depth;
+
+        // The LUTs that tell if a carry is generated or not
+        // for a cum sum block in the first group (excluding first block)
+        let first_group_propagation_state_luts: Vec<_> = (0..group_size)
+            .map(|idx| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    let carry = (propa_cum_sum_block >> idx) & 1;
+                    if carry == 0 {
+                        0 // Nothing
+                    } else {
+                        2 // Generate
+                    }
+                })
+            })
+            .collect();
+
+        let first_group_carry_lut =
+            shortint_key.generate_lookup_vector(&|block| (block >> (num_bits_in_block - 1)) & 1);
+
+        let other_groups_inner_propagation_luts: Vec<_> = (0..group_size)
+            .map(|idx| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    let mask = (2 << idx) - 1;
+                    match propa_cum_sum_block.cmp(&mask) {
+                        std::cmp::Ordering::Less => 0,    // Nothing
+                        std::cmp::Ordering::Equal => 1,   // Propagate
+                        std::cmp::Ordering::Greater => 2, // Generate
+                    }
+                })
+            })
+            .collect();
+
+        let other_group_carry_luts: Vec<_> = if use_sequential_algorithm_to_resolve_group_carries {
+            (0..group_size)
+                .map(|idx| {
+                    shortint_key.generate_lookup_vector(&|block| {
+                        if block == (block_modulus - 1) {
+                            0
+                        } else {
+                            u64::MAX << idx
+                        }
+                    })
+                })
+                .collect()
+        } else {
+            vec![shortint_key.generate_lookup_vector(&|block| {
+                if block == (block_modulus - 1) {
+                    2
+                } else {
+                    u64::MAX
+                }
+            })]
+        };
+
+        // Compute cumulative sums for all additions (flattened)
+        let mut all_propagation_cum_sums = Vec::with_capacity(total_blocks);
+
+        for add_idx in 0..num_additions {
+            let add_start = add_idx * (blocks_per_addition + 1);
+            let add_block_states = &all_block_states[add_start..add_start + blocks_per_addition];
+
+            add_block_states.chunks(group_size).for_each(|group| {
+                all_propagation_cum_sums.push(shortint_key.create_trivial(0));
+                let mut previous_cum_sum = &group[0];
+
+                for other in &group[1..] {
+                    let mut result = other.clone();
+                    shortint_key.unchecked_add_assign(&mut result, previous_cum_sum);
+                    all_propagation_cum_sums.push(result);
+                    previous_cum_sum = all_propagation_cum_sums.last().unwrap();
+                }
+            });
+        }
+
+        // Build LUT references for all blocks across all additions
+        let propagation_cum_sum_luts = (0..blocks_per_addition)
+            .map(|i| {
+                let group_index = i / group_size;
+                let is_in_first_group = group_index == 0;
+                let index_in_group = i % group_size;
+
+                if is_in_first_group {
+                    if index_in_group == group_size - 1 {
+                        &first_group_carry_lut
+                    } else {
+                        &first_group_propagation_state_luts[index_in_group]
+                    }
+                } else if index_in_group == group_size - 1 {
+                    if use_sequential_algorithm_to_resolve_group_carries {
+                        &other_group_carry_luts[(group_index - 1) % (group_size - 1)]
+                    } else {
+                        &other_group_carry_luts[0]
+                    }
+                } else {
+                    &other_groups_inner_propagation_luts[index_in_group]
+                }
+            })
+            .cycle()
+            .take(num_additions * blocks_per_addition)
+            .collect::<Vec<_>>();
+
+        // Apply LUTs to all cumulative sums in one packed operation
+        self.apply_lookup_vector_packed_assign(
+            &mut all_propagation_cum_sums,
+            &propagation_cum_sum_luts,
+        );
+
+        // Fill in correct values for first blocks of each group
+        for add_idx in 0..num_additions {
+            let add_start = add_idx * (blocks_per_addition + 1);
+            let add_block_states = &all_block_states[add_start..add_start + blocks_per_addition];
+
+            add_block_states
+                .chunks(group_size)
+                .enumerate()
+                .for_each(|(group_idx, group)| {
+                    let flat_base = add_idx * blocks_per_addition;
+                    if group_idx == 0 {
+                        all_propagation_cum_sums[flat_base] =
+                            shortint_key.unchecked_scalar_mul(&group[0], 2);
+                    } else {
+                        all_propagation_cum_sums[flat_base + (group_size * group_idx)]
+                            .clone_from(&group[0]);
+                    }
+                });
+        }
+
+        // Fix padding bits
+        all_propagation_cum_sums
+            .par_iter_mut()
+            .enumerate()
+            .for_each(|(flat_idx, block)| {
+                let block_idx = flat_idx % blocks_per_addition;
+                let group_idx = block_idx / group_size;
+                let is_in_first_group = group_idx == 0;
+                let idx_in_group = block_idx % group_size;
+
+                let may_have_its_padding_bit_set =
+                    !is_in_first_group && idx_in_group == group_size - 1;
+                if may_have_its_padding_bit_set {
+                    if use_sequential_algorithm_to_resolve_group_carries {
+                        shortint_key.unchecked_scalar_add_assign(
+                            block,
+                            1 << ((group_idx - 1) % (group_size - 1)),
+                        );
+                    } else {
+                        shortint_key.unchecked_scalar_add_assign(block, 1);
+                    }
+                    block.degree = Degree::new(message_modulus - 1);
+                }
+            });
+
+        // Extract group carries and build propagation simulators for all additions
+        let mut all_propagation_simulators = Vec::with_capacity(total_blocks);
+        let mut all_group_carries = Vec::with_capacity(num_additions);
+
+        for add_idx in 0..num_additions {
+            let add_start = add_idx * blocks_per_addition;
+            let add_end = add_start + blocks_per_addition;
+            let mut group_carry = Vec::with_capacity(num_groups);
+            // First block does not get a carry
+            all_propagation_simulators.push(shortint_key.create_trivial(1));
+
+            for (i, block) in all_propagation_cum_sums[add_start..add_end]
+                .iter()
+                .cloned()
+                .enumerate()
+            {
+                let single_addition_propagation_simulators_len = i + 1; // +1 because we already pushed the first trivial
+                if single_addition_propagation_simulators_len % group_size == 0 {
+                    group_carry.push(block);
+                    all_propagation_simulators.push(shortint_key.create_trivial(1));
+                } else {
+                    all_propagation_simulators.push(block);
+                }
+            }
+            all_group_carries.push(group_carry);
+        }
+
+        // Resolve carries for all additions
+        // Batch the resolution by collecting all group carries and resolving together
+        let all_resolved_carries = if all_group_carries.iter().any(|g| g.is_empty()) {
+            // No carries to resolve between groups
+            vec![vec![shortint_key.create_trivial(0)]; num_additions]
+        } else if use_sequential_algorithm_to_resolve_group_carries {
+            // Use sequential algorithm for each addition
+            self.resolve_carries_of_groups_sequentially_simd(
+                all_group_carries,
+                group_size,
+                num_additions,
+            )
+        } else {
+            // Use Hillis-Steele algorithm
+            // Batch all group carries together for resolution
+            self.resolve_carries_of_groups_using_hillis_steele_simd(
+                all_group_carries,
+                num_additions,
+            )
+        };
+
+        (all_propagation_simulators, all_resolved_carries)
+    }
+
+    /// SIMD version of resolve_carries_of_groups_using_hillis_steele
+    /// Processes multiple additions together
+    pub(crate) fn resolve_carries_of_groups_using_hillis_steele_simd(
+        &self,
+        all_group_pgns: Vec<Vec<Ciphertext>>,
+        num_additions: usize,
+    ) -> Vec<Vec<Ciphertext>> {
+        let shortint_key = &self.key.key.key;
+        let lut_carry_propagation_sum = |msb: u64, lsb: u64| -> u64 {
+            if msb == 2 {
+                1
+            } else if msb == 3 {
+                if lsb == 2 {
+                    1
+                } else {
+                    lsb
+                }
+            } else {
+                msb
+            }
+        };
+
+        // Process each addition's group carries
+        // Note: The Hillis-Steele algorithm has dependencies within each addition's carries,
+        // but different additions are independent. We batch the LUT applications.
+        let mut resolved_carries =
+            self.compute_prefix_sum_hillis_steele_simd(all_group_pgns, &lut_carry_propagation_sum);
+        resolved_carries
+            .iter_mut()
+            .take(num_additions)
+            .for_each(|carries| {
+                carries.insert(0, shortint_key.create_trivial(0));
+            });
+        resolved_carries
+    }
+
+    pub(crate) fn compute_prefix_sum_hillis_steele_simd<F>(
+        &self,
+        mut blocks: Vec<Vec<Ciphertext>>,
+        lut_function: &F,
+    ) -> Vec<Vec<Ciphertext>>
+    where
+        F: Fn(u64, u64) -> u64,
+    {
+        let num_parallel_lanes = blocks.len();
+        let shortint_key = &self.key.key.key;
+        debug_assert!(shortint_key.message_modulus.0 * shortint_key.carry_modulus.0 >= (1 << 4));
+
+        if blocks.is_empty() {
+            return vec![];
+        }
+
+        let lut_vector_sum = shortint_key.generate_lookup_vector_bivariate(&lut_function);
+
+        let mut space = 1;
+        let mut step_output = blocks.clone();
+
+        let num_blocks = blocks[0].len();
+        let num_steps = num_blocks.ceil_ilog2() as usize;
+
+        for _ in 0..num_steps {
+            let num_blocks_to_resolve = num_blocks - space;
+            let mut prepared_blocks =
+                Vec::with_capacity(num_parallel_lanes * num_blocks_to_resolve);
+            // Initialize single vector that is always updated
+            let mut prev_block_carries = vec![blocks[0][0].clone(); num_blocks_to_resolve];
+
+            // Copies carries
+            for i in 0..num_parallel_lanes {
+                for (idx, block) in blocks[i].iter().enumerate().take(num_blocks_to_resolve) {
+                    prev_block_carries[idx].clone_from(block);
+                }
+
+                // Shifts block by space
+                let step_output_vec = &step_output[i][space..num_blocks];
+                prepared_blocks.append(
+                    &mut self.prepare_block_vecs_bivariate(step_output_vec, &prev_block_carries),
+                );
+            }
+
+            self.apply_same_lookup_vector_packed_assign(&mut prepared_blocks, &lut_vector_sum);
+
+            let mut add_idx = 0;
+            for (i, block) in prepared_blocks.into_iter().enumerate() {
+                if add_idx != (i / num_blocks_to_resolve) {
+                    add_idx += 1;
+                }
+                let block_idx = i % num_blocks_to_resolve;
+                step_output[add_idx][space + block_idx] = block;
+            }
+
+            for i in 0..num_parallel_lanes {
+                for j in space..num_blocks {
+                    blocks[i][j].clone_from(&step_output[i][j]);
+                }
+            }
+
+            space *= 2;
+        }
+
+        blocks
+    }
+
+    /// This resolves the carries using a sequential algorithm
+    /// where each iteration resolves group_size - 1 "PGN"
+    ///
+    /// Blocks must have a value in
+    /// - 2 for generate
+    /// - 1 for propagate
+    /// - 0 for no carry
+    ///
+    /// This value must be shifted by the position in the block's group.
+    ///
+    /// The block of the first group (so group_pgns[0]) must have a value in
+    /// - 1 for generate
+    /// - 0 for no carry
+    ///
+    /// The returned Vec of blocks encrypting 1 if a carry is generated, 0 if not
+    pub(crate) fn resolve_carries_of_groups_sequentially_simd(
+        &self,
+        mut all_group_carries: Vec<Vec<Ciphertext>>,
+        group_size: usize,
+        num_additions: usize,
+    ) -> Vec<Vec<Ciphertext>> {
+        let shortint_key = &self.key.key.key;
+        let luts = (0..group_size - 1)
+            .map(|idx| {
+                shortint_key.generate_lookup_vector(&|propa_cum_sum_block| {
+                    (propa_cum_sum_block >> (idx + 1)) & 1
+                })
+            })
+            .collect::<Vec<_>>();
+        let luts = luts.iter().collect::<Vec<_>>();
+
+        let mut resolved_carries = all_group_carries
+            .par_iter_mut()
+            .map(|group| {
+                group.rotate_left(1);
+                vec![shortint_key.create_trivial(0), group.pop().unwrap()]
+            })
+            .collect::<Vec<_>>();
+
+        let iteration_nb = all_group_carries[0].len().div_ceil(group_size - 1);
+
+        for _ in 0..iteration_nb {
+            let mut luts_parallel = Vec::with_capacity(group_size * num_additions);
+            let mut carries_parallel = Vec::with_capacity(group_size * num_additions);
+
+            let drain_size = all_group_carries[0].len().min(group_size - 1);
+
+            all_group_carries
+                .iter_mut()
+                .enumerate()
+                .for_each(|(i, group_carries)| {
+                    let mut cum_sums = group_carries.drain(..drain_size).collect::<Vec<_>>();
+                    shortint_key.unchecked_add_assign(
+                        &mut cum_sums[0],
+                        resolved_carries[i].last().unwrap(),
+                    );
+
+                    if cum_sums.len() > 1 {
+                        let mut accumulator = cum_sums[0].clone();
+                        for block in cum_sums[1..].iter_mut() {
+                            shortint_key.unchecked_add_assign(&mut accumulator, block);
+                            block.clone_from(&accumulator);
+                        }
+                    }
+                    luts_parallel.extend_from_slice(&luts[..cum_sums.len()]);
+                    carries_parallel.append(&mut cum_sums);
+                });
+
+            self.apply_lookup_vector_packed_assign(&mut carries_parallel, &luts_parallel);
+            carries_parallel
+                .chunks_mut(drain_size)
+                .enumerate()
+                .for_each(|(i, group)| {
+                    resolved_carries[i].extend_from_slice(group);
+                });
+        }
+
+        resolved_carries
+    }
+}
diff --git a/tfhe/src/integer/fpga/server_key/radix/bit_extractor.rs b/tfhe/src/integer/fpga/server_key/radix/bit_extractor.rs
new file mode 100644
index 000000000..b77fe09fa
--- /dev/null
+++ b/tfhe/src/integer/fpga/server_key/radix/bit_extractor.rs
@@ -0,0 +1,110 @@
+use crate::core_crypto::fpga::lookup_vector::LookupVector;
+use crate::integer::fpga::server_key::BelfortServerKey;
+use crate::shortint::Ciphertext;
+use itertools::iproduct;
+
+pub(crate) struct BitExtractor<'a> {
+    bit_extract_luts: Vec<LookupVector>,
+    bits_per_block: usize,
+    server_key: &'a BelfortServerKey,
+}
+
+impl<'a> BitExtractor<'a> {
+    pub(crate) fn msg_with_final_offset0(
+        server_key: &'a BelfortServerKey,
+        bits_per_block: usize,
+    ) -> Self {
+        let shortint_key = &server_key.key.key.key;
+
+        let mut bit_extract_luts: Vec<LookupVector> = Vec::new();
+
+        bit_extract_luts.push({
+            // Scalar Bitand 1
+            {
+                let func = |x| x & 1;
+                shortint_key.generate_lookup_vector(&func)
+            }
+        });
+        if bits_per_block == 2 {
+            bit_extract_luts.push({
+                // Message bit 1 extraction
+                {
+                    let func = |x| (x >> 1) & 1_u64;
+                    shortint_key.generate_lookup_vector(&func)
+                }
+            });
+        }
+
+        Self {
+            bit_extract_luts,
+            bits_per_block,
+            server_key,
+        }
+    }
+
+    /// Creates a bit extractor that will extract bits from an input ciphertext
+    /// into single blocks.
+    ///
+    /// The offset which is 2 gives the position where the extracted bit shall be placed
+    /// in the resulting block.
+    /// It may be used to align the bit with a certain position to avoid
+    /// shifting it later (and increasing noise)
+    pub(crate) fn msg_with_final_offset2(
+        server_key: &'a BelfortServerKey,
+        bits_per_block: usize,
+    ) -> Self {
+        let shortint_key = &server_key.key.key.key;
+
+        let mut bit_extract_luts: Vec<LookupVector> = Vec::new();
+
+        bit_extract_luts.push({
+            // Message bit 0 extraction with offset two
+            {
+                let func = |x| (x & 1) << 2;
+                shortint_key.generate_lookup_vector(&func)
+            }
+        });
+        if bits_per_block == 2 {
+            bit_extract_luts.push({
+                // Message bit 1 extraction with offset two
+                {
+                    let func = |x| ((x >> 1) & 1_u64) << 2;
+                    shortint_key.generate_lookup_vector(&func)
+                }
+            });
+        }
+
+        Self {
+            bit_extract_luts,
+            bits_per_block,
+            server_key,
+        }
+    }
+
+    pub(crate) fn extract_all_bits(&self, blocks: &[Ciphertext]) -> Vec<Ciphertext> {
+        let num_blocks: usize = blocks.len();
+        self.extract_n_bits(blocks, num_blocks * self.bits_per_block)
+    }
+
+    pub(crate) fn extract_n_bits(&self, blocks: &[Ciphertext], n: usize) -> Vec<Ciphertext> {
+        let num_blocks = blocks.len();
+        let (blocks_idxs, lut_idxs): (Vec<usize>, Vec<usize>) =
+            iproduct!(0..num_blocks, 0..self.bits_per_block)
+                .take(n)
+                .unzip();
+        let mut blocks = blocks_idxs
+            .iter()
+            .map(|block_idx| blocks[*block_idx].clone())
+            .collect::<Vec<_>>();
+
+        let luts = lut_idxs
+            .into_iter()
+            .map(|lut_idx| &self.bit_extract_luts[lut_idx])
+            .collect::<Vec<_>>();
+
+        self.server_key
+            .apply_lookup_vector_packed_assign(&mut blocks, &luts);
+
+        blocks
+    }
+}
