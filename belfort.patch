index 000000000..559d14a17
--- /dev/null
+++ b/tfhe/src/high_level_api/composites/erc20_simd/tests.rs
@@ -0,0 +1,96 @@
+use super::erc20_transfer_simd;
+use crate::integer::fpga::server_key::radix::tests::FpgaFunctionExecutor;
+use crate::integer::fpga::BelfortServerKey;
+use crate::integer::keycache::KEY_CACHE;
+use crate::integer::server_key::radix_parallel::tests_cases_unsigned::FunctionExecutor;
+use crate::integer::server_key::radix_parallel::tests_long_run::NB_CTXT_LONG_RUN;
+use crate::integer::tests::create_test_belfort_params;
+use crate::integer::{IntegerKeyKind, RadixCiphertext, RadixClientKey};
+use crate::shortint::parameters::*;
+use rand::Rng;
+use std::sync::Arc;
+
+const ARRAY_SIZE: usize = 5;
+
+create_test_belfort_params!(no_cmux_erc20_simd);
+
+fn no_cmux_erc20_simd<P>(param: P)
+where
+    P: Into<TestParameters>,
+{
+    let executor = FpgaFunctionExecutor::new(erc20_transfer_simd);
+    no_cmux_erc20_simd_test(param, executor);
+}
+
+pub(crate) fn no_cmux_erc20_simd_test<P, F>(param: P, mut executor: FpgaFunctionExecutor<F>)
+where
+    P: Into<TestParameters>,
+    F: for<'a, 'b> Fn(
+        &'a BelfortServerKey,
+        &'a [RadixCiphertext],
+        &'a [RadixCiphertext],
+        &'a [RadixCiphertext],
+    ) -> (Vec<RadixCiphertext>, Vec<RadixCiphertext>),
+    FpgaFunctionExecutor<F>: for<'a> FunctionExecutor<
+        (
+            &'a [RadixCiphertext],
+            &'a [RadixCiphertext],
+            &'a [RadixCiphertext],
+        ),
+        (Vec<RadixCiphertext>, Vec<RadixCiphertext>),
+    >,
+{
+    let param = param.into();
+    let (cks, sks) = KEY_CACHE.get_from_params(param, IntegerKeyKind::Radix);
+
+    let cks = RadixClientKey::from((cks, NB_CTXT_LONG_RUN));
+
+    let mut rng = rand::thread_rng();
+    let sks = Arc::new(sks);
+    executor.setup(sks);
+
+    let clear_from_amounts = (0..ARRAY_SIZE)
+        .map(|_| rng.gen::<u64>())
+        .collect::<Vec<u64>>();
+    let clear_to_amounts = (0..ARRAY_SIZE)
+        .map(|_| rng.gen::<u64>())
+        .collect::<Vec<u64>>();
+    let clear_amounts = (0..ARRAY_SIZE)
+        .map(|_| rng.gen::<u64>())
+        .collect::<Vec<u64>>();
+
+    let from_amounts = cks.encrypt_array(&clear_from_amounts);
+    let to_amounts = cks.encrypt_array(&clear_to_amounts);
+    let amounts = cks.encrypt_array(&clear_amounts);
+
+    let (new_to_amounts, new_from_amounts) =
+        executor.execute((&from_amounts, &to_amounts, &amounts));
+
+    let decrypted_new_from_amount: Vec<u64> = cks.decrypt_array(&new_from_amounts);
+    let decrypted_new_to_amount: Vec<u64> = cks.decrypt_array(&new_to_amounts);
+
+    for i in 0..ARRAY_SIZE {
+        let expected_new_from_amount = if clear_from_amounts[i] >= clear_amounts[i] {
+            clear_from_amounts[i].wrapping_sub(clear_amounts[i])
+        } else {
+            clear_from_amounts[i]
+        };
+        let expected_new_to_amount = if clear_from_amounts[i] >= clear_amounts[i] {
+            clear_to_amounts[i].wrapping_add(clear_amounts[i])
+        } else {
+            clear_to_amounts[i]
+        };
+
+        assert_eq!(
+                decrypted_new_from_amount[i], expected_new_from_amount,
+                "Invalid erc20 result on from amount: original from amount: {}, amount: {}, to amount: {}, expected new from amount: {expected_new_from_amount}.",
+                clear_from_amounts[i],
+                clear_amounts[i],
+                clear_to_amounts[i],
+            );
+        assert_eq!(
+            decrypted_new_to_amount[i], expected_new_to_amount,
+            "Invalid erc20 result on to amount."
+        );
+    }
+}
